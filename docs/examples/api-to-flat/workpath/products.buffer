{"uuid":"67def170-a766-48d7-8ebc-316ffe60b9bc","identifier":"1111111319","enabled":true,"family":"clothing","categories":["master_men_pants_jeans","supplier_zaro"],"groups":[],"parent":"zeus","values":{"size":[{"locale":null,"scope":null,"data":"s"}],"color":[{"locale":null,"scope":null,"data":"blue"}],"supplier":[{"locale":null,"scope":null,"data":"zaro"}],"wash_temperature":[{"locale":null,"scope":null,"data":"400"}],"collection":[{"locale":null,"scope":null,"data":["autumn_2016"]}],"price":[{"locale":null,"scope":null,"data":[{"amount":"1290.00","currency":"EUR"}]}],"name":[{"locale":null,"scope":null,"data":"zeus"}],"erp_name":[{"locale":"en_US","scope":null,"data":"Zeus"}],"description":[{"locale":"en_US","scope":"ecommerce","data":"Poplin shirts are easy to iron and do not wrinkle. A must-have for any wardrobe that respects the Ellington section has a hidden button collar and a fitted and stylish look. 100% cotton. * Returns this article are made only by post. This item can only be returned in store."}]},"created":"2023-04-18T13:33:03+00:00","updated":"2023-04-18T13:33:03+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"9f6d7da1-b458-4db7-8b36-4a49861cd7f1","identifier":"11113932","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Canon PowerShot S100"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"The PowerShot S100 uses Canon EOS sensor know-how and the latest DIGIC 5 processor to deliver exceptional images even in low light. With an f\/2.0 lens, RAW and GPS this is an expert compact with impact.\\n\\n<b>Features<\/b>\\n\\n- High-sensitivity 12.1 MP Canon CMOS\\n- HS System with DIGIC 5\\n- Ultra-wide 24mm, f\/2.0, 5x zoom lens. Intelligent IS\\n- Lens Control Ring, NR control and RAW\\n- GPS\\n- Full HD, HDMI\\n- Large 7.5 cm (3.0\") LCD\\n- High-speed Burst HQ\\n- Smart Auto, Multi-area WB\\n- Optional Waterproof Case\\n- Expert control. Seriously compact\\n\\n<b>High-sensitivity 12.1 MP Canon CMOS sensor<\/b>\\nThe high-sensitivity 1\/1.7 type CMOS sensor, developed using EOS DSLR sensor know-how, works in combination with the DIGIC 5 processor to deliver class leading image quality especially at higher ISO speeds and in low light.\\n\\n<b>HS System with DIGIC 5<\/b>\\nThe HS System is a powerful combination of the DIGIC 5 image processor, which is 6x more powerful than DIGIC 4, and a high-sensitivity CMOS sensor. It lets you shoot with low noise and high image quality even in low light up to ISO 6400 - reducing the need for flash or a tripod.\\n\\n<b>Versatile lens. Intelligent IS<\/b>\\nA bright f\/2.0 lens further extends your ability to shoot in darker conditions. A 24mm ultra-wide angle setting lets you take stunning landscapes and a flexible 5x zoom gets you up close. Intelligent IS automatically selects exactly the right optical Image Stabilizer setting from 7 possible modes to ensure sharp, detailed photos and videos.\\n\\n<b>Lens Control Ring, Noise Reduction control and RAW<\/b>\\nThe lens Control Ring allows quick access to functions such as zoom, aperture, shutter speed, focus or ISO. Make adjustments to the level of noise reduction applied to images or shoot in RAW format for post-processing in the supplied DPP software.\\n\\n<b>GPS<\/b>\\nEmbed valuable location information into your images every time you take a shot with GPS tagging. The GPS Logger function can record your position at set time intervals so you can review your entire journey on the supplied Map Utility software.\\n\\n<b>Full HD Movies, HDMI-CEC<\/b>\\nRecord superb, Full HD 1080p movies at 24fps with stereo sound. An HDMI-CEC mini connection allows for loss-less playback on a compatible HDTV.\\n\\n<b>7.5 cm (3.0\u201d) PureColor II G LCD<\/b>\\nA 460k dot bright and clear LCD features a tempered glass outer layer for strength and high visibility even when shooting in bright conditions.\\n\\n<b>High-speed Burst HQ<\/b>\\nThanks to the processing capabilities of DIGIC 5 you can capture full resolution split second action at 9.6fps in an 8-frame burst using High-speed Burst HQ mode.\\n\\n<b>Smart Auto, Multi-area WB<\/b>\\nSmart Auto selects camera settings for you from 32 different scenes (21 in movies), automatically ensuring optimum results. Multi-area White Balance compensates for the presence of multiple light sources for natural results.\\n\\nOptional Waterproof Case\\nProtect your camera underwater to depths of up to 40m with the optional WP-DC43 waterproof case."}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"optical_zoom":[{"locale":null,"scope":null,"data":5}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-30T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6db17186-d042-48b2-86db-404ed7082d79","identifier":"11134785","enabled":true,"family":"mp3_players","categories":["approx","audio_video_sales","mp3_players"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"c\/9\/8\/a\/c98a59581342e2d45683f1c0de4af90451f25de6_11134785_5058.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/c\/9\/8\/a\/c98a59581342e2d45683f1c0de4af90451f25de6_11134785_5058.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Approx APPMP4014GBB MP3 player & recorder"}],"power_requirements":[{"locale":null,"scope":null,"data":"3.7V"}],"description":[{"locale":"en_US","scope":"print","data":"MP4 Player in various colors. Compact and lightweight addition to having very complete technical features despite its small size. Its touch keypad and high-quality TFT screen makes handling fun.\\n\\nIt has a rechargeable battery about 10 hours of operation that lets you enjoy all your music, video, images, documents, radio, etc. Power multimedia to your fingertips!"},{"locale":"fr_FR","scope":"print","data":"Lecteur MP4 en diff\u00e9rentes couleurs. Compact et l\u00e9ger en plus d \u0301avoir des caract\u00e9ristiques techniques compl\u00e8tes, malgr\u00e9 sa petite taille. Son clavier tactile et de haute qualit\u00e9 de l\u2019\u00e9cran TFT facilite l \u0301utilisation.\\n\\nAvec batterie rechargeable de 10 heures de fonctionnement qui vous permet de profiter de tous vos musiques, vid\u00e9os, images, documents, radio, etc."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-10-04T00:00:00+00:00"}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
