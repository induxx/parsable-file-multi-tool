{"uuid":"1869f2aa-0a10-4422-87f8-035e5e4d8b42","identifier":"100121","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","oki","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"picture":[{"locale":null,"scope":null,"data":"d\/2\/b\/3\/d2b31c9ee37bb208ae296c2426f76ff14beb924c_100121_1864.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/d\/2\/b\/3\/d2b31c9ee37bb208ae296c2426f76ff14beb924c_100121_1864.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"OKI B4100 Desktop printer"}],"description":[{"locale":"en_US","scope":"print","data":"It\u2019s a fast, quiet, quality desktop printer for the finance conscious user. \\nOffering excellent print and processing speed for your money, the new B4100 is the consummate mono printer for the individual business user. Compact (A4), stylish and robust, it boasts class-leading features including 18 pages per minute (ppm), high 8MB RAM memory and fast first page to print at under 6.2 seconds. Ideal for the Personal Desktop where high quality documents such as report and point of service material are required.\\n\u2022  18 Pages per minute print speed  \\n\u2022  6.2 seconds to first page for instant customer documents  \\n\u2022  Oki reliability for years of trouble-free service  \\n\u2022  Low cost consumables reduce the cost of ownership  \\n\u2022  Compatible with all major computer operating systems  \\n\u2022  Flexible upgrade options for now and in the future  \\n\u2022  Ideal for personal desktop where high quality documents such as reports and point-of-service material are required."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-08-12T00:00:00+00:00"}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"82c7f900-8c12-4062-b4ec-40cab68b7eb4","identifier":"100136","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","oki","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"name":[{"locale":null,"scope":null,"data":"OKI B6200 NON 128MB 24ppm 1200x1200dpi A4"}],"description":[{"locale":"en_US","scope":"print","data":"Oki has a more holistic view of Mono Printing - why offer faster speed of printing if you do not have the processor power to handle the information on the page? Why worry about first page to print times if you do not have enough memory to complete printing your job? Oki offers class leading printers like the B6200 with impressive speed, processor power, memory, duty cycle, toner capacity, trays and reliability which will improve your business productivity. \\n \\nSpeed, Versatility,flexibility and Reliability - these are the qualities that productive professionals in busy workgroups tell us they must have in a printer. And that\u2019s what the B6200 printer deliver for small to medium workgroups - a cost-effective solution for all their printing requirements. The fast time to first page makes the printer ideal for heavy duty customer-facing applications or medium workgroups where time at the printer needs to be minimised. The B6200 offers a number of productivity enhancing features including optimal paper handling. The additional paper trays offer large capacity storage of multiple paper types and envelopes which speeds up mailshots or mail merges. \\nOki\u2019s stringent quality and design standards together with the capability to print up to 75,000 pages per month ensure uninterrupted reliability. That means busy workgroups can be assured of continuous, consistent output no matter how hard the B6200 is working. There are many features on the B6200 printer that contribute to the machine\u2019s efficiency and workgroup productivity, yet all this functionality comes at a very competitive price, making the B6200 the best ever value in serious workgroup printers.\\n\u2022  24 pages per minute  \\n\u2022  128mb Memory  \\n\u2022  266mhz Processor  \\n\u2022  True 1200dpi x 1200dpi for sharp, crisp business documents  \\n\u2022  Standard input 400 maximum 1500 sheets.  \\n\u2022  Flexibility to choose your options (network, duplex, memory, HDD, Offset Tray, Face-up tray)"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-08-12T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"69868c62-cfab-4633-8c27-7532b53fe37e","identifier":"1002239","enabled":true,"family":"multifunctionals","categories":["lexmark","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["n"]}],"picture":[{"locale":null,"scope":null,"data":"3\/0\/4\/b\/304b66d03d56c9f3c5266b953c652dc28fea5f57_1002239_7457.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/3\/0\/4\/b\/304b66d03d56c9f3c5266b953c652dc28fea5f57_1002239_7457.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark X632s MFP"}],"description":[{"locale":"en_US","scope":"print","data":"Compact, affordable and very easy to use, the Lexmark X632s brings all the benefits of multifunction printing to small workgroups with A4 mono needs. It integrates seamlessly into your existing network environment and offers a wide range of options, including advanced finishing and an extended warranty of up to four years! \\n--------------------------------------------------------------------------------\\nAffordable multifunction A4 monochrome laser\\n\\n--------------------------------------------------------------------------------\\nConsolidated printing, copying, faxing and colour scanning\\n\\n--------------------------------------------------------------------------------\\nRapid 40 pages per minute for printing and copying\\n\\n--------------------------------------------------------------------------------\\nLess than 8.5 seconds warm-up time to first printed page\\n\\n--------------------------------------------------------------------------------\\n300 MHz RISC processor and standard 65 MB of memory\\n\\n--------------------------------------------------------------------------------\\nNetwork-ready with 10\/100 Ethernet adapter\\n\\n--------------------------------------------------------------------------------\\nEfficient document transmission via LDAP support\\n\\n--------------------------------------------------------------------------------\\nEnhanced data security and authentication features\\n\\n--------------------------------------------------------------------------------\\nMarkVision Professional software to simplify network management\\n\\n--------------------------------------------------------------------------------\\nWide range of advanced finishing options\\n\\n--------------------------------------------------------------------------------\\nStandard onsite support and extended warranty options"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2007-08-09T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"5b2dacd1-bee2-4228-8d35-3da5a0d33c6a","identifier":"1002311","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","lexmark","print_scan_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"5\/9\/3\/a\/593a7cea89a0418eda8f0f86ac903dc7780c633b_1002311_3210.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/9\/3\/a\/593a7cea89a0418eda8f0f86ac903dc7780c633b_1002311_3210.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark T640n"}],"description":[{"locale":"en_US","scope":"print","data":"Lexmark T640n. Maximum resolution: 2400 x 2400, Print technology: Laser. ISO A-series sizes (A0...A9): A4, A5, Standard tray media types: Envelopes, Labels, Plain paper, Transparencies, Non-ISO print media sizes: executive, folio, legal, letter, statement. Supported network protocols (IPv4): TCP\/IP IPv4, IPX\/SPX, AppleTalk, LexLink, TCP\/IP IPv6. Dimensions (WxDxH): 421 x 498 x 345, Package dimensions (WxDxH): 518 x 591 x 451"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2007-08-09T00:00:00+00:00"}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"bcfcf192-f355-49be-bc38-8ae8dfe1ee5a","identifier":"1004114","enabled":true,"family":"scanners","categories":["kodak","print_scan_sales","scanners"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"3\/1\/0\/6\/3106d9b10806b823425f05c4ae3c7d6018093acd_1004114_4416.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/3\/1\/0\/6\/3106d9b10806b823425f05c4ae3c7d6018093acd_1004114_4416.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Kodak i1410"}],"description":[{"locale":"de_DE","scope":"print","data":"Durch die F\u00e4higkeit, Dokumente praktisch jeder Gr\u00f6\u00dfe und jeden Zustands verarbeiten zu k\u00f6nnen, bietet der kompakte KODAK i1410 Scanner Flexibilit\u00e4t, Benutzerfreundlichkeit und Perfect Page-Bildqualit\u00e4t f\u00fcr Gesch\u00e4ftsanwendungen.\\n-Kann alle Arten von Dokumenten von Karton bis hin zu Durchschlagpapier in praktisch jedem Zustand und bis zu einer L\u00e4nge von 863 mm verarbeiten. Und dies mit einer Geschwindigkeit von bis zu 60 Seiten pro Minute (bei 200 dpi). \\n-Bietet Ihnen herausragende Bildqualit\u00e4t durch die neueste Perfect Page-Bildverarbeitung \u2013 einschlie\u00dflich Hintergrundfarbgl\u00e4ttung, verbesserter Farbtreue, automatischer Farberkennung u. v. m.\\n-Einfach anzuschlie\u00dfen und schnelle Bild\u00fcbertragung durch USB 2.0-Schnittstelle\\n-Smart Touch-Funktion zur direkten Scanausgabe in Dateien, E-Mails sowie Publishing- oder sonstige Desktop-Anwendungen mit nur einem Klick\\n-F\u00fcnf Ausgabeoptionen: Schwarzwei\u00df, Graustufen oder Farbe sowie Dual Stream-Ausgabe (Farbe und Schwarzwei\u00df oder Graustufen und Schwarzwei\u00df gleichzeitig). So bekommt Ihr Unternehmen genau die Bilder, die es f\u00fcr die unterschiedlichsten Gesch\u00e4ftsanwendungen ben\u00f6tigt \u2013 Formularverarbeitung, manuelle, bildbasierte Dateneingabe, Archivierung, Erf\u00fcllung von gesetzlichen Bestimmungen, Web-Darstellung und vieles mehr."},{"locale":"en_US","scope":"print","data":"With the ability to handle documents in virtually any size or condition, the KODAK i1410 Scanner brings flexibility, ease of use and enhanced Perfect Page image quality to your tabletop business scanning.\\nHandles all kinds of documents ranging from card stock to onionskin in just about any condition, up to 863 mm (34 in.) long, with speeds up to 60 pages per minute (at 200 dpi) \\n\\n-Gives you outstanding image quality with the latest Perfect Page image processing, including background color smoothing, improved color accuracy, automatic color detection and much more\\n-Easy connectivity and fast image transfer with USB 2.0 interface\\n-Smart touch feature allows you to easily scan to file, e-mail, publishing or other desktop applications with just one click\\n-Five output options: black-and-white, grayscale or color, plus dual stream simultaneous output\u2014color and black-and-white or grayscale and black-and-white to give your organization the types of images needed to meet a range of business needs such as forms processing, key from image, archiving, regulatory compliance, web presentment and more."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2007-08-09T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":true}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1e6fb827-31cd-4423-b681-73bdb7e6f403","identifier":"10055902","enabled":true,"family":"led_tvs","categories":["led_tvs","philips","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"4\/1\/f\/5\/41f53284902d417e2f17235bc099246e086d6b3d_10055902_Philips.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/4\/1\/f\/5\/41f53284902d417e2f17235bc099246e086d6b3d_10055902_Philips.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Philips 37PFL9606H"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Award winning performance<\/b>\\n\\n<b>3 sided Ambilight and best picture quality<\/b>\\n\\nAwarded Best LCD TV by EISA for the last 10 years, the 9000 series brings innovation in picture and connectivity. Perfect Pixel HD Engine and LED give you the most true to life images. Ambilight and 3D Max bring movies to life.\\n\\n<b>Intensify your viewing experience<\/b>\\n- Ambilight Spectra 3-sided intensifies the viewing experience\\n- 3D Max for a truly immersive Full HD 3D experience\\n\\n<b>Award winning picture and sound performance<\/b>\\n- Full HD TV and Perfect Pixel HD Engine for unrivaled clarity\\n- Brilliant LED images with incredible contrast\\n- 800Hz Perfect Motion Rate (PMR) for superb motion sharpness\\n- Perfect Natural Motion for ultra smooth Full HD movies\\n- 40W SoundStage for dynamic powerful sound in a ultra slim TV\\n\\n<b>Enjoy the online world with Smart TV<\/b>\\n- A wealth of online apps, videos to rent and catch-up TV\\n- Control the TV with your smart phone, tablet or keyboard\\n- With DLNA, enjoy photos, music and movies on your TV\\n- Find, schedule, record & pause TV\\n- Integrated Wi-Fi to use Net TV apps and SimplyShare wireless"},{"locale":"fr_FR","scope":"print","data":"\u00c9lus meilleurs t\u00e9l\u00e9viseurs LCD des 10\u00a0derni\u00e8res ann\u00e9es par l'EISA, les mod\u00e8les de la s\u00e9rie\u00a09000 innovent en termes d'image et de connectivit\u00e9. Les technologies Perfect Pixel HD Engine et LED vous garantissent des images parfaitement r\u00e9alistes, tandis que les fonctions Ambilight et 3D Max donnent vie \u00e0 vos films."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-07-31T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":37,"unit":"INCH"}}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"882f6767-7f36-48d8-9c79-d9b999100789","identifier":"10058031","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","print_scan_sales","xerox"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"picture":[{"locale":null,"scope":null,"data":"9\/e\/7\/c\/9e7c91b09e997d287d53b52dd53fa8018fa7c89f_10058031_9207.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/e\/7\/c\/9e7c91b09e997d287d53b52dd53fa8018fa7c89f_10058031_9207.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Xerox Phaser 6000B"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Vibrant colour and ef\ufb01 ciency in a compact design<\/b>\\n<b>Competitive Edge - Phaser 6000<\/b>\\n- The Phaser 6000 colour printer is faster than other printers in its class;\\n- A smaller footprint means you can locate the Phaser 6000 where it\u2019s most convenient;\\n- Proven Hi-Q LED print engine consumes low energy and space and produces low noise.\\n\\n<b>Print Quality Features - Phaser 6000<\/b>\\n- Hi-Q LED print engine uses the same breakthrough technology found in some of our higher-end graphic arts devices;\\n- A print resolution of 1200 x 2400 dpi delivers an amazing 16 shades of colour per pixel. That means a wider colour range for more impressive business graphics;\\n- Unique Xerox EA Eco toner technology gives you crisp text and printed images with superior detail and clarity. It\u2019s the same high-quality toner used in our professional graphic-arts colour devices.\\n\\n<b>Reliability and Ease-of-use Features - Phaser 6000<\/b>\\n- Print on everything from labels to cardstock to envelopes;\\n- Outstanding reliability is backed by Xerox with a one-year on-site warranty;\\n- Easy installation and pre-loaded toner cartridges make this printer virtually plug-and-play.\\n\\n<b>Productivity Features - Phaser 6000<\/b>\\n- The value-packed Phaser 6000 colour printer means business for your desktop, providing real-world print productivity and a host of built-in features;\\n- Superior performance gets your jobs out quickly, with print speeds as fast as 10 ppm for colour and 12 ppm for black-and-white;\\n- A 192 MHz processor and 64 MB standard memory handle your daily workload \u2014 even pages with graphics, photos and charts.\\n\\n<b>Software Solutions - Phaser 6000<\/b>\\nDigitize . . . Organize . . . Distribute . . . Collaborate.\\nWith digital documents, you can easily create, search, re-use, and build upon your documents. Maximize your hardware investments with innovative software solutions from Xerox and Xerox Business Partners:\\n- Contain costs;\\n- Share knowledge;\\n- Accelerate workflow;\\n- Integrate paper and electronic documents;\\n- Manage and distribute documents effectively."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-01T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"11.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"4e54e66b-cd7d-4be1-a98f-2194658e564f","identifier":"10066052","enabled":true,"family":"multifunctionals","categories":["lexmark","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["n"]}],"picture":[{"locale":null,"scope":null,"data":"f\/8\/a\/1\/f8a13fcf72a43f5b24ccd92abfe5bad9c8c6ccbc_10066052_6998.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/8\/a\/1\/f8a13fcf72a43f5b24ccd92abfe5bad9c8c6ccbc_10066052_6998.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark T652DN"}],"description":[{"locale":"en_US","scope":"print","data":"<b>High-Endurance Printing at Its Best<\/b>\\nSimplify high-volume jobs with a fast-thinking powerhouse featuring built-in duplexing, up to 50 ppm print speed, and generous input capacity (650 sheets standard, up to 4,300 sheets with options). Expertly handles a range of media sizes and types, plus offers a rich selection of paper handling and finishing options.\\n\\n<b>Lexmark T652dn Let It Decide the Best Speed<\/b>\\nIdentifies the size and complexity of your job and automatically calculates the optimal speed\u2014quicker time-to-first-page for short jobs and more pages per minute for longer jobs.\\n\\n<b>Lexmark T652dn Intelligent Job Waiting<\/b>\\nNo more letting missing media derail hours of print time. The innovative Job Waiting feature will simply hold that job aside, letting others go on working without interruption (requires the hard disk option).\\n\\n<b>Lexmark T652dn Outstanding Print Quality<\/b>\\nCombines true 1200 x 1200 dpi with automatic darkness adjustment and pixel-boosting technology to ensure high-quality, professional documents every time.\\n\\n<b>Lexmark T652dn Cutting-Edge Security<\/b>\\nFrom network security to user-access restrictions, you\u2019ll be fully equipped to keep valuable data safe and sound. In addition to IPSec, SNMPv3 and 802.1x network security, the Lexmark T652dn offers an alphanumeric pad for easy PIN authentication, plus encryption and disk wiping to secure the optional hard disk.\\n\\n<b>Lexmark T652dn Less Work for IT<\/b>\\nNetwork-ready and very easy to set up, plus Universal Driver support for simple deployment. Includes Lexmark MarkVision\u2122 Professional software for time-saving remote management and automated tools."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-02T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"94a1c980-f5ca-4682-ad1b-cb1109e49275","identifier":"101546","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","lexmark","print_scan_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"e\/a\/a\/1\/eaa1c271958b685deac432a8025144216c957111_101546_5518.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/e\/a\/a\/1\/eaa1c271958b685deac432a8025144216c957111_101546_5518.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark C752n + X5150"}],"description":[{"locale":"en_US","scope":"print","data":"The Lexmark C752 series delivers speeds of 20 pages per minute in color and monochrome for complex print jobs. Lexmark high-speed technology will eliminate bottlenecks and waiting for print jobs at the printer. This fast delivery enables your workgroup to be more efficient which saves you money. The 2400 Image Quality produces high print quality while using less memory for faster processing. Sharp business graphics and professional looking documents can now be delivered fast when you're in a hurry.\\nThe Lexmark C752 offers 2400 Image Quality printing at up to 20 ppm in color or black and is excellent for the medium to large workgroup. \\n\\nUp to 20 ppm, and less than 17.5 seconds time to first color page \\n\\nTrue 1200 x 1200 dpi and 2400 Image Quality for best color images and business graphics\\n\\n85,000 page per month maximum duty cycle for short-run custom production printing \\n\\nColor Care Technology with ColorSaver\u2122, 3 levels of color and monochrome toner saver, Mono Only Driver, Black and White Lock and Proof then Print \\n\\nEasy-to-replace high yield, single-element print cartridges for each color \\n\\nSWOP and EuroScale simulation color tables with Pantone Calibration for accurate color pre-press layouts \\n\\nEthernet Network-Ready"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-07-15T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"48.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b6807bdd-97c0-49f0-a05b-e007323a7d64","identifier":"102696","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","lexmark","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"picture":[{"locale":null,"scope":null,"data":"a\/8\/0\/5\/a80564efe7023f4cb40c07b4622cb4b831cc673f_102696.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/a\/8\/0\/5\/a80564efe7023f4cb40c07b4622cb4b831cc673f_102696.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark C510 KLEUREN LASERPRINTER"}],"description":[{"locale":"en_US","scope":"print","data":"The Lexmark C510 is a high quality, small workgroup color laser printer for price-sensitive business users. It allows you to create professional, high quality color documents with 2400 Image Quality.  The Lexmark C510 has a 500 MHz processor based controller for less network traffic and faster throughput. The Lexmark C510 allows you to print complex color jobs quickly with speeds of up to 30ppm in monochrome, 8ppm in color and fast time to first print."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-06-27T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"30.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ca5e07b5-8866-495b-9313-00f8382d31ad","identifier":"102714","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","oki","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"name":[{"locale":null,"scope":null,"data":"OKI B6200n NON 128MB 24ppm 1200x1200dpi A4"}],"description":[{"locale":"en_US","scope":"print","data":"Oki has a more holistic view of Mono Printing - why offer faster speed of printing if you do not have the processor power to handle the information on the page? Why worry about first page to print times if you do not have enough memory to complete printing your job? Oki offers class leading printers like the B6200 with impressive speed, processor power, memory, duty cycle, toner capacity, trays and reliability which will improve your business productivity. \\n \\nSpeed, Versatility,flexibility and Reliability - these are the qualities that productive professionals in busy workgroups tell us they must have in a printer. And that\u2019s what the B6200 printer deliver for small to medium workgroups - a cost-effective solution for all their printing requirements. The fast time to first page makes the printer ideal for heavy duty customer-facing applications or medium workgroups where time at the printer needs to be minimised. The B6200 offers a number of productivity enhancing features including optimal paper handling. The additional paper trays offer large capacity storage of multiple paper types and envelopes which speeds up mailshots or mail merges. \\nOki\u2019s stringent quality and design standards together with the capability to print up to 75,000 pages per month ensure uninterrupted reliability. That means busy workgroups can be assured of continuous, consistent output no matter how hard the B6200 is working. There are many features on the B6200 printer that contribute to the machine\u2019s efficiency and workgroup productivity, yet all this functionality comes at a very competitive price, making the B6200 the best ever value in serious workgroup printers.\\n\u2022  24 pages per minute  \\n\u2022  128mb Memory  \\n\u2022  266mhz Processor  \\n\u2022  True 1200dpi x 1200dpi for sharp, crisp business documents  \\n\u2022  Standard input 400 maximum 1500 sheets.  \\n\u2022  Flexibility to choose your options (network, duplex, memory, HDD, Offset Tray, Face-up tray)"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-06-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1c2df027-8c08-4796-8ab7-238be5f0ad00","identifier":"102774","enabled":true,"family":"pc_monitors","categories":["pc_monitors","samsung","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"6\/a\/d\/1\/6ad1b444a28680f9e4cdbf738a31cb08e84faeec_102774.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/6\/a\/d\/1\/6ad1b444a28680f9e4cdbf738a31cb08e84faeec_102774.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Samsung 19IN LCD 910T SIL"}],"description":[{"locale":"en_US","scope":"print","data":"Samsung 19IN LCD 910T SIL. Display resolution: 1280 x 1024, Display: LCD, Contrast ratio (typical): 800:1. Certification: TCO'03"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-06-27T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"response_time":[{"locale":null,"scope":null,"data":25}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"8477bb11-a7be-4edd-9871-e69ee4477608","identifier":"102788","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy"]}],"picture":[{"locale":null,"scope":null,"data":"e\/6\/c\/6\/e6c6e79d05297a49ff811b8a748d334eaa7d6c60_102788.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/e\/6\/c\/6\/e6c6e79d05297a49ff811b8a748d334eaa7d6c60_102788.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon SMARTBASE MP360 A4 18PPM"}],"description":[{"locale":"en_US","scope":"print","data":"Delivering exceptional photo quality designed with elegance Get photo quality colour printing, scanning and copying in one single, stylish unit. The SmartBase MP360 combines elegance, ease and efficiency with practical features such as borderless printing. Benefit from true-to-life colours, detailed images and crisp, clear text on both plain and photo paper. The SmartBase MP360 uses a print head containing micro-nozzles that eject tiny 2 picolitre ink droplets with extraordinary precision. This advanced MicroFine Droplet Technology means that you get the highest print quality - right up to a 4800 x 1200 dots per inch resolution. Printing or copying photos usually results in a white frame around the edge of the paper. With the SmartBase MP360 you can print right up to the paper's edge, without any border. And by using special photo or glossy paper, you can produce ready-to-frame photographs or other material on A4, 4\" x 6\" and 5\" x 7\" sizes. Plus printing is fast, without compromising colour quality.\\n    * High image quality All-in-One\\n    * Professional photo quality\\n    * Advanced Microfine Droplet Technology\\n    * 2 pl ink droplets\\n    * Fast print\/copy speed\\n    * CCD scanner, 1200 x 2400 dpi\\n    * Borderless print\/copy\\n    * Hi-Speed USB 2.0 interface\\n    * Compact design"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-06-27T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"8.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b7c24192-1dd8-4765-92a8-1cb9c24c776f","identifier":"10485060","enabled":true,"family":"led_tvs","categories":["led_tvs","toshiba","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"f\/7\/1\/c\/f71c4930efe9a364d67f7fe782ad9e42638b81e8_10485060_4713.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/7\/1\/c\/f71c4930efe9a364d67f7fe782ad9e42638b81e8_10485060_4713.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Toshiba 55WL863B LED TV"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>CEVO ENGINE<\/b>\\nDie CEVO ENGINE ist eine speziell f\u00fcr den Einsatz in Fernsehern ausgelegte Multi-Prozessor-Plattform. Durch dieses Konzept k\u00f6nnen mehrere Rechenkerne f\u00fcr die unterschiedlichen Aufgaben und Funktionen eines TVs eingesetzt werden. Dies erm\u00f6glicht einmalige Funktionen und einen gro\u00dfen Sprung in der Qualit\u00e4t.\\n\\n<b>PRO LED 32<\/b>\\nFernseher mit Pro LED 32 verf\u00fcgen \u00fcber 32 unabh\u00e4ngig voneinander steuerbare Zonen in der Hintergrundbeleuchtung. So k\u00f6nnen im gleichen Bild sehr helle und sehr dunkle Bereiche gleichzeitig angezeigt werden, was zu einem erh\u00f6hten Kontrastverh\u00e4ltnis und besseren Schwarzwerten f\u00fchrt.\\n\\n<b>ACTIVE-SHUTTER-TECHNOLOGIE<\/b>\\nDamit der Mensch einen 3D-Film sehen kann, m\u00fcssen die unterschiedlichen Perspektiven jeweils das entsprechende Auge erreichen. Daf\u00fcr sorgt die active Shutter-Brille FPT-AG01G.\\n\\n<b>AUTO CALIBRATION<\/b>\\nToshiba-TVs mit Auto Calibration lassen sich mit einem USB-Sensor perfekt kalibrieren, sprich alle Bildparameter (Helligkeit, Kontrast, Farbwerte, Graustufen, Gamma) werden anhand der Sensordaten automatisch eingestellt.\\n\\n<b>Toshiba Places<\/b>\\nToshiba Places \u2013 die besten Internet-Inhalte auf Knopfdruck."},{"locale":"en_US","scope":"print","data":"Full HD 3D PRO-LED TV \u2013 Innovation in design, technology and total performance.\\n<ul>\\n<li>CEVO Engine next generation picture processing<\/li>\\n<li>3D TV with 2D to 3D image upscaling<\/li>\\n<li>PRO-LED local dimming technology<\/li>\\n<\/ul>"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-03T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":55,"unit":"INCH"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"825aa638-f84d-4d9f-af4f-8e83817b793b","identifier":"10493290","enabled":true,"family":"pc_monitors","categories":["acer","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"f\/6\/2\/f\/f62fc6038544aefe094f8b706db12f19c5710606_10493290_346.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/6\/2\/f\/f62fc6038544aefe094f8b706db12f19c5710606_10493290_346.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Acer S S273HLAbmii"}],"description":[{"locale":"de_DE","scope":"print","data":"Die Displays der Serie S sind extraflach, haben jedoch eine gro\u00dfe Anzeigefl\u00e4che und eignen sich daher perfekt f\u00fcr Multitasking und zum Surfen im Web. Die Full HD-Aufl\u00f6sung und das besonders hohe Kontrastverh\u00e4ltnis erwecken High Definition-Bilder f\u00f6rmlich zum Leben. Von diesem leistungsstarken Acer-Display werden Sie begeistert sein, von seiner Darstellungsqualit\u00e4t ebenso wie von seinem attraktiven Look!\\n\\n<b>Ultraflaches, platzsparendes Design<\/b>\\nDie Modelle der Serie S haben ein Design, mit dem sie sich exzellent in jedes Ambiente einbinden lassen, sei es ein Wohnzimmer, ein Heimb\u00fcro, ein \u00f6ffentlicher Bereich oder ein Schalter. Sie sind ultra-flach, und ultra-elegant mit einer rundum modernen, schlichten Ausstrahlung.\\n\\n<b>Umweltfreundliche Technologien<\/b>\\nDie Serie S wird mit quecksilberfreien Materialien hergestellt und arbeitet mit LED-Technologie. Diese Technologie senkt den Energiebedarf um bis zu 68%, was Kosten spart und zus\u00e4tzlich die Umwelt sch\u00fctzt. Die Konformit\u00e4t mit dem Standard ENERGY STAR\u00ae 5.0 ist ein weiterer Beweis f\u00fcr die \u00f6kologische Nachhaltigkeit.\\n\\n<b>Beeindruckende Leistung<\/b>\\nDank Full HD-Aufl\u00f6sung sind Spiele spannender und alle Inhalte werden mit pr\u00e4zisen Details auf Kino-Niveau dargestellt. \u00dcber den HDMI\u00ae oder den DVI Port k\u00f6nnen Sie die neuesten HD-Ger\u00e4te anschlie\u00dfen und der unglaubliche Kontrast sorgt f\u00fcr h\u00f6chste Pr\u00e4zision in der Darstellung."},{"locale":"en_US","scope":"print","data":"Acer S Series monitors are very slim yet spacious displays that are great for multitasking and web browsing. High-def visuals leap to life thanks to Full HD resolution and an extremely high contrast ratio. You'll appreciate both the imagery and the look of this streamlined yet powerful Acer monitor!\\n\\n<b>Ultra-thin, space-saving design<\/b>\\nThe S Series is designed to fit nicely in your living space, be it at home or in a SOHO, public area, or front-desk setting. Ultra-thin and ultra-elegant, the display is built around a sense of simple modernism.\\n\\n<b>Earth-friendly technologies<\/b>\\nThe S Series uses mercury-free materials and white LED technology for up to 68% lower power consumption, giving you big savings while helping preserve nature's energy resources. By meeting ENERGY STAR\u00ae 5.0 requirements, the S Series considers the environment.\\n\\n<b>Impressive performance<\/b>\\nGames are more exciting and entertainment is truly cinematic with excellent detail courtesy of Full HD resolution. In addition, an HDMI\u00ae or DVI interface connects you to the latest high-definition devices, while an astounding contrast ratio delivers fantastic clarity."},{"locale":"fr_FR","scope":"print","data":"\u00c0 la fois fins et larges, les \u00e9crans de la s\u00e9rie S d\u2019Acer sont parfaits pour les activit\u00e9s multit\u00e2ches et la navigation sur Internet. Les images haute d\u00e9finition prennent vie gr\u00e2ce \u00e0 la r\u00e9solution Full HD et au taux de contraste extr\u00eamement \u00e9lev\u00e9. Vous appr\u00e9cierez non seulement la qualit\u00e9 des images mais \u00e9galement l\u2019allure \u00e9lanc\u00e9e et puissante de ces \u00e9crans Acer.\\n\\n<b>Un design compact et ultrafin<\/b>\\nLes \u00e9crans de la s\u00e9rie S sont con\u00e7us pour s\u2019int\u00e9grer parfaitement dans votre cadre de vie, qu\u2019il s\u2019agisse de votre domicile ou de votre bureau, d\u2019un lieu public ou d\u2019un comptoir. Ultrafins et ultra\u00e9l\u00e9gants, ils profitent d\u2019un design \u00e0 la fois moderne et simple.\\n\\n<b>Des technologies respectueuses de l'environnement<\/b>\\nLes \u00e9crans de la s\u00e9rie S sont con\u00e7us avec des mat\u00e9riaux exempts de mercure. La technologie \u00e0 LED blanche permet de diminuer la consommation d\u2019\u00e9lectricit\u00e9 jusqu\u2019\u00e0 68 %, ce qui all\u00e8ge consid\u00e9rablement les frais tout en contribuant \u00e0 pr\u00e9server les ressources \u00e9nerg\u00e9tiques de la plan\u00e8te. Conformes aux exigences ENERGY STAR\u00ae 5.0, ils ont \u00e9t\u00e9 con\u00e7us dans le souci du plus grand respect de l\u2019environnement.\\n\\n<b>Des performances impressionnantes<\/b>\\nGr\u00e2ce \u00e0 la r\u00e9solution Full HD, les jeux sont plus passionnants et les divertissements aux d\u00e9tails pr\u00e9cis sont dignes des salles de cin\u00e9ma. En outre, l\u2019interface HDMI\u00ae ou DVI vous permet de raccorder les appareils haute d\u00e9finition les plus r\u00e9cents, tandis que le taux de contraste exceptionnel offre une nettet\u00e9 impressionnante."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-03T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":27,"unit":"INCH"}}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"9e7be2be-f14a-4822-9a5a-8c0bd3c24ba1","identifier":"10499018","enabled":true,"family":"multifunctionals","categories":["brother","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","fax","print","scan"]}],"picture":[{"locale":null,"scope":null,"data":"7\/c\/e\/e\/7ceed5043ef62e29f785938c0e50dfc8cbe54592_15743_10499018_640.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/7\/c\/e\/e\/7ceed5043ef62e29f785938c0e50dfc8cbe54592_15743_10499018_640.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Brother MFC-J625DW multifunctional"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Farbdrucker<\/b>\\n- 6-Farbdruckqualit\u00e4t mit nur 4 Patronen dank 1,5 pl Tr\u00f6pfchen-Technologie.\\n- Fl\u00fcsterleiser Druck durch kapillares Tintensystem.\\n- 4 separate Tintenpatronen.\\n- Bis zu 12 ISO-Seiten\/Min. Druckgeschwindigkeit in S\/W.\\n- Bis zu 10 ISO-Seiten\/Min. Druckgeschwindigkeit in Farbe.\\n- Bis zu 35 Seiten\/Min. Druckgeschwindigkeit in S\/W - Entwurfsmodus.\\n- Bis zu 27 Seiten\/Min. Druckgeschwindigkeit in Farbe - Entwurfsmodus.\\n- Automatischer Duplexdruck inkl. Brosch\u00fcrendruckfunktion.\\n- Integrierte Papierkassette f\u00fcr bis zu 100 Blatt.\\n- Integrierte Fotopapierkassette f\u00fcr bis zu 20 Blatt.\\n- 100 Jahre lichtechte Fotos mit Fotopapier BP-71.\\n- Dokumentenecht drucken nach ISO 11798:2000.\\n<b>Farbkopierer<\/b>\\n- 20 Blatt Automatischer Vorlageneinzug (ADF).\\n- Kopieren ohne PC.\\n- Kopieren \u00fcber ADF oder Vorlagenglas.\\n- 4,9 cm Touchscreen mit ber\u00fchrungsempfindlichem Bedienfeld.\\n<b>Farbfax<\/b>\\n- Faxen mit und ohne PC.\\n- Werbefax-L\u00f6schfunktion.\\n<b>Farbscanner<\/b>\\n- Scan-to-E-Mail, -Bild, -Text, -Datei, -PDF, -USB-Stick, -Speicherkarte.\\n<b>Fotodirektdruck<\/b>\\n- Randloser Fotodruck bis A4.\\n- Fotodirektdruck via PictBridge, USB-Stick, Speicherkarte.\\n<b>Integrierter WLAN-MFC-Server<\/b>\\n- Drucken, Scannen und Faxen im WLAN.\\n<b>iPrint&Scan<\/b>\\n- Direkt Drucken vom und Scannen zum iPhone, iPad, iPod Touch, Windows Phone sowie zu Android-Ger\u00e4ten."},{"locale":"en_US","scope":"print","data":"This A4 inkjet all-in-one printer is the perfect choice for a home or small office environment. It provides you with all the professional standards you'd expect from your office equipment, fast quality printing, clear sharp copying, and high quality scanning and faxing, all in one compact machine. And because of its sleek black styling it will look just as good at home as it will in the office. There's no compromise on features, with automatic double-sided printing provided as standard to save time and money and wireless network-ready out of the box so you can share with other users. And because it's one of the most eco-friendly machines on the market you benefit from low power consumption and low noise levels."},{"locale":"fr_FR","scope":"print","data":"<b>Un multifonction 4-en-1 \u00e9conomique, convivial et rapide<\/b>\\nEquip\u00e9 du recto-verso automatique en impression, le MFC-J625DW vous permet de r\u00e9duire la consommation de papier et ainsi faire des \u00e9conomies. De plus, gagnez du temps gr\u00e2ce \u00e0 la num\u00e9risation et la copie automatique de vos documents de plusieurs pages \u00e0 travers le chargeur automatique de documents. Avec un \u00e9cran LCD couleur de 8,3 cm \u00e0 commandes tactiles, acc\u00e9dez \u00e0 l\u2019ensemble des param\u00e8tres d\u2019impression devient un jeu d\u2019enfant. La navigation devient intuitive et conviviale.\\n\\n- Vitesses d'impression de 35 ppm en N&B et 27 ppm en couleur\\n- Impression recto-verso automatique\\n- Connexion WiFi 802.11b\/g\/n\\n- Cartouches haute capacit\u00e9\\n- Chargeur automatique de documents et Fax 14,4 kbps."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-03T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"51b97d56-7fe3-4cc8-a152-54b986f4bb98","identifier":"10584885","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","ricatech"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"1\/2\/c\/3\/12c3143e7142ae4ea5b8ee0d7b879cc6e202eed9_10584885_7547.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/1\/2\/c\/3\/12c3143e7142ae4ea5b8ee0d7b879cc6e202eed9_10584885_7547.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Ricatech RC1600"}],"description":[{"locale":"en_US","scope":"print","data":"<b>RC1600<\/b>\\n\\nEnjoy everything modern technology has to offer with the brand new, shiny RC1600. It has a built-in camera, Photo and video capture mode and offcourse this fully featured new gadget plays your favorite MP3 and WMA tracks. The casing is made out of aluminum with a oval bent shape and a luxurious glossy finish in four trendy colors."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-03T00:00:00+00:00"}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"0e084e3b-c161-4f48-a74a-8304dfec7a1c","identifier":"10597353","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","nec"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"9\/d\/c\/6\/9dc6bc9fda19c5b02fda153422a4b012fafdcc8c_10597353_1104.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/d\/c\/6\/9dc6bc9fda19c5b02fda153422a4b012fafdcc8c_10597353_1104.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"NEC SP-4046PV"}],"description":[{"locale":"de_DE","scope":"print","data":"Dem edlen Design der Displays angepasst und mit wenigen Handgriffen montiert bzw. demontiert."},{"locale":"en_US","scope":"print","data":"Enhance your Large-Screen Display Speakers without breaking your budget with NEC's SP-4046PV."},{"locale":"fr_FR","scope":"print","data":"Adapt\u00e9 au design des moniteurs LCD NEC Public Display, montage et d\u00e9montage faciles."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-07T00:00:00+00:00"}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ef2ae330-f567-4601-bf1e-d9900a9befe0","identifier":"10598379","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","philips"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"f\/6\/7\/2\/f672860a16846b14cddc5701f048912f455e4838_10598379_Philips.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/6\/7\/2\/f672860a16846b14cddc5701f048912f455e4838_10598379_Philips.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Philips SPA2210R"}],"description":[{"locale":"de_DE","scope":"print","data":"Wir sind perfekt f\u00fcr die Wiedergabe von Musik, Stimmen und Soundtracks! Schlie\u00dfen Sie uns einfach an Ihr Notebook oder Ihren MP3-Player an, und wir erwecken Ihre Musik und Sounds zum Leben! Mit der praktischen Kabelaufwicklung sorgen wir au\u00dferdem f\u00fcr Ordnung auf Ihrem Schreibtisch!"},{"locale":"en_US","scope":"print","data":"<b>Cable length can be variable<\/b>\\nEasy cable management helps organise messy cables so you can have a tidy desk, and the cable length is adjustable to suit your needs.\\n\\n<b>Enjoy music, games, movies and online videos<\/b>\\nThe perfect accompaniment for your notebook and netbook, so you can play multimedia music and videos with great sound quality.\\n\\n<b>Rich bass<\/b>\\nThey provide good sound quality with a rich bass experience from a loudspeaker box system.\\n\\n<b>USB plug for power<\/b>\\nWith plug-and-play convenience, the USB cable plugs directly into any USB port and your notebook automatically recognises this as a removable USB mass storage device.\\n\\n<b>Green product<\/b>\\nCertified by Royal Philips Electronics as a Green Product. Green Product means the performance of the device is at least 10% better than main competitors on selected sustainability issues (e.g. energy efficiency, product weight, lifecycle management etc.)."},{"locale":"fr_FR","scope":"print","data":"<b>La longueur de c\u00e2ble peut \u00eatre modifi\u00e9e.<\/b>\\nLa gestion ais\u00e9e des c\u00e2bles vous aide \u00e0 en finir avec les c\u00e2bles emm\u00eal\u00e9s et vous permet d'avoir un bureau toujours bien rang\u00e9. Vous pouvez r\u00e9gler la longueur du c\u00e2ble selon vos besoins.\\n\\n<b>Musique, jeux et vid\u00e9os en ligne<\/b>\\nL'accessoire parfait pour votre (mini) ordinateur portable afin de pouvoir profiter de votre musique et de vos vid\u00e9os multim\u00e9dias avec une qualit\u00e9 sonore exceptionnelle.\\n\\n<b>Basses riches<\/b>\\nQualit\u00e9 de son exceptionnelle avec des basses d'une grande richesse gr\u00e2ce \u00e0 un haut-parleur.\\n\\n<b>Fiche d'alimentation USB<\/b>\\nGr\u00e2ce au confort du plug-and-play, le c\u00e2ble USB se connecte directement \u00e0 un port USB de votre ordinateur portable, qui le reconna\u00eet automatiquement comme un p\u00e9riph\u00e9rique de stockage USB amovible.\\n\\n<b>Produit vert<\/b>\\nCertifi\u00e9 \u00ab produit vert \u00bb par Royal Philips Electronics. Les performances d'un produit vert sont au moins 10 % sup\u00e9rieures \u00e0 celles de nos principaux concurrents sur un certain nombre de questions li\u00e9es au d\u00e9veloppement durable (par exemple, la faible consommation, le poids du produit, la gestion du cycle de vie, etc.)."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-09T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b85a84fe-76e6-4336-823e-1f0fb1d08cbf","identifier":"10598481","enabled":true,"family":"pc_monitors","categories":["pc_monitors","philips","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"1\/2\/8\/1\/12819d6e7323cb792e6885dd995182818f20a610_10598481_Philips.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/1\/2\/8\/1\/12819d6e7323cb792e6885dd995182818f20a610_10598481_Philips.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Philips 201BL2CB"}],"description":[{"locale":"de_DE","scope":"print","data":"Mit Funktionen wie dem Ergo Fu\u00df, Stereo-Audio, einem USB-Anschluss, dem Energiesparmodus mit 0,1\u00a0Watt, SmartImage und SmartControl tr\u00e4gt der energieeffiziente Philips\u00a0201B2\u00a0LED-Monitor zur Steigerung Ihrer Produktivit\u00e4t bei."},{"locale":"en_US","scope":"print","data":"<b>Ergonomic business display enhances productivity<\/b>\\n\\nWith features like Ergo base, Stereo Audio, USB port, 0.1watt Soft off mode, SmartImage\\nand SmartControl, the energy efficient Philips 201B2 Business LED display enhances your\\nproductivity\\n\\n<b>Sustainable Eco-friendly solution<\/b>\\n\\n- EPEAT Gold ensures lowest impact on environment\\n- Energy Star for energy efficiency and low power consumption\\n- SmartPower: Up to 50% power saving\\n- 0.1 watt Soft-Off mode\\n\\n<b>Ergonomic design<\/b>\\n\\n- 70mm height adjustment for ideal sitting position\\n- Tilt and swivel adjustment for an ideal viewing angle\\n\\n<b>Outstanding display performance<\/b>\\n\\n- LED technology ensures natural colors\\n- SmartImage: Optimized user friendly display experience\\n\\n<b>Great convenience<\/b>\\n\\n- Modern Touch controls\\n- Built in stereo audio for multimedia experience\\n- USB port for convenient peripheral connections"},{"locale":"fr_FR","scope":"print","data":"Avec sa base Ergo, son son st\u00e9r\u00e9o, son port USB, son mode de veille 0,1\u00a0watt, ainsi que ses fonctions SmartImage et SmartControl, l'\u00e9cran LED professionnel Philips 201B2 \u00e0 faible consommation d'\u00e9nergie dope votre productivit\u00e9"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-09T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":true}],"display_color":[{"locale":null,"scope":null,"data":false}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":20,"unit":"INCH"}}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"208df19c-f619-497a-a1d5-ae291a118cd5","identifier":"10620069","enabled":true,"family":"pc_monitors","categories":["aoc","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"5\/8\/b\/d\/58bd2982940063a520e686e39519045e3f8da403_10620069_1317.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/8\/b\/d\/58bd2982940063a520e686e39519045e3f8da403_10620069_1317.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"AOC e950Swa"}],"power_requirements":[{"locale":null,"scope":null,"data":"90 - 240 VAC"}],"description":[{"locale":"de_DE","scope":"print","data":"Modernste Technologie mit LED-Backlights, eine starke Performance sowie ein zeitlos klassisches, schwarzes Design kennzeichnen dieses Modell. Aufgrund hoher Kontrast- und Helligkeitswerte sowie einer schnellen Reaktionszeit pr\u00e4sentiert es selbst rasante Bewegtbildsequenzen fl\u00fcssig und gestochen scharf. Das elegante Display mit haarfeinen Texturen an der R\u00fcckseite und an dem runden Sockel ist an seiner \u201eschlanksten\u201c Stelle gerade einmal 1,6 cm tief. Dank seiner zahlreichen Features empfiehlt es sich sowohl f\u00fcr B\u00fcroarbeitspl\u00e4tze als auch f\u00fcr Zuhause."},{"locale":"en_US","scope":"print","data":"This model is characterised by the latest display technology with LED backlights, a top performance and a timelessly classic, black design. Due to high contrast and brightness values as well as a quick response time, the monitor renders even the fastest movie sequences fluently and razor-sharp. At its slimmest region, this elegant display, which sports hairline textures on the rear side as well as the base, is just 1.6 cm deep. Thanks to numerous features it is recommended for both office and home."},{"locale":"fr_FR","scope":"print","data":"Principales caract\u00e9ristiques de ce mod\u00e8le : une technologie d\u2019affichage de pointe \u00e0 r\u00e9tro-\u00e9clairage LED*, d\u2019excellentes performances et un design noir, \u00e0 la fois classique et ind\u00e9modable. Avec ses valeurs \u00e9lev\u00e9es de contraste et de luminosit\u00e9 et un temps de r\u00e9ponse rapide, le moniteur conf\u00e8re une nettet\u00e9 une fluidit\u00e9 exceptionnelle aux images anim\u00e9es les plus rapides. Cet \u00e9cran, \u00e0 texture bross\u00e9e sur la face arri\u00e8re et la base, ne mesure qu\u20191,6 cm \u00e0 l\u2019endroit le plus mince. Sa grande polyvalence en fait un outil aussi \u00e0 l\u2019aise au bureau qu\u2019\u00e0 la maison."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-11T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"95a26f71-b356-49c2-a0ef-ca5aaacd17b8","identifier":"10620502","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"5\/f\/5\/6\/5f56d21ba719fe293f8978364774c41784a79988_10620502_5164.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/f\/5\/6\/5f56d21ba719fe293f8978364774c41784a79988_10620502_5164.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon EOS 600D + EF 18-55mm IS + EF 55-250mm IS"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"<b>With class-leading 18-megapixel resolution, user-friendly design, and the entire EOS family of lenses and accessories at your disposal, the EOS 600D lets nothing stand in the way of your photography.<\/b>\\n\\n<b>Features<\/b>\\n- 18-megapixel CMOS sensor\\n- Scene Intelligent Auto mode\\n- Full-HD EOS Movie\\n- On-screen Feature Guide\\n- Up to 3.7fps continuous shooting\\n- Wide-area 9-point AF\\n- 1,040k-dot vari-angle 7.7cm (3.0\u201d) screen\\n- Basic+ and Creative Filters\\n- Built-in wireless flash control\\n- Your EOS adventure starts here\\n\\n<b>18 MP APS-C CMOS sensor<\/b>\\nAn APS-C sized, 18-megapixel CMOS sensor captures images that are packed with detail and clarity. Such high-resolution allows large print sizes and the flexibility to crop pictures for alternative compositions.\\n\\n<b>ISO 100-6400 sensitivity<\/b>\\nAn ISO range of 100-6400, extendable to ISO 12,800, enables high-quality hand-held shooting in low-light conditions, without the need for flash.\\n\\n<b>14-bit image processing<\/b>\\nAt the heart of the Canon EOS 600D is a 14-bit DIGIC 4 image processor that provides exceptional colour reproduction, smooth tonal gradation and tight control over noise.\\n\\n<b>Scene Intelligent Auto mode<\/b>\\nScene Intelligent Auto analyzes each scene in detail and picks the right camera settings each and every time, leaving you free to concentrate on what\u2019s important \u2013 your photography.\\n\\n<b>On-screen Feature Guide<\/b>\\nThe EOS 600D\u2019s on-screen Feature Guide provides descriptions of many of the camera\u2019s functions, as well as advice on how to use them.\\n\\n<b>Full-HD EOS Movie<\/b>\\nShoot Full-HD video with manual control over frame rate, exposure and sound. Video Snapshot technology allows short clips of 2, 4 or 8 sec to be merged into a single movie file, for footage that looks like it was edited professionally, while Movie Digital Zoom permits 3-10x magnification.\\n\\n<b>9-point wide-area AF and iFCL metering<\/b>\\nNine AF points, including one central cross-type sensor, spread out across the frame for swift, accurate focusing, even with off-centre subjects. 63-zone iFCL metering ensures accurate exposures time after time.\\n\\n<b>1,040k-dot vari-angle 7.7cm (3.0\u201d) screen<\/b>\\nShoot from unique angles with a 7.7cm (3.0\u201d) 3:2 Clear View LCD screen, containing 1,040,000 dots for increased clarity.\\n\\n<b>Basic+<\/b>\\nBasic+ technology allows photographers to customize basic auto settings according to lighting conditions or ambience.\\n\\n<b>Creative Filter Effects<\/b>\\nCreative Filter Effects can be applied to Raw and JPEG files post capture, including Toy Camera, Soft Focus, Miniature, Grainy Black & White and Fish Eye simulations.\\n\\n<b>Built-in wireless flash control<\/b>\\nAn integrated wireless Speedlite flash controller and Easy Wireless technology allow off-camera TTL flash without the need for extra accessories.\\n\\n<b>Use with all EF and EF-S lenses<\/b>\\nThe EOS 600D is supported by the complete system: flashguns, remote releases and over 60 lenses trusted by professional photographers the world over."}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-11T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"4e8d8dd4-d8ba-4143-a556-1ee53e2b97e7","identifier":"10627328","enabled":true,"family":"pc_monitors","categories":["nec","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"2\/5\/0\/c\/250c4e8360b10e6dcfc33a5920fc254b810eab23_10627328_562.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/2\/5\/0\/c\/250c4e8360b10e6dcfc33a5920fc254b810eab23_10627328_562.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"NEC EX201W"}],"description":[{"locale":"de_DE","scope":"print","data":"Das ultraschmale \u201eOffice Cool\"-Design verbindet die bewahrte Qualitat und Leistungsfahigkeit von MultiSync\u00ae mit neuen Standards in Bezug auf Minimalismus und Eco- Innovation. Der 20 Zoll gro.e Breitbild-TFT-Monitor mit TNPanel und LED-Hintergrundbeleuchtung ist ideal fur Unternehmen, die Wert auf Stil, zukunftssichere Technologie und bewahrte Bildqualitat bei hochster\\nFlexibilitat legen.\\n\\nMit seiner au.erst schmalen LED-Hintergrundbeleuchtung und einem Design, bei dem Bildschirminhalt und -position im Mittelpunkt stehen, passt der EX201W von NEC perfekt ins\\nmoderne Buro und zu den neuen Trends bei Unternehmensausstattung. Sein kompaktes Format und flexibles Konzept machen ihn ideal fur Rezeptionen, Abfertigungsbereiche und informelle Besprechungen. Fur anspruchsvolle, umweltbewusste Nutzer und Anwender, die Wert auf optimale Arbeitsplatzgestaltung legen, bietet der EX201W einen Leuchtdichtesensor und einen Human Sensor sowie die kleinste Standflache unter allen Geraten auf dem Markt, die mit umfassenden Ergonomiefunktionen ausgestattet sind. Der Bildschirm lasst sich leicht mit VESA-Halterungen befestigen."},{"locale":"en_US","scope":"print","data":"NEC EX201W. Response time: 3.7, Display resolution: 1600 x 900, Contrast ratio (typical): 1000:1. VESA mounting interfaces compatibility: 100 x 100, Swivel angle range: -170 - 170, Tilt angle: -5 - 30. Input voltage: 100 - 240, Input frequency: 50\/60, Power consumption (standby): 0.5. Width: 474.8, Depth: 47.6, Height: 278.2. Cables included: AC, DVI, USB"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-11T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":4}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":20,"unit":"INCH"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c9303bc0-8a96-4400-9d3b-66f14119aa86","identifier":"10627329","enabled":true,"family":"pc_monitors","categories":["nec","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"9\/f\/8\/3\/9f83009d7fd819dfbf1c7e9ebe708af43a457e1d_10627329_7290.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/f\/8\/3\/9f83009d7fd819dfbf1c7e9ebe708af43a457e1d_10627329_7290.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"NEC EX201W"}],"description":[{"locale":"de_DE","scope":"print","data":"Das ultraschmale \u201eOffice Cool\"-Design verbindet die bewahrte Qualitat und Leistungsfahigkeit von MultiSync\u00ae mit neuen Standards in Bezug auf Minimalismus und Eco- Innovation. Der 20 Zoll gro.e Breitbild-TFT-Monitor mit TNPanel und LED-Hintergrundbeleuchtung ist ideal fur Unternehmen, die Wert auf Stil, zukunftssichere Technologie und bewahrte Bildqualitat bei hochster\\nFlexibilitat legen.\\n\\nMit seiner au.erst schmalen LED-Hintergrundbeleuchtung und einem Design, bei dem Bildschirminhalt und -position im Mittelpunkt stehen, passt der EX201W von NEC perfekt ins\\nmoderne Buro und zu den neuen Trends bei Unternehmensausstattung. Sein kompaktes Format und flexibles Konzept machen ihn ideal fur Rezeptionen, Abfertigungsbereiche und informelle Besprechungen. Fur anspruchsvolle, umweltbewusste Nutzer und Anwender, die Wert auf optimale Arbeitsplatzgestaltung legen, bietet der EX201W einen Leuchtdichtesensor und einen Human Sensor sowie die kleinste Standflache unter allen Geraten auf dem Markt, die mit umfassenden Ergonomiefunktionen ausgestattet sind. Der Bildschirm lasst sich leicht mit VESA-Halterungen befestigen."},{"locale":"en_US","scope":"print","data":"NEC EX201W. Response time: 3.7, Display resolution: 1600 x 900, Contrast ratio (typical): 1000:1. VESA mounting interfaces compatibility: 100 x 100, Swivel angle range: -170 - 170, Tilt angle: -5 - 30. Input voltage: 100 - 240, Input frequency: 50\/60, Power consumption (standby): 0.5. Width: 474.8, Depth: 47.6, Height: 278.2. Cables included: AC, DVI, USB"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-11T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":4}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":20,"unit":"INCH"}}]},"created":"2023-04-18T13:32:59+00:00","updated":"2023-04-18T13:32:59+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6ad5e005-ec13-404f-b7c5-c0ca3f8653ff","identifier":"10627331","enabled":true,"family":"pc_monitors","categories":["nec","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"8\/9\/2\/4\/8924a2c6bcc6a25de83d95bab77a1a201ad74318_10627331_3228.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/8\/9\/2\/4\/8924a2c6bcc6a25de83d95bab77a1a201ad74318_10627331_3228.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"NEC P241W-BK"}],"description":[{"locale":"en_US","scope":"print","data":"The NEC MultiSync\u00ae P241W delivers outstanding image quality with class-leading ergonomics for demanding professional application. 15 cm height adjust, latest DisplayPort connector, Digital Uniformity Control, integrated USB hub and Picture-in- Picture give advanced users all the flexibility and image quality to ensure highest personal productivity. This outstanding display has won the prestigious iF Design Award.\\n\\nThe ideal display for professional design, CAD-CAM, finance, demanding office and industrial applications (e.g. NDT).\\n\\n- Consistent Colour Viewing - with IPS 16:10 TFT display.\\n- Ergonomic Office - full height adjustability (150 mm), swivel, tilt and pivot functionality ensures perfect individual ergonomic set-up.\\n- Improved Productivity and Reduced Desk Clutter - through easy multi-platform support and input following USB hub. Picture-by-picture allows two different platforms to be simultaneously viewed. A single mouse and keyboard can be switched to the active operating system.\\n- Future-proof Connectivity - as well as easier support of high resolution, 10-bit colour input signals is assured with the DisplayPort connector.\\n- Extraordinary Features - such as Digital Uniformity Control, Picture-in-Picture, USB Hub, 3D LUT colour space emulation, backlight ageing correction, DisplayPort.\\n- Special Characteristics \u2013 Advanced NTAA; AmbiBright ; Auto Black Level ; Auto Brightness; Auto Contrast; Backlight Ageing Correction ; CableComp with Sync Continuity Detection; ColorComp ; DDC\/CI compatible; Direct Brightness and Contrast; EcoModes ; 14 Bit Look Up Table for 14 Bit smooth Gamma curves; NaViSet\u00aeand NaViSet\u00aeAdministrator compatible; OmniColor\u2122 : sRGB and 6-Axis-Colour-Control; Overdrive; Quick release Stand and Handle; RapidMotion; Rapid Response Technology ; Self Diagnostics; TileComp ; TileMatrix ; TORO\u2122 Design"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-11T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":8}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}],"weight":[{"locale":null,"scope":null,"data":{"amount":"7.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"dae885d6-2f38-4f86-b18e-f555ccc2093b","identifier":"10638601","enabled":true,"family":"led_tvs","categories":["led_tvs","philips","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"c\/3\/8\/b\/c38bb4e3d5eb49dfb13ef6fffc2eb7344da0a1ef_10638601_Philips.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/c\/3\/8\/b\/c38bb4e3d5eb49dfb13ef6fffc2eb7344da0a1ef_10638601_Philips.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Philips 22PDL4906H\/12 LED TV"}],"description":[{"locale":"de_DE","scope":"print","data":"Erleben Sie mit diesem Philips 56\u00a0cm (22\") HD Ready LED-Fernseher Filme, Sportereignisse oder Spiele in brillanten LED-Bildern. Dank der Bild- und Klangqualit\u00e4t von Philips und dem anspruchsvollen Design passt dieser Fernseher perfekt in jeden Raum Ihres Zuhauses."},{"locale":"en_US","scope":"print","data":"<b>With true to life LED picture performance<\/b>\\n\\nExperience movies, sports or games in brilliant LED pictures with this Philips 22\" HD Ready LED TV. With Philips picture and sound quality, and its sophisticated design, this TV will fit perfectly in any room of your home.\\n\\n<b>Modern design to fit your home d\u00e9cor<\/b>\\n- Ultra slim and thin TV for perfect fit in any room\\n\\n<b>A clear, vivid LCD picture everytime<\/b>\\n- HD Ready with Digital Crystal Clear for depth and clarity\\n- Brilliant LED images with low power consumption\\n- Dynamic contrast 150.000:1 for incredible rich black details\\n\\n<b>Authentic and clear sound experience<\/b>\\n- Incredible Surround for powerful sound\\n\\n<b>Complete digital connectivity made simple<\/b>\\n- Seamless connectivity with 2 HDMI inputs and Easylink\\n- Integrated MPEG-4 tuner for HD reception without set top box\\n- PC-input allows you to use your TV as a PC monitor\\n\\n<b>Greener every day<\/b>\\n- LED TVs up to 40% more energy efficient than normal LCD TVs"},{"locale":"fr_FR","scope":"print","data":"Red\u00e9couvrez le plaisir du cin\u00e9ma, des rencontres sportives ou du jeu avec des images LED \u00e9clatantes gr\u00e2ce \u00e0 ce t\u00e9l\u00e9viseur LED 56\u00a0cm (22\") HD\u00a0Ready sign\u00e9 Philips. En plus de vous offrir la qualit\u00e9 de son et d'image Philips, ce mod\u00e8le au design raffin\u00e9 s'int\u00e8grera parfaitement \u00e0 votre int\u00e9rieur."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-13T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b6b5e575-ae4c-4df3-8063-7df83c2b5a36","identifier":"10643171","enabled":true,"family":"pc_monitors","categories":["pc_monitors","philips","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"4\/f\/1\/6\/4f1627cead6e89334afc60a7433f47ae3ad43fe6_10643171_Philips.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/4\/f\/1\/6\/4f1627cead6e89334afc60a7433f47ae3ad43fe6_10643171_Philips.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Philips 227E3QPHSU"}],"description":[{"locale":"de_DE","scope":"print","data":"Erleben Sie brillante LED-Bilder auf diesem breiten IPS Display. Das elegante Design mit transparentem blauem Rahmen, HDMI und innovativem PowerSensor, der erkennt, wenn Sie das Ger\u00e4t verwenden, und bis zu 80\u00a0% an Energie und Geld spart, macht diesen Monitor zu einer intelligenten und umweltfreundlichen L\u00f6sung."},{"locale":"en_US","scope":"print","data":"Experience brilliant LED pictures on this IPS wide-view display. With elegant design, translucent blue bezel, HDMI and Innovative PowerSensor that detects your presence saving upto 80% of your energy bill, it's a smart green choice\\n<b>Great picture quality<\/b>\\n- IPS LED wide view technology for image and color accuracy\\n- 16:9 Full HD display for best viewing experience\\n- SmartContrast 20000000:1 for incredible rich black details\\n<b>Design that complements any interior<\/b>\\n- Elegant, slim design complements your home decor\\n- Translucent blue bezel with glossy finish\\n- Modern Touch controls\\n<b>Experience true multimedia<\/b>\\n- HDMI-ready for Full HD entertainment\\n<b>Greener everyday<\/b>\\n- PowerSensor ensures lower operating costs by saving energy\\n- Mercury Free eco-friendly display"},{"locale":"fr_FR","scope":"print","data":"Profitez d'images LED \u00e9clatantes avec cet \u00e9cran large avec technologie IPS. Son design \u00e9l\u00e9gant, son ch\u00e2ssis bleu transparent, sa compatibilit\u00e9 HDMI et la technologie PowerSensor innovante qui d\u00e9tecte votre pr\u00e9sence pour r\u00e9duire la consommation \u00e9nerg\u00e9tique de 80 % dans le meilleur des cas lui permettent d'allier performances et \u00e9cologie\\n<b>Une qualit\u00e9 d'image exceptionnelle<\/b>\\n- Technologie LED IPS grand angle pour des images et couleurs plus pr\u00e9cises\\n- \u00c9cran 16\/9 Full HD pour un confort de visionnage maximal\\n- SmartContrast 20 000 000:1 pour des d\u00e9tails de noir incroyablement profonds\\n<b>Un design adapt\u00e9 \u00e0 tous les int\u00e9rieurs<\/b>\\n- Design \u00e9l\u00e9gant, compact et soign\u00e9 pour agr\u00e9menter votre int\u00e9rieur\\n- Ch\u00e2ssis bleu translucide avec finition glossy\\n- Touches tactiles\\n<b>Une exp\u00e9rience multim\u00e9dia plus vraie que nature<\/b>\\n- Compatible HDMI pour un divertissement en Full HD\\n<b>Soyez un peu plus \u00e9colo chaque jour<\/b>\\n- PowerSensor r\u00e9duit la consommation d'\u00e9nergie et les co\u00fbts d'exploitation\\n- \u00c9cran sans mercure respectueux de l'environnement"}],"display_srgb":[{"locale":null,"scope":null,"data":true}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-15T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":7}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"4d545c55-a168-4e1c-9466-3cd0601ecfab","identifier":"10643196","enabled":true,"family":"pc_monitors","categories":["pc_monitors","philips","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips 196V3LSB"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Enjoy great LED pictures in vivid colors<\/b>\\nThis attractive, slim display is a delight to use. Essential features like SmartContrast that ensures rich bright images makes it a great choice!\\n\\n<b>Great picture quality<\/b>\\n- LED technology for natural colors\\n- SmartContrast 10000000:1 for incredible rich black details\\n\\n<b>Design that complements any interior<\/b>\\n- Attractive slim, glossy design\\n- Small footprint to blend into any lifestyle\\n\\n<b>Greener everyday<\/b>\\n- Mercury Free eco-friendly display\\n- Energy Star for energy efficiency and low power consumption\\n\\n<b>Great convenience<\/b>\\n- Easy display performance tuning with SmartControl Lite"},{"locale":"fr_FR","scope":"print","data":"<b>Profitez de superbes images LED aux couleurs \u00e9clatantes<\/b>\\nAvec son design fin et \u00e9l\u00e9gant, cet \u00e9cran est facile \u00e0 utiliser. Les fonctions essentielles, dont SmartContrast, vous permettent de b\u00e9n\u00e9ficier d'images profondes et lumineuses. Ce mod\u00e8le est exceptionnel !\\n\\nUne qualit\u00e9 d'image\\n<b>exceptionnelle<\/b>\\n- Technologie LED pour des couleurs naturelles\\n- SmartContrast 10 000 000:1 pour des d\u00e9tails de noir incroyablement profonds\\n\\n<b>Un design adapt\u00e9 \u00e0 tous les int\u00e9rieurs<\/b>\\n- Design fin et brillant, tr\u00e8s esth\u00e9tique\\n- Encombrement r\u00e9duit adapt\u00e9 \u00e0 votre style de vie\\n\\n<b>Soyez un peu plus \u00e9colo chaque jour<\/b>\\n- \u00c9cran sans mercure respectueux de l'environnement\\n- Energy Star : plus d'efficacit\u00e9 pour une consommation minimale\\n\\n<b>Pour un confort maximal<\/b>\\n- R\u00e9glage facile des performances d'affichage avec SmartControl Lite"}],"display_srgb":[{"locale":null,"scope":null,"data":true}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-15T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"98ece983-d516-4d28-9d45-da6204fcc9e0","identifier":"10645955","enabled":true,"family":"multifunctionals","categories":["multifunctionals","oki","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a3_297_x_420_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print","scan"]}],"picture":[{"locale":null,"scope":null,"data":"5\/5\/c\/e\/55cea8b8763ee43c3146e137e8f27c7c739b1a8c_10645955_9731.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/5\/c\/e\/55cea8b8763ee43c3146e137e8f27c7c739b1a8c_10645955_9731.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"OKI MC851DN"}],"description":[{"locale":"en_US","scope":"print","data":"<b>The MC851 has been designed for the budget conscious business that needs the flexibility of an A3 colour MFP combined with a highly-competitive entry price but without compromising on functionality.<\/b>\\n\\n- Easy to use graphical LCD display with simple navigation of advanced features. Plus one-touch Copy, Scan, Print and Fax buttons for simplified interaction\\n- Scan to USB stick via Host USB port for convenient file sharing\\n- Scanning to client, email or network PC improves document communications and management\\n- Fax A4 and A3 single and double sided documents or to save paper send faxes directly from a PC\\n- Forward incoming faxes to an email account saving paper and increasing document workflow efficiency\\n- Embedded LDAP provides direct access to contact and email data in an existing database, saving time and improving the reliability of document delivery\\n- Job Program allows users to save time by def.ining regularly used functions for repeated use\\n- Job Interrupt temporarily pauses the device, allowing users to copy urgent documents without disrupting the workflow\\n- Secure Print password protects print jobs so only authorised persons can retrieve them, whilst encryption takes care of data security as it travels across the network queue, allowing users to copy urgent documents"}],"color_scanning":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"68.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c80b910a-97fd-4880-98c7-32bf8e63c3a8","identifier":"10646015","enabled":true,"family":"pc_monitors","categories":["dell","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"2\/3\/6\/0\/2360ee67e6c0ea96c49ea824aa91d4acbcf413e2_10646015_963.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/2\/3\/6\/0\/2360ee67e6c0ea96c49ea824aa91d4acbcf413e2_10646015_963.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"DELL U2412M"}],"description":[{"locale":"en_US","scope":"print","data":"Enjoy widescreen performance, any way you want it. With a 61 cm(24'') 16:10 panel, IPS technology and LED backlight, the U2412M provides a brilliant view, plus amazing adjustability to suit any style.\\n- Powerful: Experience IPS technology, featuring a wide viewing angle with high-quality colour representation for a peerless viewing experience.\\n- Flexible: Pick the view that works best for you with an almost unlimited range of tilt, swivel, pivot and height adjustments.Customizable: Change your energy usage settings, text brightness and colour temperature with the touch of a button to help conserve energy with this eco-designed arsenic-free and mercury-free panel.\\n\\n<b>Whether for work or for play, the Dell UltraSharp\u2122 U2412M can deliver an unmatched viewing experience.<\/b>\\n- Clearly outstanding: Watch your graphics come to life on a vast 61 cm(24'') LED-backlit screen featuring a crystal-clear 1920x1200 resolution on a 16:10 widescreen aspect ratio so you can\u2019t lose screen area just because your customized applications support a different resolution.\\n- Contrasting view: Get ready for blur-free viewing with 2 million:1 (typical) high dynamic contrast ratio and 8ms with overdrive gray-to-gray (typical) response time that helps ensure crisp, sharp and ghost-free images.\\n- Colourful character: Enjoy an amazing range of rich, dramatic and accurate colours, thanks to IPS technology designed to give you colour consistency across a broad viewing angle and a wide colour gamut at 82% (typical)."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":8}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c712f916-43e6-4700-9a3d-69f6b8e9d409","identifier":"10646908","enabled":true,"family":"pc_monitors","categories":["asus","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"5\/8\/5\/9\/5859bc866ac1b1991baed5ca5f740cfd838f5583_10646908_5974.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/8\/5\/9\/5859bc866ac1b1991baed5ca5f740cfd838f5583_10646908_5974.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"ASUS VS197D"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"3.0000","unit":"KILOGRAM"}}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"<b>Superior Image Quality Meets Classic Elegant Design<\/b>\\nDelicate touches make a monitor truly great, VS197D LED monitor with 50,000,000:1 high contrast ratio, is optimized for the finest image and color quality. This approach extends to the sturdy stand and slim profile without compromising style in ensuring stability and durability.\\n\\n<b>50,000,000:1 ASUS Smart Contrast Ratio<\/b>\\nDynamically enhances the display\u2019s contrast by adjusting the luminance of the backlight to achieve the darkest black and brightest white \u2013 delivering lifelike images.\\n\\n<b>Excellent Visual Performance<\/b>\\n- Indulge your visual senses with 1366x768 resolution and 5ms quick response time for work and entertainment.\\n- The best dual-display companion with your widescreen notebook enlarges the visual space for multi-tasking efficiency.\\n- Aspect Control function allows users to select a preferred display mode among Full and 4:3 for true-to-life gaming or movie watching without any data loss or image distortion.\\n\\n<b>Versatile viewing positions with Smart View Technology<\/b>\\nWhen you would like to watch movies upward lying down, Smart View Technology can adjust color parameters to deliver the same image quality and colors with straight viewing.\\n\\n<b>Splendid\u2122 Video Intelligence Technology<\/b>\\nThe exclusive Splendid Video Intelligence Technology optimizes video performance and image fidelity by enhancing color, brightness, contrast, and sharpness. 6 preset video modes (Scenery, Theater, Game, Night View, sRGB and Standard) can be selected via a hotkey.\\n\\n<b>User-friendly Design<\/b>\\n- Convenient key controls for functional set-up in the multi-language OSD.\\n- VESA Wall Mount Standard (75 x 75 mm ).\\n- 25\u00b0 ( forward 5\u00b0, backwards 20\u00b0 )Tilting Angle.\\n- KENSINGTON Security Lock.\\n\\n<b>Complete After-Sale Service<\/b>\\n- 3-year system warranty.\\n- 3-year panel warranty.\\n- Free pick-up service (in specific countries).\\n\\n<b>Green in Mind<\/b>\\n<b>Greener Materials<\/b>\\n- Mercury-free LED-backlit panel.\\n- Corrugated cardboard packaging with at least 80% recycled content.\\n- Slim-flat packaging allows more cartons to be fitted per cargo, reducing transportation costs and CO\u2082 emission.\\n\\n<b>Energy and Planet Saving<\/b>\\n- 37.2k Wh electricity saving\\n- 23.6kg reduction in CO\u2082emissions, equivalent to:\\n1.9 trees planted\\n2 years of oxygen for a family of four"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"5815bac5-3470-4535-8015-bd4ac33e8a14","identifier":"10646929","enabled":true,"family":"pc_monitors","categories":["aoc","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"9\/1\/5\/2\/91526a66eb99e8c88c9227ba1cabd23279b918b1_10646929_3544.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/1\/5\/2\/91526a66eb99e8c88c9227ba1cabd23279b918b1_10646929_3544.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"AOC e2350Sda"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":23,"unit":"INCH"}}],"description":[{"locale":"de_DE","scope":"print","data":"Modernste Technologie mit LED-Backlights, eine starke Performance sowie ein zeitlos klassisches, schwarzes Design kennzeichnen dieses Modell. Aufgrund hoher Kontrast- und Helligkeitswerte sowie einer schnellen Reaktionszeit pr\u00e4sentiert es selbst rasante Bewegtbildsequenzen fl\u00fcssig und gestochen scharf. Das elegante Display mit haarfeinen Texturen an der R\u00fcckseite und an dem runden Sockel ist an seiner \u201eschlanksten\u201c Stelle gerade einmal 1,6 cm tief. Dank seiner zahlreichen Features empfiehlt es sich sowohl f\u00fcr B\u00fcroarbeitspl\u00e4tze als auch f\u00fcr Zuhause."},{"locale":"en_US","scope":"print","data":"This model is characterised by the latest display technology with LED backlights, a top performance and a timelessly classic, black design. Due to high contrast and brightness values as well as a quick response time, the monitor renders even the fastest movie sequences fluently and razor-sharp. At its slimmest region, this elegant display, which sports hairline textures on the rear side as well as the base, is just 1.6 cm deep. Thanks to numerous features it is recommended for both office and home."},{"locale":"fr_FR","scope":"print","data":"Principales caract\u00e9ristiques de ce mod\u00e8le : une technologie d\u2019affichage de pointe \u00e0 r\u00e9tro-\u00e9clairage LED*, d\u2019excellentes performances et un design noir, \u00e0 la fois classique et ind\u00e9modable. Avec ses valeurs \u00e9lev\u00e9es de contraste et de luminosit\u00e9 et un temps de r\u00e9ponse rapide, le moniteur conf\u00e8re une nettet\u00e9 une fluidit\u00e9 exceptionnelle aux images anim\u00e9es les plus rapides. Cet \u00e9cran, \u00e0 texture bross\u00e9e sur la face arri\u00e8re et la base, ne mesure qu\u20191,6 cm \u00e0 l\u2019endroit le plus mince. Sa grande polyvalence en fait un outil aussi \u00e0 l\u2019aise au bureau qu\u2019\u00e0 la maison."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"5d1f828a-cda4-4c14-92a2-2b1154672e45","identifier":"10646931","enabled":true,"family":"pc_monitors","categories":["aoc","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"7\/4\/e\/a\/74eabd8caa9e1b947031b88d03afb530ee0f29d4_10646931_5446.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/7\/4\/e\/a\/74eabd8caa9e1b947031b88d03afb530ee0f29d4_10646931_5446.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"AOC e2352Phz"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":23,"unit":"INCH"}}],"description":[{"locale":"de_DE","scope":"print","data":"Der 3D-Monitor e2352Phz holt die Action ganz dicht heran. Dank der realistischen 3D-Darstellung des 58,5 cm\/23\u2033-Modells mit modernster LED-Backlight-Technologie f\u00fchlt der Nutzer sich direkt in das Geschehen hineinversetzt. Aufgrund der schnellen Reaktionszeit von nur 5 Millisekunden und einer Aufl\u00f6sung von 1920 x 1080 Bildpunkten (Full HD) ist er zudem perfekt f\u00fcr Movies und Gaming ausgestattet. Sehr gute Kontrast- (20.000.000:1) und Helligkeitswerte (250 cd\/m\u00b2) sorgen f\u00fcr eine ausgezeichnete Bildqualit\u00e4t. Hochaufl\u00f6sende Inhalte empf\u00e4ngt der Monitor \u00fcber einen HDCP-kompatiblen HDMI-Eingang."},{"locale":"en_US","scope":"print","data":"The 3D monitor e2352Phz brings action up close and personal. Thanks to its lifelike 3D rendering, the 58.5 cm\/23\u2033 model with the latest LED backlight technology makes users feel like they are right in the middle of the experience. Due to its fast response time of five milliseconds and resolution of 1920 x 1080 pixels (Full HD) it is also ideally suited for movies and gaming. Very good contrast (20,000,000:1) and brightness values (250 cd\/m\u00b2) provide an excellent image quality. High resolution content is received by the monitor via an HDCP compatible HDMI input."},{"locale":"fr_FR","scope":"print","data":"Gr\u00e2ce \u00e0 un rendu 3D tr\u00e8s r\u00e9aliste, l\u2019e2352Vz - mod\u00e8le de 58,5 cm\/23\u2033 \u00e0 r\u00e9tro-\u00e9clairage par LED* - plonge l\u2019utilisateur au c\u0153ur de l\u2019action ! Son temps de r\u00e9ponse de cinq millisecondes et sa r\u00e9solution Full HD de 1920 x 1080 pixels en font \u00e9galement l\u2019alli\u00e9 id\u00e9al des films et des jeux. Ses excellentes valeurs de contraste et de luminosit\u00e9 (250 cd\/m\u00b2) lui conf\u00e8rent une qualit\u00e9 d\u2019image exceptionnelle, en 3D comme en 2D. Le contenu haute r\u00e9solution est transmis au moniteur par le biais d\u2019une entr\u00e9e HDMI compatible HDCP. *LED : diodes \u00e9lectroluminescentes"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"89169312-58c9-4102-bdaa-301bc4853aa7","identifier":"10649473","enabled":true,"family":"scanners","categories":["ion","print_scan_sales","scanners"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"e\/f\/a\/e\/efaed5685f9858531311c4588478d753434a2447_10649473_8098.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/e\/f\/a\/e\/efaed5685f9858531311c4588478d753434a2447_10649473_8098.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"ION Film2SD Rapid Feeder"}],"color_scanning":[{"locale":null,"scope":null,"data":true}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"10f4d3a2-0a1a-4d36-b345-d109b4db19f8","identifier":"10655295","enabled":true,"family":"scanners","categories":["kodak","print_scan_sales","scanners"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"d\/3\/7\/b\/d37b4bedfa37845f3faa7823189a6848dd2f1f05_15743_10655295_2946.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/d\/3\/7\/b\/d37b4bedfa37845f3faa7823189a6848dd2f1f05_15743_10655295_2946.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Kodak i2800 for Govt"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Energize your information for a competitive edge<\/b>\\n\\nToday\u2019s business runs on information. But when that information is on paper, it can slow you down. Get things flowing faster with the KODAK i2800 Scanner. It lets you extract critical information from documents at the point of entry, for quick distribution to decision-makers who need it. So money to be gained isn\u2019t left waiting for choices to be made.\\n\\nNo matter what size your business or department is, the reliable performance of the KODAK i2800 Scanner can enable collaboration right from your desktop. It decreases processing time for information that needs to be shared for review, reference, approval, and legal and compliance reasons. This helps increase both internal and external customer satisfaction, and saves your company time and money. Plus, if your business has branch offices or field agents, distributed capture allows document images to be immediately sent to a central location for easy access.\\n\\nHelp your company get ahead with a scanning solution that can bring you increased security, faster internal processes, better teamwork, and a host of other business benefits\u2014the KODAK i2800 Scanner."}],"color_scanning":[{"locale":null,"scope":null,"data":true}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"0c6312c2-11cc-4911-8746-feff1cd8e3fe","identifier":"10655470","enabled":true,"family":"scanners","categories":["canon","print_scan_sales","scanners"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"c\/1\/2\/8\/c128323e914ddb344679759e9017a4b36eed309d_10655470_4868.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/c\/1\/2\/8\/c128323e914ddb344679759e9017a4b36eed309d_10655470_4868.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon imageFormula DR-C125"}],"description":[{"locale":"en_US","scope":"print","data":"The Canon imageFORMULA DR-C125 Document Scanner's innovative space-saving design makes it a standout in any office environment for improving information accessibility, management, and collaboration. Its flexibility and high image quality are only surpassed by its easy use, making it ideal for converting and capturing paper-based documents to digital format.\\n\\nThe DR-C125 scanner is ideal for general purpose distributed scanning of a variety of document types. In corporate or remote offices, this scanner is well-suited for use by individuals or small workgroups to modernize paper-based processes, increasing efficiency and productivity. Legal services, financial services, healthcare, government, and other industries can benefit from its small size and easy use.\\n\\n- Space Saving\\n- Easy Use\\n- Flexibility\\n- High Image Quality\\n- Environment In Mind\\n- Customer Care"}],"color_scanning":[{"locale":null,"scope":null,"data":true}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"3246cc2e-df06-493a-bd6c-13bb97a63748","identifier":"10660721","enabled":true,"family":"pc_monitors","categories":["pc_monitors","samsung","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"8\/2\/0\/c\/820c6274e0b5754d6ae6239771777a99a887b544_15743_10660721_6413.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/8\/2\/0\/c\/820c6274e0b5754d6ae6239771777a99a887b544_15743_10660721_6413.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Samsung S19A450MW"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"<b>Conveniently adjust monitor height, tilt and perspective<\/b>\\nThe Samsung LED Business Monitor SA450 has been designed to help boost work efficiency, delivering a tailored experience with its choice of viewer settings. The height-adjustable stand ensures that the screen can always be set at the optimal eye level, which enhances the visual experience while also helping maintain the viewer\u2019s body posture. Other features include the tilt and pivot capabilities, which not only increase comfort levels but also introduce new ways of working. The SA450 Monitor can rotate 90\u030a\u030a\u030a degrees, allowing for more appropriate view depending on the work. So, now you can take convenience and efficiency to amazing heights with the Samsung LED Business Monitor SA450.\\n\\n\\n<b>Maximise workspace with an efficient detachable adaptor<\/b>\\nIf you need a work monitor that uses office space efficiently, then Samsung LED Business Monitor SA450 is the perfect choice. It features an innovative new detachable adaptor, which allows the monitor to be easily moved and installed. From physically moving the monitor with the carrying handle to quickly installing, the SA450 is ready to deliver an efficient and clean work space. The SA450 is also equipped and prepared for you as a VESA Wall mount, providing a multi-screen or wall mounted monitor. Optimising your office space is now easily achieved with the Samsung LED Business Monitor SA450."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"7b1b51f5-f9d3-4e2b-8002-8a1766ceb7d2","identifier":"10661721","enabled":true,"family":"scanners","categories":["kodak","print_scan_sales","scanners"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"e\/f\/f\/0\/eff02a4f4da544ba0d039455cd31f153ba9584f6_15743_10661721_4414.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/e\/f\/f\/0\/eff02a4f4da544ba0d039455cd31f153ba9584f6_15743_10661721_4414.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Kodak i2600 for Govt"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Energize your information for a competitive edge<\/b>\\n\\nToday\u2019s business runs on information. But when that information is on paper, it can slow you down. Get things flowing faster with the KODAK i2600 Scanner. It lets you extract critical information from documents at the point of entry, for quick distribution to decision-makers who need it. So money to be gained isn\u2019t left waiting for choices to be made.\\n\\nNo matter what size your business or department is, the reliable performance of the KODAK i2600 Scanner can enable collaboration right from your desktop. It decreases processing time for information that needs to be shared for review, reference, approval, and legal and compliance reasons. This helps increase both internal and external customer satisfaction, and saves your company time and money. Plus, if your business has branch offices or field agents, distributed capture allows document images to be immediately sent to a central location for easy access.\\n\\nHelp your company get ahead with a scanning solution that can bring you increased security, faster internal processes, better teamwork, and a host of other business benefits\u2014the KODAK i2600 Scanner."}],"color_scanning":[{"locale":null,"scope":null,"data":true}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"d7a26209-d5ac-4076-a2dd-2b457888695e","identifier":"10663527","enabled":true,"family":"pc_monitors","categories":["asus","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"0\/a\/b\/5\/0ab5a68f0828b158268a5a41a32316c05597f423_10663527_2426.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/0\/a\/b\/5\/0ab5a68f0828b158268a5a41a32316c05597f423_10663527_2426.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"ASUS PA238Q"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":23,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"<b>The Professional Monitor with a Touch of Play<\/b>\\n\\n- IPS panel with 100% sRGB coverage and 178 wide viewing angle\\n- Every unit is factory-calibrated for superior color fidelity\\n- QuickFit Virtual Scale instantly boosts design efficiency by providing real-size document, photo and grid on screen\\n\\n<b>Ultimate Color Precision<\/b>\\n<b>High Color Accuracy with Low Delta E<\/b>\\n\\nEach PA238Q is pre-calibrated with a maximum \u0394E (Delta E) of less than 5. Ensures precise reading of color input and guarantees excellent color fidelity\\n\\n<b>178\u02da Wide Viewing Angle<\/b>\\n\\nPA238Q adopts 178\u02da of horizontal and vertical viewing angle that eradicates color shift on your screen no matter where and how you look at it\\n\\n<b>Flawless Gradation with 10-bit Look-up Table<\/b>\\n\\nPA238Q's built-in internal 10-bit Look-up Table can produce greater depth for each RGB colors than 8-bit Look-up Table in conventional monitors. Resulting in smooth gradation and accurate color resolution\\n\\n<b>User-friendly Solutions<\/b>\\n\\n<b>QuickFit Virtual Scale<\/b>\\n\\nThe ASUS-exclusive QuickFit built in the monitor provides real-size document, photo, and grid mode on top of the operating windows on the screen. It can activated via a hotkey on monitor and used as a guide to accurately view and edit photos.\\n\\nSupporting Formats:\\n- Document: A4, letter\\n- Photo: 8\u201dx10\u201d, 5\u201dx7\u201d, 4\u201dx6\u201d, 3\u201dx5\u201d, 2\u201dx2\u201d\\n- Grid: Alignment, Centimeters, Inches\\n\\n<b>Versatile Comfort with Ergonomic Design<\/b>\\n\\nThe ergonomically-designed PA238Q Professional Monitor comes with swivel, tilt, pivot, and height adjustments for ideal viewing position.\\n\\n<b>Customized Color Adjustment<\/b>\\n\\nCustomized hue and saturation control with 6 color adjustment allows user to adjust six colors (red, green, blue, cyan, magenta and yellow) independently without effecting other colors.\\n\\n<b>Picture-in-Picture and Picture-by-Picture<\/b>\\n\\nPicture-in-Picture and Picture-by-Picture allows users to view images from different signals in almost anyway they want\\n\\n<b>Hassle-Free Connection<\/b>\\n\\nPA238Q comes with rich connectivity including DisplayPort, HDMI, DVI, D-sub. It is also equipped with four USB 2.0 ports so that users could easily connect PA238Q to many peripherals, such as USB drives, keyboard, mouse, digital camera, etc.\\n\\n<b>Mercury-free LED-backlit panel<\/b>\\n\\nEmbedded LED backlight panel helps power saving and environmental protection with no mercury usage.\\n\\n<b>Award-winning Design<\/b>\\n\\nReddot Design Award winner 2011"}],"display_srgb":[{"locale":null,"scope":null,"data":true}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":6}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"8dc43234-e641-4a6e-a344-b3d663ac507f","identifier":"10668550","enabled":true,"family":"multifunctionals","categories":["multifunctionals","print_scan_sales","samsung"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["scan"]}],"picture":[{"locale":null,"scope":null,"data":"2\/4\/c\/a\/24ca2a7a33076b90218dde03b1f310a8e329da8a_10668550_747.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/2\/4\/c\/a\/24ca2a7a33076b90218dde03b1f310a8e329da8a_10668550_747.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Samsung SCX-4728FD multifunctional"}],"description":[{"locale":"de_DE","scope":"print","data":"Die Samsung S \/ W-Laser-Multifunktionsdrucker SCX-4728FD Serie bietet ein Multifunktionsger\u00e4t, bei dem Umweltfreundlichkeit und Leistung im idealen Gleichgewicht stehen.\\n\\n<b>Holen Sie mit Duplex-Druck mehr aus jeder Seite heraus<\/b>\\nVerdoppeln Sie Ihre Druckausgabe. Oder halbieren Sie Ihre Papierkosten. Egal, wie Sie es betrachten ist der Duplex-Druck eine wichtige Funktion f\u00fcr Drucker in Gesch\u00e4ftsumgebungen und im pers\u00f6nlichen Bereich. Die Funktion bietet viele coole und kreative M\u00f6glichkeiten, Druckauftr\u00e4ge von einseitigen Formaten bis zu doppelseitigen Buchformaten zu verarbeiten und liefert immer professionelles und edles Aussehen. Die Funktionen f\u00fcr doppelseitiges Drucken senken au\u00dferdem die Kosten betr\u00e4chtlich und sorgen daf\u00fcr, dass der Papiervorrat l\u00e4nger h\u00e4lt. Der Abfall wird verringert und die Auswirkungen auf die Umwelt werden minimiert. Duplex-Druck bietet also f\u00fcr alle Beteiligten viele Vorteile.\\n\\n<b>Jetzt noch einfacher mehr f\u00fcr die Umwelt tun<\/b>\\nDurch den neuen Eco-Modus von Samsung mit dem Ergebnissimulator, der den Status anzeigt, k\u00f6nnen Sie Ihre Umweltziele noch einfacher erreichen. Der Eco-Modus wird \u00fcber eine One-Touch-Taste bedient, die den Modus beim Aktivieren als Standard festlegt. Der Papierverbrauch wird dann durch Duplex-Druck und 2- oder 4-Seiten-Druck verringert und der Tonersparmodus ist au\u00dferdem eingeschaltet. Dank des Ergebnissimulators k\u00f6nnen Sie jetzt sehen, wie viel gute Arbeit Sie f\u00fcr die Umwelt leisten. Die Simulation zeigt die Kohlendioxidbilanz sowie den Strom- und Papierverbrauch. Der Eco-Modus ist eine einfache und effektive Methode, Ihren Druckverbrauch im Auge zu behalten und sich sowie unserer Umwelt einen Gefallen zu tun!\\n\\n<b>Eine Arbeitserleichterung mit Multitasking<\/b>\\nProduktivit\u00e4t steht in jedem B\u00fcro oder bei jeder professionellen Arbeitsgruppe an erster Stelle. Der sehr vielseitige, schnell druckende SCX-4728FD ist f\u00fcr Produktivit\u00e4t ausgelegt. Sie k\u00f6nnen jetzt bequem, einfach und schnell drucken, kopieren, scannen und faxen. Warum sollten Sie verschiedene Ger\u00e4te im B\u00fcro aufstellen, wenn Sie nur ein vielseitiges Ger\u00e4t ben\u00f6tigen: den 4-in-1 SCX-4728FD Laser-Multifunktionsdrucker.\\n\\n<b>Besseres Arbeiten mit schneller Druckgeschwindigkeit<\/b>\\nDank der CPU mit 533 MHz und dem Speicher mit 128 MB bietet Samsung schnelle Druckgeschwindigkeiten f\u00fcr gro\u00dfe und kleine Dokumente. Durch die schnelle Druckgeschwindigkeit k\u00f6nnen Sie wichtige Arbeitsdokumente problemlos und mit hoher Qualit\u00e4t drucken, dabei die Produktivit\u00e4t im B\u00fcro steigern und die Arbeitsabl\u00e4ufe verbessern. Ein zuverl\u00e4ssiger und \u00fcberlegener Drucker wie dieser wird schnell zum unerl\u00e4sslichen Werkzeug und Sie werden sich fragen, wie die Gesch\u00e4fte jemals ohne liefen.\\n\\n<b>In Verbindung mit Ihren Kollegen<\/b>\\nStellen Sie in Ihrem B\u00fcro f\u00fcr alle eine Netzwerkverbindung her und sorgen Sie f\u00fcr einen reibungslosen Arbeitsablauf. Sie k\u00f6nnen alle einen gemeinsamen Drucker verwenden, was Ihnen Zeit wie auch die Wartung mehrerer Ger\u00e4te einspart. Und mit der Ethernet-Schnittstelle k\u00f6nnen Sie die Leistung durch Anbindung an das Netzwerk erh\u00f6hen. Optimieren Sie mit dem bedienerfreundlichen Laserdrucker Ihre Kommunikationsf\u00e4higkeiten und bleiben Sie allzeit bereit.\\n\\n<b>Ein toller Drucker mit niedrigem Ger\u00e4uschpegel<\/b>\\nDank der weitreichenden Erfahrung von Samsung arbeitet die neue Produktreihe der bedienerfreundlichen Drucker mit nur 50 Dezibel \u2013 ideal f\u00fcrs B\u00fcro und unbeliebt bei unserer Konkurrenz. Im Standby liegt der Ger\u00e4uschpegel bei 30 dBA, damit Kollegen nicht bereits vor dem Druckvorgang schreien m\u00fcssen, um sich Geh\u00f6r zu verschaffen. Sie m\u00fcssen die T\u00fcren zum Gang nicht schlie\u00dfen, da der SCX-4728FD die anderen f\u00fchrenden Drucker bei jeder gedruckten Seiten in den Schatten stellt.\\n\\n<b>Ideal f\u00fcr enge, stilvolle Ecken und viel genutzte Pl\u00e4tze<\/b>\\nEndlich sieht Ihr Schreibtisch mit Drucker cool und sch\u00f6n aus. Der Samsung SCX-4728FD Laserdrucker hat ein elegantes Geh\u00e4use, das in jeden Arbeitsbereich passt. Die Abdeckung sieht schick und sauber aus und sch\u00fctzt gleichzeitig vor Staub. Versch\u00f6nern Sie Ihren Schreibtisch mit Zubeh\u00f6r, das Ihnen bei der Arbeit hilft.\\n\\n<b>Erfassen, was Ihnen ins Auge sticht<\/b>\\nMit der Software AnyWeb Print von Samsung k\u00f6nnen Sie im Internet jagen und sammeln. Sie k\u00f6nnen mit dem SCX-4728FD einfach Inhalte von verschiedenen Internetseiten ausw\u00e4hlen und zum sp\u00e4teren Drucken in einen speziellen Bereich in Ihrem Browserfenster ziehen \u2013 und dabei weiter surfen. Es ist eine einfache M\u00f6glichkeit, diese n\u00fctzlichen Referenzpunkte und Ressourcen f\u00fcr Ihr gro\u00dfes Projekt oder nur zum Spa\u00df zu sammeln, zu ordnen und zu bearbeiten, die Sie nur im Internet finden."},{"locale":"en_US","scope":"print","data":"For a multifunction device that delivers the ultimate balance of economy and power, look no further than the Samsung Mono Laser Multifunction Printer SCX-4728FD Series.\\n\\n<b>Get more from every page with Duplex printing<\/b>\\nDouble your print output. Or, halve your paper costs. Either way you look at it; there is no denying that Duplex printing is an essential feature for both business and personal printing. It provides loads of cool and creative ways to fulfill print jobs, from single-sided formats to double-sided booklet formats, and really delivers a professional look and feel every time. The double-sided printing capabilities will also massively reduce costs and ensure that your paper supplies last longer. This then helps reduce waste, and minimises your impact on the environment. So, it is definitely a win-win situation with Duplex printing.\\n\\n<b>Being eco-friendly just got easier<\/b>\\nMake hitting your environmental goals a whole lot easier with Samsung\u2019s new Eco Mode, which also includes a Results Simulator to check how well you are doing. The Eco Mode features a one touch Eco Button, which conveniently serves as your default setting once activated, and reduces paper consumption with Duplex printing, 2 or 4-up printing and a Toner Save setting. Thanks to the Results Simulator, you can really appreciate how much good work you are doing. The simulation shows levels of carbon dioxide emissions, electricity and paper usage. The Eco Mode is an easy and effective way of keeping track of your printer consumption \u2013 which is better for you and the planet!\\n\\n<b>It multi-tasks so you don\u2019t have to<\/b>\\nProductivity is a key to running any office or professional workgroup. The ultra-versatile, fast-printing SCX-4728FD is designed to deliver productivity. Now you can print, copy, scan and fax with convenience, ease and speed. Why clutter a corner of your office with several different machines when all you need is one versatile device \u2013 the 4-in-1 SCX-4728FD laser multifunction printer.\\n\\n<b>Work better with Fast Speed printing performance<\/b>\\nPrint documents (small or large) quickly thanks to Samsung\u2019s Fast Speed printing, which is made possible with the 533MHz CPU and 128MB memory. Perfect for getting important work documents printed with high quality and zero fuss, the faster printing speeds will also help boost office productivity and enhance workflows. A reliable and superior printer like this will quickly become a must-have business tool - you\u2019ll wonder how your business ever functioned without one.\\n\\n<b>Connect with your colleagues<\/b>\\nConnect everyone in your office to one network and keep everything running smoothly. They\u2019ll share a common printer and you\u2019ll save time from servicing multiple machines. And with the Ethernet interface you can increase your performance by hooking it up to the network. Improve your communication skills with the Streamline work with easy-to-use printers laser printer and keep your lines of communication open.\\n\\n<b>A top printer that\u2019s low on noise<\/b>\\nFrom a company that knows its business, the new Samsung Streamline work with easy-to-use printers printer can work flat out at a mere 50 decibels, an office-friendly volume you won\u2018t be hearing our competitors shout about. With a standby volume of 30dBA, it signals an end to colleagues having to scream to be heard, even before their printing has begun. Doors can stay open along corridors as the SCX-4728FD outperforms the other leading printers copy after copy.\\n\\n<b>Ideal for small, stylish spaces and busy places<\/b>\\nFinally, your desk can look stylish because of your printer, not in spite of it. The Samsung SCX-4728FD laser printer has an elegant exterior design, sure to fit in with any workspace. Its top cover looks chic and polished while offering dust-free protection. Spiff up your space with a desktop accessory that actually helps you work better.\\n\\n<b>Capture what catches your eye<\/b>\\nSamsung\u2019s AnyWeb Print software lets you go hunting and gathering on the Web. You can utilise the SCX-4728FD to easily select, drag and drop content from different web pages onto a printable scrap board in your browser window, all while you surf. It\u2019s the easy way to collect, arrange and edit those useful reference points and resources you can only find on the Internet for that big project ? or just for fun."}],"color_scanning":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"2e6b9ac1-1d4a-469f-bb7e-14320e6fa7c7","identifier":"10672501","enabled":true,"family":"pc_monitors","categories":["pc_monitors","toshiba","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"b\/c\/1\/b\/bc1b0df928c9372d7059d64f776c557197b4d885_10672501_596.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/c\/1\/b\/bc1b0df928c9372d7059d64f776c557197b4d885_10672501_596.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Toshiba PA3923E-2LC3"}],"description":[{"locale":"de_DE","scope":"print","data":"Mit dem TOSHIBA Mobile LCD Monitor erweitern Sie jedes Windows-basierende Notebook um ein zus\u00e4tzliches Display, egal ob bei der Arbeit, im Au\u00dfendienst, in der Schule oder Zuhause.\\nDas 14 Zoll Display mit einer Aufl\u00f6sung von 1366 x 768 Pixeln bietet Sch\u00e4rfe und Farbbrillianz in HD-Qualit\u00e4t. Sie brauchen keinen Projektor mehr f\u00fcr Ihre Pr\u00e4sentation.\\nIm erweiteren Modus ist der Monitor ideal geeignet f\u00fcr parallel laufende Anwendungen. Nur 17 mm dick und 780 g leicht. Dieser ultra-portable Monitor passt in die meisten Notebook-Taschen.\\nSowohl die \u00dcbertragung des Videosignals als auch die Stromversorgung erfolgt nur \u00fcber ein USB-Kabel. Somit entf\u00e4llt auch die Mitnahme von diversen Videokabeln und einem AC Adapter.\\nMit dem TOSHIBA Mobile Monitor erhalten Sie ein Hybrid-Cover in hochwertiger Lederoptik, welches sich schnell von einer Schutztasche in einen variabel einstellbaren Monitorst\u00e4nder verwandeln l\u00e4\u00dft. Unter einer Lasche l\u00e4\u00dft sich auch das USB-Kabel komfortabel verstauen."},{"locale":"en_US","scope":"print","data":"- Users who need a portable monitor\\n- Users who need an additional portable monitor\\n- Serious multi-taskers who want to have two screens\\n- Students on campus in dormitories, libaries, student centers\\n- Business travelers in hotel meeting rooms or trade shows\\n- Environments with limited space\\n\\n<b>THE MAIN BENEFITS:<\/b>\\n- USB interface\\n- Hybrid carry case\/stand included\\n- Sleek and slim design\\n- Low power consumption\\n- Easy adjust brightness control buttons\\n- Power saving mode"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-18T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":16}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":14,"unit":"INCH"}}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"5c6c8570-e746-4158-ac36-e5ca2ed2b85a","identifier":"10684896","enabled":true,"family":"webcams","categories":["cameras_sales","logitech","webcams"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Logitech C110"}],"total_megapixels":[{"locale":null,"scope":null,"data":"1.3"}],"description":[{"locale":"de_DE","scope":"print","data":"Dank Plug&Play-Einrichtung, VGA-Videoqualit\u00e4t und integriertem Mikrofon ist es mit dieser Webcam ein Kinderspiel, Videogespr\u00e4che zu f\u00fchren und Fotos (1.3MP) zu verschicken.\\n\\n<b>Plug&Play-Installation, einfache Bedienung<\/b>\\nDank der einfachen Plug&Play-Installation k\u00f6nnen Sie schnell Videogespr\u00e4che f\u00fchren \u2013 \u00fcber die meisten Instant Messenger und Logitech Vid HD.\\n\\n<b>Klar verst\u00e4ndliche Videogespr\u00e4che<\/b>\\nDank VGA-Sensor sehen Ihre Familie und Freunde Sie bei Gespr\u00e4chen in realistischen Farben.\\n\\n<b>Fotos mit 1.3 Megapixeln<\/b>\\nSie k\u00f6nnen auch ganz einfach Schnappsch\u00fcsse mit bis zu 1.3 Megapixeln aufnehmen (Software-interpoliert).\\n\\n<b>XVGA-Videoaufnahmen<\/b>\\nLebendige, farbenfrohe Videoaufnahmen in XVGA-Aufl\u00f6sung (1024 x 768), die Sie mit Ihren Freunden, Ihrer Familie oder der ganzen Welt teilen k\u00f6nnen \u2013 auf Facebook, YouTube, Twitter oder in Ihrem Blog.\\n\\n<b>Integriertes Mikrofon mit RightSound<\/b>\\nKlar verst\u00e4ndliche Gespr\u00e4che ohne st\u00f6rende Hintergrundger\u00e4usche.\\n\\n<b>Universalhalterung<\/b>\\nBefestigen Sie Ihre Webcam sicher am Notebook oder LCD-Monitor oder stellen Sie sie ins Regal oder auf den Schreibtisch."},{"locale":"en_US","scope":"print","data":"Logitech C110. Megapixel: 1.3. Maximum image resolution: 1024 x 768, Still image resolution(s): 1024 x 768. Interface: USB, Colour of product: Black, White, Mounting type: Clip\/Stand. Power source: DC. Minimum processor: 1.6GHz"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-19T00:00:00+00:00"}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"3d44b4fa-7bf0-42db-a5ac-d61775cb6078","identifier":"10699783","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","sony"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"b\/b\/7\/3\/bb73d1e5369c6f13d3ee3c6966d71c68ab6e6ad0_10699783_840.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/b\/7\/3\/bb73d1e5369c6f13d3ee3c6966d71c68ab6e6ad0_10699783_840.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Sony SRS-BTV25"}],"description":[{"locale":"de_DE","scope":"print","data":"Bluetooth\u00ae Wireless, USB-Ladefunktion, A2DP\/AVRCP Bluetooth\u00ae Profil\\n\\n- Kristallklares, kraftvolles 360\u00b0-Sound-Erlebnis\\n- Kabellose Musik\u00fcbertragung von Ihrem Ger\u00e4t\\n- Elegantes, kompaktes Design \u2013 passt in jeden Raum"},{"locale":"en_US","scope":"print","data":"Bluetooth wireless, USB charging, A2DP \/ AVRCP Bluetooth profile\\n\\n- Crisp, powerful 360\u00b0 sound experience\\n- Stream music from your device without wires\\n- Stylish, compact design - fits into any space"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-21T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"05027301-1f5f-41d0-b7c0-990866d25db1","identifier":"10709378","enabled":true,"family":"pc_monitors","categories":["hp","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"3\/1\/5\/a\/315ad8c24a4dd10575f65723cfd2bacf1230cb2e_10709378_2259.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/3\/1\/5\/a\/315ad8c24a4dd10575f65723cfd2bacf1230cb2e_10709378_2259.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"HP 646995-001"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-21T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":13,"unit":"INCH"}}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b9136abb-eb8a-4087-a915-e8975b448237","identifier":"10709379","enabled":true,"family":"pc_monitors","categories":["hp","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"HP 646997-001"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-21T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":13,"unit":"INCH"}}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"26cbf2fa-ad69-4bc6-a58d-9fe575904d13","identifier":"10720908","enabled":true,"family":"pc_monitors","categories":["lenovo","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Lenovo ThinkVision LS2421p"}],"description":[{"locale":"en_US","scope":"print","data":"The Lenovo LS2421p Wide is a 23.6\"Full HD LED TFT Monitor which adopts the latest W-LED backlight technology and provides great display quality and saves power consumption up to 40% compared to previous product. It offers digital visual interface (HDMI1.3). It comes in a high gloss ID, transparent bezel, touch OSD buttons. It has high display performance, such as 10M:1 high dynamic contrast ratio and Novo Vision, and a 4ports USB hub for ease use.\\n\\nThe Lenovo LS2421p Wide is packed with green features including Mercury free by adopting white LED backlights, arsenic-free glass, and is Energy-Star 5.1 and TCO Displays 5.2 compliant."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-26T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"920f8d1a-ff74-4fda-9078-ac32522c34d0","identifier":"10727018","enabled":true,"family":"mp3_players","categories":["audio_video_sales","lenco","mp3_players"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"b\/3\/f\/8\/b3f80f27889aacf4112b922ce765e29146e71ae2_10727018_8169.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/3\/f\/8\/b3f80f27889aacf4112b922ce765e29146e71ae2_10727018_8169.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lenco XEMIO-655GRY MP3 player & recorder"}],"description":[{"locale":"en_US","scope":"print","data":"- 4,5 cm (1,8\u201d) TFT screen\\n- Built-in 4 GB flash memory\\n- Supports: MP3 and WMA\\n- Supports video in AMV format\\n- Supports photos in JPG, BMP and GIF format\\n- Multi language OSD\\n- USB 2.0 connection\\n- 3,5mm earphone jack\\n- Supports Windows 98\/ME\/2000\/XP\/Vista\\n- Repeat (A\/B) function\\n- ID3 tag\\n- Micro SD card slot up to 8 GB (not included)\\n- Voice recording\\n- Built-in Li-Polymer Battery\\n- When fully charged: playtime approx. 3,5 hours videoplay, 8 hours Musicplay."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-26T00:00:00+00:00"}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"3bea3091-7f2f-4a8b-9522-3b7bc9f9de2d","identifier":"10734342","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_letter_216_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print","scan"]}],"picture":[{"locale":null,"scope":null,"data":"4\/6\/1\/f\/461f170c3024d36bfd08cda4cc0afa94d1edf352_10734342_3677.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/4\/6\/1\/f\/461f170c3024d36bfd08cda4cc0afa94d1edf352_10734342_3677.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon PIXMA MG3150"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Herausragende Qualit\u00e4t<\/b>\\nDieses kompakte Multifunktionssystem eignet sich hervorragend f\u00fcr das t\u00e4gliche Drucken, Scannen und Kopieren und ist ideal f\u00fcr Erstk\u00e4ufer, Studenten und Familien. Canons exzellentes FINE-Druckkopfsystem vereint Mikrod\u00fcsen f\u00fcr bis zu 2 pl feine Tintentr\u00f6pfchen mit einer Druckaufl\u00f6sung von bis zu 4.800 dpi und bietet so hochwertige Drucke in Laborqualit\u00e4t mit sanften Abstufungen ohne K\u00f6rnung und gestochen scharfem Text.\\n\\n<b>Wirtschaftliches Drucken<\/b>\\nUm die Druckkosten zu senken, kann der MG3150 mit optional erh\u00e4ltlichen XL-Patronen ausger\u00fcstet werden, was eine Ersparnis von bis zu 50 % mit sich bringt (im Vergleich zu den Standardpatronen).\\n\\n<b>Schnelles Drucken f\u00fcr zu Hause<\/b>\\nDrucken Sie Ihre Dokumente mit einer Geschwindigkeit von ca. 9,2 ISO-Seiten\/Minute in Schwarzwei\u00df und ca. 5,0 ISO-Seiten\/Minute in Farbe. Ein 10 x 15 cm Randlosprint ist in nur ca. 44 Sekunden in klarer Laborqualit\u00e4t gedruckt.*\\n\\n<b>Umfangreiche Anschlussm\u00f6glichkeiten<\/b>\\nDank des integrierten LAN und WLAN k\u00f6nnen Sie sich das System problemlos mit Mehreren teilen. Die App Easy-PhotoPrint erm\u00f6glicht es Ihnen, direkt \u00fcber Ihr WLAN Netz von Ihrem Mobilger\u00e4t zu drucken und sogar Scans an dieses zu senden.\\n\\n<b>Einfach zu verwenden und kompakt<\/b>\\nDank der neuen Frontbedienung k\u00f6nnen Sie nun problemlos von vorne Papier zuf\u00fchren und die 2 Tintenpatronen austauschen. Dadurch kann das Multifunktionssystem nun n\u00e4her an der Wand oder auf einem Regal platziert werden und hilft so, Platz zu sparen.\\n\\n<b>Umweltfreundlich<\/b>\\nVerwenden Sie den Duplexdruck f\u00fcr automatischen beidseitigen Druck, um Ihren Papierverbrauch zu reduzieren und Ihren Beitrag zum Umweltschutz zu leisten, ohne Abstriche bei der Druckqualit\u00e4t zu machen. Mit der Funktion \u201eECO Information\u201c erfahren Sie, wie viel CO2 und Papier Sie durch beidseitigen Druck einsparen. Sparen Sie Strom durch die automatische Stromabschaltung: Stellen Sie den Drucker so ein, dass er sich ausschaltet, wenn er w\u00e4hrend des vorher festgelegten Zeitraums nicht benutzt wird.\\n\\n<b>Intelligente Software<\/b>\\nMit Canons einzigartigem Full HD Movie Print haben Sie dieM\u00f6glichkeit, Ihre sch\u00f6nsten Momente, die Sie mit einer Canon Digitalkamera gefilmt haben, in brillante Fotodrucke zu verwandeln. Zu den neuen Funktionen geh\u00f6ren unter anderem Einzelbilder \u00fcberlagern (Merge Frames) und Layout Print, um noch eindrucksvollere Ausdrucke zu erhalten. Gestalten Sie Ihre Bilder mit Fun Filter-Effekten (z.B. Fischaugeneffekt) sogar noch aufregender mit dem neuen Easy-PhotoPrint EX. Mit Easy-WebPrint EX k\u00f6nnen Sie m\u00fchelos Webseiten aus dem Internet Explorer oder Safari drucken: Kombinieren Sie Ausschnitte von mehreren Webseiten, sodass Sie nur das drucken, was Sie wirklich wollen. Lassen Sie Ihrer Kreativit\u00e4t freien Lauf mit CREATIVE PARK PREMIUM, einem Online-Service, \u00fcber den Sie Fotos, Bilder, Bastelvorlagen und vieles mehr von international anerkannten Fotografen und K\u00fcnstlern herunterladen und drucken k\u00f6nnen.**\\n\\n<b>Brillante Fotos mit hoher Farbstabilit\u00e4t<\/b>\\nChromaLife100 f\u00fcr brillante Fotos mit besonders hoher Farbstabilit\u00e4t Die Kombination aus PIXMA MG3150, Canon Originaltinten und Canon Originalfotopapier sorgt f\u00fcr brillante Fotos mit hoher Farbstabilit\u00e4t, die lange halten.***\\n\\n* Siehe technische Daten\\n** Erfordert Internetanschluss\\n*** Weitere Details finden Sie unter www.canon.de\/chromalife100."},{"locale":"en_US","scope":"print","data":"<b>Excellent quality<\/b>\\nPerfect for first time buyers, students and families, this compact All-In-One is ideal for everyday printing, scanning and copying. Canon\u2019s class leading FINE cartridge system using minimum 2pl ink droplet size combined with a print resolution of up to 4800dpi delivers smooth, virtually grain free photo-lab quality prints and crisp text. Lower your printing cost by using optional XL FINE cartridges.\\n\\n<b>Quick printing for the home<\/b>\\nPrint your documents quickly with ISO ESAT speeds of 9.2 ipm for mono documents and 5.0 ipm for colour. A vivid photo-lab quality 10x15cm borderless print is produced in approximately 44 seconds.\\n\\n<b>Enhanced connectivity<\/b>\\nIn-built Wi-Fi makes it easy to share in the home. Print from and scan directly to mobile devices using the Easy-PhotoPrint App.\\n\\n<b>Easy to use and compact<\/b>\\nBenefiting from the FastFront feature, loading paper and replacing ink can now be done easily from the front and as a result has a more compact design. This allows the All-In-One to be placed closer to the wall or on a shelf - taking up less space.\\n\\n<b>Eco features<\/b>\\nUse Auto Duplex Print for automatic double-sided printing to reduce your paper consumption and help the environment - all without comprising on print quality. With ECO Information you can see your CO2 and paper savings made by double-sided printing. Save energy by using the Auto Power Off - set the printer to switch off, when not being used for a set amount of time.\\n\\n<b>Intelligent software<\/b>\\nTurn your movie moments into beautiful prints with Canon\u2019s unique Full HD Movie Print. New features include Merge Frames and Layout Print to create more striking images. Make your photos even more exciting by applying Fun Filter Effects with Easy-PhotoPrint EX. For easy web printing use Easy-WebPrint EX, combine clips from several web pages so you only print what you need from the web. Get creative with CREATIVE PARK PREMIUM an online service that lets you download photos, illustrations, paper crafts and much more, from internationally recognised photographers & artists.\\n\\n<b>Long lasting, beautiful photos<\/b>\\nThe ChromaLife100 system provides long lasting, beautiful photos. The combination of the PIXMA MG3150, original Canon inks and genuine Canon photo papers preserves memories for a lifetime."},{"locale":"fr_FR","scope":"print","data":"<b>Excellente qualit\u00e9<\/b>\\nDestin\u00e9 aux n\u00e9ophytes, \u00e9tudiants et familles, ce multifonction compact est id\u00e9al pour les impressions, num\u00e9risations et copies du quotidien. Le syst\u00e8me de cartouches FINE de Canon \u00e0 gouttes d'encre de 2 pl minimum et la r\u00e9solution d'impression maximale de 4 800 dpi garantissent des impressions de qualit\u00e9 professionnelle quasiment exemptes de grain et des textes \u00e0 la nettet\u00e9 irr\u00e9prochable. R\u00e9duisez vos co\u00fbts d'impression avec les cartouches XL FINE en option.\\n\\n<b>Impressions rapides \u00e0 la maison<\/b>\\nImprimez rapidement vos documents \u00e0 des vitesses ESAT ISO de 9,2 ipm en noir et blanc et 5 ipm en couleur. Produisez des tirages \u00e9clatants de qualit\u00e9 professionnelle au format 10 x 15 cm sans marge en 44 secondes environ*.\\n\\n<b>Connectivit\u00e9 am\u00e9lior\u00e9e<\/b>\\nLe Wi-Fi int\u00e9gr\u00e9 facilite le partage \u00e0 la maison. Imprimez directement depuis des p\u00e9riph\u00e9riques mobiles et envoyez-leur directement des num\u00e9risations gr\u00e2ce \u00e0 l'application Easy-PhotoPrint.\\n\\n<b>Compact et simple d'utilisation<\/b>\\nGr\u00e2ce au syst\u00e8me FastFront, le chargement du papier et le remplacement de l'encre s'effectuent facilement \u00e0 l'avant de l'appareil, ce qui r\u00e9duit \u00e9galement l'encombrement. Ce design compact permet de placer l'appareil plus pr\u00e8s du mur ou sur une \u00e9tag\u00e8re.\\n\\n<b>Fonctions \u00e9conomiques<\/b>\\nImprimez automatiquement en recto verso pour r\u00e9duire votre consommation de papier et pr\u00e9server l'environnement sans transiger sur la qualit\u00e9 de vos impressions. La fonction ECO Information vous informe des \u00e9conomies de CO2 et de papier r\u00e9alis\u00e9es gr\u00e2ce aux impressions recto verso. \u00c9conomisez de l'\u00e9nergie avec la fonction de mise hors tension automatique : r\u00e9glez le d\u00e9lai de mise hors tension de l'imprimante en cas d'inactivit\u00e9.\\n\\n<b>Des logiciels intelligents<\/b>\\nCr\u00e9ez de magnifiques impressions \u00e0 partir de films avec le logiciel Full HD Movie Print de Canon. Les nouvelles fonctions incluent la fusion des images et l'impression avec mise en page, pour des images encore plus saisissantes. Appliquez des effets de filtre amusants \u00e0 vos photos avec Easy-PhotoPrint EX. Utilisez Easy-WebPrint EX pour combiner des \u00e9l\u00e9ments de plusieurs pages Web, ce qui vous permet d'imprimer seulement ce dont vous avez besoin sur Internet. Exprimez votre cr\u00e9ativit\u00e9 avec CREATIVE PARK PREMIUM, un service en ligne qui vous permet de t\u00e9l\u00e9charger des photos, illustrations, maquettes papier et bien d'autres articles propos\u00e9s par des photographes et artistes de renomm\u00e9e mondiale**.\\n\\n<b>Des photos belles et durables<\/b>\\nLe syst\u00e8me ChromaLife100 garantit des photos d'une beaut\u00e9 et d'une long\u00e9vit\u00e9 extraordinaires. Utilisez avec le multifonction PIXMA MG3150 les encres et les papiers photo Canon d'origine, et vos souvenirs resteront \u00e0 jamais intacts***.\\n\\n* Voir caract\u00e9ristiques.\\n** Connexion Internet n\u00e9cessaire\\n*** Rendez-vous sur www.canon-europe.com\/chromalife100 pour en savoir plus."}],"color_scanning":[{"locale":null,"scope":null,"data":true}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1018d3f5-c5b4-405f-b022-47243db880bb","identifier":"10734346","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"c\/3\/6\/5\/c36537d76a74987c1072471906c3c37b2f64c67a_10734346_1480.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/c\/3\/6\/5\/c36537d76a74987c1072471906c3c37b2f64c67a_10734346_1480.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon Digital IXUS 1100 HS"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Vielseitige Kamera f\u00fcr gestochen scharfe Aufnahmen<\/b>\\nDank 28-mm-Weitwinkelobjektiv mit 12fach optischem Zoom ist die Kamera hervorragend f\u00fcr weit entfernte Motive, Gruppenfotos und Panorama-Landschaften geeignet. Mit 7 Modi passt Intelligent IS den Bildstabilisator automatisch an das Motiv an; das Resultat: minimierte Verwacklungsunsch\u00e4rfe und gestochen scharfe, detailreiche Fotos und Movieclips.\\n\\n<b>HS-System (12,1 Megapixel)<\/b>\\nDas innovative HS-System, die Kombination aus leistungsstarkem DIGIC-4-Bildprozessor und hoch empfindlichem Sensor, sorgt f\u00fcr exzellente Bildqualit\u00e4t in nahezu allen Aufnahmesituationen. Es brilliert besonders bei schwachen Lichtverh\u00e4ltnissen \u2013 ideal, um den Zauber einer Stimmung auch ohne Blitz und Stativ festzuhalten. Die Kombination aus hoch empfindlichem Bildsensor und leistungsstarkem DIGIC-4-Bildprozessor sorgt f\u00fcr exzellente Bildqualit\u00e4t in nahezu allen Situationen.\\n\\n<b>Schlank und elegant<\/b>\\nDie ultrakompakte IXUS 1100 HS ist eine erstklassige Kombination aus schickem Design und innovativerTechnologie, ein attraktiver Begleiter f\u00fcr unterwegs.\\n\\n<b>Bedienung per Fingertipp<\/b>\\nDas gro\u00dfe, hochaufl\u00f6sende 8,0 cm (3,2 Zoll) PureColor II Touch-LCD erm\u00f6glicht per intuitiver Touch-Steuerung die schnelle, einfache Bedienung und komfortable Wiedergabe. Die innovative Steuerung bietet das Fokussieren per Touch AF, Fokussieren und Ausl\u00f6sen per Touch-Ausl\u00f6ser und das individuelle Anlegen der Funktionen.\\n\\n<b>Full-HD-Movies<\/b>\\nIm Moviemodus entstehen 1080p-Full-HD-Movies mit Stereoton; die teilt man gern mit Freunden. Mit dem optischen Zoom kommen Sie ganz nah an das Geschehen heran; dank des optischen Dynamik-Bildstabilisators werden die Movieclips auch dann gestochen scharf, wenn Sie sich w\u00e4hrend des Filmens bewegen oder im Telebereich filmen. \u00dcber eine spezielle Taste wechseln Sie sofort vom Foto- in den Moviemodus; die Kamera ist mit einem HDMI-CEC-Anschluss f\u00fcr die bequeme Wiedergabe auf einem HD-Fernseher ausgestattet.\\n\\n<b>Intelligenter AUTO-Modus (Smart Auto)<\/b>\\nIm intelligenten AUTO-Modus (Smart Auto) entstehen ganz komfortabel hochwertige Fotos oder Movies. 32 Aufnahmesituationen (21 bei Movies) werden unterschieden und automatisch die richtigen Einstellungen ausgew\u00e4hlt. Sie m\u00fcssen nur noch das Motiv anvisieren und ausl\u00f6sen.\\n\\n<b>Highspeed-Serienbilder. Superzeitlupe-Movie<\/b>\\nDie Funktion Highspeed-Serienbilder erm\u00f6glicht die ununterbrochene Aufnahme mit 7,8 Bildern pro Sekunde (bei 3,0 MP), Sie verpassen nichts mehr. Im Super Slow Motion Movie Modus werden Szenen mit schneller Action bei der Wiedergabe auf 1\/8 ihrer eigentlichen Geschwindigkeit reduziert.\\n\\n<b>720p-iFrame-Movie Filmtagebuch<\/b>\\nPC- und Mac-kompatible 720p-HD-Movies filmen Sie im optimierten Apple iFrame-Format \u2013 ideal f\u00fcr den schnellen Import, die m\u00fchelose Bearbeitung und bequeme Weitergabe. Im Modus Filmtagebuch wird vor jedem Foto eine 4 Sekunden lange Moviesequenz in VGA-Qualit\u00e4t aufgenommen; die Movieclips eines Tages k\u00f6nnen zu einem interessanten Bonus-Video zusammengef\u00fcgt werden.\\n\\n<b>Kreativmodi<\/b>\\nEntdecken Sie mit interessanten Aufnahmemodi Ihre kreative Ader. Beispielsweise mit dem Spielzeugkamera-Effekt f\u00fcr einen altmodischen Look, dem Miniatureffekt, der ein Foto oder eine Filmszene wie in einer Miniaturwelt darstellt oder dem Monochrom-Effekt.\\n\\n<b>Hinweise und Tipps<\/b>\\nMit einfachen und auf dem Display einblendbaren Hinweisen und Tipps lernen Sie die Funktionsweise Ihrer Kamera besser verstehen und optimieren Ihre Ergebnisse."},{"locale":"en_US","scope":"print","data":"Canon 1100 HS, Digital IXUS. Megapixel: 12.1, Camera type: Compact, Optical sensor size: 1\/2.3. Focal length range (f-f): 5 - 60, Lens structure (elements\/groups): 14\/12. Focus: TTL, Focus adjustment: Auto, Auto focusing (AF) modes: Face tracking, Single Auto Focus. ISO sensitivity: 100, 200, 400, 800, 1600, 3200, Auto, Light exposure correction: \u00b1 2EV (1\/3EV step), Light metering: Centre-weighted, Spot. Camera shutter type: Electronic"},{"locale":"fr_FR","scope":"print","data":"<b>Versatile, sharp shooting<\/b>\\nA Canon lens that lets you get close with 12x optical zoom, while 28mm wide-angle fits more in the frame for great group shots and sweeping landscapes. Intelligent IS automatically adjusts the optical Image Stabilizer to the scene from 7 modes to prevent blur and deliver sharp, detailed photos and videos.\\n\\n<b>HS System (12.1 MP)<\/b>\\nHS System excels in low light allowing you to capture the real atmosphere of the moment without flash or tripod. A high performance DIGIC 4 processor and high sensitivity sensor combine to give superior image quality in all situations.\\n\\n<b>Slim and stylish<\/b>\\nAn ultra-compact fusion of high-class styling and superb technology you can easily keep in your pocket.\\n\\n<b>Fingertip control<\/b>\\nA large, high-resolution 8.0 cm (3.2\") PureColor II Touch LCD provides intuitive touch control for fast, easy operation and pleasurable playback. Advanced controls include Touch AF to focus the shot, Touch Shutter to focus and trigger the shot and customisable layout of functions.\\n\\n<b>Full HD movies<\/b>\\nCreate Full HD (1080p) movies with stereo sound you'll be proud to share. Use the optical zoom to get close to the action while Powered and Dynamic image stabilisation keep movies steady. A dedicated movie button instantly switches from stills to movie mode; an HDMI-CEC connector allows easy playback on an HDTV.\\n\\n<b>Smart Auto<\/b>\\nEffortlessly shoot high quality photos or movies with Smart Auto, which detects the scene and selects the perfect settings from 32 variables (21 in movie). All you have to do is point and shoot.\\n\\n<b>High-speed Burst. Super Slow Motion Movie<\/b>\\nHigh-speed Burst delivers non-stop photo shooting, capturing 7.8 shots per second (3.0 MP), so you never miss a thing. Super Slow Motion Movie slows fast-paced action to 1\/8th of the real speed.\\n\\n<b>iFrame movie (720p). Movie Digest<\/b>\\nShoot PC and Mac friendly HD video (720p) in the optimised Apple iFrame format for fast importing, easy editing and simple sharing. Movie Digest records up to 4-seconds of action before each still shot, joining the day\u2019s clips into a bonus VGA movie.\\n\\n<b>Creative modes<\/b>\\nExplore your creativity with fun shooting modes. Effects include Toy Camera for an older style camera look, Miniature to transform a photo or movie scene into a scale model and Monochrome.\\n\\n<b>Hints & Tips<\/b>\\nSimple Hints & Tips interface messages offer step-by-step menu guidance making it easy to understand camera features and settings."}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-27T00:00:00+00:00"}],"optical_zoom":[{"locale":null,"scope":null,"data":12}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"999158f9-bc26-427e-9c64-89c0d3b6e1ec","identifier":"10734920","enabled":true,"family":"laser_led_printers","categories":["canon","laser_led_printers","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"215_x_355_mm"}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS LBP7018C"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Stylish, space-saving design<\/b>\\nThe compact design of the i-SENSYS LBP7018C and its quiet operation make it the ideal desktop printer for small or home office use. Small in size and responsive, this affordable laser printer offers exceptional quality colour printing.\\n\\n<b>Quick to print<\/b>\\nThere\u2019s no waiting around when you want to print, with Canon\u2019s Quick First-Print technologies. Printing at up to 16 ppm in mono and 4 ppm in colour, it has a mono First Print Out Time of just 13.6 seconds \u2013 so there\u2019s minimal delay in initial output.\\n\\n<b>Brilliant output \u2013 in colour and black-and-white<\/b>\\nMake your mark with great quality prints. With up to 2400 x 600 dpi print resolution you\u2019ll notice the improved detail, sharp, crisp text and smooth grey scales. Canon\u2019s superior image processing and innovative S-Toner ensure the finest quality colour output.\\n\\n<b>Reduce costs with low energy consumption<\/b>\\nThe superior energy efficiency of the i-SENSYS LBP7018C will help save you money and lower the cost of ownership, as well as reduce your carbon footprint. As part of Canon\u2019s commitment to providing the most eco-friendly products possible, this colour laser printer is Energy Star certified. It has a Typical Electricity Consumption (TEC) rating of just 0.5 kWh and in sleep mode it consumes as little as 1.1 watts, making it one of the most efficient printers in its class.\\n\\n<b>Easy to use and run<\/b>\\nThis printer is exceptionally simple to set up and operate. The toner cartridges are easy to replace and special noise reduction features make for a quieter, more pleasant working environment, so you are free to concentrate on your business. You have the peace of mind that the user-friendly Canon CAPT printer driver will save you time and deliver outstanding colour output."},{"locale":"fr_FR","scope":"print","data":"<b>Design \u00e9l\u00e9gant et peu encombrant<\/b>\\nGr\u00e2ce \u00e0 son design compact et son fonctionnement silencieux, l'imprimante de bureau i-SENSYS LBP7018C est id\u00e9ale pour les travailleurs ind\u00e9pendants et les petites entreprises. De petite taille et r\u00e9active, cette imprimante laser au prix abordable offre une qualit\u00e9 d'impression couleur exceptionnelle.\\n\\n<b>Impression rapide<\/b>\\nAvec la technologie Canon \u00ab Quick First Print \u00bb (premi\u00e8re impression rapide), fini le temps d'attente avant impression. Imprimant jusqu'\u00e0 16 ppm en noir et 4 ppm en couleur, elle a un temps de sortie de la premi\u00e8re impression en noir de seulement 13,6 secondes ; l'attente avant la premi\u00e8re impression est ainsi minimale.\\n\\n<b>Excellent r\u00e9sultat en couleur et en noir et blanc<\/b>\\nObtenez des tirages de qualit\u00e9 exceptionnelle. Avec une r\u00e9solution d'impression allant jusqu'\u00e0 2 400 x 600 dpi, vous remarquerez l'am\u00e9lioration au niveau des d\u00e9tails, la nettet\u00e9 du texte et la fluidit\u00e9 des niveaux de gris. Le traitement sup\u00e9rieur de l'image de Canon et son toner de type \u00ab S \u00bb garantissent des impressions couleur d'une qualit\u00e9 sup\u00e9rieure.\\n\\n<b>R\u00e9duction des co\u00fbts gr\u00e2ce \u00e0 la faible consommation d'\u00e9nergie<\/b>\\nL'efficacit\u00e9 \u00e9nerg\u00e9tique sup\u00e9rieure de l'imprimante i-SENSYS LBP7018C vous permet d'\u00e9conomiser de l'argent et de diminuer le co\u00fbt global. Elle vous permet en outre de diminuer vos \u00e9missions de dioxyde de carbone. Dans le cadre de l'engagement de Canon \u00e0 proposer les produits les plus \u00e9cologiques possible, cette imprimante laser couleur est homologu\u00e9e Energy Star. Sa consommation \u00e9lectrique typique (TEC) est de seulement 0,5 kWh ; en mode veille, elle ne consomme que 1,1 watt, ce qui en fait l'une des imprimantes les plus \u00e9conomes de sa cat\u00e9gorie.\\n\\n<b>Facile \u00e0 utiliser<\/b>\\nCette imprimante est extraordinairement facile \u00e0 configurer et \u00e0 utiliser. Les cartouches de toner sont faciles \u00e0 remplacer et des fonctions avanc\u00e9es de r\u00e9duction du bruit rendent le lieu de travail plus silencieux et plus agr\u00e9able. Vous pouvez ainsi vous concentrer pleinement sur votre travail. Vous avez l'assurance que le tr\u00e8s convivial pilote d'imprimante Canon CAPT vous fera gagner du temps et vous permettra d'obtenir des impressions couleur exceptionnelles."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6ea11c42-4c30-4727-85c8-4d00d75cc617","identifier":"10738335","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","ngs"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"9\/4\/7\/5\/9475b16be153f31adb01253a3a6202039bea08bf_10738335_5132.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/4\/7\/5\/9475b16be153f31adb01253a3a6202039bea08bf_10738335_5132.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"NGS Silver Rook 2.0"}],"description":[{"locale":"en_US","scope":"print","data":"This handy and excellent quality sound system 2.0 includes headphone and microphone. It includes volume control and headphone front output. Perfect to enjoy music or games, it is also suitable for internet phone calls and voice recognition software.\\n\\n<b>Technical specifications:<\/b>\\n- Speaker\\n- Volume Control\\n- Headphone output\\n- Input: 230V 50Hz\\n- Output: 9V\/0,2 A\\n- Frequency response: 200Hz~20KHz\\n- Impedance: 4 ohms\\n\\n<b>Headphone<\/b>\\n- Frequency response: 20Hz~20KHz\\n- Impedance: 32 ohms\/1KHz\\n- Sensitivity: 105DB\/nW\u00b12dB\\n- Max. input power: 100MW\\n\\n<b>Microphone<\/b>\\nsitivity: 9x7\/-58\u00b13dB"},{"locale":"fr_FR","scope":"print","data":"Syst\u00e8me de son 2.0 d\u00b4une qualit\u00e8 excellente, tr\u00e8s pratique,il inclut des \u00e8couteurs avec un micro. Dispose d\u00b4un contr\u00f4le de volume et d\u00b4une prise pour \u00e9couteurs sur sa fa\u00e7ade. Parfait pour profiter de votre musique ou de vos jeux, il permet \u00e9galement d\u00b4effectuer des appels t\u00e9l\u00e9phoniques et d\u00b4utiliser des logiciels de reconnaissance vocale.\\n\\n<b>Caract\u00e9ristiques techniques :<\/b>\\n- Haut-parleur :\\n- Puissance de sortie : 2 W\\n- Contr\u00f4le de volume\\n- Prise casque\\n- Entr\u00e9e : 230 V \/ 50 Hz\\n- Bande passante : 200Hz - 20KHz\\n- Imp\u00e9dance : 4\\n- Casque :\\n- Bande passante : 20Hz - 20KHz\\n- Imp\u00e9dance : 32\\n- Sensibilit\u00e9 : 105dB\/nW +\/- 2dB\\n- Puissance maximale : 100 mW\\n- Micro :\\n- Bande passante : 20Hz - 20KHz\\n- Imp\u00e9dance : 2.2K\\n- Sensibilit\u00e9 : -58 +\/- 3dB"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"376b7fd7-a3e5-4481-a72e-9fb0548dd9fa","identifier":"107406","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print","scan"]}],"picture":[{"locale":null,"scope":null,"data":"1\/3\/9\/8\/1398c198e267dec482f3d66a2531bfa23a73b8e7_107406_9841.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/1\/3\/9\/8\/1398c198e267dec482f3d66a2531bfa23a73b8e7_107406_9841.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon Smartbase MP370 Inkjet 18ppm Zwart 12ppm Kleur 4800X1200dpi Printreso"}],"power_requirements":[{"locale":null,"scope":null,"data":"AC 200-240V 50-60Hz"}],"description":[{"locale":"en_US","scope":"print","data":"Easy direct photo printing, delivering professional quality images Enjoy fast and easy home photo printing, without the need for a PC. Providing high quality prints, using either camera direct printing or card direct printing with a convenient photo index sheet.\\n-Digital Photo All-in-One .\\n-Professional photo quality .\\n-Advanced MicroFine Droplet Technology\u2122 .\\n-Camera & Card direct printing .\\n-Easy Photo Index Sheet .\\n-Borderless printing\/copying. \\n-Fast print\/copy speed .\\n-USB 2.0 Hi-Speed interface  ."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2005-07-15T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"8.0000","unit":"KILOGRAM"}}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"cac7a462-2d6c-4353-ae9f-592bfc874218","identifier":"10772282","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","print_scan_sales","ricoh"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"picture":[{"locale":null,"scope":null,"data":"0\/7\/c\/e\/07ce2ec709ee48a6cb374585ec3c7709baf6ddb6_10772282_8764.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/0\/7\/c\/e\/07ce2ec709ee48a6cb374585ec3c7709baf6ddb6_10772282_8764.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Ricoh Aficio GX e5550N"}],"description":[{"locale":"en_US","scope":"print","data":"Optimise your business communication with the Aficio\u2122GX e5550N. Using Ricoh\u2019s unique ECOnomy Color, colour documents cost virtually the same as black and white. Ricoh\u2019s latest GelSprinter\u2122 is a high-performance colour printer for small workgroups and small offices. It can easily be added to your network. Environmentally-friendly features like low power consumption and duplexing contribute to its low overall cost."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-29T00:00:00+00:00"}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"321a94f9-1159-42bb-8380-2e17d12b8a50","identifier":"1077546","enabled":true,"family":"webcams","categories":["cameras_sales","d_link","webcams"],"groups":[],"parent":null,"values":{"maximum_video_resolution":[{"locale":null,"scope":null,"data":"320_x_240"}],"picture":[{"locale":null,"scope":null,"data":"9\/8\/8\/d\/988d8aacc74c601abc1d384dbb9a1fa9c97a25fa_1077546_3927.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/8\/8\/d\/988d8aacc74c601abc1d384dbb9a1fa9c97a25fa_1077546_3927.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"D-Link DCS-5300 webcam"}],"description":[{"locale":"en_US","scope":"print","data":"Remotely watch and listen with the D-Link Securicam NetworkTM DCS-5300 Internet Camera. The DCS-5300 Internet Camera is a full-featured surveillance system that connects to an Ethernet or Fast Ethernet connection to provide high quality video and audio over the Intranet or the Internet.\\n\\nThe DCS-5300 Internet Camera differs from a conventional PC Camera because the DCS-5300 is a stand-alone device with a built-in CPU and Web server that allows you to access your camera using Internet Explorer 5.X or above from anywhere in the world.\\n\\nThe D-Link DCS-5300 Internet Camera also has a pan, tilt, and digital zoom function that can be controlled from the Web interface or from the included remote control. Auto pan mode enables the camera to move 270 degrees horizontally and the Patrol mode cycles through up to 20 preset positions. The speed of either pan or tilt can be adjusted to your preference. The 4x digital zoom lens enables the camera to obtain a closer view.\\n\\nThe D-Link DCS-5300 Internet Camera comes with a CCD sensor that provides a sharp and clear image with life-like color representation. The sensor is a CCD sensor with resolution of 380 TV lines. The built-in microphone adds sound that accompanies the video. Altogether, you can record streaming video with sound that utilizes high quality MPEG4 Short Header Mode Compression to your hard drive, enable motion detection, and set up automated e-mail alert notification.\\n\\nA powerful surveillance software is included to enhance the monitoring and management of your DCS-5300. The bundled surveillance software further enhances the security features of the DCS-5300, allowing you to archive streaming video and audio straight to your hard drive, playback video, monitor as many as 16 cameras on a single screen, and set up motion detection to trigger automatic recording.\\n\\nBy signing up with one of the many Dynamic DNS services, you can assign an easy-to-remember name and domain (e.g. www.mycamera.myddns.com). This allows you to remotely access your camera without having to remember the IP address, even if it has been changed by your Internet Service Provider.\\n\\nThe DCS-5300 Internet Camera is a Price\/Performance breakthrough, feature rich solution capable of meeting demanding security and home\/office monitoring needs. Secure your site with the D-Link Securicam DCS-5300 Internet Camera."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2007-08-09T00:00:00+00:00"}],"maximum_frame_rate":[{"locale":null,"scope":null,"data":30}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"e39ef79e-986c-435d-8954-3a7e704ebebc","identifier":"1077553","enabled":true,"family":"webcams","categories":["cameras_sales","d_link","webcams"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"7\/6\/6\/d\/766d257bdaf0824f0d20d2b924c74cb6bc8b86d4_1077553_5275.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/7\/6\/6\/d\/766d257bdaf0824f0d20d2b924c74cb6bc8b86d4_1077553_5275.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"D-Link 10\/100TX Fast Ethernet 2-Way Audio Internet Camera"}],"description":[{"locale":"en_US","scope":"print","data":"D-Link is pleased to introduce the latest product in Internet camera technology. The D-Link SECURICAM Network\u2122 DCS-3220 Internet Camera is a full-featured surveillance system that connects to an Ethernet broadband network to provide remote high-quality video and audio.\\n\\nYou can access and control the DCS-3220 Internet Camera using Internet Explorer version 6. Watch and listen remotely as the DCS-3220 captures both sound and video of your site.\\n\\nThe DCS-3220 Internet Camera takes surveillance to another level using 2-way audio1. By adding a powered speaker to the DCS-3220, you can now remotely talk to anyone at your camera site.\\n\\nThe DCS-3220 uses a CCD sensor that provides sharp video images with lifelike color representation. It also features 4x digital zoom2 for close-up viewing using the Web interface. Plus, with low light sensitivity, it has the capability to monitor and record video in rooms with minimal lighting, making it ideal to use at night.\\n\\nThe DCS-3220 Internet Camera adheres to the Universal Plug & Play (UPnP\u2122) specification which allows computers running Windows\u00ae XP\/Me to automatically recognize the DCS-3220 and add it to the network. The DCS-3220 can be accessed and viewed from \u201cMy Network Places\u201d as a device on the network.\\n\\nBy signing up with one of the many free Dynamic DNS services available on the Web, you can assign an easy-to-remember name and domain to the camera (e.g. www.mycamera.myddns.com). This allows you to remotely access your camera without having to remember the IP address, even if it has been changed by your Internet Service Provider.\\n\\nEverything needed to get started is included with the DCS-3220 Internet Camera. Simple installation procedures, along with the built-in Web-based interface offer easy integration into your network environment. Powerful surveillance software is included to enhance the monitoring and management of the DCS-3220, allowing you to archive video straight to the hard drive, playback video, monitor as many as 16 cameras on a single screen, and set up motion detection to trigger video\/audio recording and e-mail alerts. The DCS-3220 is a cost-effective and versatile security solution for your home or business.\\n\\n<i>1- 2-way audio requires a powered speaker to be connected to the camera (not included).\\n2- 4x digital zoom enlarges an image by magnifying the pixels in a selected portion of the image by 4 times.<\/i>"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2007-08-09T00:00:00+00:00"}],"maximum_frame_rate":[{"locale":null,"scope":null,"data":30}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"92560abc-8d46-4051-b586-a8d05f3c759b","identifier":"10776151","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"b\/5\/f\/3\/b5f381540beef0136d07b8837dadf9f03e7503ae_10776151_5360.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/5\/f\/3\/b5f381540beef0136d07b8837dadf9f03e7503ae_10776151_5360.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon Digital IXUS 230 HS"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"With an 8x zoom lens, Full HD and the low-light skills of the HS System, the fashionably slim IXUS 230 HS is the perfect partner for nights out. Smart Auto lets you focus on living life to the full.\\n\\n<b>Features<\/b>\\n\\n- 8x zoom, 28mm wide lens. Intelligent IS\\n- HS System (12.1 MP)\\n- Smart, thin metal body\\n- 7.5 cm (3.0\") PureColor II G LCD\\n- Full HD, Powered IS\\n- Smart Auto (32 scenes)\\n- High-speed Burst & Super Slow Motion Movie\\n- iFrame movie. Movie Digest\\n- Creative modes\\n- Hints & Tips\\n\\n<b>Zoom into life<\/b>\\n\\n\\n<b>Sharp, versatile, intelligent<\/b>\\nA powerful 8x optical zoom lets you home in on details of far away objects or fit more in the frame with the 28mm wide-angle lens for great group shots and landscapes. Intelligent IS automatically adjusts the optical Image Stabilizer to the scene from 7 modes to prevent blur and deliver sharp and detailed photos and videos.\\n\\n<b>HS System<\/b>\\nHS System excels in low light allowing you to capture the real atmosphere of the moment without flash or tripod. A high performance DIGIC 4 processor and high sensitivity sensor combine to give superior image quality in all situations.\\n\\n<b>Smart and compact<\/b>\\nOne of the slimmest 8x zoom cameras available, the IXUS 230 HS has a compact, elegant metal body that\u2019s small enough to carry in your pocket.\\n\\n<b>7.5 cm (3.0\") PureColor II G LCD<\/b>\\nA large, high quality 460k dot LCD screen allows easy framing and reviewing of images from any angle and effortless menu navigation. A tempered glass outer layer gives excellent durability.\\n\\n<b>Full HD movies, Powered IS<\/b>\\nCreate Full HD (1080p) movies with stereo sound you\u2019ll be proud to share. Use the optical zoom to get close to the action while the optical Image Stabilizer keeps your movies steady. A dedicated movie button lets you switch instantly from stills to movie mode; an HDMI-CEC connector allows easy playback on an HDTV.\\n\\n<b>Smart Auto<\/b>\\nEffortlessly shoot high quality photos or movies with Smart Auto, which detects the scene and selects the perfect settings from 32 variables (21 in movie). All you have to do is point and shoot.\\n\\n<b>High-speed Burst. Super Slow Motion Movie<\/b>\\nHigh-speed Burst delivers non-stop photo shooting, capturing 8.7 shots per second (3.0 MP), so you never miss a thing. Super Slow Motion Movie slows fast-paced action up to an 1\/8th of the real speed.\\n\\n<b>iFrame movie (720p). Movie Digest<\/b>\\nShoot PC and Mac friendly HD video (720p) in the optimised Apple iFrame format for fast importing, easy editing and simple sharing. Movie Digest records up to 4-seconds of action before each still shot, joining the day\u2019s clips into a bonus VGA movie.\\n\\n<b>Creative modes<\/b>\\nExplore your creativity with fun shooting modes. Effects include Toy Camera for an older style camera look, Miniature to transform a photo or movie scene into a scale model and Monochrome.\\n\\n<b>Hints & Tips<\/b>\\nSimple Hints & Tips interface messages offer step-by-step menu guidance making it easy to understand camera features and settings."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-30T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"optical_zoom":[{"locale":null,"scope":null,"data":8}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"63e3b1ca-3306-4335-87c4-2b8f181e3744","identifier":"10776961","enabled":true,"family":"laser_led_printers","categories":["canon","laser_led_printers","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"picture":[{"locale":null,"scope":null,"data":"e\/c\/f\/2\/ecf2927738be42344052daab2d7287a2ad34894c_10776961_4029.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/e\/c\/f\/2\/ecf2927738be42344052daab2d7287a2ad34894c_10776961_4029.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS LBP7018C"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Canon i-SENSYS LBP7018C<\/b>\\n\\n<b>Colour laser printing for your home office.<\/b>\\n\\nThe smallest and most affordable colour laser printer from Canon. This easy-to- use colour laser printer delivers uncompromising quality and unrivalled energy efficiency.\\n\\n<b>Benefits<\/b>\\n\\n-Space-saving design\\n-4 ppm colour and 16 ppm mono laser printing\\n-Quick First-Print technologies\\n-Energy efficient\\n-2400 x 600 dpi print resolution\\n-Easy toner cartridge replacement\\n\\n<b>Detailed Features<\/b>\\n<b>Stylish, space-saving design<\/b>\\n\\nThe compact design of the i-SENSYS LBP7018C and its quiet operation make it the ideal desktop printer for small or home office use. Small in size and responsive, this affordable laser printer offers exceptional quality colour printing.\\n\\n<b>Quick to print<\/b>\\n\\nThere\u2019s no waiting around when you want to print, with Canon\u2019s Quick First-Print technologies. Printing at up to 16 ppm in mono and 4 ppm in colour, it has a mono First Print Out Time of just 13.6 seconds \u2013 so there\u2019s minimal delay in initial output.\\n\\n<b>Brilliant output \u2013 in colour and black-and-white<\/b>\\n\\nMake your mark with great quality prints. With up to 2400 x 600 dpi print resolution you\u2019ll notice the improved detail, sharp, crisp text and smooth grey scales. Canon\u2019s superior image processing and innovative S-Toner ensure the finest quality colour output.\\n\\n<b>Reduce costs with low energy consumption<\/b>\\n\\nThe superior energy efficiency of the i-SENSYS LBP7018C will help save you money and lower the cost of ownership, as well as reduce your carbon footprint. As part of Canon\u2019s commitment to providing the most eco-friendly products possible, this colour laser printer is Energy Star certified. It has a Typical Electricity Consumption (TEC) rating of just 0.5 kWh and in sleep mode it consumes as little as 1.1 watts, making it one of the most efficient printers in its class.\\n\\n<b>Easy to use and run<\/b>\\n\\nThis printer is exceptionally simple to set up and operate. The toner cartridges are easy to replace and special noise reduction features make for a quieter, more pleasant working environment, so you are free to concentrate on your business. You have the peace of mind that the user-friendly Canon CAPT printer driver will save you time and deliver outstanding colour output."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-08-30T00:00:00+00:00"}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c212fe6d-6f85-4817-aa4c-3254c40ef1c2","identifier":"10791984","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print","scan"]}],"picture":[{"locale":null,"scope":null,"data":"8\/6\/0\/c\/860ca6d1d3afed06b4ceca0ab5955ac6438b1dbc_10791984_6878.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/8\/6\/0\/c\/860ca6d1d3afed06b4ceca0ab5955ac6438b1dbc_10791984_6878.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon PIXMA MG5350"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Advanced photolab quality for the home<\/b>\\nThe ideal 5 ink All-in-One for those who enjoy powerful features and high quality printing. Canon's class leading FINE print head technology, with a minimum of 1pl ink droplets, delivers up to 9600dpi print resolution for amazing photos with smooth gradations and grain-free monochrome images. A photo-lab quality 10x15cm borderless print is produced in approximately 20 seconds and exceptional ISO ESAT speeds of 12.5 ipm for mono documents and 9.3 ipm for colour.\\n\\n<b>Simple Operation<\/b>\\nThe centralised operation panel with 7.5cm colour TFT display delivers an intuitive user experience and with Quick Operation, features can be accessed effortlessly.\\n\\n<b>Stylish design<\/b>\\nCompact and sleek all black finish, this device fits neatly in any home.\\n\\n<b>Enhanced connectivity<\/b>\\nIn-built Wi-Fi makes it easy to share in the home. Print from and scan directly to mobile devices using the Easy-PhotoPrint App.\\n\\n<b>Cloud printing<\/b>\\nBrowse and print your favourite photos directly to the printer from online albums at CANON iMAGE GATEWAY** & Google\u2019s Picasa. Access on demand calendars, stationery and other templates without a need of a PC.\\n\\n<b>Versatile media handling<\/b>\\nExperience versatility with Auto Duplex Print to use both sides of the paper, 2-way paper feed lets you load photo & plain paper at the same time. Print directly onto compatible CDs, DVDs and Blu-ray\u00ae discs with Direct Disc Print.\\n\\n<b>Eco features<\/b>\\nFind out your CO2 and paper savings made by double-sided printing with ECO Information to see how you are helping the environment. Save energy by using the Auto Power Off - set the printer to switch off, when not being used for a set amount of time.\\n\\n<b>Advanced Software<\/b>\\nTurn your movie moments into beautiful prints with Canon\u2019s unique Full HD Movie Print. New features include Merge Frames and Layout Print to create more striking images. Make your photos even more exciting by applying Fun Filter Effects with Easy-PhotoPrint EX. Use Easy-WebPrint EX to combine clips from several web pages so you only print what you need from the web. Get creative with CREATIVE PARK PREMIUM an online service that lets you download photos, illustrations, paper crafts and much more, from internationally recognised photographers & artists."},{"locale":"fr_FR","scope":"print","data":"Le PIXMA MG5350 est un multifonction photo avanc\u00e9 avec 5 r\u00e9servoirs d'encre individuels, connexion Wi-Fi et impression recto verso automatique. L'interface intuitive dot\u00e9e du syst\u00e8me Quick Operation et l'\u00e9cran TFT de 7,5 cm permettent d'acc\u00e9der rapidement \u00e0 la fonction souhait\u00e9e.\\n\\n<b>Caract\u00e9ristiques<\/b>\\n\\n- Multifonction avanc\u00e9\\n- Syst\u00e8me Quick Operation\\n- 5 r\u00e9servoirs d'encre individuels, r\u00e9solution jusqu'\u00e0 9600 dpi, 1 pl minimum\\n- Vitesse ESAT ISO de 12,5 ipm en noir et blanc\/9,3 ipm en couleur\\n- Photo 10 \u00d7 15 cm en 20 secondes environ\\n- Wi-Fi\\n- Recto verso automatique et impression directe sur disques\\n- Full HD Movie Print\\n- PIXMA Cloud Link\\n\\nMultifonction photo haute qualit\u00e9 extr\u00eamement polyvalent avec connexion Wi-Fi, id\u00e9al pour une utilisation \u00e0 la maison\\n\\n<b>La qualit\u00e9 professionnelle \u00e0 la maison<\/b>\\nCe multifonction \u00e0 5 r\u00e9servoirs d'encre est id\u00e9al pour ceux qui souhaitent b\u00e9n\u00e9ficier de fonctionnalit\u00e9s avanc\u00e9es et d'une qualit\u00e9 d'impression \u00e9lev\u00e9e. Avec ses gouttelettes d'encre de 1 pl minimum, la technologie de t\u00eates d'impression FINE de Canon assure une r\u00e9solution d'impression maximale de 9600 dpi, pour des photos exceptionnelles au d\u00e9grad\u00e9 irr\u00e9prochable et des images noir et blanc exemptes de grain. Obtenez des tirages de qualit\u00e9 professionnelle au format 10 \u00d7 15 cm sans marge en 20 secondes environ gr\u00e2ce aux impressionnantes vitesses ESAT ISO de 12,5 ipm en noir et blanc et 9,3 ipm en couleur*.\\n\\n<b>Fonctionnement simple<\/b>\\nDot\u00e9 d'un \u00e9cran TFT couleur de 7,5 cm, le panneau de commande centralis\u00e9 est tr\u00e8s intuitif. Gr\u00e2ce \u00e0 son syst\u00e8me Quick Operation, vous acc\u00e9dez rapidement \u00e0 la fonction souhait\u00e9e.\\n\\n<b>Design sophistiqu\u00e9<\/b>\\nCompact et b\u00e9n\u00e9ficiant d'une \u00e9l\u00e9gante finition noire, cet appareil saura trouver sa place dans votre int\u00e9rieur.\\n\\n<b>Connectivit\u00e9 am\u00e9lior\u00e9e<\/b>\\nLe Wi-Fi int\u00e9gr\u00e9 facilite le partage \u00e0 la maison. Imprimez directement depuis des p\u00e9riph\u00e9riques mobiles et envoyez-leur directement des num\u00e9risations gr\u00e2ce \u00e0 l'application Easy-PhotoPrint. La prise en charge d'Apple AirPrint* vous permet d'imprimer directement depuis votre iPad ou votre iPhone.\\n\\n<b>Impression en cloud<\/b>\\nParcourez les photos pr\u00e9f\u00e9r\u00e9es de vos albums en ligne sur CANON iMAGE GATEWAY** et Google Picasa et envoyez-les directement sur l'imprimante. Acc\u00e9dez \u00e0 des calendriers, articles de papeterie et autres mod\u00e8les \u00e0 la demande sans ordinateur***.\\n\\n<b>Gestion des supports polyvalente<\/b>\\nProfitez de la polyvalence avec l'impression recto verso automatique, pour imprimer les deux faces d'une feuille, et la double alimentation papier, qui vous permet de charger du papier standard et photo en m\u00eame temps. Imprimez directement sur des CD, DVD et Blu-ray\u00ae compatibles avec l'impression directe sur disques.\\n\\n<b>Fonctions \u00e9conomiques<\/b>\\nLa fonction ECO Information vous informe sur les \u00e9conomies de CO2 et de papier r\u00e9alis\u00e9es via l'impression recto verso. \u00c9conomisez de l'\u00e9nergie avec la fonction de mise hors tension automatique : r\u00e9glez le d\u00e9lai de mise hors tension de l'imprimante en cas d'inactivit\u00e9.\\n\\n<b>Logiciels avanc\u00e9s<\/b>\\nCr\u00e9ez de magnifiques impressions \u00e0 partir de films avec le logiciel Full HD Movie Print de Canon. Les nouvelles fonctions incluent la fusion des images et l'impression avec mise en page, pour des images encore plus saisissantes. Appliquez des effets de filtre amusants \u00e0 vos photos avec Easy-PhotoPrint EX. Utilisez Easy-WebPrint EX pour combiner des \u00e9l\u00e9ments de plusieurs pages Web, ce qui vous permet d'imprimer seulement ce dont vous avez besoin sur Internet. Exprimez votre cr\u00e9ativit\u00e9 avec CREATIVE PARK PREMIUM, un service en ligne qui vous permet de t\u00e9l\u00e9charger des photos, illustrations, maquettes papier et bien d'autres articles propos\u00e9s par des photographes et artistes de renomm\u00e9e mondiale***.\\n\\n* Voir caract\u00e9ristiques.\\n** Selon disponibilit\u00e9.\\n*** Connexion Internet n\u00e9cessaire."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-01T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"de05f0db-b3c8-44f4-9317-0aaf4c6aa2c8","identifier":"10794815","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","samsung"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"9\/f\/a\/f\/9faf62f279f721d7de82a3fbec127afa5ecd906e_10794815_5420.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/9\/f\/a\/f\/9faf62f279f721d7de82a3fbec127afa5ecd906e_10794815_5420.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Samsung NX 100"}],"power_requirements":[{"locale":null,"scope":null,"data":"100 - 240V"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Stunning photos in seconds<\/b>\\nGetting great pictures has never been easier thanks to the NX100's i-Function lens. That\u2019s because NX100\u2019s built-in i-Scene mode allows your camera to automatically recognize what type of lens has been attached, and suggests which kind of scene a particular lens type is best-suited for\u2014simply select and choose the scene you like, and your camera is optimized to take the perfect shot. Additionally, with the i-Function Lens and its convenient i-Function button, you can easily change composition parameters (ISO, shutter speed, aperture, EV, WB) adjusting for ideal exposure settings in any type of shooting situation.\\n\\n<b>Snap stunning photos in style<\/b>\\nThe Samsung NX100 incorporates innovative design, advanced features and professional quality into a compact form. DSLR cameras typically offer the highest level of performance available but tend to be bulky and cumbersome in design. The Samsung NX100\u2019s sleek, leaf-like design revolutionizes the traditional camera with a compact form. Typically, DSLR cameras require more space between the lens and CMOS sensor (flangeback size). Thanks to the reduced flangeback size as well as the Live View System which eliminates the need for a space-consuming pentaprism, the NX100 is small, slim, and compact\u2014but still delivers professional results. Also, you\u2019ll see how easy and comfortable it is to hold NX100 with its curved sides and smooth exterior finish. The NX100 goes wherever you go for professional, high-quality photos that you never thought were possible from a camera that fits in your pocket or purse.\\n\\n<b>Super large image sensor offers utmost image quality and rich natural colors<\/b>\\nThe Samsung NX100 is equipped with a super large APS-C size CMOS sensor that reproduces rich and natural colors for exquisitely clear images even in low light settings."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-02T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6231f716-fc71-427d-92ed-f75081f910ca","identifier":"10795247","enabled":true,"family":"pc_monitors","categories":["pc_monitors","samsung","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Samsung S24A450BW-1"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Conveniently Adjust Monitor Height, Tilt and Perspective<\/b>\\nConveniently Adjust Monitor Height, Tilt and Perspective The Samsung LED Business Monitor SA450 has been designed to help boost work efficiency, delivering a tailored experience with its choice of viewer settings. The height-adjustable stand ensures that the screen can always be set at the optimal eye level, which enhances the visual experience while also helping maintain the viewer's body posture. Other features include the tilt and pivot capabilities, which not only increase comfort levels but also introduce new ways of working. The SA450 Monitor can rotate 90\u00b0 degrees, allowing for more appropriate view depending on the work. So, now you can take convenience and efficiency to amazing heights with the Samsung LED Business Monitor SA450.\\n\\n<b>Maximize Workspace with an Efficient Detachable Adaptor<\/b>\\nIf you need a work monitor that uses office space efficiently, then Samsung LED Business Monitor SA450 is the perfect choice. It features an innovative new detachable adaptor which allows the monitor to be easily moved and installed. From physically moving the monitor with the carrying handle to quickly installing, the SA450 is ready to deliver an efficient and clean work space. the SA450 is also equipped and prepared for your as a VESA Wall mount, providing a multi-screen or wall mounted monitor. Optimizing your office space is now easily achieved with the Samsung LED Business Monitor SA450.\\n\\n<b>Enjoy Energy Savings with the Lightweight LED Display<\/b>\\nSamsung\u2019s lightweight LED Business Monitor SA450 provides another energy saving option through its low consumption levels. This reduction in energy helps both financial and environmental aspects of the business, and is an important part of any work operation. The LED Business Monitor SA450 is also remarkably lightweight and reduces the hassles associated with transporting monitors, and is just one more way that Samsung is helping enhance the working environment.\\n\\n<b>Go Green with Samsung's Adaptor On Off 0W<\/b>\\nThe ultimate energy saving measure has been created by Samsung with the new Adaptor On Of mode. By simply flicking the mechanical switch found on the Samsung LED Business monitor SA450, you can cut energy output while not using the monitor down to an amazing 0 Watts. Conventional standby modes reduce energy output to about 1 Watt, but the SA450 goes one stop further for greater results. This helps minimizes both environmental impact and operating costs, and is just one more step by Samsung in creating a greener environment."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-02T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"d1f83b61-db8b-461c-b4c9-3c35257d39b8","identifier":"10806720","enabled":true,"family":"multifunctionals","categories":["hp","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["print","scan"]}],"name":[{"locale":null,"scope":null,"data":"HP Photosmart 5515 e-All-in-One"}],"description":[{"locale":"de_DE","scope":"print","data":"Drucken Sie Fotos in Laborqualit\u00e4t, beidseitige Dokumente und Webinhalte mit diesem HP e-All-in-One mit benutzerfreundlichem Touchscreen. Sie k\u00f6nnen alle gew\u00fcnschten Dokumente drucken \u2013 \u00fcber ein drahtloses Netzwerk oder mit HP ePrint f\u00fcr mobiles Drucken.\\n\\n<b>Funktionen<\/b>\\n\\n<b>Benutzerfreundliches, mobiles und kabelloses Drucken mit HP ePrint und HP Auto Wireless Connect.<\/b>\\n- Dokumente lassen sich einfach drucken und weiterleiten \u2013 stellen Sie mit HP Auto Wireless Connect eine Verbindung zu Ihrem kabellosen Netzwerk her.\\n- Entdecken Sie die Vorteile des mobilen Druckens mit HP ePrint \u2013 von nun an k\u00f6nnen Sie von praktisch \u00fcberall aus drucken.\\n- Drucken Sie E-Mails, Fotos, Webseiten und vieles mehr direkt \u00fcber Ihr iPad\u00ae, Ihr iPhone\u00ae oder Ihren iPod touch\u00ae \u2013 mithilfe von AirPrint\u2122.\\n- Drucken Sie kabellos direkt \u00fcber ein Smartphone \u2013 dank der HP Anwendung f\u00fcr mobiles Drucken.\\n\\n<b>Mit dem Farb-Touchscreen (6,0 cm) und einer Auswahl an Apps k\u00f6nnen Sie Webinhalte ohne PC drucken.<\/b>\\n- Mit dem intuitiven und benutzerfreundlichen Farb-Touchscreen k\u00f6nnen Sie drucken, kopieren und scannen \u2013 sogar das Drucken von Webinhalten ist m\u00f6glich \u2013 ohne PC.\\n- Zugriff auf benutzerfreundliche Apps und Druck von Sudoku-R\u00e4tseln, Ausmalseiten und mehr.\\n- Mit HP Quick Forms k\u00f6nnen Sie Vorlagen f\u00fcr Kalender, Spiele, Notizbuchseiten und mehr drucken.\\n- Nutzen Sie die Vorteile der Steuerung per Fingertipp \u2013 drucken Sie Fotos und Dokumente, erstellen Sie Kopien und scannen Sie Fotos \u2013 und das alles \u00fcber den Farb-Touchscreen.\\n\\n<b>Drucken und Kopieren von Fotos, beidseitigen Dokumenten und vielem mehr \u2013 mit kosteng\u00fcnstigen separaten HP Tinten.<\/b>\\n- Drucken Sie mit kosteng\u00fcnstigen, separat austauschbaren Tintenpatronen; optionale XL-Patronen f\u00fcr h\u00e4ufiges Drucken.\\n- Zeitersparnis und weniger Papieraufwand durch automatisches beidseitiges Drucken und Kopieren.\\n- Drucken Sie randlose Fotos in Laborqualit\u00e4t \u2013 ideal f\u00fcr Bilderrahmen, Alben oder als Geschenk.\\n- Stilvoller und eleganter Drucker in kompaktem Design \u2013 passt in Regale oder B\u00fccherregale."},{"locale":"en_US","scope":"print","data":"Print lab-quality photos, two-sided documents and web content with this easy-to-use, touchscreen HP e-all-in-one. Enjoy the freedom to print however you choose \u2013 via your wireless network or with HP ePrint mobile printing.\\n\\n<b>Features<\/b>\\n\\n<b>Get easy mobile and wireless printing with HP ePrint and HP Auto Wireless Connect.<\/b>\\n- Enjoy easy printing and sharing \u2013 connect to your wireless network with HP Auto Wireless Connect.\\n- Discover the freedom of HP ePrint mobile printing \u2013 now you can print from virtually anywhere.\\n- Print e-mails, photos, web pages and more direct from your iPad\u00ae, iPhone\u00ae or iPod touch\u00ae with AirPrint\u2122.\\n- Print wirelessly direct from a smartphone using HP mobile printing applications.\\n\\n<b>Print web content without a PC using the 6.0 cm colour touchscreen and a selection of apps.<\/b>\\n- Use the intuitive, easy-to-use colour touchscreen to print, copy and scan \u2013 even print web content \u2013 without a PC.\\n- Access easy-to-use apps and print Sudoku puzzles, colouring pages and more.\\n- Choose HP Quick Forms and print templates such as calendars, games and notebook pages.\\n- Enjoy fingertip control \u2013 print photos and documents, make copies and scan photos, all via the colour touchscreen.\\n\\n<b>Print and copy photos, two-sided documents and more with affordable individual HP inks.<\/b>\\n- Print using affordable, individually-replaceable ink cartridges; optional XL cartridges for frequent printing.\\n- Save time and paper with automatic two-sided printing and copying.\\n- Print lab-quality borderless photos \u2013 perfect for framing, albums or to share as gifts.\\n- Sleek and stylish space-saving design \u2013 fits on shelves or bookcases."},{"locale":"fr_FR","scope":"print","data":"Imprimez des photos de qualit\u00e9 professionnelle, des documents courants et du contenu Web avec l'\u00e9cran tactile HP e-all-in-one facile \u00e0 utiliser. Profiter de la libert\u00e9 d'imprimer \u00e0 volont\u00e9 par le biais de votre r\u00e9seau sans fil ou avec l'impression mobile HP ePrint.\\n\\n<b>Caract\u00e9ristiques<\/b>\\n\\n<b>B\u00e9n\u00e9ficiez d'une impression mobile et sans fil simplifi\u00e9e avec HP ePrint et HP Auto Wireless Connect.<\/b>\\n- Imprimez et partagez facilement. Connectez-vous \u00e0 votre r\u00e9seau sans fil avec HP Auto Wireless Connect.\\n- D\u00e9couvrez la libert\u00e9 de l'impression mobile HP ePrint, elle vous permet dor\u00e9navant d'imprimer de pratiquement n'importe o\u00f9.\\n- Imprimez des e-mails, photos, pages Web et plus encore directement depuis votre iPad\u00ae, iPhone\u00ae ou iPod touch\u00ae avec AirPrint\u2122.\\n- Imprimez sans fil directement d'un smartphone, en utilisant les applications d'impression mobile HP.\\n\\n<b>Imprimez du contenu Web sans ordinateur[6] \u00e0 l'aide de l'\u00e9cran tactile couleur de 6,0 cm et d'une s\u00e9lection d'applications.<\/b>\\n- Utilisez l'\u00e9cran tactile couleur intuitif et facile \u00e0 utiliser pour imprimer, copier et num\u00e9riser, et m\u00eame imprimer du contenu Web, sans passer par un ordinateur.\\n- Acc\u00e9dez \u00e0 des applications faciles \u00e0 utiliser et imprimer des puzzles Sudoku, des pages \u00e0 colorier, etc.\\n- Choisissez les formulaires rapides et imprimez HP des mod\u00e8les tels que des calendriers, des jeux et des pages de cahier.\\n- Contr\u00f4lez tout du bout des doigts, imprimez des photos et des documents, faites des copies et num\u00e9risez des photos, tout cela directement sur l'\u00e9cran tactile.\\n\\n<b>Imprimez et copiez des photos, documents et plus encore \u2013 avec des cartouches d'encre individuelles abordables.<\/b>\\n- Imprimez avec des cartouches d'encre \u00e9conomiques, rempla\u00e7ables individuellement ; cartouches XL en option pour impressions fr\u00e9quentes.\\n- \u00e9conomisez de l'argent et du papier avec l'impression recto verso autom.\\n- Imprimez des photos sans bordure de qualit\u00e9 professionnelle, id\u00e9ales pour l'encadrement, les albums ou pour offrir en cadeau.\\n- Conception \u00e9l\u00e9gante et non encombrante, parfaite sur les \u00e9tag\u00e8res ou dans les biblioth\u00e8ques."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-05T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"706186a1-5d86-4952-b466-b2ae0e2c0adc","identifier":"10806799","enabled":true,"family":"led_tvs","categories":["led_tvs","salora","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"b\/5\/8\/2\/b58213fbb1dc278c929667cc97404c747b1f0e02_10806799_1356.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/5\/8\/2\/b58213fbb1dc278c929667cc97404c747b1f0e02_10806799_1356.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Salora 19LED7015TDW LED TV"}],"description":[{"locale":"en_US","scope":"print","data":"Salora 19LED7015TDW. HD type: HD-Ready, Display resolution: 1366 x 768, Aspect ratio: 16:9. Tuner type: Digital, Digital signal format system: DVB-T. RMS rated power: 2.5. HDMI version: 1.3. Optical disc player type: DVD player, Disc types supported: CD, CD-R, CD-RW, DVD, DVD-R, DVD-RW"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-05T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"82983fd5-5bd4-437c-b4e2-0acb4e62368b","identifier":"10806800","enabled":true,"family":"led_tvs","categories":["led_tvs","salora","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"5\/9\/6\/3\/596307fa351a41f7b893b988b3b1cb5715fcbbf2_10806800_2267.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/5\/9\/6\/3\/596307fa351a41f7b893b988b3b1cb5715fcbbf2_10806800_2267.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Salora 22LED7015TDW LED TV"}],"description":[{"locale":"en_US","scope":"print","data":"Salora 22LED7015TDW. HD type: Full HD, Display resolution: 1920 x 1080, Aspect ratio: 16:9. Tuner type: Digital, Digital signal format system: DVB-T. RMS rated power: 2.5. HDMI version: 1.3. Optical disc player type: DVD player, Disc types supported: CD, CD-R, CD-RW, DVD, DVD+R, DVD+RW, DVD-R, DVD-RW"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-05T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6de8e1f5-d0e9-4e21-a4b9-8ffdcd021c92","identifier":"10809911","enabled":true,"family":"pc_monitors","categories":["pc_monitors","tvs_projectors_sales","viewsonic"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Viewsonic LED LCD CDP6530"}],"description":[{"locale":"en_US","scope":"print","data":"ViewSonic\u2019s new CDP6530 full HD commercial display with 1920x1080p, 500 nits panel with 20,000:1 dynamic contrast ratio. Additional features include versatile inputs \u2013 HDMI, DVI, VGA, S-video and composite, YPbPr (BNC) with built-in 12Wx2 speakers and 12Wx2 speaker output connections. The CDP6530 can be used to make up to a 5x5 display video wall applications and automatic scheduler. RS232 daisy chain and DDC\/CI is also provided for remote control. VGA and composite video output is also provided for video loop through applications.\\n\\nFeatures\\n\\n- 1080p 8ms LED panel for vibrant images using up to 35% less power than standard CCFL displays\\n- 42.3mm bezel with 5x5 display video wall capability\\n- Versatile inputs include \u2013 HDMI, DVI, VGA, YPbPr, CVBS (BNC) S-video and composite video\\n- Designed for 24\/7 operation with 3-year limited warranty 500 nits brightness with 20,000:1 dynamic contrast ratio\\n- RS232 daisy-chain capable\\n- Remote and panel control lock out\\n- Built-in 12Wx2 speakers\\n- Installation options include stand or VESA wall mount\\n- PIP (Picture-in-Picture) >>Internal Scheduler"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-06T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":65,"unit":"INCH"}}],"response_time":[{"locale":null,"scope":null,"data":8}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"df4dd239-9697-48fb-ae6e-4475acc5f01d","identifier":"10809937","enabled":true,"family":"pc_monitors","categories":["aoc","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"AOC e950Sw"}],"power_requirements":[{"locale":null,"scope":null,"data":"90-240VAC"}],"description":[{"locale":"en_US","scope":"print","data":"This environmentally friendly LCDA liquid crystal display (LCD) is an electro-optical amplitude modulator realized as a thin, flat display device made up of any number of color or monochrome pixels arrayed in front of a light source or reflector. monitor is both Energy-Star and EPEAT Gold certified. Along with an energy-saving Eco Mode, the monitor offers impressive image quality with a 16:9 aspect ratio, 5ms response time and 20,000,000:1 dynamic contrast ratio. The wall-mountable monitor features a Kensington security slot, user-friendly graphical OSD menu and direct-insert horizontal connectors."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-06T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"919a51d6-cd31-4739-b620-8e8a3184f7b2","identifier":"10809940","enabled":true,"family":"pc_monitors","categories":["nec","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"NEC EX201W-BK"}],"description":[{"locale":"en_US","scope":"print","data":"<b>20\" Widescreen Ultra-Slim Desktop Monitor<\/b>\\n\\nMODEL: EX201W-BK\\n\\nThe NEC MultiSync EX201W is a 20\u201d widescreen, lightweight LED-backlit LCD monitor with an ultra-slim bezel depth. It stands out with its stylish minimalist design, rich features and ergonomic adjustability. Rated EPEAT Gold, this display is packed with green features. Its smart sensing technology, such as human sensor and ambient light sensor, make it one of the most power-efficient monitors (.37W in power saving mode and 62% less power consumption). The EX201W is an ideal solution for business users on-the-go and small-sized client meetings in that it\u2019s portable, flexible and adaptable.\\n\\n- LED backlight technology provides for industry-leading low power consumption and less hazardous materials\\n- Minimalist design, featuring an ultra-thin bezel width and depth and lightweight design, puts the focus on the screen vs. the cabinet\\n- ECO Mode allows you to manually adjust the display\u2019s brightness to your liking, saving power and reducing your energy costs\\n- Human and ambient light sensors automatically detect your work conditions to determine the proper display brightness, thereby conserving power\\n- Fully adjustable quick-release stand, including height-adjust (110mm), pivot, tilt and swivel capabilities, adds flexibility and comfort to your viewing preferences\\n- Full connectivity, including DisplayPort and DVI-I inputs and USB pass-through\\n- Touch-sensitive OSD controls are integrated into the bezel, making display adjustments easier than ever"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-06T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":20,"unit":"INCH"}}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"af59fe7d-a868-4fe4-97f2-09f1783c3f1e","identifier":"10813144","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","sony"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"8\/6\/8\/9\/8689a68865545aa4f1e0328910a99b86cea6d8c4_10813144_4758.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/8\/6\/8\/9\/8689a68865545aa4f1e0328910a99b86cea6d8c4_10813144_4758.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Sony SLT-A65VK"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>F\u00fcr professionelle Bilder<\/b>\\nEntdecken Sie eine neue Vielfalt von k\u00fcnstlerischen M\u00f6glichkeiten. Jetzt k\u00f6nnen Sie \u00e4u\u00dferst hochwertige Standbild- und Full HD-Videoaufnahmen mit superschnellen Reaktionszeiten und vielseitigen, benutzerfreundlichen Funktionen erstellen und steuern.\\n\\n<b>Auf die Details kommt es an<\/b>\\nDank des hochaufl\u00f6senden (24,3 Mio. Pixel) CMOS Sensors erhalten Sie Bilder mit gro\u00dfer Detailtiefe, ausgezeichnetem Kontrast und wundersch\u00f6nen Farben. Durch die Exmor Technologie wird bei der Digitalisierung das Bildrauschen minimiert. Das Ergebnis sind makellose, sch\u00f6ne Bilder.\\n\\n<b>Erstklassige Serienaufnahmen<\/b>\\nHalten Sie rasante Actionszenen mit einer Serie von bis zu 10 Bildern pro Sekunde in voller Aufl\u00f6sung fest. Ob actionreiche Sportveranstaltungen oder ausdrucksstarke Portr\u00e4tserien \u2013 auf diese Weise entgeht Ihnen kein wichtiger Moment.\\n\\n<b>Entdecken Sie Ihre k\u00fcnstlerische Seite<\/b>\\nNutzen Sie ganz ohne PC zahlreiche kreative Modi. Die Bildeffekte-Funktion bietet Ihnen umfassende Bearbeitungsm\u00f6glichkeiten, wie Teilfarbfilter, Poster-, Retro-, High-key-, Mono- oder Spielzeugkamera-Effekte. Sehen Sie sich die Ergebnisse schon beim Fotografieren oder Filmen im Live View-Modus an.\\n\\n<b>Atemberaubende HD-Videos<\/b>\\nHalten Sie dank eines pr\u00e4zisen Autofokus mit Phasendetektion selbst bewegliche Motive in klaren, detailreichen Full HD-Videos fest. Kreieren Sie sch\u00f6ne Unsch\u00e4rfe-Effekte im Hintergrund, und stellen Sie Fokus und Belichtung manuell ein. Mit einem progressiven Aufnahmemodus gelingt es Ihnen, mit Ihren Videos Kinostimmung zu erzeugen.\\n\\n<b>Gro\u00dfartige Bilder aus jedem Winkel<\/b>\\nDas LC-Display kann nach unten oder oben geneigt werden und sorgt somit f\u00fcr eine problemlose Ansicht aus jeder Aufnahmeposition. Diese Eigenschaft erweist sich als besonders n\u00fctzlich, wenn Sie die Kamera nicht nah am Auge halten, beispielsweise wenn Sie ein Gruppenfoto aus erh\u00f6hter Position schie\u00dfen oder f\u00fcr ein interessantes Foto in die Hocke gehen."},{"locale":"en_US","scope":"print","data":"<b>Built to keep delivering serious images<\/b>\\nExplore a new world of artistic possibilities. Now you can create and control extremely high quality still images and Full HD video, with super-fast shooting responses and versatile, easy-to-use creative features.\\n\\n<b>It's all in the detail<\/b>\\nThe high-resolution 24.3 megapixel CMOS sensor assures detail-packed pictures with excellent contrast and gorgeous colours. Exmor technology cuts noise while signals are converted to digital form. The result? Flawlessly beautiful images.\\n\\n<b>Pro-style continuous shooting<\/b>\\nCapture fleeting action with a continuous burst of full-resolution images at up to 10 frames per second. From dynamic sports to momentary expression of portrait subjects - it's a great way to grab that decisive moment.\\n\\n<b>Discover the artist within you<\/b>\\nCreate a range of artistic styles, with no PC needed. Picture Effect offers a rich palette of options including posterise, partial colour, retro, high-key, mono and toy camera. Preview results in live view mode while shooting stills or movies.\\n\\n<b>Amazing HD movies<\/b>\\nCapture smooth, detailed Full HD videos with accurate phase-detection autofocus of moving subjects. Produce beautiful background defocus effects, and enjoy full manual control over focus and exposure modes. Create a cinematic mood with progressive shooting.\\n\\n<b>Great pictures from any angle<\/b>\\nThe LCD screen tilts up or down for comfortable viewing in different shooting positions. It\u2019s useful if you\u2019re not holding the camera close to your eye: for example of you\u2019re shooting above a crowd or crouching down for an interesting viewpoint."},{"locale":"fr_FR","scope":"print","data":"<b>Con\u00e7u pour r\u00e9aliser des prises de vue de qualit\u00e9<\/b>\\nPlongez au c\u0153ur d'un nouvel univers de possibilit\u00e9s artistiques. D\u00e9sormais, vous pouvez cr\u00e9er et ma\u00eetriser des photos et des vid\u00e9os Full HD de tr\u00e8s grande qualit\u00e9, avec un temps de r\u00e9ponse ultrarapide, ainsi que des fonctions polyvalentes et cr\u00e9atives faciles \u00e0 utiliser.\\n\\n<b>L'importance du d\u00e9tail<\/b>\\nGr\u00e2ce au capteur CMOS haute r\u00e9solution de 24,3 m\u00e9gapixels, r\u00e9alisez des photos d'une pr\u00e9cision exceptionnelle, associant de sublimes couleurs et un contraste \u00e9lev\u00e9. La technologie Exmor\u2122 r\u00e9duit les bruits ambiants lors de la conversion des signaux au format num\u00e9rique. Le r\u00e9sultat ? Des photos parfaitement r\u00e9ussies.\\n\\n<b>Prise de vue continue professionnelle<\/b>\\nSaisissez les sc\u00e8nes les plus furtives gr\u00e2ce \u00e0 une prise de vue en rafale pleine r\u00e9solution vous permettant de capturer jusqu'\u00e0 10 images par seconde. Une fonction pr\u00e9cieuse pour capturer les moments fatidiques, que ce soit une action sportive ou l'expression d'un visage.\\n\\n<b>R\u00e9v\u00e9lez l'artiste qui est en vous<\/b>\\nCr\u00e9ez toute une gamme de styles artistiques, sans PC. La fonctionnalit\u00e9 Effets sp\u00e9ciaux vous offre un large \u00e9ventail d'options : Poster, Couleur partielle, R\u00e9tro, Image claire, Mono et Photo \u00e0 l'ancienne. Pr\u00e9visualisez les r\u00e9sultats en mode Live View tout en r\u00e9alisant des photos ou des films.\\n\\n<b>Des films HD exceptionnels<\/b>\\nCapturez des vid\u00e9os Full HD fluides et d\u00e9taill\u00e9es gr\u00e2ce \u00e0 la fonction de d\u00e9tection de phase pr\u00e9cise pour la mise au point des sujets en mouvement. Produisez des effets de flou artistique en arri\u00e8re-plan et profitez d'un contr\u00f4le enti\u00e8rement manuel des modes de mise au point et d'exposition. Cr\u00e9ez une ambiance cin\u00e9ma avec le mode de prise de vue progressif.\\n\\n<b>De superbes photos sous tous les angles<\/b>\\nL'\u00e9cran LCD s'incline vers le haut ou vers le bas pour vous offrir diverses positions de prise de vue confortables : une fonction particuli\u00e8rement pratique lorsque vous tenez l'appareil photo \u00e0 hauteur de l'\u0153il, par exemple si vous prenez des photos au-dessus d'une foule, ou si vous vous accroupissez pour obtenir un angle de vue int\u00e9ressant."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-06T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"2abced94-852d-4442-b577-e3baf3108c22","identifier":"10813145","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","sony"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"3\/b\/4\/d\/3b4dfaa25054fcb29b1ff183c24a5a0c9757417e_10813145_Sony.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/3\/b\/4\/d\/3b4dfaa25054fcb29b1ff183c24a5a0c9757417e_10813145_Sony.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Sony SLT-A77V digital camera"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"Erf\u00fcllt die kreativen Anforderungen wahrer Fotoliebhaber<br\/>\\n<br\/>24,3 Mio. Pixel (effektiv): Extrem hochaufl\u00f6sender Exmor\u2122 APS HD CMOS Sensor mit Rauschunterdr\u00fcckung in 2 Stufen f\u00fcr makellose Stand- und Videoaufnahmen mit geringem Rauschen.<br\/>\\n\u00dcberarbeiteter BIONZ Prozessor: Der optimierte Bildprozessor verarbeitet gro\u00dfe Datenmengen des Sensors, damit Sie schnell hervorragende Bilder mit geringem Rauschen aufnehmen k\u00f6nnen.<br\/>\\nTranslucent Mirror-Technologie: Der bewegliche DSLR-Spiegel wird durch einen unbeweglichen, durchsichtigen Spiegel ersetzt: So sind extrem schnelle Reaktionszeiten bei pr\u00e4zisem Phasendetektions-AF m\u00f6glich..<br\/>\\nErstklassige Verschlusszeit: Ultrakurze Verschlusszeit von nur 50 ms entspricht der Leistung hochwertiger Profikameras: Hervorragend geeignet f\u00fcr schnelle Actionszenen.<br\/>\\nSerienaufnahmefunktion: Erfassen Sie schnelle Actionszenen mit bis zu 12 Bildern pro Sekunde dank permanentem Autofokus f\u00fcr Videoaufnahmen f\u00fcr blitzschnelle Verfolgung bewegter Objekte.<br\/>\\nQuick AF Full HD Movie: Nehmen Sie mit permanentem Autofokus1920 x 1080 Videos von bewegten Motiven auf: Jetzt mit progressivem 24p\/50p-Aufnahmemodus f\u00fcr kinoreife Ergebnisse.<br\/>\\nKreative Full HD-Videofunktionen: Der manuelle Fokus erm\u00f6glicht einen wundersch\u00f6nen Unsch\u00e4rfe-Effekt (Bokeh) bei HD-Videoaufzeichnungen; PASM-Belichtungsmodi bieten volle kreative Kontrolle.<br\/>\\nVerbesserter Quick AF Live View: Hochaufgel\u00f6ste Bildanzeige vom Hauptbildsensor auf dem LC-Display oder im Sucher mit schnellem, pr\u00e4zisem Phasendetektions-Autofokus.<br\/>\\nAF mit Objektverfolgung: Damit bleiben Gesichter und andere ausgew\u00e4hlte Motive scharf fokussiert, selbst wenn das Ziel kurzfristig von einem vorbeikommenden Objekt verdeckt wird.<br\/>\\n3D-Schwenkpanorama: Dr\u00fccken Sie den Ausl\u00f6ser und schwenken die Kamera, um extrabreite Panoramabilder aufzunehmen: Sie k\u00f6nnen 3D-Panoramen auch zur Anzeige auf 3D-Fernsehern aufnehmen.<br\/>\\nHohe Empfindlichkeit von ISO 50 bis 16000: Die hohe Empfindlichkeit erm\u00f6glicht nat\u00fcrliche Bilder mit geringem Rauschen, selbst bei schwierigen Lichtverh\u00e4ltnissen: Der erweiterte Modus dehnt die Empfindlichkeit auf ISO 50 aus.<br\/>\\n19-Punkt AF-Phasendetektionssystem: Neu entwickeltes AF-System mit 11 Fadenkreuzsensoren f\u00fcr akkuraten, unterbrechungsfreien Autofokus \u2013 verf\u00fcgbar mit Viewfinder oder Live View auf dem LCD.<br\/>\\nIn 3 Richtungen neigbares 7,5 cm (3,0 Zoll) Xtra Fine LCD: Frei einstellbares, hochaufl\u00f6sendes LC-Display (921.000 Pixel): mit TruBlack\u2122 Technologie f\u00fcr hervorragende Detailtreue und Kontraste.<br\/>\\nXGA OLED TruFinder\u2122: Pr\u00e4ziser elektronischer Sucher mit einer Aufl\u00f6sung von 2,36 Mio. Bildpunkten, hohem Kontrast und 100 %iger Bildabdeckung f\u00fcr pr\u00e4zise Bildsteuerung, manuellem Fokus und Beurteilung der Bildqualit\u00e4t.<br\/>\\nHochaufl\u00f6sende Informationsanzeige: Sie k\u00f6nnen verschiedene digitale Ausrichtungshilfen, Aufnahmeparameter, Aufteilungslinien und grafische Belichtungshilfen anzeigen.<br\/>\\nTelekonverter: Ein Digitalzoom vergr\u00f6\u00dfert den zentralen Bereich eines Bildes 1,4fach oder 2fach f\u00fcr hochaufl\u00f6sende Bilder mit 12 Mio. Pixeln.<br\/>\\nVorschau des Aufnahmeergebnisses: Per Knopfdruck k\u00f6nnen Sie die Wirkung der Blendeneinstellung, Verschluss- und DRO-Einstellungen auf Tiefensch\u00e4rfe, Bewegungsunsch\u00e4rfe und Dynamikumfang \u00fcberpr\u00fcfen.<br\/>\\nVerbesserter Automatikmodus: Analysiert automatisch Szenen und Aufnahmebedingungen und passt die Kameraeinstellungen entsprechend an, um immer hervorragende Ergebnisse zu gew\u00e4hrleisten.<br\/>\\nGesichtserkennung mit Gesichtsregistrierung: Pro Szene k\u00f6nnen bis zu 8 Gesichter erkannt werden, wobei Optimalbelichtung, Wei\u00dfabgleich, Blitz und andere Parameter zur Aufnahme ansprechender Portr\u00e4ts optimiert werden.<br\/>\\nSmile Shutter: L\u00f6st dank der einstellbaren Smile Shutter-Funktion f\u00fcr L\u00e4cheln automatisch eine Aufnahme aus, wenn die Person im Sucher l\u00e4chelt.<br\/>\\nBildeffektmodi: Erstellen Sie beeindruckende Effekte ganz ohne PC \u2013 unter anderem mit Posterisation, Teilfarbfilter, HDR Painting, Weichzeichner, Miniatureffekt.<br\/>\\nVerbesserte HDR-Automatik: Erzeugt aus drei aufeinander folgenden Aufnahmen automatisch ein einziges Bild mit einem Dynamikumfang, der sogar den von Film \u00fcbersteigt.<br\/>\\nMulti-Frame-Rauschunterdr\u00fcckung: Kombiniert automatisch eine Serienaufnahme von sechs Bildern, um ein einzelnes Bild mit sehr niedrigem Rauschen zu erzeugen.<br\/>\\nHandheld D\u00e4mmerungsmodus: Kombiniert autom. eine Serienaufnahme von sechs Bildern, um ein einzelnes Bild mit verminderter Unsch\u00e4rfe und weniger Rauschen bei schlechten Lichtverh\u00e4ltnissen zu erzeugen.<br\/>\\nEinfaches GPS-Geotagging: F\u00fcgt Bildern automatisch Ortsinformationen hinzu: Kartenansichten sind mit der PMB-Software oder auf BRAVIA-Fernsehern mit der Photo Map-Funktion m\u00f6glich.<br\/>\\nKreativmodi: 6 ausw\u00e4hlbare Finish-Optionen f\u00fcr jede Aufnahmesituation, die f\u00fcr noch mehr kreative Freiheit entsprechend angepasst werden k\u00f6nnen.<br\/>\\nDynamische Bereichsoptimierung: Dynamische Bereichsoptimierung \u2013 Analysiert das Bild in Echtzeit und stellt Helligkeit und Kontrast f\u00fcr eine optimale Belichtung bei Szenen mit Hintergrundbeleuchtung ein.<br\/>\\nVielseitige Serienaufnahmemodi: Zu den Serienaufnahmemodi geh\u00f6ren: Serienbild, Selbstausl\u00f6ser, Autom. Belichtungsreihe (Exposure Bracketing) und Belichtungsreihe mit Wei\u00dfabgleich (White Balance Bracketing).<br\/>\\nKn\u00f6pfe auf der Vorder- und R\u00fcckseite sowie Datenanzeige auf dem LC-Display: Kn\u00f6pfe an Vorder- und R\u00fcckseite des Griffs erm\u00f6glichen schnelle Einstellungen: zweite Datenanzeige f\u00fcr Belichtung und andere Einstellungen.<br\/>\\nKonfigurierbare Tasten: AEL-, ISO- und AF\/MF-Taste k\u00f6nnen f\u00fcr bequemen Zugang 24 Funktionen zugewiesen werden.<br\/>\\nSteadyShot INSIDE: Integrierte Bildstabilisierung bietet eine Anti-Shake-Funktion mit 2,5\u20134,0 Schritten f\u00fcr alle A-Objektive von Sony oder Konica Minolta.<br\/>\\nKompensierung von Schattierungen und Abbildungsfehlern: Intelligente Korrektur von Vignettierung (Randschattierung), seitliche Abbildungsfehler und Verzerrung f\u00fcr jedes A-Objektiv.<br\/>\\nRobustes Magnesiumgeh\u00e4use: Robuste Geh\u00e4usefl\u00e4chen widerstehen selbst starker Beanspruchung Tasten und Steuerungen sind vor Staub und Feuchtigkeit gesch\u00fctzt.<br\/>\\nZweifaches Anti-Staubsystem: Reduziert das Ansammeln von Staub auf dem Sensor beim Austauschen des Objektivs.<br\/>\\nHDMI\u00ae Ausgang: HD-Ausgang f\u00fcr die Anzeige von Fotos auf einem HD-Fernseher (optionales Kabel erforderlich). Photo TV HD optimiert die Anzeige von Fotos auf kompatiblen BRAVIA Ger\u00e4ten.<br\/>\\nBRAVIA Sync: F\u00fcr die Steuerung der Wiedergabefunktionen der Kamera \u00fcber die Fernbedienung des BRAVIA\u00ae Fernsehers.<br\/>\\nMitgelieferte Software: Inklusive: Image Data Converter SR, Image Data Lightbox SR und Picture Motion Browser.<br\/>\\n"},{"locale":"en_US","scope":"print","data":"<b>Built to keep delivering serious images<\/b>\\nStep up to new levels of imaging quality, performance and handling to meet the demands of serious photo enthusiasts. Capture flawless images and Full HD video, with class-leading responsiveness and immense creative control.\\n\\n<b>It's all in the detail<\/b>\\nThe high-resolution 24.3 megapixel CMOS sensor assures detail-packed pictures with excellent contrast and gorgeous colours. Exmor technology cuts noise while signals are converted to digital form. The result? Flawlessly beautiful images.\\n\\n<b>World's fastest continuous shooting<\/b>\\nCapture fleeting action with a continuous burst of full-resolution images at up to 12 frames per second. It's the quickest shooting performance of any consumer-oriented APS-C interchangeable-lens digital camera (Aug. 2011).\\n\\n<b>Total control over your image<\/b>\\nCraft beautiful images more decisively, with fingertip access to key functions and custom buttons. Front- and rear-mounted dials simplify quick adjustments. There's also a secondary display to confirm exposure and other settings.\\n\\n<b>Amazing HD movies<\/b>\\nCapture smooth, detailed Full HD videos with accurate phase-detection autofocus of moving subjects. Produce beautiful background defocus effects, and enjoy full manual control over focus and exposure modes. Create a cinematic mood with progressive shooting.\\n\\n<b>Tough, durable performance<\/b>\\nHandle challenging asignments with ease. The magnesium alloy body combines rigidity and lightness, while seals aroud key buttons and dials guard against dust and moisture. The newly developed shutter unit is proven to approx. 150,000 releases."},{"locale":"fr_FR","scope":"print","data":"<b>Con\u00e7u pour r\u00e9aliser des prises de vue de qualit\u00e9<\/b>\\nD\u00e9couvrez un appareil photo avec une qualit\u00e9 d'image, des performances et une utilisation in\u00e9dites, qui r\u00e9pondent aux besoins des v\u00e9ritables amateurs de photos. R\u00e9alisez des photos et des vid\u00e9os Full HD parfaites, gr\u00e2ce \u00e0 la rapidit\u00e9 remarquable et \u00e0 la cr\u00e9ativit\u00e9 exceptionnelle qu'offre ce mod\u00e8le.\\n\\n<b>L'importance du d\u00e9tail<\/b>\\nGr\u00e2ce au capteur CMOS haute r\u00e9solution de 24,3 m\u00e9gapixels, r\u00e9alisez des photos d'une pr\u00e9cision exceptionnelle, associant de sublimes couleurs et un contraste \u00e9lev\u00e9. La technologie Exmor\u2122 r\u00e9duit les bruits ambiants lors de la conversion des signaux au format num\u00e9rique. Le r\u00e9sultat ? Des photos parfaitement r\u00e9ussies.\\n\\n<b>La prise de vue la plus rapide au monde<\/b>\\nSaisissez les sc\u00e8nes les plus furtives gr\u00e2ce \u00e0 une prise de vue en rafale pleine r\u00e9solution vous permettant de capturer jusqu'\u00e0 12 images par seconde : la vitesse de prise de vue la plus \u00e9lev\u00e9e sur un appareil photo num\u00e9rique \u00e0 objectifs interchangeables de type APS-C destin\u00e9 au grand public (ao\u00fbt 2011).\\n\\n<b>Prenez le contr\u00f4le de vos photos<\/b>\\nCr\u00e9ez de superbes photos en toute confiance gr\u00e2ce \u00e0 des fonctions accessibles du bout des doigts et des touches personnalisables. Des boutons situ\u00e9s \u00e0 l'avant et \u00e0 l'arri\u00e8re vous permettent d'effectuer des r\u00e9glages rapidement et en toute simplicit\u00e9 et un second \u00e9cran vous permet de r\u00e9gler l'exposition et les autres param\u00e8tres.\\n\\n<b>Des films HD exceptionnels<\/b>\\nCapturez des vid\u00e9os Full HD fluides et d\u00e9taill\u00e9es gr\u00e2ce \u00e0 la fonction de d\u00e9tection de phase pr\u00e9cise pour la mise au point des sujets en mouvement. Produisez des effets de flou artistique en arri\u00e8re-plan et profitez d'un contr\u00f4le enti\u00e8rement manuel des modes de mise au point et d'exposition. Cr\u00e9ez une ambiance cin\u00e9ma avec le mode de prise de vue progressif.\\n\\n<b>Des performances hors pair sur le long terme<\/b>\\nTraitez vos t\u00e2ches les plus complexes en toute facilit\u00e9. Le bo\u00eetier en alliage de magn\u00e9sium associe rigidit\u00e9 et l\u00e9g\u00e8ret\u00e9, tandis que les capuchons autour des boutons et des touches de base prot\u00e8gent votre appareil de la poussi\u00e8re et de l'humidit\u00e9. Le tout nouvel obturateur a \u00e9t\u00e9 test\u00e9 sur environ 150 000 cycles."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-06T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"52ab44f6-7adc-406d-a453-69a0433d858e","identifier":"10817854","enabled":true,"family":"laser_led_printers","categories":["canon","laser_led_printers","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"215_x_355_mm"}],"picture":[{"locale":null,"scope":null,"data":"b\/3\/a\/d\/b3adcc334b688f5c5fe89c7f59ccfbbb7aa62e83_10817854_5160.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/b\/3\/a\/d\/b3adcc334b688f5c5fe89c7f59ccfbbb7aa62e83_10817854_5160.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS MF5980DW"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Compact laser All-in-One<\/b>\\nMeet the demands of small, busy workgroups with the exceptional performance of this compact, network-ready multifunctional. The easy to use i-SENSYS MF5980dw offers double-sided printing, scanning, copying and faxing in a single slim device.\\n\\n<b>Time-saver<\/b>\\nThe i-SENSYS MF5980dw boosts productivity with its 33 ppm output speed and class-leading First Copy Out Time of less than 8 seconds. There is also minimal waiting time for print outs, thanks to Quick First-Print technologies. The 50-sheet Duplex Automatic Document Feeder for scanning, copying or faxing double-sided documents, together with the optional cassette that expands paper supply capacity up to 800 sheets, also ensure faster and more efficient working.\\n\\n<b>One touch, ease of use<\/b>\\nThe intuitive 5-line LCD display presents more information on screen, so users make the most of the available functions. For even greater ease of use, there are one touch solution keys that allow quick scanning direct to your PC; eco-copying for combining several pages into a single print out, saving paper and money; and secure print, which is a secure way to print sensitive documents and reduce waste.\\n\\n<b>Accelerate workflows<\/b>\\nDistribute your documents faster and more efficiently using Canon\u2019s SEND functionality. With this you can scan direct to email, a network folder or a USB memory key. In addition, Compact PDF compression technology creates smaller files \u2013 up to 1\/10th of the size achievable with standard compression \u2013 without compromising quality, making it much easier to send and share documents.\\n\\n<b>Easy networking \u2013 wired and wireless<\/b>\\nSave space and cut costs with one high performance network-ready device that\u2019s available to everyone in the workgroup. The i-SENSYS MF5980dw is easy to manage over the network and Wi-Fi compatibility enables you to easily integrate it into your wireless network.\\n\\n<b>Seamless integration<\/b>\\nThis network-ready unit offers PCL 5c, PCL 6 and PostScript Level 3 support for easy integration into your existing print environment.\\n\\n<b>Save energy and cut costs<\/b>\\nReduce your impact on the environment, while cutting costs. Energy Star compliant, the i-SENSYS MF5980dw leads the way with one of the lowest Typical Energy Consumption (TEC) figures \u2013 just 1.4 kWh. In sleep mode it only consumes 2.3 Watts for greater energy efficiency. Automatic double-sided printing cuts costs further by reducing paper usage."},{"locale":"fr_FR","scope":"print","data":"<b>Multifonction laser compact<\/b>\\nR\u00e9pondez aux besoins des petits groupes de travail \u00e0 forte activit\u00e9 gr\u00e2ce aux performances exceptionnelles de cet appareil multifonction compatible r\u00e9seau compact. Simple d'utilisation, l'i-SENSYS MF5980dw offre des fonctions d'impression recto verso, de num\u00e9risation, de copie et de t\u00e9l\u00e9copie r\u00e9unies en un seul appareil au design compact.\\n\\n<b>\u00c9conomie de temps<\/b>\\nL'i-SENSYS MF5980dw permet d'optimiser la productivit\u00e9 gr\u00e2ce \u00e0 sa vitesse de sortie de 33 ppm et son temps de sortie de la premi\u00e8re copie in\u00e9gal\u00e9 inf\u00e9rieur \u00e0 8 secondes. Les technologies \u00ab Quick First-Print \u00bb (premi\u00e8re sortie rapide) permettent \u00e9galement un temps d'attente minimal pour les impressions. Son chargeur automatique de documents recto verso de 50 pages pour la num\u00e9risation, la copie ou la t\u00e9l\u00e9copie de documents recto verso, associ\u00e9 \u00e0 la cassette en option permettant d'\u00e9tendre la capacit\u00e9 papier jusqu'\u00e0 800 feuilles, contribuent \u00e9galement \u00e0 accro\u00eetre la rapidit\u00e9 et l'efficacit\u00e9 de travail.\\n\\n<b>Simplicit\u00e9 d'utilisation \u00e0 partir d'une seule touche<\/b>\\nL'\u00e9cran LCD intuitif de 5 lignes pr\u00e9sente plus d'informations \u00e0 l'\u00e9cran de sorte que les utilisateurs tirent le meilleur parti des fonctions disponibles. Pour une simplicit\u00e9 d'utilisation encore accrue, des commandes par simple pression d'une touche permettent la num\u00e9risation rapide directement vers votre PC ; la copie \u00e9conomique en combinant plusieurs pages en une seule impression, r\u00e9alisant ainsi des \u00e9conomies de papier et d'argent ; et l'impression s\u00e9curis\u00e9e, qui permet d'imprimer en toute s\u00e9curit\u00e9 les documents sensibles tout en r\u00e9duisant le gaspillage.\\n\\n<b>Acc\u00e9l\u00e9ration des flux de travail<\/b>\\nDistribuez vos documents plus rapidement et efficacement \u00e0 l'aide de la fonctionnalit\u00e9 ENVOI de Canon. Cette fonctionnalit\u00e9 vous permet d'effectuer une num\u00e9risation directement vers un courriel, un dossier r\u00e9seau ou une cl\u00e9 USB. En outre, la technologie de compression \u00ab Compact PDF \u00bb permet de cr\u00e9er des fichiers de plus petite taille (jusqu'\u00e0 1\/10\u00e8me de la taille obtenue en utilisant la compression classique) sans pour autant compromettre la qualit\u00e9, facilitant ainsi nettement l'envoi et le partage de documents.\\n\\n<b>Mise en r\u00e9seau (filaire et sans fil) ais\u00e9e<\/b>\\n\u00c9conomisez de l'espace et r\u00e9duisez les co\u00fbts en mettant ce p\u00e9riph\u00e9rique compatible r\u00e9seau hautes performances unique \u00e0 la disposition de tous les membres du groupe de travail. L'i-SENSYS MF5980dw est facile \u00e0 g\u00e9rer sur le r\u00e9seau et sa compatibilit\u00e9 Wi-Fi vous permet de l'int\u00e9grer \u00e0 votre r\u00e9seau sans fil en toute simplicit\u00e9.\\n\\n<b>Int\u00e9gration transparente<\/b>\\nCette unit\u00e9 compatible r\u00e9seau prend en charge le PCL 5c, PCL 6 et le Postscript 3, facilitant ainsi son int\u00e9gration dans votre environnement d'impression existant.\\n\\n<b>R\u00e9duisez vos co\u00fbts tout en faisant des \u00e9conomies d'\u00e9nergie<\/b>\\nAtt\u00e9nuez votre impact sur l'environnement tout en r\u00e9duisant les co\u00fbts. Conforme \u00e0 la norme Energy Star, l'i-SENSYS MF5980dw donne l'exemple en affichant l'une des consommations r\u00e9elles d'\u00e9lectricit\u00e9 (TEC) les plus faibles, \u00e0 savoir 1,4 kWh seulement. Il consomme uniquement 2,3 watts en mode veille, pour une efficacit\u00e9 \u00e9nerg\u00e9tique accrue. L'impression recto verso automatique contribue \u00e0 minimiser les co\u00fbts en r\u00e9duisant l'utilisation de papier."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-07T00:00:00+00:00"}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"90c3cc7e-622d-4ab4-9fd0-fc20d2bc9ef6","identifier":"10949254","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"215_x_355_mm"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["scan"]}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS MF5980DW"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Kompaktes Laser-Multifunktionssystem<\/b>\\nDie herausragende Leistung dieses kompakten, netzwerkf\u00e4higen Multifunktionsger\u00e4ts erf\u00fcllt die Anforderungen kleiner, vielbesch\u00e4ftigter Arbeitsgruppen. Der benutzerfreundliche i-SENSYS MF5980dw bietet Duplexdruck (beidseitig), Scan-, Kopier- und Faxfunktionen in einem schlanken Ger\u00e4t.\\n\\n<b>Zeitsparend<\/b>\\nDer i-SENSYS MF5980dw steigert mit seiner Ausgabegeschwindigkeit von 33 Seiten pro Minute und schneller Ausgabe der ersten Seite nach weniger als 8 Sekunden die Produktivit\u00e4t. Au\u00dferdem gew\u00e4hrleistet die Quick First Print-Technologie minimale Wartezeiten f\u00fcr Ausdrucke. Der automatische Dokumenteneinzug mit Duplexfunktion f\u00fcr bis zu 50 Blatt zum Scannen, Kopieren oder Faxen doppelseitiger Dokumente und die optionale Papierkassette, die die Papierkapazit\u00e4t auf insgesamt bis zu 800 Blatt erweitert, garantieren ebenfalls schnelleres und effizienteres Arbeiten.\\n\\n<b>Zielwahl-Tasten f\u00fcr einfache Bedienung<\/b>\\nDas intuitive 5-zeilige LCD-Display zeigt mehr Informationen an, damit Anwender die verf\u00fcgbaren Funktionen optimal nutzen k\u00f6nnen. F\u00fcr einen noch h\u00f6heren Bedienkomfort sorgen Zielwahltasten, die direktes Scannen auf den PC, umweltfreundliches Kopieren mehrerer Seiten auf einen Ausdruck zum Einsparen von Papier und Kosten und sicheren Druck von vertraulichen Dokumenten erm\u00f6glichen und Ressourcen schonen.\\n\\n<b>Beschleunigte Arbeitsabl\u00e4ufe<\/b>\\nMit den SEND-Funktionen von Canon k\u00f6nnen Sie Ihre Dokumente schneller und effizienter verteilen. Sie bieten die M\u00f6glichkeit direkt in eine E-Mail, einen Netzwerkordner oder auf einen USB-Stick zu scannen. Dar\u00fcber hinaus erstellt die Compact PDF-Komprimierungstechnologie kleinere Dateien \u2013 mit bis zu einem Zehntel der Gr\u00f6\u00dfe, die standardm\u00e4\u00dfige Komprimierung bietet \u2013 ohne Qualit\u00e4tsverlust, sodass Dokumente einfacher gesendet und gemeinsam genutzt werden k\u00f6nnen.\\n\\n<b>Einfaches Einbindung in Netzwerk \u2013 mit und ohne Kabel<\/b>\\nMit diesem leistungsstarken, netzwerkf\u00e4higen Ger\u00e4t, auf das jedes Mitglied der Arbeitsgruppe zugreifen kann, sparen Sie Platz und Kosten. Der i-SENSYS MF5980dw kann \u00fcber das Netzwerk problemlos verwaltet werden, und die Wi-Fi-Kompatibilit\u00e4t erm\u00f6glicht eine einfache Integration in das WLAN.\\n\\n<b>Nahtlose Integration<\/b>\\nDieses Ger\u00e4t verf\u00fcgt \u00fcber eine integrierte Netzwerkkarte und unterst\u00fctzt die Druckersprachen PCL 5c\/6 und PostScript Level 3 f\u00fcr eine problemlose Integration in bestehende Druckumgebungen.\\n\\n<b>Energie sparen und Kosten senken<\/b>\\nSch\u00fctzen Sie die Umwelt, und reduzieren Sie gleichzeitig Kosten. Der i-SENSYS MF5980dw erf\u00fcllt die Energy Star-Richtlinie und ist mit seinen geringen durchschnittlichen Energieverbrauch (TEC) von nur 1,4 kWh branchenf\u00fchrend. Im Ruhezustand ist er mit einem Verbrauch von lediglich 2,3 Watt noch energiesparender. Automatischer Duplexdruck f\u00fchrt durch geringeren Papierverbrauch zu weiteren Kosteneinsparungen."},{"locale":"en_US","scope":"print","data":"<b>Compact laser All-in-One<\/b>\\nMeet the demands of small, busy workgroups with the exceptional performance of this compact, network-ready multifunctional. The easy to use i-SENSYS MF5980dw offers double-sided printing, scanning, copying and faxing in a single slim device.\\n\\n<b>Time-saver<\/b>\\nThe i-SENSYS MF5980dw boosts productivity with its 33 ppm output speed and class-leading First Copy Out Time of less than 8 seconds. There is also minimal waiting time for print outs, thanks to Quick First-Print technologies. The 50-sheet Duplex Automatic Document Feeder for scanning, copying or faxing double-sided documents, together with the optional cassette that expands paper supply capacity up to 800 sheets, also ensure faster and more efficient working.\\n\\n<b>One touch, ease of use<\/b>\\nThe intuitive 5-line LCD display presents more information on screen, so users make the most of the available functions. For even greater ease of use, there are one touch solution keys that allow quick scanning direct to your PC; eco-copying for combining several pages into a single print out, saving paper and money; and secure print, which is a secure way to print sensitive documents and reduce waste.\\n\\n<b>Accelerate workflows<\/b>\\nDistribute your documents faster and more efficiently using Canon\u2019s SEND functionality. With this you can scan direct to email, a network folder or a USB memory key. In addition, Compact PDF compression technology creates smaller files \u2013 up to 1\/10th of the size achievable with standard compression \u2013 without compromising quality, making it much easier to send and share documents.\\n\\n<b>Easy networking \u2013 wired and wireless<\/b>\\nSave space and cut costs with one high performance network-ready device that\u2019s available to everyone in the workgroup. The i-SENSYS MF5980dw is easy to manage over the network and Wi-Fi compatibility enables you to easily integrate it into your wireless network.\\n\\n<b>Seamless integration<\/b>\\nThis network-ready unit offers PCL 5c, PCL 6 and PostScript Level 3 support for easy integration into your existing print environment.\\n\\n<b>Save energy and cut costs<\/b>\\nReduce your impact on the environment, while cutting costs. Energy Star compliant, the i-SENSYS MF5980dw leads the way with one of the lowest Typical Energy Consumption (TEC) figures \u2013 just 1.4 kWh. In sleep mode it only consumes 2.3 Watts for greater energy efficiency. Automatic double-sided printing cuts costs further by reducing paper usage."},{"locale":"fr_FR","scope":"print","data":"<b>Multifonction laser compact<\/b>\\nR\u00e9pondez aux besoins des petits groupes de travail \u00e0 forte activit\u00e9 gr\u00e2ce aux performances exceptionnelles de cet appareil multifonction compatible r\u00e9seau compact. Simple d'utilisation, l'i-SENSYS MF5980dw offre des fonctions d'impression recto verso, de num\u00e9risation, de copie et de t\u00e9l\u00e9copie r\u00e9unies en un seul appareil au design compact.\\n\\n<b>\u00c9conomie de temps<\/b>\\nL'i-SENSYS MF5980dw permet d'optimiser la productivit\u00e9 gr\u00e2ce \u00e0 sa vitesse de sortie de 33 ppm et son temps de sortie de la premi\u00e8re copie in\u00e9gal\u00e9 inf\u00e9rieur \u00e0 8 secondes. Les technologies \u00ab Quick First-Print \u00bb (premi\u00e8re sortie rapide) permettent \u00e9galement un temps d'attente minimal pour les impressions. Son chargeur automatique de documents recto verso de 50 pages pour la num\u00e9risation, la copie ou la t\u00e9l\u00e9copie de documents recto verso, associ\u00e9 \u00e0 la cassette en option permettant d'\u00e9tendre la capacit\u00e9 papier jusqu'\u00e0 800 feuilles, contribuent \u00e9galement \u00e0 accro\u00eetre la rapidit\u00e9 et l'efficacit\u00e9 de travail.\\n\\n<b>Simplicit\u00e9 d'utilisation \u00e0 partir d'une seule touche<\/b>\\nL'\u00e9cran LCD intuitif de 5 lignes pr\u00e9sente plus d'informations \u00e0 l'\u00e9cran de sorte que les utilisateurs tirent le meilleur parti des fonctions disponibles. Pour une simplicit\u00e9 d'utilisation encore accrue, des commandes par simple pression d'une touche permettent la num\u00e9risation rapide directement vers votre PC ; la copie \u00e9conomique en combinant plusieurs pages en une seule impression, r\u00e9alisant ainsi des \u00e9conomies de papier et d'argent ; et l'impression s\u00e9curis\u00e9e, qui permet d'imprimer en toute s\u00e9curit\u00e9 les documents sensibles tout en r\u00e9duisant le gaspillage.\\n\\n<b>Acc\u00e9l\u00e9ration des flux de travail<\/b>\\nDistribuez vos documents plus rapidement et efficacement \u00e0 l'aide de la fonctionnalit\u00e9 ENVOI de Canon. Cette fonctionnalit\u00e9 vous permet d'effectuer une num\u00e9risation directement vers un courriel, un dossier r\u00e9seau ou une cl\u00e9 USB. En outre, la technologie de compression \u00ab Compact PDF \u00bb permet de cr\u00e9er des fichiers de plus petite taille (jusqu'\u00e0 1\/10\u00e8me de la taille obtenue en utilisant la compression classique) sans pour autant compromettre la qualit\u00e9, facilitant ainsi nettement l'envoi et le partage de documents.\\n\\n<b>Mise en r\u00e9seau (filaire et sans fil) ais\u00e9e<\/b>\\n\u00c9conomisez de l'espace et r\u00e9duisez les co\u00fbts en mettant ce p\u00e9riph\u00e9rique compatible r\u00e9seau hautes performances unique \u00e0 la disposition de tous les membres du groupe de travail. L'i-SENSYS MF5980dw est facile \u00e0 g\u00e9rer sur le r\u00e9seau et sa compatibilit\u00e9 Wi-Fi vous permet de l'int\u00e9grer \u00e0 votre r\u00e9seau sans fil en toute simplicit\u00e9.\\n\\n<b>Int\u00e9gration transparente<\/b>\\nCette unit\u00e9 compatible r\u00e9seau prend en charge le PCL 5c, PCL 6 et le Postscript 3, facilitant ainsi son int\u00e9gration dans votre environnement d'impression existant.\\n\\n<b>R\u00e9duisez vos co\u00fbts tout en faisant des \u00e9conomies d'\u00e9nergie<\/b>\\nAtt\u00e9nuez votre impact sur l'environnement tout en r\u00e9duisant les co\u00fbts. Conforme \u00e0 la norme Energy Star, l'i-SENSYS MF5980dw donne l'exemple en affichant l'une des consommations r\u00e9elles d'\u00e9lectricit\u00e9 (TEC) les plus faibles, \u00e0 savoir 1,4 kWh seulement. Il consomme uniquement 2,3 watts en mode veille, pour une efficacit\u00e9 \u00e9nerg\u00e9tique accrue. L'impression recto verso automatique contribue \u00e0 minimiser les co\u00fbts en r\u00e9duisant l'utilisation de papier."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-08T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"e4878ffe-030c-4f46-b465-2ae86925f3ac","identifier":"10949760","enabled":true,"family":"multifunctionals","categories":["lexmark","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a3_297_x_420_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print","scan"]}],"name":[{"locale":null,"scope":null,"data":"Lexmark X950de"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Intuitive Color Touch screen<\/b>\\nThe extra large 10.2-inch color touch screen allows you to operate your MFP with ease through intuitive navigation and easy access to workflow solutions.\\n\\n<b>Exceptional Media Handling<\/b>\\nUltra-reliable paper feeding lets you load up to six different media types, including sizes up to 12.6 x 48 inch and weights up to 300 gsm.\\n\\n<b>Advanced Finishing Options<\/b>\\nEasily create professional output in-house with flexible finishing options, including multi-position stapling, hole punch, expanded output stacking, and booklet capability.\\n\\n<b>Outstanding A3 Color Output<\/b>\\nPANTONE\u00ae calibration helps ensure consistent color tones and Named Color Replacement makes color matching easy.\\n\\n<b>Productive and Intuitive<\/b>\\nScan to multiple destinations: scan to e-mail, scan to FTP, scan to fax, scan to network, scan to USB drive, and more.\\n\\n<b>Protecting Your Information<\/b>\\nMultilayered security features help protect your devices, your documents, your information, and your network infrastructure."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-08T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"a164b05a-4252-4b1e-9d73-5d9096b56374","identifier":"10958432","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","sony"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"0\/b\/6\/2\/0b62715687a2af8f2c545f47df13c72a2f7aa810_10958432_Sony.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/0\/b\/6\/2\/0b62715687a2af8f2c545f47df13c72a2f7aa810_10958432_Sony.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Sony SLT-A77VK digital camera"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"Erf\u00fcllt die kreativen Anforderungen wahrer Fotoliebhaber<br\/>\\n<br\/>24,3 Mio. Pixel (effektiv): Extrem hochaufl\u00f6sender Exmor\u2122 APS HD CMOS Sensor mit Rauschunterdr\u00fcckung in 2 Stufen f\u00fcr makellose Stand- und Videoaufnahmen mit geringem Rauschen.<br\/>\\n\u00dcberarbeiteter BIONZ Prozessor: Der optimierte Bildprozessor verarbeitet gro\u00dfe Datenmengen des Sensors, damit Sie schnell hervorragende Bilder mit geringem Rauschen aufnehmen k\u00f6nnen.<br\/>\\nTranslucent Mirror-Technologie: Der bewegliche DSLR-Spiegel wird durch einen unbeweglichen, durchsichtigen Spiegel ersetzt: So sind extrem schnelle Reaktionszeiten bei pr\u00e4zisem Phasendetektions-AF m\u00f6glich..<br\/>\\nErstklassige Verschlusszeit: Ultrakurze Verschlusszeit von nur 50 ms entspricht der Leistung hochwertiger Profikameras: Hervorragend geeignet f\u00fcr schnelle Actionszenen.<br\/>\\nDT 18 \u2013 55 mm F3,5 \u2013 5,6 SAM Objektiv: Bietet hochwertiges Tele-Zoomobjektiv f\u00fcr allgemeine Anwendungen \u2013 ideal f\u00fcr den t\u00e4glichen Gebrauch.<br\/>\\nSerienaufnahmefunktion: Erfassen Sie schnelle Actionszenen mit bis zu 12 Bildern pro Sekunde dank permanentem Autofokus f\u00fcr Videoaufnahmen f\u00fcr blitzschnelle Verfolgung bewegter Objekte.<br\/>\\nQuick AF Full HD Movie: Nehmen Sie mit permanentem Autofokus1920 x 1080 Videos von bewegten Motiven auf: Jetzt mit progressivem 24p\/50p-Aufnahmemodus f\u00fcr kinoreife Ergebnisse.<br\/>\\nKreative Full HD-Videofunktionen: Der manuelle Fokus erm\u00f6glicht einen wundersch\u00f6nen Unsch\u00e4rfe-Effekt (Bokeh) bei HD-Videoaufzeichnungen; PASM-Belichtungsmodi bieten volle kreative Kontrolle.<br\/>\\nVerbesserter Quick AF Live View: Hochaufgel\u00f6ste Bildanzeige vom Hauptbildsensor auf dem LC-Display oder im Sucher mit schnellem, pr\u00e4zisem Phasendetektions-Autofokus.<br\/>\\nAF mit Objektverfolgung: Damit bleiben Gesichter und andere ausgew\u00e4hlte Motive scharf fokussiert, selbst wenn das Ziel kurzfristig von einem vorbeikommenden Objekt verdeckt wird.<br\/>\\n3D-Schwenkpanorama: Dr\u00fccken Sie den Ausl\u00f6ser und schwenken die Kamera, um extrabreite Panoramabilder aufzunehmen: Sie k\u00f6nnen 3D-Panoramen auch zur Anzeige auf 3D-Fernsehern aufnehmen.<br\/>\\nHohe Empfindlichkeit von ISO 50 bis 16000: Die hohe Empfindlichkeit erm\u00f6glicht nat\u00fcrliche Bilder mit geringem Rauschen, selbst bei schwierigen Lichtverh\u00e4ltnissen: Der erweiterte Modus dehnt die Empfindlichkeit auf ISO 50 aus.<br\/>\\n19-Punkt AF-Phasendetektionssystem: Neu entwickeltes AF-System mit 11 Fadenkreuzsensoren f\u00fcr akkuraten, unterbrechungsfreien Autofokus \u2013 verf\u00fcgbar mit Viewfinder oder Live View auf dem LCD.<br\/>\\nIn 3 Richtungen neigbares 7,5 cm (3,0 Zoll) Xtra Fine LCD: Frei einstellbares, hochaufl\u00f6sendes LC-Display (921.000 Pixel): mit TruBlack\u2122 Technologie f\u00fcr hervorragende Detailtreue und Kontraste.<br\/>\\nXGA OLED TruFinder\u2122: Pr\u00e4zisier elektronischer Sucher mit hohem Kontrast und 100 %iger Bildabdeckung f\u00fcr akkurate Beurteilung der Positionierung, Fokussierung und Qualit\u00e4t der Aufnahme.<br\/>\\nHochaufl\u00f6sende Informationsanzeige: Sie k\u00f6nnen verschiedene Digitalanzeigen, Aufnahmeparameter, Aufteilungslinien und grafische Belichtungshilfen anzeigen.<br\/>\\nTelekonverter: Ein Digitalzoom vergr\u00f6\u00dfert den zentralen Bereich eines Bildes 1,4fach oder 2fach f\u00fcr hochaufl\u00f6sende Bilder mit 12 Mio. Pixeln.<br\/>\\nVorschau des Aufnahmeergebnisses: Per Knopfdruck k\u00f6nnen Sie die Wirkung der Blendeneinstellung, Verschluss- und DRO-Einstellungen auf Tiefensch\u00e4rfe, Bewegungsunsch\u00e4rfe und Dynamikumfang \u00fcberpr\u00fcfen.<br\/>\\nVerbesserter Automatikmodus: Analysiert automatisch Szenen und Aufnahmebedingungen und passt die Kameraeinstellungen entsprechend an, um immer hervorragende Ergebnisse zu gew\u00e4hrleisten.<br\/>\\nGesichtserkennung mit Gesichtsregistrierung: Pro Szene k\u00f6nnen bis zu 8 Gesichter erkannt werden, wobei Optimalbelichtung, Wei\u00dfabgleich, Blitz und andere Parameter zur Aufnahme ansprechender Portr\u00e4ts optimiert werden.<br\/>\\nSmile Shutter: L\u00f6st dank der einstellbaren Smile Shutter-Funktion f\u00fcr L\u00e4cheln automatisch eine Aufnahme aus, wenn die Person im Sucher l\u00e4chelt.<br\/>\\nBildeffektmodi: Erstellen Sie beeindruckende Effekte ganz ohne PC \u2013 unter anderem mit Posterisation, Teilfarbfilter, HDR Painting, Weichzeichner, Miniatureffekt.<br\/>\\nVerbesserte HDR-Automatik: Erzeugt aus drei aufeinander folgenden Aufnahmen automatisch ein einziges Bild mit einem Dynamikumfang, der sogar den von Film \u00fcbersteigt.<br\/>\\nMulti-Frame-Rauschunterdr\u00fcckung: Kombiniert automatisch eine Serienaufnahme von sechs Bildern, um ein einzelnes Bild mit sehr niedrigem Rauschen zu erzeugen.<br\/>\\nHandheld D\u00e4mmerungsmodus: Kombiniert autom. eine Serienaufnahme von sechs Bildern, um ein einzelnes Bild mit verminderter Unsch\u00e4rfe und weniger Rauschen bei schlechten Lichtverh\u00e4ltnissen zu erzeugen.<br\/>\\nEinfaches GPS-Geotagging: F\u00fcgt Bildern automatisch Ortsinformationen hinzu: Kartenansichten sind mit der PMB-Software oder auf BRAVIA-Fernsehern mit der Photo Map-Funktion m\u00f6glich.<br\/>\\nKreativmodi: 6 ausw\u00e4hlbare Finish-Optionen f\u00fcr jede Aufnahmesituation, die f\u00fcr noch mehr kreative Freiheit entsprechend angepasst werden k\u00f6nnen.<br\/>\\nDynamische Bereichsoptimierung: Dynamische Bereichsoptimierung \u2013 Analysiert das Bild in Echtzeit und stellt Helligkeit und Kontrast f\u00fcr eine optimale Belichtung bei Szenen mit Hintergrundbeleuchtung ein.<br\/>\\nVielseitige Serienaufnahmemodi: Zu den Serienaufnahmemodi geh\u00f6ren: Serienbild, Selbstausl\u00f6ser, Autom. Belichtungsreihe (Exposure Bracketing) und Belichtungsreihe mit Wei\u00dfabgleich (White Balance Bracketing).<br\/>\\nKn\u00f6pfe auf der Vorder- und R\u00fcckseite sowie Datenanzeige auf dem LC-Display: Kn\u00f6pfe an Vorder- und R\u00fcckseite des Griffs erm\u00f6glichen schnelle Einstellungen: zweite Datenanzeige f\u00fcr Belichtung und andere Einstellungen.<br\/>\\nKonfigurierbare Tasten: AEL-, ISO- und AF\/MF-Taste k\u00f6nnen f\u00fcr bequemen Zugang 24 Funktionen zugewiesen werden.<br\/>\\nSteadyShot INSIDE: Integrierte Bildstabilisierung bietet eine Anti-Shake-Funktion mit 2,5\u20134,0 Schritten f\u00fcr alle A-Objektive von Sony oder Konica Minolta.<br\/>\\nKompensierung von Schattierungen und Abbildungsfehlern: Intelligente Korrektur von Vignettierung (Randschattierung), seitliche Abbildungsfehler und Verzerrung f\u00fcr jedes A-Objektiv.<br\/>\\nRobustes Magnesiumgeh\u00e4use: Robuste Geh\u00e4usefl\u00e4chen widerstehen selbst starker Beanspruchung Tasten und Steuerungen sind vor Staub und Feuchtigkeit gesch\u00fctzt.<br\/>\\nZweifaches Anti-Staubsystem: Reduziert das Ansammeln von Staub auf dem Sensor beim Austauschen des Objektivs.<br\/>\\nHDMI\u00ae Ausgang: HD-Ausgang f\u00fcr die Anzeige von Fotos auf einem HD-Fernseher (optionales Kabel erforderlich). Photo TV HD optimiert die Anzeige von Fotos auf kompatiblen BRAVIA Ger\u00e4ten.<br\/>\\nBRAVIA Sync: F\u00fcr die Steuerung der Wiedergabefunktionen der Kamera \u00fcber die Fernbedienung des BRAVIA\u00ae Fernsehers.<br\/>\\nMitgelieferte Software: Inklusive: Image Data Converter SR, Image Data Lightbox SR und Picture Motion Browser.<br\/>\\n"},{"locale":"en_US","scope":"print","data":"<b>Built to keep delivering serious images<\/b>\\nStep up to new levels of imaging quality, performance and handling to meet the demands of serious photo enthusiasts. Capture flawless images and Full HD video, with class-leading responsiveness and immense creative control.\\n\\n<b>It's all in the detail<\/b>\\nThe high-resolution 24.3 megapixel CMOS sensor assures detail-packed pictures with excellent contrast and gorgeous colours. Exmor technology cuts noise while signals are converted to digital form. The result? Flawlessly beautiful images.\\n\\n<b>World's fastest continuous shooting<\/b>\\nCapture fleeting action with a continuous burst of full-resolution images at up to 12 frames per second. It's the quickest shooting performance of any consumer-oriented APS-C interchangeable-lens digital camera (Aug. 2011).\\n\\n<b>Total control over your image<\/b>\\nCraft beautiful images more decisively, with fingertip access to key functions and custom buttons. Front- and rear-mounted dials simplify quick adjustments. There's also a secondary display to confirm exposure and other settings.\\n\\n<b>Amazing HD movies<\/b>\\nCapture smooth, detailed Full HD videos with accurate phase-detection autofocus of moving subjects. Produce beautiful background defocus effects, and enjoy full manual control over focus and exposure modes. Create a cinematic mood with progressive shooting.\\n\\n<b>Tough, durable performance<\/b>\\nHandle challenging asignments with ease. The magnesium alloy body combines rigidity and lightness, while seals aroud key buttons and dials guard against dust and moisture. The newly developed shutter unit is proven to approx. 150,000 releases."},{"locale":"fr_FR","scope":"print","data":"<b>Con\u00e7u pour r\u00e9aliser des prises de vue de qualit\u00e9<\/b>\\nD\u00e9couvrez un appareil photo avec une qualit\u00e9 d'image, des performances et une utilisation in\u00e9dites, qui r\u00e9pondent aux besoins des v\u00e9ritables amateurs de photos. R\u00e9alisez des photos et des vid\u00e9os Full HD parfaites, gr\u00e2ce \u00e0 la rapidit\u00e9 remarquable et \u00e0 la cr\u00e9ativit\u00e9 exceptionnelle qu'offre ce mod\u00e8le.\\n\\n<b>L'importance du d\u00e9tail<\/b>\\nGr\u00e2ce au capteur CMOS haute r\u00e9solution de 24,3 m\u00e9gapixels, r\u00e9alisez des photos d'une pr\u00e9cision exceptionnelle, associant de sublimes couleurs et un contraste \u00e9lev\u00e9. La technologie Exmor\u2122 r\u00e9duit les bruits ambiants lors de la conversion des signaux au format num\u00e9rique. Le r\u00e9sultat ? Des photos parfaitement r\u00e9ussies.\\n\\n<b>La prise de vue la plus rapide au monde<\/b>\\nSaisissez les sc\u00e8nes les plus furtives gr\u00e2ce \u00e0 une prise de vue en rafale pleine r\u00e9solution vous permettant de capturer jusqu'\u00e0 12 images par seconde : la vitesse de prise de vue la plus \u00e9lev\u00e9e sur un appareil photo num\u00e9rique \u00e0 objectifs interchangeables de type APS-C destin\u00e9 au grand public (ao\u00fbt 2011).\\n\\n<b>Prenez le contr\u00f4le de vos photos<\/b>\\nCr\u00e9ez de superbes photos en toute confiance gr\u00e2ce \u00e0 des fonctions accessibles du bout des doigts et des touches personnalisables. Des boutons situ\u00e9s \u00e0 l'avant et \u00e0 l'arri\u00e8re vous permettent d'effectuer des r\u00e9glages rapidement et en toute simplicit\u00e9 et un second \u00e9cran vous permet de r\u00e9gler l'exposition et les autres param\u00e8tres.\\n\\n<b>Des films HD exceptionnels<\/b>\\nCapturez des vid\u00e9os Full HD fluides et d\u00e9taill\u00e9es gr\u00e2ce \u00e0 la fonction de d\u00e9tection de phase pr\u00e9cise pour la mise au point des sujets en mouvement. Produisez des effets de flou artistique en arri\u00e8re-plan et profitez d'un contr\u00f4le enti\u00e8rement manuel des modes de mise au point et d'exposition. Cr\u00e9ez une ambiance cin\u00e9ma avec le mode de prise de vue progressif.\\n\\n<b>Des performances hors pair sur le long terme<\/b>\\nTraitez vos t\u00e2ches les plus complexes en toute facilit\u00e9. Le bo\u00eetier en alliage de magn\u00e9sium associe rigidit\u00e9 et l\u00e9g\u00e8ret\u00e9, tandis que les capuchons autour des boutons et des touches de base prot\u00e8gent votre appareil de la poussi\u00e8re et de l'humidit\u00e9. Le tout nouvel obturateur a \u00e9t\u00e9 test\u00e9 sur environ 150 000 cycles."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-09T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"0d0b3f47-5e87-43df-bd6f-cecc449e0958","identifier":"10959423","enabled":true,"family":"webcams","categories":["cameras_sales","icidu","webcams"],"groups":[],"parent":null,"values":{"maximum_video_resolution":[{"locale":null,"scope":null,"data":"1280_x_1024"}],"picture":[{"locale":null,"scope":null,"data":"7\/9\/3\/3\/7933b84c0abe9f318971f22275557bc110565c08_10959423_2323.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/7\/9\/3\/3\/7933b84c0abe9f318971f22275557bc110565c08_10959423_2323.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"ICIDU 1.3 Megapixel webcam with microphone"}],"description":[{"locale":"de_DE","scope":"print","data":"Mit dieser Webcam k\u00f6nnen Sie Live-Kontakt mit Ihren Freunden etablieren. Die hohe Aufl\u00f6sung und Mikrofon gew\u00e4hrleistet Sie von einem guten Empfangspunkt auf der anderen Seite."},{"locale":"en_US","scope":"print","data":"With this webcam you can establish live contact with your friends. The high resolution and microphone ensures you good quility pictures and sound at the other side."},{"locale":"fr_FR","scope":"print","data":"Avec cette webcam, vous pouvez \u00e9tablir un contact direct avec vos amis. La haute r\u00e9solution et d'un microphone vous assure d'une bonne arrivage \u00e0 l'autre c\u00f4t\u00e9."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-09T00:00:00+00:00"}],"maximum_frame_rate":[{"locale":null,"scope":null,"data":30}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"33dacb60-ce79-45bc-9391-93cb363ee987","identifier":"10959424","enabled":true,"family":"webcams","categories":["cameras_sales","icidu","webcams"],"groups":[],"parent":null,"values":{"maximum_video_resolution":[{"locale":null,"scope":null,"data":"1280_x_720"}],"picture":[{"locale":null,"scope":null,"data":"7\/9\/f\/b\/79fb0c004e15243f18b7bcc383f20f7973c55ec8_10959424_8604.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/7\/9\/f\/b\/79fb0c004e15243f18b7bcc383f20f7973c55ec8_10959424_8604.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"ICIDU HD Webcam 720P"}],"total_megapixels":[{"locale":null,"scope":null,"data":"12"}],"description":[{"locale":"de_DE","scope":"print","data":"F\u00fcr die beste Qualit\u00e4t f\u00fcr Ihre Video-Chat brauchen Sie die ICIDU HD Webcam. Scharfe Bilder und exzellenten Klang durch das Mikrofon."},{"locale":"en_US","scope":"print","data":"For the best quality video chat you use the ICIDU HD webcam. Sharp images and excellent sound with the build in microphone."},{"locale":"fr_FR","scope":"print","data":"Pour la meilleure qualit\u00e9 pour votre chat vid\u00e9o, vous utilisez l'ICIDU webcam HD. Des images nettes et son excellent gr\u00e2ce au la microphone."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-09T00:00:00+00:00"}],"maximum_frame_rate":[{"locale":null,"scope":null,"data":30}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"84ad3988-56a1-4229-93b9-cf828ab2d29f","identifier":"10959625","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["scan"]}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS MF5980dw"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Kompaktes Laser-Multifunktionssystem<\/b>\\nDie herausragende Leistung dieses kompakten, netzwerkf\u00e4higen Multifunktionsger\u00e4ts erf\u00fcllt die Anforderungen kleiner, vielbesch\u00e4ftigter Arbeitsgruppen. Der benutzerfreundliche i-SENSYS MF5980dw bietet Duplexdruck (beidseitig), Scan-, Kopier- und Faxfunktionen in einem schlanken Ger\u00e4t.\\n\\n<b>Zeitsparend<\/b>\\nDer i-SENSYS MF5980dw steigert mit seiner Ausgabegeschwindigkeit von 33 Seiten pro Minute und schneller Ausgabe der ersten Seite nach weniger als 8 Sekunden die Produktivit\u00e4t. Au\u00dferdem gew\u00e4hrleistet die Quick First Print-Technologie minimale Wartezeiten f\u00fcr Ausdrucke. Der automatische Dokumenteneinzug mit Duplexfunktion f\u00fcr bis zu 50 Blatt zum Scannen, Kopieren oder Faxen doppelseitiger Dokumente und die optionale Papierkassette, die die Papierkapazit\u00e4t auf insgesamt bis zu 800 Blatt erweitert, garantieren ebenfalls schnelleres und effizienteres Arbeiten.\\n\\n<b>Zielwahl-Tasten f\u00fcr einfache Bedienung<\/b>\\nDas intuitive 5-zeilige LCD-Display zeigt mehr Informationen an, damit Anwender die verf\u00fcgbaren Funktionen optimal nutzen k\u00f6nnen. F\u00fcr einen noch h\u00f6heren Bedienkomfort sorgen Zielwahltasten, die direktes Scannen auf den PC, umweltfreundliches Kopieren mehrerer Seiten auf einen Ausdruck zum Einsparen von Papier und Kosten und sicheren Druck von vertraulichen Dokumenten erm\u00f6glichen und Ressourcen schonen.\\n\\n<b>Beschleunigte Arbeitsabl\u00e4ufe<\/b>\\nMit den SEND-Funktionen von Canon k\u00f6nnen Sie Ihre Dokumente schneller und effizienter verteilen. Sie bieten die M\u00f6glichkeit direkt in eine E-Mail, einen Netzwerkordner oder auf einen USB-Stick zu scannen. Dar\u00fcber hinaus erstellt die Compact PDF-Komprimierungstechnologie kleinere Dateien \u2013 mit bis zu einem Zehntel der Gr\u00f6\u00dfe, die standardm\u00e4\u00dfige Komprimierung bietet \u2013 ohne Qualit\u00e4tsverlust, sodass Dokumente einfacher gesendet und gemeinsam genutzt werden k\u00f6nnen.\\n\\n<b>Einfaches Einbindung in Netzwerk \u2013 mit und ohne Kabel<\/b>\\nMit diesem leistungsstarken, netzwerkf\u00e4higen Ger\u00e4t, auf das jedes Mitglied der Arbeitsgruppe zugreifen kann, sparen Sie Platz und Kosten. Der i-SENSYS MF5980dw kann \u00fcber das Netzwerk problemlos verwaltet werden, und die Wi-Fi-Kompatibilit\u00e4t erm\u00f6glicht eine einfache Integration in das WLAN.\\n\\n<b>Nahtlose Integration<\/b>\\nDieses Ger\u00e4t verf\u00fcgt \u00fcber eine integrierte Netzwerkkarte und unterst\u00fctzt die Druckersprachen PCL 5c\/6 und PostScript Level 3 f\u00fcr eine problemlose Integration in bestehende Druckumgebungen.\\n\\n<b>Energie sparen und Kosten senken<\/b>\\nSch\u00fctzen Sie die Umwelt, und reduzieren Sie gleichzeitig Kosten. Der i-SENSYS MF5980dw erf\u00fcllt die Energy Star-Richtlinie und ist mit seinen geringen durchschnittlichen Energieverbrauch (TEC) von nur 1,4 kWh branchenf\u00fchrend. Im Ruhezustand ist er mit einem Verbrauch von lediglich 2,3 Watt noch energiesparender. Automatischer Duplexdruck f\u00fchrt durch geringeren Papierverbrauch zu weiteren Kosteneinsparungen."},{"locale":"en_US","scope":"print","data":"<b>Compact laser All-in-One<\/b>\\nMeet the demands of small, busy workgroups with the exceptional performance of this compact, network-ready multifunctional. The easy to use i-SENSYS MF5980dw offers double-sided printing, scanning, copying and faxing in a single slim device.\\n\\n<b>Time-saver<\/b>\\nThe i-SENSYS MF5980dw boosts productivity with its 33 ppm output speed and class-leading First Copy Out Time of less than 8 seconds. There is also minimal waiting time for print outs, thanks to Quick First-Print technologies. The 50-sheet Duplex Automatic Document Feeder for scanning, copying or faxing double-sided documents, together with the optional cassette that expands paper supply capacity up to 800 sheets, also ensure faster and more efficient working.\\n\\n<b>One touch, ease of use<\/b>\\nThe intuitive 5-line LCD display presents more information on screen, so users make the most of the available functions. For even greater ease of use, there are one touch solution keys that allow quick scanning direct to your PC; eco-copying for combining several pages into a single print out, saving paper and money; and secure print, which is a secure way to print sensitive documents and reduce waste.\\n\\n<b>Accelerate workflows<\/b>\\nDistribute your documents faster and more efficiently using Canon\u2019s SEND functionality. With this you can scan direct to email, a network folder or a USB memory key. In addition, Compact PDF compression technology creates smaller files \u2013 up to 1\/10th of the size achievable with standard compression \u2013 without compromising quality, making it much easier to send and share documents.\\n\\n<b>Easy networking \u2013 wired and wireless<\/b>\\nSave space and cut costs with one high performance network-ready device that\u2019s available to everyone in the workgroup. The i-SENSYS MF5980dw is easy to manage over the network and Wi-Fi compatibility enables you to easily integrate it into your wireless network.\\n\\n<b>Seamless integration<\/b>\\nThis network-ready unit offers PCL 5c, PCL 6 and PostScript Level 3 support for easy integration into your existing print environment.\\n\\n<b>Save energy and cut costs<\/b>\\nReduce your impact on the environment, while cutting costs. Energy Star compliant, the i-SENSYS MF5980dw leads the way with one of the lowest Typical Energy Consumption (TEC) figures \u2013 just 1.4 kWh. In sleep mode it only consumes 2.3 Watts for greater energy efficiency. Automatic double-sided printing cuts costs further by reducing paper usage."},{"locale":"fr_FR","scope":"print","data":"- Impression, copie, t\u00e9l\u00e9copie et num\u00e9risation recto verso automatiques\\n- 33 ppm\/cpm, temps de sortie de la premi\u00e8re copie de 8 secondes\\n- Touches permettant une num\u00e9risation ais\u00e9e, une copie \u00e9conomique et une impression s\u00e9curis\u00e9e\\n- Num\u00e9risation vers messagerie \u00e9lectronique, dossier r\u00e9seau et cl\u00e9 USB\\n- Ethernet et Wi-Fi\\n- PCL5e\/6 et PostScript\\n- Faible consommation d'\u00e9nergie\\n- Solution multifonction flexible pour les petits groupes de travail \u00e0 forte activit\u00e9.\\n\\n<b>Multifonction laser compact<\/b>\\nR\u00e9pondez aux besoins des petits groupes de travail \u00e0 forte activit\u00e9 gr\u00e2ce aux performances exceptionnelles de cet appareil multifonction compatible r\u00e9seau compact. Simple d'utilisation, l'i-SENSYS MF5980dw offre des fonctions d'impression recto verso, de num\u00e9risation, de copie et de t\u00e9l\u00e9copie r\u00e9unies en un seul appareil au design compact.\\n\\n<b>\u00c9conomie de temps<\/b>\\nL'i-SENSYS MF5980dw permet d'optimiser la productivit\u00e9 gr\u00e2ce \u00e0 sa vitesse de sortie de 33 ppm et son temps de sortie de la premi\u00e8re copie in\u00e9gal\u00e9 inf\u00e9rieur \u00e0 8 secondes. Les technologies \u00ab Quick First-Print \u00bb (premi\u00e8re sortie rapide) permettent \u00e9galement un temps d'attente minimal pour les impressions. Son chargeur automatique de documents recto verso de 50 pages pour la num\u00e9risation, la copie ou la t\u00e9l\u00e9copie de documents recto verso, associ\u00e9 \u00e0 la cassette en option permettant d'\u00e9tendre la capacit\u00e9 papier jusqu'\u00e0 800 feuilles, contribuent \u00e9galement \u00e0 accro\u00eetre la rapidit\u00e9 et l'efficacit\u00e9 de travail.\\n\\n<b>Simplicit\u00e9 d'utilisation \u00e0 partir d'une seule touche<\/b>\\nL'\u00e9cran LCD intuitif de 5 lignes pr\u00e9sente plus d'informations \u00e0 l'\u00e9cran de sorte que les utilisateurs tirent le meilleur parti des fonctions disponibles. Pour une simplicit\u00e9 d'utilisation encore accrue, des commandes par simple pression d'une touche permettent la num\u00e9risation rapide directement vers votre PC ; la copie \u00e9conomique en combinant plusieurs pages en une seule impression, r\u00e9alisant ainsi des \u00e9conomies de papier et d'argent ; et l'impression s\u00e9curis\u00e9e, qui permet d'imprimer en toute s\u00e9curit\u00e9 les documents sensibles tout en r\u00e9duisant le gaspillage.\\n\\n<b>Acc\u00e9l\u00e9ration des flux de travail<\/b>\\nDistribuez vos documents plus rapidement et efficacement \u00e0 l'aide de la fonctionnalit\u00e9 ENVOI de Canon. Cette fonctionnalit\u00e9 vous permet d'effectuer une num\u00e9risation directement vers un courriel, un dossier r\u00e9seau ou une cl\u00e9 USB. En outre, la technologie de compression \u00ab Compact PDF \u00bb permet de cr\u00e9er des fichiers de plus petite taille (jusqu'\u00e0 1\/10\u00e8me de la taille obtenue en utilisant la compression classique) sans pour autant compromettre la qualit\u00e9, facilitant ainsi nettement l'envoi et le partage de documents.\\n\\n<b>Mise en r\u00e9seau (filaire et sans fil) ais\u00e9e<\/b>\\n\u00c9conomisez de l'espace et r\u00e9duisez les co\u00fbts en mettant ce p\u00e9riph\u00e9rique compatible r\u00e9seau hautes performances unique \u00e0 la disposition de tous les membres du groupe de travail. L'i-SENSYS MF5980dw est facile \u00e0 g\u00e9rer sur le r\u00e9seau et sa compatibilit\u00e9 Wi-Fi vous permet de l'int\u00e9grer \u00e0 votre r\u00e9seau sans fil en toute simplicit\u00e9.\\n\\n<b>Int\u00e9gration transparente<\/b>\\nCette unit\u00e9 compatible r\u00e9seau prend en charge le PCL 5c, PCL 6 et le Postscript 3, facilitant ainsi son int\u00e9gration dans votre environnement d'impression existant.\\n\\n<b>R\u00e9duisez vos co\u00fbts tout en faisant des \u00e9conomies d'\u00e9nergie<\/b>\\nAtt\u00e9nuez votre impact sur l'environnement tout en r\u00e9duisant les co\u00fbts. Conforme \u00e0 la norme Energy Star, l'i-SENSYS MF5980dw donne l'exemple en affichant l'une des consommations r\u00e9elles d'\u00e9lectricit\u00e9 (TEC) les plus faibles, \u00e0 savoir 1,4 kWh seulement. Il consomme uniquement 2,3 watts en mode veille, pour une efficacit\u00e9 \u00e9nerg\u00e9tique accrue. L'impression recto verso automatique contribue \u00e0 minimiser les co\u00fbts en r\u00e9duisant l'utilisation de papier."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-10T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":true}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"a9e1875f-6cfb-410f-97f6-8bb20bcd2373","identifier":"10970033","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","fujifilm"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"f\/0\/1\/5\/f015ad27a373d3f50631d4edea9b9ac3fc0aae2f_10970033_1139.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/0\/1\/5\/f015ad27a373d3f50631d4edea9b9ac3fc0aae2f_10970033_1139.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Fujifilm Z950EXR"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"<b>High Quality Photos & Movies with the New EXR AUTO<\/b>\\nThe 16 megapixel EXR CMOS sensor creates ultimate image quality. The FinePix Z950EXR prevents blur with Motion Detection and captures bright image in dark scene.\\n\\n<b>EXR AUTO 99 Shooting Patterns<\/b>\\nThe new EXR AUTO with new Motion Detection instantly recognizes 54 scene types, automatically optimizes every setting from exposure to white balance, and even switches to the ideal sensor mode: HR High Resolution for well-lit conditions, SN High Sensitivity\/Low Noise mode for low light, and DR Dynamic Range mode for high-contrast scenes.\\n\\n<b>EXR AUTO + Motion Detection<\/b>\\n- Capture Still Night Scenes with Breathtaking Quality\\n- Shoot Dynamic Night Shots with Stunning Results\\n\\n<b>Advanced Anti Blur<\/b>\\nWhen shooting dark scenes, Advanced Anti Blur adds the power of EXR CMOS and Multi Frame technology to combine 4 frames into a single, sharp blur image with remarkably low noise.\\n\\n<b>Super High Quality Full HD Movies<\/b>\\nAble to capture both photos and movies in high-definition 16:9 format, the FinePix Z950EXR lets you discover the impact of full-screen HDTV image display.\\n\\n<b>Powerful zoom Super-high Resolution in a Compact Body<\/b>\\nCapture superb image with Fujinon Lens.\\nPowerful zoom and high speed function is featured in a compact body.\\n\\n<b>High-precision Molded Glass Aspheric Lens<\/b>\\nBy precisely focusing light at the same point on the focal plane, aspheric lens design eliminates the need for additional corrective lens elements. While this lens reduces distortion at wide angles, improves resolution in both center and edge areas, cuts glare and reflections, and minimizes chromatic aberration throughout the zoom range, the lens also makes possible a lighter and more compact design.\\n\\n<b>Image Stabilization (CMOS Shift + High ISO)<\/b>\\nLong telephoto shots usually suffer from camera shake and subject movement which can ruin photos by producing blurred results. The FinePix Z950EXR's highly effective CMOS-shift and high ISO image stabilization ensures that your shots stay extra-crisp and clear, even at the full 5x zoom.\\n(Left) Conventional Digital Camera (Right) FinePix Z950EXR.\\n\\n<b>High Speed Continuous Shooting<\/b>\\nCapture every detail of the action with the FinePix Z950EXR's continuous 12-frame shooting mode at an amazing 12fps, at 4 megapixel resolution.\\n\\n<b>3.5-inch High-contrast LCD<\/b>\\nFeaturing high contrast for a brighter display and 460,000 dots of resolution for easy reading of icons, menus and, of course, exceptional image viewing quality, the large 3.5-inch LCD sets FinePix Z950EXR apart in the ultra-compact class.\\n\\n<b>Face Detection Timer Function<\/b>\\nThe Face Detection Self-timer automatically sets off after the number and position of faces in a scene are detected, snapping the photo at the right moment, with the faces in focus and properly exposed."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-10T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"optical_zoom":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1050092e-e36e-41a7-8255-48ac05b6ea0e","identifier":"10974886","enabled":true,"family":"pc_monitors","categories":["asus","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"ASUS VE198S"}],"description":[{"locale":"en_US","scope":"print","data":"<b>10,000,000:1 ASUS Smart Contrast Ratio<\/b>\\nDynamically enhances the display\u2019s contrast by adjusting the luminance of the backlight to achieve the darkest black and brightest white \u2013 delivering lifelike images.\\n\\n<b>Excellent Visual Performance<\/b>\\n- Indulge your visual senses with 1440x900 resolution and 5ms quick response time for work and entertainment.\\n- The best dual-display companion with your widescreen notebook enlarges the visual space for multi-tasking efficiency.\\n- Aspect Control function allows users to select a preferred display mode among Full and 4:3 for true-to-life gaming or movie watching without any data loss or image distortion.\\n\\n<b>Splendid\u2122 Video Intelligence Technology<\/b>\\nThe exclusive Splendid Video Intelligence Technology optimizes video performance and image fidelity by enhancing color, brightness, contrast, and sharpness. 5 preset video modes (Scenery, Theater, Game, Night View, and Standard) can be selected via a hotkey.\\n\\n<b>Stylish and User-friendly Design for Modern Sophistication<\/b>\\n- Glare black frame and smooth base design create a fresh new look of LCD monitors.\\n- Built-in hidden stereo speakers enable audio enjoyment together with true-to-life visual.\\n- Convenient key controls for functional set-up in the multi-language OSD.\\n- Cable manager gets rid of tangling cables and wires.\\n- VESA Wall Mount Standard (100 x 100 mm ).\\n- 25\u00b0 ( forward 5\u00b0, backwards 20\u00b0 )Tilting Angle.\\n- KENSINGTON Security Lock.\\n\\n<b>Greener Materials<\/b>\\n- Mercury-free LED-backlit panel.\\n- Corrugated cardboard packaging with at least 80% recycled content.\\n- Slim-flat packaging allows more cartons to be fitted per cargo, reducing transportation costs and CO\u2082 emission.\\n\\n<b>Energy and Planet Saving<\/b>\\n- 37.2k Wh electricity saving.\\n- 23.6kg reduction in CO\u2082emissions, equivalent to:\\n1.9 trees planted.\\n2 years of oxygen for a family of four."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-10T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"response_time":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"60951d74-d13f-41af-9d40-4c9ace3cb3b0","identifier":"10977324","enabled":true,"family":"multifunctionals","categories":["brother","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"297_x_432_mm"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","fax","print","scan"]}],"name":[{"locale":null,"scope":null,"data":"Brother MFC-J5910DW multifunctional"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>DIN A3 Business 4-in-1 Tinten-Multifunktionscenter mit DIN A3 Duplexdruck-Funktion, LAN-\/WLAN-MFC-Server und Touchscreen-Display<\/b>\\n\\n<b>DIN A3 Farbdrucker<\/b>\\n- Bis zu 35 Seiten pro Minute in S\/W (DIN A4)\\n- Bis zu 27 Seiten pro Minute in Farbe (DIN A4)\\n- Bis zu 12 ISO-Seiten pro Minute in S\/W (DIN A4)\\n- Bis zu 10 ISO-Seiten pro Minute in Farbe (DIN A4)\\n- Automatischer Duplexdruck bis DIN A3\\n- Bis zu 6.000 x 1.200 dpi Druckaufl\u00f6sung\\n- 4 separate Tintenpatronen\\n- USB 2.0 Hi-Speed, 10\/100 BaseTX (LAN) und 802.11 b\/g\/n (WLAN) Schnittstelle\\n- Dokumentenecht drucken nach PTS\\n- mit LC-1240BK\/LC-1280XLBK\\n- AirPrint kompatibel\\n- Google Cloud Print\u2122 kompatibel\\n\\n<b>DIN A4 Farbkopierer<\/b>\\n- 35 Blatt Vorlageneinzug (ADF) und\\n- DIN A4 Vorlagenglas\\n- 1 Papierkassette f\u00fcr 250 Blatt\\n- 4,9 cm Touchscreen LCD-Farbdisplay mit ber\u00fchrungsempfindlichem Bedienfeld\\n\\n<b>DIN A4 Farbscanner<\/b>\\n- Scan-to-E-Mail, -Bild, -Text, -PDF, -Datei, USB-Stick, -Speicherkarte,\\n\\n<b>DIN A4 Farbfax<\/b>\\n- Werbefax-L\u00f6schfunktion\\n\\n<b>Fotodirektdruck<\/b>\\n- Randloser Fotodruck bis DIN A3\\n- Fotodirektdruck via PictBridge, USB-Stick, Speicherkarte\\n\\n<b>Integrierter LAN-\/WLAN-MFC-Server<\/b>\\n- Drucken, Scannen, Faxen im LAN oder WLAN."},{"locale":"en_US","scope":"print","data":"All\u2010in\u2010one A3 colour printing just got faster and more affordable. Quickly print, copy, scan or fax using the MFC\u2010J5910DW, a model that\u2019s compact enough for any office, whether it\u2019s at home or at work.\\n\\nWith precision colour printing up to A3, your presentations, projects and photographs can be given more punch than previously possible, whilst our XL cartridges help you considerably reduce running costs. Plus, the latest wireless 'N' technology means you can share the benefits of the small printer with big capability with the rest of the team in your office \u2010or the family at home."},{"locale":"fr_FR","scope":"print","data":"<b>Imprimante multifonction jet d\u2019encre couleur A3 professionnelle avec Fax, Impression recto-verso et connection r\u00e9seau et WiFi<\/b>\\nB\u00e9n\u00e9ficiez du format A3 gr\u00e2ce \u00e0 cette imprimante multifonction jet d\u2019encre 4-en-1. En plus d\u2019imprimer, de num\u00e9riser, de copier et de t\u00e9l\u00e9copier jusqu\u2019au format A4, le MFC-J5910DW imprime vos documents et photos jusqu\u2019au format A3. D\u00e9sormais, donnez davantage d\u2019impact et communiquez en grand pour l\u2019ensemble de vos documents personnels et professionnels. D\u00e9marquez-vous et fa\u00eetes des \u00e9conomies gr\u00e2ce aux cartouches haute capacit\u00e9 LC1280XL permettant d'imprimer jusqu'\u00e0 2400 pages en N&B et 1200 pages en couleur. Economisez jusqu'\u00e0 65% sur vos co\u00fbts d'impression en noir gr\u00e2ce \u00e0 l'utilisation des cartouches LC1280XL-BK par rapport aux cartouches standards LC1240BK (calcul bas\u00e9 sur les prix publics HT conseill\u00e9s par Brother)."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-11T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:33:01+00:00","updated":"2023-04-18T13:33:01+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"32d59cbb-350f-485f-96ce-8f60c399eaaa","identifier":"10978314","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","fujifilm"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"picture":[{"locale":null,"scope":null,"data":"6\/7\/a\/d\/67ad575135c6e0fa1570d797142bc7cda1ae9b8c_10978314_5271.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/6\/7\/a\/d\/67ad575135c6e0fa1570d797142bc7cda1ae9b8c_10978314_5271.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Fujifilm FinePix Z950EXR"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Focus, shoot, search and browse with new touch screen technology<\/b>\\n\\n<b>Fotos und Videos in hoher Qualit\u00e4t mit dem neuen EXR AUTO-Modus<\/b>\\nDer 16-Megapixel EXR CMOS-Sensor liefert Bilder in un\u00fcbertroffener Qualit\u00e4t. Die FINEPIX Z950EXR verhindert Unsch\u00e4rfe durch die Bewegungserkennung und schie\u00dft helle, klare Fotos auch bei schlechten Lichtverh\u00e4ltnissen.\\n\\n<b>EXR AUTO mit 99 Aufnahmemustern<\/b>\\nDie neue EXR AUTO mit Bewegungserkennung erkennt blitzschnell 54 Szenenarten und optimiert automatisch alle Einstellungen von der Belichtung bis zum Wei\u00dfabgleich und schaltet dar\u00fcber hinaus in den idealen Sensormodus: HR (hohe Aufl\u00f6sung) f\u00fcr gute Lichtbedingungen, SN (hohe Empfindlichkeit \/ geringes Rauschen) f\u00fcr schlechte Lichtverh\u00e4ltnisse und DR (Dynamikbereich) f\u00fcr Szenen mit hohem Kontrast.\\n\\n<b>Intelligente Szenenerkennung<\/b>\\nDer innovative neue EXR AUTO-Modus mit Bewegungserkennung reduziert die Motiv-Unsch\u00e4rfe bei schlechten Lichtverh\u00e4ltnissen nahezu vollst\u00e4ndig.\\nDank der neuen Bewegungserkennung konnten die Aufnahmearten durch die erkannten Szenen und die automatisch optimierten Aufnahmemodi im EXR AUTO-Modus auf 99 Muster erweitert werden.\\n- Easy Web Upload\\n\\n<b>Advanced Detection & Flex Shooting<\/b>\\n- Motion Panorama 360\\n- Dog \/ Cat Detection\\n- Face Recognition"},{"locale":"en_US","scope":"print","data":"<b>Focus, shoot, search and browse with new touch screen technology<\/b>\\n\\n<b>High Quality Photos & Movies with the New EXR AUTO<\/b>\\nThe 16 megapixel EXR CMOS sensor creates ultimate image quality. The FinePix Z950EXR prevents blur with Motion Detection and captures bright image in dark scene.\\n\\n<b>Powerful zoom Super-high Resolution in a Compact Body<\/b>\\nCapture superb image with Fujinon Lens.\\nPowerful zoom and high speed function is featured in a compact body.\\n\\n<b>Enjoy Shooting! Enjoy Viewing! This Camera is Packed Full of Fun Features!<\/b>\\n- Touch Screen Technology enhances Image Serch\\n- Fujifilm Boasts Original Functions for Better Shooting\\n- Easy Web Upload\\n\\n<b>Advanced Detection & Flex Shooting<\/b>\\n- Motion Panorama 360\\n- Dog \/ Cat Detection\\n- Face Recognition"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-12T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"optical_zoom":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"041bdf64-676e-43ae-8a29-896bed394031","identifier":"10978316","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","fujifilm"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Fujifilm FinePix Z950EXR"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Focus, shoot, search and browse with new touch screen technology<\/b>\\n\\n<b>Fotos und Videos in hoher Qualit\u00e4t mit dem neuen EXR AUTO-Modus<\/b>\\nDer 16-Megapixel EXR CMOS-Sensor liefert Bilder in un\u00fcbertroffener Qualit\u00e4t. Die FINEPIX Z950EXR verhindert Unsch\u00e4rfe durch die Bewegungserkennung und schie\u00dft helle, klare Fotos auch bei schlechten Lichtverh\u00e4ltnissen.\\n\\n<b>EXR AUTO mit 99 Aufnahmemustern<\/b>\\nDie neue EXR AUTO mit Bewegungserkennung erkennt blitzschnell 54 Szenenarten und optimiert automatisch alle Einstellungen von der Belichtung bis zum Wei\u00dfabgleich und schaltet dar\u00fcber hinaus in den idealen Sensormodus: HR (hohe Aufl\u00f6sung) f\u00fcr gute Lichtbedingungen, SN (hohe Empfindlichkeit \/ geringes Rauschen) f\u00fcr schlechte Lichtverh\u00e4ltnisse und DR (Dynamikbereich) f\u00fcr Szenen mit hohem Kontrast.\\n\\n<b>Intelligente Szenenerkennung<\/b>\\nDer innovative neue EXR AUTO-Modus mit Bewegungserkennung reduziert die Motiv-Unsch\u00e4rfe bei schlechten Lichtverh\u00e4ltnissen nahezu vollst\u00e4ndig.\\nDank der neuen Bewegungserkennung konnten die Aufnahmearten durch die erkannten Szenen und die automatisch optimierten Aufnahmemodi im EXR AUTO-Modus auf 99 Muster erweitert werden.\\n- Easy Web Upload\\n\\n<b>Advanced Detection & Flex Shooting<\/b>\\n- Motion Panorama 360\\n- Dog \/ Cat Detection\\n- Face Recognition"},{"locale":"en_US","scope":"print","data":"<b>Focus, shoot, search and browse with new touch screen technology<\/b>\\n\\n<b>High Quality Photos & Movies with the New EXR AUTO<\/b>\\nThe 16 megapixel EXR CMOS sensor creates ultimate image quality. The FinePix Z950EXR prevents blur with Motion Detection and captures bright image in dark scene.\\n\\n<b>Powerful zoom Super-high Resolution in a Compact Body<\/b>\\nCapture superb image with Fujinon Lens.\\nPowerful zoom and high speed function is featured in a compact body.\\n\\n<b>Enjoy Shooting! Enjoy Viewing! This Camera is Packed Full of Fun Features!<\/b>\\n- Touch Screen Technology enhances Image Serch\\n- Fujifilm Boasts Original Functions for Better Shooting\\n- Easy Web Upload\\n\\n<b>Advanced Detection & Flex Shooting<\/b>\\n- Motion Panorama 360\\n- Dog \/ Cat Detection\\n- Face Recognition"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-12T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"optical_zoom":[{"locale":null,"scope":null,"data":5}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c38116be-7e3e-4e82-9b46-b05e10734059","identifier":"10978321","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","samsung"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Samsung MV 800"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"description":[{"locale":"de_DE","scope":"print","data":"Auf der Suche nach spektakul\u00e4ren Aufnahmen? Die Perspektive macht\u00b4s! Dank des innovativen Flip-Displays der MV800 k\u00f6nnen jetzt Bilder mit v\u00f6llig neuer Sichtweise aufgenommen werden. Entdecken Sie noch mehr kreative M\u00f6glichkeiten: ob Vogel- oder Froschperspektive \u2013 solche Ansichten schaffen Dynamik. Und um die besten Ergebnisse gleich genie\u00dfen zu k\u00f6nnen, erm\u00f6glicht das Flip-Display einen bequemen Stand der Kamera.\\n\\n<b>Flip-Display \u2013 Aufnahmen in jeder Situation<\/b>\\nUngew\u00f6hnliche Perspektiven k\u00f6nnen jetzt einfacher denn je eingefangen werden. Dank des 7,6 cm gro\u00dfen Flip-Displays gelingen spektakul\u00e4re Fotos in allen Lagen und das ganz bequem, ob \u00dcberkopf oder aus der H\u00fcfte. Und bei Aufnahmen, bei denen ein tiefer Kamerastandpunkt n\u00f6tig ist, entf\u00e4llt zudem das l\u00e4stige Hinknien. Auch Selbstaufnahmen gelingen spielend leicht \u2013 das Aufklappen des Displays gen\u00fcgt. Um die sch\u00f6nsten Erinnerungen dann gemeinsam mit Freunden einfach und komfortabel genie\u00dfen zu k\u00f6nnen, erm\u00f6glicht der Bildschirm einen sicheren Stand der Kamera. Entdecken Sie die sch\u00f6nsten Seiten des Lebens aus einer v\u00f6llig neuen Perspektive.\\n\\n<b>Modernste Fototechnik in stilvollem Design<\/b>\\nDank ihres gl\u00e4nzenden Metallbodys ist die MV800 auch optisch ein wahrer Hingucker. In ihrem schlichten, minimalistischen Design versteckt sich modernste Fototechnik. Und mit dem modernen \u201eSmart Touch 3.0\u201c- Bedienkonzept gestaltet sich die Handhabung so einfach, wie bei einem Smartphone.\\n\\n<b>Hochwertige Bildqualit\u00e4t<\/b>\\nOb ausgedehnter Stadtbummel oder Restaurantbesuch mit Freunden, die MV800 bannt mit 16,1-Megapixel-Aufl\u00f6sung die sch\u00f6nsten Momente gestochen scharf und detailreich auf Bild. Und das ist noch nicht alles: Der 5-fach optische Zoom holt weiter Entferntes ganz nah heran, der 26-mm-Weitwinkel bildet Motive in voller Bandbreite ab. So gelingt auch das perfekte Portr\u00e4t von der besten Freundin oder des ganzen Freundeskreises spielend einfach.\\n\\n<b>Eine Kamera-Bedienung wie beim Smartphone<\/b>\\nSmartphone-Besitzer f\u00fchlen sich schon zu Hause, denn \u00fcber den gro\u00dfz\u00fcgigen Touchscreen l\u00e4sst sich die MV800 so leicht und intuitiv wie ein Smartphone handhaben. Klare Symbole im App-Stil werden mit leichtem Fingerdruck aktiviert, v\u00f6llig unkompliziert l\u00e4sst es sich zwischen unterschiedlichen Einstellungen wechseln und detailgenaue Regelungen k\u00f6nnen vorgenommen werden. Ebenso bequem lassen sich spezielle Effekte aufrufen oder durch bereits gespeicherte Aufnahmen bl\u00e4ttern. Personalisieren Sie Ihre Kamera: W\u00e4hlen Sie aus den verschiedenen Wallpaper-Vorlagen aus oder nutzen Sie ihr eigenes Lieblingsbild f\u00fcr einen ganz individuell gestalteten Bildschirm.\\n\\n<b>Bild im Bild \u2013 zeigt beide Seiten der Geschichte<\/b>\\nWarum sich nur auf ein Bild beschr\u00e4nken, wenn auch zwei m\u00f6glich sind? Zeigen Sie beispielsweise beim Kegeln den erfolgreichen Wurf und - alle Neune - gleichzeitig das Jubelgeschrei des Gewinnerteams. Die neue Bild-im-Bild-Funktion erm\u00f6glicht es, zwei Bilder zu kombinieren und so die komplette Situation einzufangen. Passen Sie Bildgr\u00f6\u00dfe und -position an und verwandeln Sie das Erlebnis in eine unvergessliche Erinnerung."},{"locale":"en_US","scope":"print","data":"<b>Groundbreaking Adjustable LCD Screen<\/b>\\nThe 3.0\" Flip-Out Display lets you take and view great pictures from multiple angles. Easily adjust the LCD from 0 to 180 degrees and make any shot possible. Snap a picture over a crowd or get waist-level candids of kids and pets, or spin the display for perfectly framed self-portraits. Choose from 3 shutter options to comfortably snap pics from any position.\\n\\n<b>Crisp, Colorful Images and Video<\/b>\\nWherever life takes you, capture the moment perfectly. With a 16.1 Megapixel resolution and 5X optical zoom, images and videos are rich and brilliant from any angle, even at long distances. Dual Image Stabilization even eliminates camera shake, so images are at their best: sharp and crisp. When you\u2019re ready, view HD videos on the big screen with the built-in HDMI port.\\n\\n<b>Perfect Panorama<\/b>\\nGetting the wide view has never been easier. Simply take aim and hold the shutter button while you capture the perfect scene. Live Panorama immediately displays the final image in preview, so you can decide if the view you have is the the view you want.\\n\\n<b>Beautiful on the Outside, Too<\/b>\\nBe fashionable and turn heads with the minimal, sleek design of the MV800. Crafted from seamless shimmering metal and a colorful 3.0\" Touchscreen, this stunning camera always makes a bold impression\u2014just like the pictures it takes.\\n\\n<b>Extend Your Creativity<\/b>\\nThe LCD display is loaded with ways to get creative and add a personal touch to the interface. Create a wallpaper of images with Magic Frame or apply filters and special effects that get your vision just right. Easily navigate creative options with Smart Touch 3.0.\\n\\n<b>Multiple Moments<\/b>\\nDeliver the whole story with the Picture in Picture function. Insert any image into another, at any size or placement, so no moment has to stand alone. Pair the bowling strike with friends cheering the score or add the birthday gift to the happy smile\u2014it\u2019s all up to you.\\n\\n<b>Spark Your Creativity<\/b>\\nExplore the possibilities for fun with Magic Frame. Mix your own images into 12 playful templates, or create a custom Magic Frame and add yourself to a group shot of friends or into a crowd.\\n\\n<b>Add Effects to Portraits<\/b>\\nHave more fun with portraits. The Funny Face feature can bend, stretch and warp your favorite faces. Just tap the screen to play with facial features, as little or as radically as you want. Face Tracking ensures that the distorted portrait stays intact even when you move the camera.\\n\\n<b>The Art of Filters<\/b>\\nUnleash your creative side with Smart Filter 3.0. Right from the display you can transform any shot just for fun or to express a mood. Give it motion or multiple points of light\u2014or even halftone dots like comic books. You can even make images look like cartoons, paintings and more.\\n\\n<b>Stunning 3D Images<\/b>\\n3D Photo transforms any image into stunning 3D. Just connect the camera to a 3D HDTV to display both still images and panoramic photos with incredible depth and dimension. Striking the Right Pose The Pose Guide function displays a gallery of posed models right on the display, so subjects can be easily directed into the perfect pose\u2014getting you just the right shot, just like a pro.\\n\\n<b>Striking the Right Pose<\/b>\\nThe Pose Guide function displays a gallery of posed models right on the display, so subjects can be easily directed into the perfect pose\u2014getting you just the right shot, just like a pro.\\n\\n<b>Perfect Details<\/b>\\nTouch up pics on the spot with Photo Editor. Remove blemishes and other imperfections using Beauty Shot, or easily rotate images, add effects and crop out distracting elements right from the display.\\n\\n<b>Tell a Story<\/b>\\nCreating storyboards for film or TV couldn\u2019t be simpler. Choose the right template, place the shots into layout then add text with a virtual keyboard. Then review the story right on the display and you're done.\\n\\n<b>Zoom Noise Reduction<\/b>\\nCrystal-clear video needs crystal-clear sound. HD Movie with Zoom Noise Reduction (ZNR) automatically adjusts and optimizes sound when recording in HD. It even discards the mechanical noise that comes from using zoom.\\n\\n<b>Intelligent Portraits<\/b>\\nPortrait takes three different pictures at one time. Snap a wide-angle shot and the camera captures two additional angles simultaneously."},{"locale":"fr_FR","scope":"print","data":"Avec sa large gamme d\u2019applications, le MV800 vous permettra de repousser vos limites photographiques et d\u00e9cupler votre sens artistique en toute simplicit\u00e9. Que ce soit en contre-plong\u00e9e ou en plong\u00e9e, ajoutez \u00e0 vos photos un ton th\u00e9\u00e2tral que vous n\u2019auriez pas pu r\u00e9aliser avec un appareil photo classique et partagez vos chef d\u2019\u0153uvres avec vos amis!\\n<br\/><b>Ecran tactile 3\u2019 pivotant \u00e0 180\u00b0: A chacun son angle!<\/b>\\n<br\/>Immortalisez, Cr\u00e9ez et Revivez les plus beaux moments de votre vie sous tous les angles avec l\u2019\u00e9cran tactile 3\u2019 pivotant \u00e0 180\u00b0 de votre Samsung MultiView MV800. La vie est tellement plus belle quand on peut en saisir tous les aspects. Si vous avez d\u00e9j\u00e0 un Smartphone, l\u2019utilisation du Samsung MultiView MV800 vous sera famili\u00e8re. Avec son Smart Touch 3.0 tactile, naviguez \u00e0 travers le menu du bout de votre index et faites d\u00e9filer toutes ses fonctionnalit\u00e9s. C\u2019est avec l\u2019esprit serein que vous utiliserez votre MultiView!\\n<br\/><b>Un appareil photo qui a de la classe!<\/b>\\n<br\/>Le Samsung MultiView MV800 est un appareil photo avec du style! Fa\u00e7onn\u00e9 pour les amateurs de design, ses courbes minimalistes fines et lisses sont tout aussi impressionnantes que ses performances technologiques. En tous points, il vous \u00e9blouira de son m\u00e9tal bross\u00e9 r\u00e9sistant et distingu\u00e9.\\n<br\/><b>Propulsez la photographie dans une nouvelle dimension!<\/b>\\n<br\/>Avec ses 16.1 Millions de pixels, saisissez parfaitement chaque moment de votre vie et dans n\u2019importe quelles circonstances. Son zoom X5 vous rapprochera toujours plus de l\u2019action alors que son grand angle 26mm vous permettra d\u2019immortaliser chaque sourire de votre entourage lors de vos photos de groupe. Gr\u00e2ce \u00e0 ces performances, revivez vos p\u00e9rip\u00e9ties en  3D \u00e0 l\u2019aide de votre c\u00e2ble 3D HDTV et contemplez vos \u0153uvres comme si vous y \u00e9tiez!\\n<br\/><b>Rendez votre appareil photo unique!<\/b>\\n<br\/>Avec l\u2019\u00e9cran tactile 3\u2019, se d\u00e9placer dans les menus devient beaucoup plus fluide et intuitif pour s\u00e9lectionner la fonction choisie. Pour un appareil \u00e0 votre image, transformez vos photos favorites en fond d\u2019\u00e9cran!\\n<br\/><b>Mode Superposition de photos: Des deux c\u00f4t\u00e9s de l\u2019action!<\/b>\\n<br\/>Pourquoi se contenter d\u2019une seule photo quand on peut en avoir deux? Le mode Superposition de photos vous permet de capter les deux c\u00f4t\u00e9s de l\u2019action et de saisir en une seule photo toute l\u2019intensit\u00e9 du moment. Prenez en photo par exemple votre ami en train de marquer un but et combinez cette image avec le public en train de jubiler."}],"optical_zoom":[{"locale":null,"scope":null,"data":5}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-12T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c073453b-717d-4bc2-8ad5-309ed0893b0b","identifier":"10978322","enabled":true,"family":"digital_cameras","categories":["cameras_sales","digital_cameras","samsung"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Samsung WB WB750"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}],"description":[{"locale":"de_DE","scope":"print","data":"<b>Mehr Zoom, mehr Details \u2013 Motivwahl ohne Grenzen<\/b>\\nOb drinnen oder drau\u00dfen, ob ganz nah dran oder weiter entfernt \u2013 die WB750 bietet alles, um die sch\u00f6nsten Momente des Lebens in all seinen Facetten und im ganzen Umfang festzuhalten. 24 mm Weitwinkel und 18-fach optischer Zoom erfassen Motive in allen Dimensionen. Der BSI-CMOS-Bildsensor mit 12,5 Megapixeln h\u00e4lt auch die kleinsten Details in exzellenter Qualit\u00e4t fest, auch bei schlechten Lichtverh\u00e4ltnissen. Die WB750 sorgt allzeit f\u00fcr ausgesprochen lebhafte Erinnerungen: Auf Foto gebannt oder in Full-HD-Video mit 1080p, wiedergegeben in 2D oder 3D.\\n\\n<b>In weiter Ferne so nah 18-fach optischer Zoom, 24-fachem Super-Zoom, 24 mm Weitwinkel<\/b>\\nAnspruchsvolle Fotografen wissen die exklusive Ausstattung der Samsung WB750 zu sch\u00e4tzen. Mit 24-mm-Ultraweitwinkel und 24-fach Super-Zoom (18-fach optischem und 1,3-fachem Smart Zoom) bringt die WB750 jedes noch so komplizierte Motiv optimal auf das Bild. Ob kleinste Details oder riesige Dimensionen \u2013 die WB750 er\u00f6ffnet v\u00f6llig neue M\u00f6glichkeiten.\\n\\n<b>Hochwertige Bildqualit\u00e4t 12,5 Megapixel BSI-CMOS-Bildsensor<\/b>\\nRomantisches Dinner zu zweit, ein Picknick in der Abendd\u00e4mmerung \u2013 die WB750 h\u00e4lt die nat\u00fcrliche Lichtstimmung gestochen scharf fest. M\u00f6glich macht dies der 12,5 Megapixel BSI-CMOS-Bildsensor. Seine spezielle Bauform sorgt f\u00fcr exzellente Bildqualit\u00e4t. Bei der BSI-Technologie wird die lichtempfindliche Schicht von hinten durchleuchtet. Dadurch gibt es weniger Lichtverlust und Fotos und Videos werden optimaler belichtet. Das Bildrauschen wird wesentlich verringert und ein hervorragendes Ergebnis ist auch bei schlechten Lichtverh\u00e4ltnissen garantiert.\\n\\n<b>Foto oder Video? Jetzt ist beides m\u00f6glich \u2013 und das gleichzeitig Dual Capture \u2013 Full-HD-Videoaufnahmen und 10M Fotos<\/b>\\nSie k\u00f6nnen sich nicht entscheiden, ob dieser spannende Moment besser als Video aufgezeichnet oder auf Bild gebannt werden soll? Kein Problem!\\nGef\u00e4llt w\u00e4hrend der Videoaufzeichnung ein Motiv besonders gut, kann mit der WB750 gleichzeitig ein Foto in voller Aufl\u00f6sung gemacht werden. Die Videoaufzeichnung in Full HD wird dabei nicht unterbrochen. F\u00fcr weiter entfernte Motive steht der 18-fach optische Zoom zur Verf\u00fcgung, und die 10-Megapixel-Aufl\u00f6sung sorgt f\u00fcr hoch qualitative und detailreiche Aufnahmen.\\n\\n<b>Erweckt Geschichten zum Leben \u2013 direkt in der Kamera Kreativer Movie-Maker<\/b>\\nDer kreative Movie-Maker er\u00f6ffnet v\u00f6llig neue M\u00f6glichkeiten: Fotos und Videos lassen sich jetzt einfacher denn je zu einer Diashow kombinieren. F\u00fcr einen ansprechenden Sound l\u00e4sst sich die eigene Geschichte mit verschiedenen Musikthemen hinterlegen. Das selbst kreierte Meisterwerk l\u00e4sst sich dann direkt auf der Kamera ansehen oder, in Full-HD-Qualit\u00e4t gespeichert, auf dem heimischen Fernseher mit Freunden und Familie genie\u00dfen.\\n\\n<b>Kompakte Gr\u00f6\u00dfe \u2013 Full-HD-Aufl\u00f6sung Videos mit 1.920 x 1.080p<\/b>\\nJetzt kann der Camcorder getrost zu Hause bleiben. Die WB750 zeichnet bewegte Bilder in bester Full-HD-Qualit\u00e4t mit einer maximalen Aufl\u00f6sung von 1.920 x 1.080p und 30 B\/s in Stereo auf. Dank der effektiven Datenkompression im H.264-Format geh\u00f6ren Sorgen \u00fcber verbleibenden Speicherplatz der Vergangenheit an. F\u00fcr das perfekte Klangerlebnis sorgt das integrierte Stereo-Mikrofon. \u00dcber die HDMI\u2122-Schnittstelle \u00fcbertragen Sie Ihre Fotos und Videos in nie gekannter Qualit\u00e4t an einen modernen LCD- oder Plasma-Bildschirm mit HD-Aufl\u00f6sung \u2013 und das direkt aus der Kamera. HDMI\u2122 bietet h\u00f6chste Aufl\u00f6sung, knackige Sch\u00e4rfen, lebendige Farben sowie tollen Sound und macht somit Ihr Wohnzimmer zum perfekten Ort, um die eigenen Fotos und selbstgedrehten Videos gemeinsam zu genie\u00dfen.\\n\\n<b>Zeigt alles in vollem Umfang Live- und Action-Panorama<\/b>\\nAufnahmen weiter Landschaften und gr\u00f6\u00dferer Gruppen sind mit der WB750 kinderleicht zu bew\u00e4ltigen: Dank des speziellen Panorama-Modus reicht ein Druck auf den Ausl\u00f6ser und ein sanfter Kameraschwenk \u2013 den Rest erledigt die Kamera von selbst. Damit Sie auch das bekommen, was Sie sehen, gelingt mithilfe von Vorschaubildern im Live-Panorama-Modus die einfache Vorabkontrolle. F\u00fcr schnelle Bewegungen steht der Action-Panorama-Modus zur Verf\u00fcgung. Dieser sorgt f\u00fcr eine sichere Motiv-Verfolgung und h\u00e4lt die Bewegung auf einem atemberaubenden Panorama fest.\\n\\n<b>Momente in der dritten Dimension 3D-Foto \/ 3D-Panorama<\/b>\\nSafari in Afrika oder Strandurlaub in Italien \u2013 mit der WB750 erleben Sie Ihre sch\u00f6nsten Urlaubserinnerungen hautnah. Einfach die Kamera an einen 3D-HDTV anschlie\u00dfen und schon k\u00f6nnen Sie Fotos und Panorama-Aufnahmen mit unglaublicher Tiefe und Dimension genie\u00dfen.\\n\\n<b>F\u00fcr starke Lichter und dunkle Schatten High Dynamic Range (HDR)<\/b>\\nRomantisch verwinkelte Gassen, ein idyllischer Waldweg? Gerade solche Motive leben von ihren gro\u00dfen Hell-Dunkel-Unterschieden, doch genau damit hat so manch eine Kamera Probleme bei der Darstellung. Anders mit der WB750. Denn dank ihres erweiterten Dynamikumfangs meistert die WB750 auch schwierigste Lichtverh\u00e4ltnisse. Starke Lichter und dunkle Schatten bekommen Struktur und sorgen so f\u00fcr detailreiche und ausdrucksstarke Bilder.\\n\\n<b>Kreative Linsen-Effekte Smart Filter 3.0<\/b>\\nDie Funktion Smart Filter macht Mut zur Kreativit\u00e4t und das direkt auf dem Display: Ob Cartoon, Cross-Filter oder Tunnel-Effekt, experimentierfreudigen Fotografen er\u00f6ffnet sie v\u00f6llig neue Gestaltungsm\u00f6glichkeiten. Im Modus Wasserfarben, \u00d6lgem\u00e4lde oder Halbtonpunkte werden Bilder im Handumdrehen zum Kunstwerk. Probieren Sie\u00b4s einfach aus und lassen Sie Ihrer Kreativit\u00e4t freien Lauf.\\n\\n\\n<b>Voll manuelle Steuerung<\/b>\\nUm alle Ideen auch ganz individuell umsetzen zu k\u00f6nnen, ist die WB750 komplett manuell zu steuern. Ob das Einfangen schneller Bewegungen oder geringe Tiefensch\u00e4rfe f\u00fcr Bildakzente \u2013 mit der Zeit- und Blendenautomatik hat der Fotograf auf Wunsch alles unter Kontrolle. Zus\u00e4tzlich kann die Kamera auch durch den Nutzer komplett manuell gesteuert werden. Damit sind zahlreiche M\u00f6glichkeiten gegeben, individuell Einfluss auf die Bilder zu nehmen.\\n\\n<b>F\u00e4llt aus dem Rahmen<\/b>\\nSchnell aus einem besonders gelungenen Motiv eine originelle Postkarte oder ein witziges Poster zaubern: \u201eMagic Frame\u201c macht es m\u00f6glich. Mit dem integrierten Programm lassen sich auf Wunsch die eigenen Fotos mit verschiedensten Rahmen schm\u00fccken. Vorlage w\u00e4hlen, Kamera auf das Motiv ausrichten und Ausl\u00f6ser dr\u00fccken. Ob Wall Art, Antik-Film, Zeitungsausschnitt oder Vollmond \u2013 individuell gestaltete Aufnahmen gelingen ganz einfach per Knopfdruck.\\n\\n<b>Gesichtserkennung, Gesichtsverfolgung, Gesichtswiedererkennung<\/b>\\nDie WB750 vergisst kein Gesicht: Die Gesichtsverfolgung verfolgt Gesichter in Bewegung; die Gesichtserkennung sorgt automatisch f\u00fcr eine exzellente Sch\u00e4rfe und eine ausgewogenen Belichtung; und die Gesichtswiedererkennung erkennt h\u00e4ufig fotografierte Personen und stellt auf diese vorrangig scharf. So gelingen Portr\u00e4ts einfacher denn je. Technische \u00c4nderungen und Irrt\u00fcmer vorbehalten. Alle im Text aufgef\u00fchrten Markennamen sind eingetragene Warenzeichen der Hersteller. Gezeigte Abbildungen k\u00f6nnen vom Original abweichen."},{"locale":"en_US","scope":"print","data":"Samsung WB750, WB. Megapixel: 12.5, Camera type: Compact, Sensor type: CMOS. Focal length range (f-f): 4 - 72. Focus: TTL, Auto focusing (AF) modes: Centre weighted Auto Focus, Multi Point Auto Focus, Normal focusing range: 0.8. Light exposure modes: Auto, Light exposure control: Program AE, Light exposure correction: \u00b1 2EV (1\/3EV step). Camera shutter type: Electronic"}],"optical_zoom":[{"locale":null,"scope":null,"data":18}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-12T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"552a1b9b-da0e-4b5a-b9bb-54e55da185a0","identifier":"10982527","enabled":true,"family":"pc_monitors","categories":["pc_monitors","samsung","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Samsung S22A450DW"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}],"description":[{"locale":"de_DE","scope":"print","data":"<b>H\u00f6he, Winkel und Ausrichtung bequem einstellen<\/b>\\nDer LED-Business-Monitor SA450 von Samsung wurde entwickelt, um Sie bei der produktiven Bildschirmarbeit effektiv zu unterst\u00fctzen. F\u00fcr ma\u00dfgeschneidertes Arbeiten bietet er Ihnen verschiedene Einstellm\u00f6glichkeiten. Mit dem h\u00f6henverstellbaren Standfu\u00df k\u00f6nnen Sie die Bildh\u00f6he immer auf einen idealen Sichtwinkel und eine orthop\u00e4disch g\u00fcnstige Sitzhaltung einstellen. Die Neige- und Schwenkfunktionen bringen weiteren Komfort und erm\u00f6glichen ganz neue Arbeitstechniken. So l\u00e4sst sich der SA450 um volle 90 Grad drehen und damit flexibel an verschiedene Situationen anpassen. Komfort und Leistung werden bei diesem LED-Business-Monitor ganz gro\u00df geschrieben.\\n\\n<b>Mehr Platz auf dem Schreibtisch<\/b>\\nWenn Sie einen Arbeitsmonitor suchen, der die vorhandene Tischfl\u00e4che effektiv ausnutzt, dann ist der LED-Business-Monitor SA450 von Samsung das richtige Ger\u00e4t f\u00fcr Sie. Mit seinem intelligenten und abnehmbaren Kabeladapter k\u00f6nnen Sie den Monitor problemlos in die Hand nehmen und woanders installieren. Der praktische Tragegriff vereinfacht Transport und Installation, sodass der SA450 auch auf diese Weise f\u00fcr mehr Ordnung und Effizienz am Arbeitsplatz sorgt. Dar\u00fcber hinaus ist der SA450 f\u00fcr eine Wandmontage nach VESA-Standard ausgestattet. So unterst\u00fctzt Sie der Business-Monitor SA450 aus der LED-Serie von Samsung bei der Optimierung Ihrer B\u00fcror\u00e4ume.\\n\\n<b>Erreichen Sie das n\u00e4chste Level mit Mega Dynamic Contrast<\/b>\\nErleben Sie mit Mega Dynamic Contrast eine neue Welt atemberaubender Farben, erstaunliche Brillanz und erstklassige Bildqualit\u00e4t. Die neuen SyncMaster der Serie 4 liefern solch realistische Bilder, dass sich dadurch Ihre gesamte Wahrnehmung ver\u00e4ndern wird. Ausgestattet mit einer unglaublich hohen Kontrastrate von 5.000.000:1, der derzeit h\u00f6chsten erh\u00e4ltlichen Kontrastrate \u00fcberhaupt, garantieren diese Displays Schwarzt\u00f6ne, die dunkler nicht sein k\u00f6nnten, makelloses Wei\u00df und strahlende Farbe. Das kristallklare, extrem intensive Bild wird Ihnen sofort ins Auge stechen. Es wird Ihnen wie eine Farbexplosion vorkommen, gegen die andere Monitore geradezu fad wirken. Genie\u00dfen Sie Multimediainhalte ab sofort mit der Professionalit\u00e4t, die Sie verdienen \u2013 dank Samsung Mega Dynamic Contrast.\\n\\n<b>Null-Watt-Adapter f\u00fcr konsequentes Energiesparen<\/b>\\nDie Adapterbox des LED-Business-Monitors SA450 von Samsung bietet eine ultimative Energiesparm\u00f6glichkeit: Durch einfaches Bet\u00e4tigen des neuen On-Off-Schalters am SA450 senken Sie den Stromverbrauch auf echte \"Null Watt\" - w\u00e4hrend eine konventionelle Standby-Schaltung den Leistungsbedarf auf nur etwa 1 Watt herunter bringen kann. So sparen Sie nicht nur Betriebskosten, sondern schonen auch unsere gemeinsamen Ressourcen. Dies ist ein weiterer Beitrag von Samsung f\u00fcr eine \"gr\u00fcne\" IT.\\n\\n<b>Samsung reduziert das Kabelgewirr auf Ihrem Schreibtisch<\/b>\\nEin sauberer und strukturierter Arbeitsplatz steht f\u00fcr Professionalit\u00e4t und macht immer einen guten Eindruck. Deshalb bietet Ihnen der LED-Business-Monitor SA450 von Samsung einen Kabelkanal, mit dem Sie die Kabel im Bereich des St\u00e4nders b\u00fcndeln und weiterleiten k\u00f6nnen. H\u00e4ssliche Kabel und Stecker verschwinden komplett aus Ihrem Sichtfeld. Profitieren Sie endlich von einem aufger\u00e4umten und angenehmen Arbeitsplatz - mit dem LED-Business-Monitor SA450 von Samsung.\\n\\n<b>Der Monitor f\u00fcr Ihren Business-Alltag<\/b>\\nDer Samsung LED-Business-Monitor SA450 wurde f\u00fcr angenehmeres und effizienteres Arbeiten entwickelt. Im Gegensatz zu Sensorfl\u00e4chen, die bei hektischer Benutzung schon mal kostspielige Bedienfehler verursachen k\u00f6nnen, bietet der SA450 taktile Bedienkn\u00f6pfe. Auch sonst ist das Design \u00e4u\u00dferst gut durchdacht. Die Tasten wurden nicht an der Seite angebracht, sondern ganz unten, sodass Sie den Monitor auch bei Wandmontage noch komfortabel bedienen k\u00f6nnen. Der schmale, mattierte Rahmen vervollst\u00e4ndigt die ansprechende Optik des SA450 und sorgt f\u00fcr irritationsfreie Videoerlebnisse, in die Sie geradezu eintauchen k\u00f6nnen.\\n\\n<b>Sehen Sie mehr mit weiteren Blickwinkeln<\/b>\\nWie sehen Sie sich Filme am liebsten an? Liegen Sie gerne auf der Couch? Oder sitzen Sie lieber auf Ihrem Lieblingsstuhl? Oder vielleicht kochen Sie dabei ja gerne oder machen Sport? Egal ob Sie stehen, sitzen oder liegen \u2013 Samsungs Magic Angle stellt sicher, dass der Film immer im Mittelpunkt steht und Sie es sich so richtig bequem machen k\u00f6nnen. Dank der 5 Winkelmodi k\u00f6nnen Sie sich Ihre Lieblingsfilme aus jedem erdenklichen Winkel in exzellenter Bildqualit\u00e4t ansehen. Mit Magic Angle ist dies ganz bequem und ohne Einschr\u00e4nkungen m\u00f6glich."},{"locale":"en_US","scope":"print","data":"<b>Conveniently adjust monitor height, tilt and perspective<\/b>\\nThe Samsung LED Business Monitor SA450 has been designed to help boost work performance ,delivering a tailored experience with its choice of viewer settings. The height-adjustable stand ensures that the screen can always be set at the optimal eye level, which enhances the visual experience while also helping maintain the viewer\u2019s body posture. Other features include the tilt and pivot capabilities, which not only increase comfort levels but also introduce new ways of working. The SA450 Monitor can rotate 90 degrees, allowing for an appropriate view depending on the work. So, now you can take convenience and performance to amazing heights with the Samsung LED Business Monitor SA450.\\n\\n<b>Maximise workspace with a great detachable adaptor<\/b>\\nIf you need a work monitor that uses office space effectively, then Samsung LED Business Monitor SA450 is the perfect choice. It features an innovative new detachable adaptor, which allows the monitor to be easily moved and installed. From physically moving the monitor with the carrying handle to quickly installing, the SA450 is ready to deliver a productive and clean work space. The SA450 is also equipped and prepared for you as a VESA Wall mount, providing a multi-screen or wall mounted monitor. Optimising your office space is now easily achieved with the Samsung LED Business Monitor SA450.\\n\\n<b>Samsung\u2019s Adaptor On Off 0W<\/b>\\nSamsung has created the new Adaptor On Off mode. By simply flicking the mechanical switch found on the Samsung LED Business monitor SA450, you can cut energy output while not using the monitor down to an amazing 0 Watts.\\n\\n<b>Clear your desk with Samsung\u2019s Cable Arrangement<\/b>\\nA tidy and clean workspace is paramount when it comes to showing professionalism at work. That\u2019s why the Samsung LED Business Monitor SA450 comes with a Cable Arrangement. It conveniently organises the cables coming from the monitor into a simple bundle along the stand and helps minimise clutter around the screen. With the Samsung LED Business Monitor SA450, you can enjoy a neat workspace, where annoying cables are kept out of sight.\\n\\n<b>A monitor design to match business needs<\/b>\\nThe Samsung LED Business Monitor SA450 has been designed to enhance work conditions furthermore, with its smart design, users can still access these buttons when wall mounted, which can be an issue when monitors feature side panel buttons. Adding to the visual experience, the SA450 features a Narrow Matt Bezel. This helps to reduce distraction around display area and delivers an experience that is immersive and engaging.\\n\\n<b>Upgrade to the next level with Mega Dynamic Contrast<\/b>\\nExperience amazing new levels of colour, brilliance and picture quality through the very latest in Mega Dynamic Contrast Ratio. The Samsung LED Business monitor SA450 delivers images so real-to-life that it will transform your whole viewing experience.\\n\\n<b>Magic Angle Vertical delivers perfection every time<\/b>\\nThe Samsung LED Business monitor SA450 feature the Magic Angle Vertical to deliver a picture-perfect screen even when not viewed from directly in front. This means that you can watch your monitor sitting down, standing up or lying on the couch and still enjoy a great view. And with 20 different angle steps (10 up and 10 down) you will always have a choice to match your position. So, when watching with Magic Angle Vertical, which is even also specialised for LED Business monitor, it feels like you\u2019re always standing right in front of the screen\u2026 even if you aren\u2019t."},{"locale":"fr_FR","scope":"print","data":"Les moniteurs LED business de la s\u00e9rie SA450 d\u2019une diagonale de respectivement 19, 22 et 24 pouces sont r\u00e9glables en hauteur. En outre, ils s'adaptent parfaitement aux besoins individuels gr\u00e2ce \u00e0 leurs fonctions de basculement et de pivotement. Gr\u00e2ce aux nombreux avantages Eco, vous r\u00e9duisez la consommation d\u2019\u00e9nergie sans perte de qualit\u00e9.\\n\\n<b>R\u00e9glez en toute simplicit\u00e9 la hauteur, l\u2019inclinaison et la perspective du moniteur.<\/b>\\nLe moniteur LED professionnel S22A450MW de Samsung a \u00e9t\u00e9 con\u00e7u pour vous aider \u00e0 dynamiser l\u2019efficacit\u00e9 de votre travail en vous proposant une exp\u00e9rience sur mesure gr\u00e2ce \u00e0 sa palette de param\u00e8tres visuels. Le pied \u00e0 hauteur r\u00e9glable garantit que l\u2019\u00e9cran peut toujours \u00eatre r\u00e9gl\u00e9 au niveau optimal des yeux afin d\u2019am\u00e9liorer l\u2019exp\u00e9rience visuelle tout en aidant \u00e0 maintenir la position du corps. D\u2019autres fonctionnalit\u00e9s comprennent les capacit\u00e9s d\u2019inclinaison et de pivot qui permettent non seulement d\u2019am\u00e9liorer les niveaux de confort, mais aussi d\u2019introduire de nouvelles mani\u00e8res de travailler. Le moniteur S22A450MW est capable d\u2019effectuer une rotation sur 90 degr\u00e9s, ce qui permet d\u2019adopter une vue plus appropri\u00e9e en fonction de la t\u00e2che \u00e0 r\u00e9aliser. D\u00e9sormais, vous pourrez atteindre un incroyable niveau de confort et d\u2019efficacit\u00e9 gr\u00e2ce au moniteur LED professionnel S22A450MW de Samsung.\\n\\n<b>Maximisez votre espace de travail gr\u00e2ce \u00e0 un adaptateur d\u00e9tachable efficace.<\/b>\\nSi vous avez besoin d\u2019un moniteur professionnel qui utilise efficacement l\u2019espace du bureau, le moniteur LED professionnel S22A450MW de Samsung est le choix id\u00e9al. Il dispose d\u2019un adaptateur d\u00e9tachable novateur qui permet de d\u00e9placer et d\u2019installer facilement le moniteur. En d\u00e9pla\u00e7ant physiquement le moniteur gr\u00e2ce \u00e0 la poign\u00e9e de transport afin de l\u2019installer rapidement, le SA200 vous proposera un espace de travail net et efficace. En outre, le S22A450MW dispose d\u2019un montage mural VESA afin que vous disposiez d\u2019un \u00e9cran multiple ou d\u2019un moniteur mont\u00e9 au mur. Il est d\u00e9sormais possible d\u2019optimiser l\u2019espace de votre bureau gr\u00e2ce au moniteur LED professionnel S22A450BW de Samsung.\\n\\n<b>R\u00e9alisez des \u00e9conomies d\u2019\u00e9nergie gr\u00e2ce \u00e0 l\u2019\u00e9cran LED ultral\u00e9ger.<\/b>\\nLe moniteur LED professionnel et ultral\u00e9ger S22A450MW de Samsung vous offre une autre option d\u2019\u00e9conomie d\u2019\u00e9nergie gr\u00e2ce \u00e0 ses niveaux de faible consommation. Cette r\u00e9duction de la consommation d\u2019\u00e9nergie est b\u00e9n\u00e9fique tant au niveau financier qu\u2019environnemental de l\u2019entreprise et est une composante importante du bon d\u00e9roulement du travail. En outre, le moniteur LED professionnel S22A450MW de Samsung est incroyablement l\u00e9ger et contribue \u00e0 r\u00e9duire les tracas li\u00e9s au transport de moniteurs. Voici encore une autre mani\u00e8re que Samsung a trouv\u00e9 pour am\u00e9liorer votre environnement de travail.\\n\\n<b>Passez au vert gr\u00e2ce \u00e0 la fonction de mise sous\/hors tension de l\u2019adaptateur Samsung \u00e0 consommation \u00e9lectrique nulle.<\/b>\\nLa mesure ultime en mati\u00e8re d\u2019\u00e9conomie d\u2019\u00e9nergie a \u00e9t\u00e9 invent\u00e9e par Samsung gr\u00e2ce au mode de mise sous\/hors tension du nouvel adaptateur. En activant simplement l\u2019interrupteur m\u00e9canique du moniteur LED professionnel S22A450MW de Samsung, vous pouvez r\u00e9duire la consommation d\u2019\u00e9nergie lorsque vous n\u2019utilisez pas le moniteur pour ainsi atteindre une consommation nulle. En effet, le mode veille traditionnel r\u00e9duit la consommation d\u2019\u00e9nergie jusqu\u2019\u00e0 atteindre 1 Watt. Le S22A450MW va encore plus loin pour atteindre de meilleurs r\u00e9sultats. Vous contribuerez ainsi \u00e0 r\u00e9duire l\u2019impact sur l\u2019environnement et les co\u00fbts de fonctionnement. Voil\u00e0 comment Samsung contribue \u00e0 cr\u00e9er un environnement plus vert.\\n\\n<b>Faites place nette sur votre bureau avec l\u2019organisateur de c\u00e2bles de Samsung.<\/b>\\nLe professionnalisme passe aussi par un environnement de travail propre et net. C\u2019est pourquoi le moniteur LED professionnel S22A450MW de Samsung est dot\u00e9 d\u2019un organisateur de c\u00e2bles. Celui-ci organise les c\u00e2bles du moniteur de mani\u00e8re pratique, les rassemblant le long du pied et d\u00e9gageant l'\u00e9cran. Avec le moniteur LED professionnel S22A450MW de Samsung, vous pouvez enfin profiter d\u2019un environnement de travail libre de tout c\u00e2ble g\u00eanant.\\n\\n<b>un moniteur dont le design r\u00e9pond aux exigences professionnelles<\/b>\\nLe moniteur LED professionnel S22A450MW de Samsung a \u00e9t\u00e9 con\u00e7u pour am\u00e9liorer vos conditions de travail et votre rendement. Dot\u00e9 de touches tactiles \u00e0 l\u2019avant, le S22A450MW minimise les erreurs dues \u00e0 une utilisation importante, car ceci repr\u00e9sente un probl\u00e8me courant avec les moniteurs \u00e0 touches tactiles. Son design intelligent permet en outre aux utilisateurs d\u2019acc\u00e9der \u00e0 ces touches m\u00eame lorsque le moniteur est fix\u00e9 au mur, ce qui n\u2019est pas toujours \u00e9vident avec les moniteurs dot\u00e9s de touches lat\u00e9rales. Le SA200 est particuli\u00e8rement esth\u00e9tique gr\u00e2ce \u00e0 son cadre \u00e9troit biseaut\u00e9 et mat. Le pourtour de l\u2019\u00e9cran est ainsi minimis\u00e9 et le spectateur plonge directement dans l\u2019image.\\n\\n<b>passez au niveau sup\u00e9rieur avec le m\u00e9ga contraste dynamique<\/b>\\nD\u00e9couvrez des niveaux de couleurs, de brillance et de qualit\u00e9 d'image in\u00e9dits gr\u00e2ce au m\u00e9ga ratio de contraste dynamique. Le moniteur LED professionnel S22A450MW offre des images si r\u00e9alistes que votre exp\u00e9rience visuelle toute enti\u00e8re en sera transform\u00e9e. Avec un ratio de contraste de 5.000.000:1 \u2013 le plus haut niveau actuellement disponible \u2013 le S22A450MW garantit les noirs les plus sombres, les blancs les plus purs et les couleurs les plus \u00e9clatantes. Vous remarquerez imm\u00e9diatement la finesse des images et leur intensit\u00e9 incomparable. C\u2019est une r\u00e9elle explosion de couleurs, qui fera para\u00eetre tous les autres \u00e9crans bien ternes en comparaison.\\n\\n<b>le Magic Angle vertical garantit une perfection immuable<\/b>\\nLe moniteur LED professionnel S22A450MW de Samsung est dot\u00e9 d\u2019une fonction Magic Angle vertical qui offre une image parfaite, m\u00eame lorsqu'on ne le regarde pas de face. Cela signifie que vous pouvez regarder le moniteur assis, debout ou couch\u00e9 sur le canap\u00e9 tout en b\u00e9n\u00e9ficiant toujours de la m\u00eame qualit\u00e9 d'image. De plus, 20 orientations diff\u00e9rentes (10 vers le haut et 10 vers le bas), vous trouverez toujours la position qui convient. Ainsi, le Magic Angle vertical - d\u00e9velopp\u00e9 tout particuli\u00e8rement pour les moniteurs LED professionnel, vous avec toujours l\u2019impression d\u2019\u00eatre en face de l\u2019\u00e9cran\u2026 m\u00eame si ce n'est pas r\u00e9ellement le cas."}],"response_time":[{"locale":null,"scope":null,"data":5}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-13T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ea1b7316-6353-4a91-9c98-9ec1b57fa215","identifier":"10982580","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["n"]}],"name":[{"locale":null,"scope":null,"data":"Canon imageCLASS MF5950DW"}],"description":[{"locale":"en_US","scope":"print","data":"The imageCLASS MF5950dw combines professional-quality multifunction capabilities with features that help businesses save time and money, making it the perfect device for today's small business owners.\\n\\nFeaturing a 50-sheet Duplex Auto Document Feeder (DADF), 250-sheet cassette plus 50-sheet multipurpose tray, and an optional 500-sheet paper cassette pedestal and handling paper sizes up to legal10, the MF5950dw delivers print speeds of up to 35 pages per minute single-sided and 17 pages per minute double-sided in black and white11. With Canon's Quick First Print Technology, your first print arrives in approximately 6 seconds.\\n\\nThe MF5950dw is also outfitted with cost-saving tools such as all-mode auto duplex functionality, energy-saving technologies and Department ID Management, which enables you to set limits on who can use the machine and how much they can print, copy or scan. You will be able to manage the device from your desk through an embedded web server (Remote UI), which will give you the freedom to view and modify network settings or retrieve an activity log. With built-in Fax Forwarding and Send functionality, the MF5950dw allows you to send incoming faxes, internet faxes and scanned documents to an email address, network folder or another fax number. For on-the-go users, the MF5950dw offers a USB port to facilitate scanning files directly to, or print files directly from a USB drive.\\n\\nWith built-in wireless you'll have the freedom to conveniently send print jobs to your device from any location in your home or small office7. The MF5950dw has a Wi-Fi Protected Setup (WPS) option for a one-touch connection to simplify the task of connecting your device to a wireless network. Furthermore, you'll reduce wiring clutter and help prevent security breaches with WEP and WPA-PSK.\\n\\nThe MF5950dw uses approximately 3 watts of energy during Energy Saving Mode and meets Energy Star guidelines, saving you money on energy costs. And like many imageCLASS products, it is part of the Generation Green program, Canon's initiative to reduce environmental burdens in all stages of a product's life-cycle."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-13T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"6f9dcb29-dba3-414c-a9e1-b90d12799422","identifier":"10993501","enabled":true,"family":"laser_led_printers","categories":["canon","laser_led_printers","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"215_x_355_mm"}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS LBP6750dn"}],"description":[{"locale":"en_US","scope":"print","data":"This black and white laser printer integrates seamlessly into any office environment. Robust, quick and featuring duplex capabilities, it\u2019s the productive solution for business workgroups.\\n\\n- 40 ppm, 8 seconds First Print Out Time\\n- Automatic double-sided printing\\n- PCL5e\/6 with optional Postscript Level 3 support\\n- 1600-sheet maximum paper supply\\n- Energy efficient\\n- All-in-One cartridge for maintenance free operation\\n- Intuitive control panel\\n- The productive and robust high quality laser printer\\n\\n<b>Highly productive<\/b>\\nEverything about this productive mono laser printer is designed to keep you well ahead of schedule. Designed for corporate workgroups and perfect for high volume printing it delivers exceptionally quick print speeds of 40 ppm. Canon\u2019s Quick First-Print technologies ensure there\u2019s virtually zero warm-up time from standby mode and the First Print Out Time is 8 seconds.\\n\\n<b>Automatic double-sided printing<\/b>\\nAdd an extra level of professionalism by automatically printing on both sides of a document \u2013 and save paper at the same time.\\n\\n<b>Extensive paper supply<\/b>\\nEquipped with a 500-sheet cassette and 100-sheet tray as standard, the i-SENSYS LBP6750dn can be further configured with 2 x 500-sheet cassettes, for a paper supply totalling 1600 sheets. This ensures even the heaviest workloads can be effortlessly handled.\\n\\n<b>Built-in networking<\/b>\\nShare printer resources for maximum productivity with standard built-in 100BASE-TX\/10BASE-T networking. It\u2019s simple to set up, use and control from every connected PC.\\n\\n<b>An optional IEEE 802.11 b\/g connection allows wireless connections too.<\/b>\\n\\n<b>PCL5e\/6 and optional PS support<\/b>\\nThis printer can be used in all PCL print environments thanks to native support for PCL 5e\/6. A PostScript option is also available and Canon\u2019s own high performance UFR II printer language is supported for maximum flexibility.\\n\\n<b>Exceptional laser quality<\/b>\\nDeliver the sharpest, crispest text and most detailed graphics thanks to a print resolution of 2400 x 600 dpi with Automatic Image Refinement.\\n\\n<b>Easy to use<\/b>\\nA 5-line LCD complete with animations makes this printer easy to work with. Canon\u2019s All-in-One cartridge - containing toner and all essential parts - can be replaced in seconds. There\u2019s no mess or maintenance worries - just continuous high quality output. A higher yield toner cartridge is also available which allows you to print well over double the amount of pages.\\n\\n<b>Energy efficient<\/b>\\nMinimise environmental impact with class leading Typical Energy Consumption (TEC) of just 2.0 KWh\/week."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"a460dc0d-5453-4ecf-97d3-a29a22248d8b","identifier":"10994742","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"name":[{"locale":null,"scope":null,"data":"Canon imageCLASS MF3010"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Print, Copy and Scan with the imageCLASS MF3010 Black & White Laser Multifunction Printer<\/b>\\nThe imageCLASS MF3010 is an ultra-compact and easy-to-use multifunction printer that delivers high-quality black and white prints, copies and color scans. It boasts print1 and copy2 speeds of up to 19 pages-per-minute (ppm) for letter-sized output, and delivers Quick First Prints in approximately eight seconds. The unit also offers paper handling of up to 150 pages in a front loading cassette9. Print sharp monochrome output with resolution up to 1200 x 600 dpi and through use of the platen glass color scans are captured in 24-bit color at an interpolated resolution of up to 9600 dpi.\\n\\nFor added productivity the MF3010 includes unique features such as the I.D. Card Copy, which allows you to create copies of your identification cards or other small documents to keep for your records on a convenient one-sided document. It offers a simple control panel (7-segment, 1-digit LED) and features Canon's Single Cartridge System, which combines toner, drum and waster toner into one unit for easy maintenance."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ec139d2b-9b36-47c9-a5cb-524dc99cadc2","identifier":"10995726","enabled":true,"family":"pc_monitors","categories":["hp","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"HP LM975A8"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":20,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"HP Performance Series Monitors are the hallmark of the HP displays family. We\u2019ve reimagined our 20-inch diagonal monitor as an LED backlit IPS monitor with 16:9 aspect ratio that\u2019s also ultra-modern and super sleek to perfectly complement HP Z Workstations. Introducing the completely redesigned HP ZR2040w 20\u201d LED Backlit IPS Monitor - at a price point you won\u2019t believe."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ff7a3dfe-0155-4de7-9262-be64e0494f76","identifier":"10995793","enabled":true,"family":"pc_monitors","categories":["asus","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"ASUS VS198D-P"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"<b>Superior Image Quality Meets Classic Elegant Design<\/b>\\nDelicate touches make a monitor truly great, VS198D LED monitor with 50,000,000:1 high contrast ratio, is optimized for the finest image and color quality. This approach extends to the sturdy stand and slim profile without compromising style in ensuring stability and durability."}],"response_time":[{"locale":null,"scope":null,"data":5}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"97139bcc-f2e5-44f2-a26a-254aa68aecdf","identifier":"10996074","enabled":true,"family":"pc_monitors","categories":["lg","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"LG 47WS10"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":47,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"Designed for 24\/7 continuous operation, the 47WS10 displays advertisements, information and broadcast video with Full HD brilliance. Its integrated RJ-45 LAN control enables individual management for multiple displays and eliminates the need for an IP card and an IP Interface box. With landscape, portrait and 5x5 tile mode capabilities, the 47WS10 adapts to your signage needs"}],"response_time":[{"locale":null,"scope":null,"data":12}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"78fcbe56-28b1-4449-9b8b-3af61486d8b9","identifier":"11009932","enabled":true,"family":"pc_monitors","categories":["lg","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"LG E2251S"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}],"description":[{"locale":"en_US","scope":"print","data":"LG E2251S. Display diagonal: 21.5, Display resolution: 1920 x 1080, Display: LED. VESA mounting interfaces compatibility: 75 x 75, Tilt angle: -5 - 15. Input voltage: 100 - 240, Power consumption (standby): 0.5. Width: 517.5, Depth: 33.5, Height: 317.3"}],"response_time":[{"locale":null,"scope":null,"data":5}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"79daf5ff-aefe-4051-99b1-cccb6a703b95","identifier":"11026270","enabled":true,"family":"pc_monitors","categories":["hp","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"HP LA2206xc + WF722A"}],"description":[{"locale":"en_US","scope":"print","data":"From small businesses to large corporations, communicating face-to-face with team members and customers is essential. Change the way your company connects, while saving time and money with the HP Compaq LA2206xc 54,6 cm (21.5\") diagonal Webcam LCD monitor.\\n\\n<b>Features<\/b>\\n\\n<b>Connect and Collaborate<\/b>\\n- Be there virtually. The LA2206xc monitor delivers a built-in 720p HD webcam, dual microphones and integrated speakers for video conferencing. Work with colleagues and clients as though they are in the same room.\\n\\n<b>Virtual Meeting Software Solutions<\/b>\\n- Strengthen work relationships online, amplify productivity, and save time and money with virtual meeting software (included with the monitor). HP MyRoom and YouCam 4 are safe and easy for real-time sharing and interaction.\\n\\n<b>Forward-thinking Design<\/b>\\n- Beyond the sleek appearance and high screen performance, stands a slender monitor that utilizes minimal desktop space, includes ergonomic features for a comfortable view and is designed with the environment in mind.\\n\\n<b>Meet the Toughest Standards<\/b>\\n- The HP Compaq LA2206xc is ENERGY STAR\u00ae 5.0 qualified, EPEAT\u00ae Gold registered, and TCO Displays certified."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-16T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"c17b80df-4910-4252-abfc-181de02bb77d","identifier":"11042547","enabled":true,"family":"multifunctionals","categories":["multifunctionals","print_scan_sales","xerox"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["copy","print"]}],"name":[{"locale":null,"scope":null,"data":"Xerox Workcentre 6015NI"}],"description":[{"locale":"de_DE","scope":"print","data":"- Farbe: bis zu 12 Seiten\/Min. in DIN A4\\n- Schwarzwei\u00df: bis zu 15 Seiten\/Min. in DIN A4\\n- Maximales Papierformat: 216 x 356 mm\\n- Aufl\u00f6sung: bis zu 1.200 x 2.400 dpi\\n- Beh\u00e4lterkapazit\u00e4t, Grundmodell: Hauptbeh\u00e4lter: 150 Blatt, Zusatzzufuhr: 10 Blatt\\n- Manueller Duplexdruck\\n- 295-MHz-Prozessor\\n- 128 MB Arbeitsspeicher\\n- Kompatibel mit Windows (einschlie\u00dflich Windows 7) und Macintosh\\n- Mindestabmessungen (B x T x H): 410 x 389 x 337 mm\\n- Elektrische Anschlusswerte: 230 V, 50\/60 Hz\\n\\n<b>Druckqualit\u00e4tsmerkmale - WorkCentre 6015<\/b>\\n\\n- Das Hi-Q LED-Drucksystem fu\u00dft auf der gleichen bahnbrechenden Technologie, die einige unserer Ger\u00e4te f\u00fcr grafisches Design im gehobenen Marktsegment auszeichnet.\\n- Die einzigartige Xerox EA-Tonertechnologie sorgt f\u00fcr gestochen scharfen Text und detailstarke Druckbilder von \u00fcberragender Klarheit. Es handelt sich dabei um denselben Hochqualit\u00e4tstoner, der in unseren professionellen Farbger\u00e4ten f\u00fcr grafisches Design zum Einsatz kommt.\\n- PANTONE\u00ae-kalibrierte Farbfl\u00e4chensimulationen und Xerox-Farbkorrekturtechnologie dienen als Tools f\u00fcr den pr\u00e4zisen Farbabgleich bei wichtigen Gesch\u00e4ftsmerkmalen wie Firmenlogos.\\n\\n<b>Zuverl\u00e4ssigkeit und Bedienfreundlichkeit - WorkCentre 6015<\/b>\\n\\n- Auf der intuitiven zweizeiligen LCD-Bedieneroberfl\u00e4che k\u00f6nnen Sie den aktuellen Tonerstand auf einen Blick an einer praktischen Anzeige ablesen.\\n- Mehr Freiheit ohne Kabel mit standardm\u00e4\u00dfig integriertem WLAN. (Modell WorkCentre 6015\/NI)\\n- Vielf\u00e4ltige Bedruckstoffe - von Etiketten \u00fcber Karton bis hin zu Umschl\u00e4gen.\\n- \u00dcber eine handliche manuelle Zusatzzufuhr k\u00f6nnen Sie bis zu 10 Blatt Spezialpapier und Umschl\u00e4ge zuf\u00fchren, ohne das Papierfach \u00f6ffnen zu m\u00fcssen.\\n- Der integrierte CentreWare IS-Webserver erm\u00f6glicht es Ihnen, den Status von Druckauftr\u00e4gen bequem von Ihrem Computer aus zu \u00fcberpr\u00fcfen und das Ger\u00e4t aus der Ferne zu verwalten.\\n- \u00dcber den USB-Anschluss an der Vorderseite k\u00f6nnen Bediener rasch Scanausgabedateien auf einem Stick speichern.\\n- Einfache Installation und vorinstallierte Tonerpatronen bedeuten, Sie brauchen den Multifunktionsdrucker nur einzust\u00f6pseln und k\u00f6nnen sofort loslegen.\\n- Extrem ger\u00e4uscharmer Betrieb - Ihre Konzentration bleibt ungest\u00f6rt, auch wenn der Drucker direkt an Ihrem Arbeitsplatz steht.\\n- Die Schwarzwei\u00df-Druckfunktion \u201eRun-Black\u201c bedeutet, Sie k\u00f6nnen den Druck in Schwarzwei\u00df fortsetzen, auch wenn die Farbpatronen aufgebraucht sind.\\n- Nur ein einziges Verbrauchsmaterial: Die superschlanken, einfach einsetzbaren Tonerpatronen wurden so entwickelt, damit sie weniger Verpackung und nur geringsten Lagerplatz ben\u00f6tigen.\\n\\n<b>Produktivit\u00e4tsmerkmale - WorkCentre 6015<\/b>\\n\\n- Der preisg\u00fcnstige WorkCentre 6015 Multifunktionsfarbdrucker ist ein Business-Tool f\u00fcr Ihren Arbeitsplatz und bietet praxisgerechte Druckproduktivit\u00e4t sowie eine Heerschar integrierter Funktionen.\\n- \u00dcberlegene Leistung zur z\u00fcgigen Auftragsabwicklung: Farbdrucke werden mit einer Geschwindigkeit von 12 Seiten\/Min. und Schwarzwei\u00dfdrucke mit 15 Seiten\/Min. erstellt.\\n- Mit einem 295-MHz-Prozessor und 128 MB Standardspeicher wird das t\u00e4gliche Auftragsvolumen spielend bew\u00e4ltigt - inklusive mehrseitiger Druckauftr\u00e4ge mit Grafiken, Fotos und Diagrammen."},{"locale":"en_US","scope":"print","data":"WorkCentre 6015 Multifunction Printer\\n Outstanding colour will help your business stand out. Xerox makes it easy and affordable with the WorkCentreTM 6015 multifunction printer (MFP), our smallest* A4 colour MFP. Combine print, copy, scan, fax and email capabilities into a single, compact device. You\u2019ll save energy as well as desk space with this super quiet MFP that fits wherever you need it. But don\u2019t let its tiny size fool you. The WorkCentre 6015 MFP features a powerful Hi-Q LED print engine, energy saving EA toner and outstanding colour print quality thanks to its 1200 x 2400 dpi resolution. The WorkCentre 6015 MFP is just the right combination of value, power and quality to help your business stand out as never before. \\n With three configurations to choose from, you only pay for the features and connectivity your office requires USB, network or Wi-Fi. \\n Easy-to-use features like scan to network, email or USB memory stick will help your office run more efficiently and productively. \\n Print or copy on a wide range of custom paper types and sizes, including card stock, labels and envelopes. Load up the standard paper tray or use the handy manual feed slot for quick, short-term paper changes. Plus the available Automatic Document Feeder makes short work of multi-page copying or scanning projects. \\n Designed for reliability, the WorkCentre 6015 MFP is as easy to maintain as it is to use. The compact, toner-only cartridges snap into place when a refill is required. The toner can be shared with Phaser\u00ae 6000 and 6010 colour printers, to simplify ordering and managing backup inventory. \\n A one year, on-site warranty is standard for your protection and peace of mind. The WorkCentre 6015 MFP provides outstanding colour quality and powerful performance in a space-saving, easy-to-use multifunction printer. It\u2019s an exceptional value. \\n *When in a closed state compared to A4-size colour multifunction printer products utilising toner-based print technology as of June 2011. \\nQuick Facts\\n<ul>\\n<li>Colour: up to 12 ppm  Black: up to 15 ppm \\n<\/li>\\n<li>Maximum paper size: 216 x 356 mm <\/li>\\n<li>Print resolution: up to 1200 x 2400 dpi <\/li>\\n<li>Standard paper capacity: Main Tray: 150 sheets, Bypass Tray: 10 sheets <\/li>\\n<li>Manual two-sided printing <\/li>\\n<li>295 MHz processor <\/li>\\n<li>128 MB memory <\/li>\\n<li>Windows (including 7) and Mac compatible <\/li>\\n<li>Minimum dimensions (w x d x h): 410 x 389 x 337 mm <\/li>\\n<li>Power requirements: 240 V, 50\/60 Hz <\/li>\\n<li>What comes in the box <\/li>\\nStarter toner cartridge (capacity: 500 pages<sup>1<\/sup>) <\/li>\\nPower cord <\/li>\\nUSB cable (6015\/B) <\/li>\\nSoftware and documentation <\/li>\\n<\/ul>\\nPrint Quality Features\\n<ul>\\n<li>Hi-Q LED print engine uses the same breakthrough technology found in some of our higher-end graphic arts devices <\/li>\\n<li>Unique Xerox EA toner technology gives you crisp text and printed images with superior detail and clarity. It\u2019s the same high-quality toner used in our professional graphic-arts colour devices <\/li>\\n<li>PANTONE\u00ae Colour calibrated solid-colour simulations and Xerox colour correction technology provide easy tools for precisely matching the colours of important business assets, such as company logos <\/li>\\n<\/ul>\\nReliability and Ease-of-use Features\\n<ul>\\n<li>The intuitive two-line LCD user interface features a convenient gauge that shows current toner levels at a glance <\/li>\\n<li>Wireless freedom with standard, internal wireless networking (WorkCentre 6015\/NI model) <\/li>\\n<li>Print on everything from labels to cardstock to envelopes <\/li>\\n<li>A convenient manual feed slot lets you feed up to 10 sheets of specialty media and envelopes without opening and loading the paper tray <\/li>\\n<li>The CentreWare IS internal web server lets you check the status of a print job or manage the device without leaving your computer <\/li>\\n<li>The front-side USB port allows users to quickly scan to any standard portable USB memory device <\/li>\\n<li>Easy installation and pre-loaded toner cartridges make this multifunction printer virtually plug-and-play <\/li>\\n<li>Super-quiet operation lets you keep your printer nearby for distraction-free convenience <\/li>\\n<li>The Run Black feature lets you keep printing in black-and-white even if the multifunction printer runs out of colour toner <\/li>\\n<li>Only one consumable: the ultra-slim, easy-to-load toner cartridges are designed to reduce packaging and require minimal storage space <\/li>\\n<\/ul>\\nProductivity Features\\n<ul>\\n<li>The value-packed WorkCentre 6015 colour multifunction printer means business for your desktop, providing real-world print productivity and a host of built-in features <\/li>\\n<li>Superior performance gets your jobs out quickly, with print speeds as fast as 12 ppm for colour and 15 ppm for black-and-white <\/li>\\n<li>A 295 MHz processor and 128 MB standard memory handle your daily workload \u2014 even pages with graphics, photos and charts <\/li>\\n<\/ul>\\n<sup>1<\/sup> Average standard pages. Declared Yield in accordance with ISO\/IEC 19798. Yield will vary based on image, area coverage and print mode."},{"locale":"fr_FR","scope":"print","data":"WorkCentre 6015\\n Des couleurs exceptionnelles pour que vos travaux sortent du lot. Avec Xerox, cela devient facile et abordable gr\u00e2ce \u00e0 l\u2019imprimante multifonctions WorkCentreTM 6015, notre plus petit<sup>*<\/sup> syst\u00e8me multifonctions couleur A4. Associez des capacit\u00e9s d\u2019impression, de copie, de num\u00e9risation, de t\u00e9l\u00e9copie et de courrier \u00e9lectronique dans un seul appareil compact. Vous ferez des \u00e9conomies d\u2019\u00e9nergie et d\u2019espace dans votre bureau gr\u00e2ce \u00e0 cet appareil multifonctions ultrasilencieux qui saura trouver sa place partout o\u00f9 vous en avez besoin. Mais ne vous laissez pas d\u00e9router par sa petite taille. Le syst\u00e8me multifonctions WorkCentre 6015 poss\u00e8de un puissant moteur d\u2019impression \u00e0 LED Hi-Q, un toner EA \u00e0 \u00e9conomies d\u2019\u00e9nergie et une qualit\u00e9 d\u2019impression couleur impressionnante avec sa r\u00e9solution \u00e0 1 200 x 2 400 ppp. Le syst\u00e8me multifonctions WorkCentre 6015 offre l\u2019accord parfait entre valeur, puissance et qualit\u00e9 pour aider vos travaux \u00e0 sortir du lot comme jamais auparavant. \\n Avec trois configurations au choix, vous ne payez que pour les fonctionnalit\u00e9s et la connectivit\u00e9 dont votre bureau a besoin : USB, r\u00e9seau ou Wi-Fi. \\n Les fonctionnalit\u00e9s faciles \u00e0 utiliser, comme la num\u00e9risation vers le r\u00e9seau, un courrier \u00e9lectronique ou une carte m\u00e9moire USB, aideront votre bureau \u00e0 travailler plus efficacement et \u00e0 \u00eatre plus productif. \\n Imprimez ou copiez sur un large \u00e9ventail de formats et de types de papiers personnalis\u00e9s, notamment le papier cartonn\u00e9, les \u00e9tiquettes et les enveloppes. Chargez le magasin papier standard ou utilisez le magasin d\u2019introduction manuelle pratique pour changer rapidement de papier pour un tirage court. En outre, le Chargeur automatique de documents offre la possibilit\u00e9 de copier ou de num\u00e9riser rapidement des projets de plusieurs pages. \\n Con\u00e7u dans une optique de fiabilit\u00e9, le syst\u00e8me multifonctions WorkCentre 6015 est aussi facile d\u2019entretien que d\u2019utilisation. Les cartouches compactes \u00e0 toner uniquement se glissent facilement en place lorsqu\u2019une recharge est n\u00e9cessaire. Pour simplifier la commande et la gestion de l\u2019inventaire de secours, le toner peut \u00eatre partag\u00e9 avec les imprimantes Phaser\u00ae 6000 et 6010. \\n Une garantie d\u2019un an sur site est propos\u00e9e en standard pour votre protection et votre tranquillit\u00e9 d\u2019esprit. Le syst\u00e8me multifonctions WorkCentre 6015 offre une qualit\u00e9 de couleur exceptionnelle et de puissantes performances dans une imprimante multifonctions facile \u00e0 utiliser et tr\u00e8s \u00e9conome en termes de place. Sa valeur est exceptionnelle. \\n<sup>*<\/sup>En position ferm\u00e9e, par rapport aux imprimantes multifonctions couleur A4 faisant appel \u00e0 la technologie d\u2019impression \u00e0 base de toner \u00e0 compter du mois de juin 2011. \\nPr\u00e9sentation g\u00e9n\u00e9rale\\n<ul>\\n<li>Couleur: jusqu'\u00e0 12 ppm  Noir et Blanc : jusqu'\u00e0 15 ppm \\n<\/li>\\n<li>Format de papier maximal : 216 x 356 mm <\/li>\\n<li>R\u00e9solution d\u2019impression : jusqu'\u00e0 1200 x 2400 ppp <\/li>\\n<li>Capacit\u00e9 papier standard : Magasin principal : 150 feuilles, d\u00e9part manuel : 10 feuilles <\/li>\\n<li>Impression recto verso manuelle <\/li>\\n<li>Processeur \u00e0 295 MHz <\/li>\\n<li>128 Mo de m\u00e9moire <\/li>\\n<li>Compatible Windows (y compris Windows 7) et Mac <\/li>\\n<li>Dimensions minimum (L x P x H): 410 x 389 x 337 mm <\/li>\\n<li>Alimentation \u00e9lectrique: 230 V, 50\/60 Hz <\/li>\\n<li>Contenu de l'emballage <\/li>\\nCartouche de d\u00e9marrage (capacit\u00e9 : 500 pages<sup>1<\/sup>) <\/li>\\nCordon d'alimentation <\/li>\\nC\u00e2ble USB (6015\/B) <\/li>\\nLogiciel et documentation <\/li>\\n<\/ul>\\nFonctions de qualit\u00e9 d'impression\\n<ul>\\n<li>Le moteur d'impression LED haute qualit\u00e9 utilise la m\u00eame technologie de pointe que certains de nos syst\u00e8mes haut de gamme d\u00e9di\u00e9s aux arts graphiques. <\/li>\\n<li>Le toner EA, une technologie unique d\u00e9velopp\u00e9e par Xerox, permet d'imprimer du texte d'une extr\u00eame nettet\u00e9 et des images au rendu plus clair et pr\u00e9cis. Ce toner haute qualit\u00e9 est d'ailleurs utilis\u00e9 dans nos syst\u00e8mes d'impression couleur destin\u00e9s aux professionnels des arts graphiques. <\/li>\\n<li>Les simulations couleurs conformes PANTONE\u00ae et la technologie de correction couleur Xerox constituent des outils conviviaux qui permettent d'assurer la correspondance pr\u00e9cise des couleurs, notamment dans les \u00e9l\u00e9ments graphiques essentiels tels que les logos d'entreprises <\/li>\\n<\/ul>\\nFiabilit\u00e9 et facilit\u00e9 d'utilisation\\n<ul>\\n<li>L'interface utilisateur intuitive est constitu\u00e9e d'un \u00e9cran LCD \u00e0 deux lignes. Pratique, elle affiche les jauges des cartouches de toner ce qui permet de conna\u00eetre les niveaux restants d'un simple coup d'\u0153il. <\/li>\\n<li>Libert\u00e9 sans fil gr\u00e2ce \u00e0 des fonctions r\u00e9seau sans fil standard internes (mod\u00e8le WorkCentre 6015\/NI) <\/li>\\n<li>Imprimez sur tous les supports, des \u00e9tiquettes aux supports cartonn\u00e9s et aux enveloppes. <\/li>\\n<li>La fente d'alimentation manuelle, tr\u00e8s pratique, vous permet d'ins\u00e9rer jusqu'\u00e0 10 feuilles de support sp\u00e9cial et enveloppes sans ouvrir et charger le magasin <\/li>\\n<li>Le serveur Web CentreWare IS int\u00e9gr\u00e9 permet de v\u00e9rifier l'\u00e9tat d'un tirage ou de g\u00e9rer le p\u00e9riph\u00e9rique depuis votre ordinateur. <\/li>\\n<li>Port USB en fa\u00e7ade pour num\u00e9riser rapidement depuis ou vers une cl\u00e9 USB standard <\/li>\\n<li>Installation ais\u00e9e et cartouches de toner pr\u00e9-charg\u00e9es pour une utilisation quasiment plug-and-play de cette imprimante multifonction <\/li>\\n<li>Son fonctionnement super silencieux permet de l'installer \u00e0 proximit\u00e9 de votre poste de travail sans \u00eatre d\u00e9rang\u00e9 par le bruit. <\/li>\\n<li>Fonctionnement en noir pour poursuivre l'impression m\u00eame lorsque le toner couleur de l'imprimante multifonction est \u00e9puis\u00e9 <\/li>\\n<li>Un seul consommable : les cartouches de toner ultra fines et faciles \u00e0 charger sont con\u00e7ues pour r\u00e9duire l'emballage et exiger un minimum d'espace d'entreposage <\/li>\\n<\/ul>\\nFonctions de productivit\u00e9\\n<ul>\\n<li>L'imprimante couleur multifonction bourr\u00e9e de qualit\u00e9s WorkCentre 6015 est un v\u00e9ritable atout pour votre bureau ; elle offre des fonctions de productivit\u00e9 concr\u00e8tes et une foule de fonctionnalit\u00e9s int\u00e9gr\u00e9es. <\/li>\\n<li>Ses performances sup\u00e9rieures permettent de r\u00e9aliser rapidement les travaux \u00e0 des vitesses d'impression pouvant atteindre 12 ppm en mode couleur et 15 ppm en mode noir et blanc. <\/li>\\n<li>Le processeur \u00e0 295 MHz et 128 Mo de m\u00e9moire en standard assurent le traitement de tous vos travaux quotidiens \u2014 m\u00eames les tirages comportant des graphiques, des photos et des diagrammes. <\/li>\\n<\/ul>\\n<sup>1<\/sup> Pages standard moyennes. Rendement d\u00e9clar\u00e9 conform\u00e9ment \u00e0 la norme ISO\/IEC 19798. Le rendement varie en fonction de l'image, de la couverture et du mode d'impression."}],"color_scanning":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-20T00:00:00+00:00"}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"3f1eea7f-5887-41b3-abe6-7c897e665ff8","identifier":"11042550","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","print_scan_sales","xerox"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"picture":[{"locale":null,"scope":null,"data":"a\/e\/6\/b\/ae6bce599738c5c2b26f215124a76623c718249d_11042550_1577.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/a\/e\/6\/b\/ae6bce599738c5c2b26f215124a76623c718249d_11042550_1577.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Xerox 6700DNM"}],"description":[{"locale":"de_DE","scope":"print","data":"Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 Farblaserdrucker Der Phaser\u00ae 6700 Farblaserdrucker steigert die Produktivit\u00e4t Ihrer Arbeitsgruppe, damit Sie mehr Zeit haben, sich ganz auf das zu konzentrieren, was am wichtigsten ist: der Erfolg Ihres Unternehmens.  Mit seiner \u00fcberzeugenden Kombination aus hervorragender Bildqualit\u00e4t und der beeindruckend schnellen Druckgeschwindigkeit verhilft der Xerox Phaser 6700 Ihrem Unternehmen oder\u2009Ihrer gro\u00dfen Arbeitsgruppe beim Drucken hoher Auflagen zu einer neuen Stufe der Produktivit\u00e4t. Bei jedem Ausdruck wichtiger Unternehmensdokumente k\u00f6nnen Sie sich auf unschlagbare Farbgenauigkeit verlassen. Weitere Pluspunkte: die enorme Benutzerfreundlichkeit und die bekannte Zuverl\u00e4ssigkeit, die nur Xerox bietet.   Die Fakten auf einen Blick <ul> <li>Farbe: bis zu 45 Seiten\/Min. in DIN A4 Schwarzwei\u00df: bis zu 45 Seiten\/Min. in DIN A4 <\/li> <li>Maximales Papierformat: 216 x 356 mm<\/li> <li>Beidseitig bedruckte Ausgabe standardm\u00e4\u00dfig mit 6700\/DN-, DT- und DX-Konfiguration<\/li> <li>Erweiterbar durch Endverarbeitungsoptionen f\u00fcr Stapeln (1.000 Blatt) und Heften (50 Blatt)<\/li> <li>Druckaufl\u00f6sung von 2.400 x 1.200 dpi<\/li> <li>Erweiterte Bedienerfreundlichkeit und Sicherheitsfunktionen<\/li> <li>Optionales Produktivit\u00e4ts-Kit mit 160 GB-Festplattenlaufwerk (Standard auf dem Modell DX)<\/li> <li>Kompatibel mit Mac, Windows (einschlie\u00dflich Vista), Unix, Linux und Citrix<\/li> <li>Maximales technisches Druckvolumen von bis zu 120.000 Seiten pro Monat<\/li> <li>Mindestabmessungen (B x T x H): 560 x 516 x 429 mm<\/li> <li>Elektrische Anschlusswerte: 230 V, 50\/60 Hz<\/li> <li>Lieferumfang<\/li> Farbe Tonerkartuschen (Kapazit\u00e4t: Je 5.000 Seiten<sup>1<\/sup>)<\/li> Schwarze Tonerkartusche (Kapazit\u00e4t: 7.100 Seiten<sup>1<\/sup>)<\/li> Trommeleinheiten<sup>2<\/sup> (Kapazit\u00e4t: 50.000 Seiten je Farbe, 50.000 Schwarzwei\u00dfseiten)<\/li> Netzkabel<\/li> Software und Dokumentation<\/li> <\/ul>  Produktivit\u00e4tsmerkmale <ul> <li>Herausragende Druckqualit\u00e4t Dank echter 2.400 x 1.200 dpi Druckaufl\u00f6sung und True Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Unglaubliche Leistung mit einer Druckgeschwindigkeit von bis zu 45 S.\/Min. in Farbe und Schwarzwei\u00df<\/li> <li>Maximales technisches Druckvolumen von 120.000 Seiten f\u00fcr B\u00fcros mit h\u00f6chstem Druckvolumen<\/li> <li>1,25 GHz-Prozessor und 1 GB Standard-Systemspeicher bew\u00e4ltigen einen konstanten Strom komplexester Auftr\u00e4ge mit Leichtigkeit<\/li> <li>Dank der Druckumgehungsfunktion entstehen keine langen Druckverz\u00f6gerungen, da der auf andere Ressourcen angewiesene Auftrag (z. B. anderes Papierformat) angehalten wird und der n\u00e4chste anstehende Druckauftrag vorgezogen wird<\/li> <li>Erweiterbar durch Endverarbeitungsoptionen f\u00fcr Stapeln (1.000 Blatt) und Heften (50 Blatt)<\/li> <\/ul>  Bedienerfreundliche Merkmale <ul> <li>\u00dcber die gro\u00dfe, farbige 10,9 cm-Touchscreen-Benutzeroberfl\u00e4che greifen Sie schnell und einfach auf jede ben\u00f6tigte Funktion zu<\/li> <li>Integrierte Videoanleitungen bieten direkt \u00fcber das Bedienfeld schnelle Hilfe bei der Fehlerbehebung<\/li> <li>Color By Words \u2013 W\u00e4hlen Sie die gew\u00fcnschten Farbmodifikationen einfach \u00fcber eine Dropdownliste im Drucker-Treiber aus<\/li> <li>Papierzuf\u00fchrung mit intelligenten Funktionen - Kein R\u00e4tselraten mehr durch die Anzeige aller verf\u00fcgbaren Druckmaterialien und -formate zum Zeitpunkt des Druckvorgangs<\/li> <\/ul>  Merkmale zur Schonung von Ressourcen <ul> <li>Serienm\u00e4\u00dfiger Duplexdruck bei Phaser 6700\/DN-, DT- und DX-Konfigurationen f\u00fcr weniger Papierverbrauch<\/li> <li>Innovativer EA-Toner erm\u00f6glicht im Vergleich zu herk\u00f6mmlichem Toner eine Fixierung bei geringerer Temperatur und erzeugt dabei hochwertigen B\u00fcro-Grafikdruck mit gl\u00e4nzender Oberfl\u00e4che<\/li> <li>Die Phaser 6700\/DN-, DT- und DX-Konfigurationen unterst\u00fctzt die ENERGY STAR\u00ae-Spitzenstandards f\u00fcr sparsamen Energieverbrauch.<\/li> <\/ul>  Sicherheitsmerkmale <ul> <li>Neueste Sicherheitsfunktionen mit kostenloser 256-Bit-Verschl\u00fcsselung nach dem Standard FIPS 140-2, au\u00dferdem integrierte Unterst\u00fctzung von IPv6, IPsec, sichere HTTPS-Verbindung und andere Netzwerksicherheitsfunktionen nach Branchennorm<\/li> <li>Optionales Produktivit\u00e4ts-Kit mit Festplattenlaufwerk enth\u00e4lt die gesch\u00fctzte Druckausgabe, die private Auftr\u00e4ge in der Warteschlange h\u00e4lt, bis sie vom Auftraggeber am Ger\u00e4t freigegeben werden (Standard auf dem Modell DX)<\/li> <li>Die verf\u00fcgbare Daten\u00fcberschreibung \u201eImage Overwrite\u201c entfernt nicht ben\u00f6tigte Daten komplett aus dem Festplattenspeicher des Farbdruckers Phaser 6700<\/li> <\/ul>  <sup>1<\/sup> Durchschnittliche Standardseiten. Angegebener Ertrag gem\u00e4\u00df ISO\/IEC 19798. Ertrag variiert aufgrund von Druckbild, Seitendeckung und Druckmodus. <sup>2<\/sup> Ungef\u00e4hre Anzahl Seiten. Angegebener Ertrag der Trommeln basiert auf einer durchschnittlichen Auftragsgr\u00f6\u00dfe von 4 Seiten im Format A4\/Letter. Angegebener Ertrag des Fixierers basiert auf Seiten von 75 g\/m\u00b2 im Format A4\/Letter. Ergiebigkeit von Trommel und Fixiereinheit variieren je nach Auftragsumfang, Nutzungsmustern sowie Art, Gr\u00f6\u00dfe, Grammatur und Ausrichtung des Materials."},{"locale":"en_US","scope":"print","data":"Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 Colour Laser Printer The Phaser\u00ae 6700 colour laser printer accelerates work group productivity, giving you more time to focus on what matters most: the success of your business.  With the winning combination of exceptional image quality and impressive fast print speed, the Xerox Phaser 6700 takes your business or large work group to a new level of high-volume productivity. You get unbeatable colour accuracy on every business-critical document you print, with the added benefits of superior ease-of-use and renowned reliability that only come from Xerox.  Quick Facts <ul> <li>Colour: up to 45 ppm Black: up to 45 ppm <\/li> <li>Maximum paper size: 216 x 356 mm<\/li> <li>Two-sided output standard on 6700\/DN, DT and DX configurations<\/li> <li>Finishing option adds 1000-sheet stacking and 50-sheet stapling<\/li> <li>True 2400 x 1200 dpi print resolution<\/li> <li>Advanced ease-of-use and security features<\/li> <li>Optional Productivity Kit with 160 GB hard drive (standard on DX model)<\/li> <li>Mac, Windows (including Vista), Unix, Linux, and Citrix compatible<\/li> <li>Maximum duty cycle of up to 120,000 pages per month<\/li> <li>Minimum dimensions (w x d x h): 560 x 516 x 429 mm<\/li> <li>Power requirements: 240 V, 50\/60 Hz<\/li> <li>What comes in the box<\/li> Colour toner cartridges (capacity: 5,000 pages each<sup>1<\/sup>)<\/li> Black toner cartridge (capacity: 7,100 pages<sup>1<\/sup>)<\/li> Drum cartridges<sup>2<\/sup> (capacity: 50,000 pages per colour, 50,000 pages black)<\/li> Power cord<\/li> Software and documentation<\/li> <\/ul>  Productivity Features <ul> <li>Superior print quality thanks to true 2400 x 1200 dpi print resolution and true Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Incredible performance, with a colour and black-and-white print speed of up to 45 ppm<\/li> <li>The 120,000-page monthly duty cycle supports the heaviest office print volumes<\/li> <li>1.25 GHz processor and standard 1 GB system memory handle a steady stream of complex jobs with ease<\/li> <li>The Print Around feature eliminates extended printing delays by holding a job in need of resources (such as a different paper size) and printing the next job in the queue<\/li> <li>Finisher option allows you to add 1000-sheet stacking and 50-sheet stapling<\/li> <\/ul>  Ease-of-use Features <ul> <li>The large, 109 mm colour touch screen interface makes it ultra easy to find the functions you need<\/li> <li>Embedded help videos provide quick troubleshooting assistance right on the front panel<\/li> <li>Color By Words lets you select desired colour modifications from a simple drop-down list <\/li> <li>Smart Trays alleviate guesswork by showing all available media types and sizes at print time<\/li> <\/ul>  Resource-conserving Features <ul> <li>Standard duplexing on Phaser 6700\/DN, DT and DX configurations help you reduce paper consumption<\/li> <li>Innovative EA Toner requires a lower fusing temperature than traditional toner while offering glossy, beautiful office graphics<\/li> <li>The Phaser 6700\/DN, DT and DX configurations support the highest ENERGY STAR\u00ae standards for power-saving.<\/li> <\/ul>  Security Features <ul> <li>State-of-the-art security includes free 256-bit encryption using the FIPS 140-2 standard, plus built-in support for IPv6, IPsec, secure HTTPS, and other industry-standard network security features<\/li> <li>Optional Productivity Kit with Hard Drive includes the Secure Print feature which holds private print jobs in the queue until they\u2019re released at the device by the job owner (standard on DX model)<\/li> <li>Available Image Overwrite feature completely removes unneeded data from the Phaser 6700 colour printer\u2019s internal storage<\/li> <\/ul>  <sup>1<\/sup> Average standard pages. Declared Yield in accordance with ISO\/IEC 19798. Yield will vary based on image, area coverage and print mode. <sup>2<\/sup> Approximate pages. Declared Yield on Drums based on an average job size of 4 pages A4\/letter size. Declared Yield on Fusers based on A4\/letter size 20 lb (75 gsm) pages. Drum and Fuser Yields will vary based on job run length, media type, size, weight, orientation, and usage patterns."},{"locale":"fr_FR","scope":"print","data":"Imprimante laser couleur Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 L\u2019imprimante laser couleur Phaser<sup>\u00ae<\/sup> 6700 am\u00e9liore la productivit\u00e9 du groupe de travail en vous lib\u00e9rant du temps que vous pouvez ainsi consacrer \u00e0 ce qui rev\u00eat le plus d\u2019importance : la r\u00e9ussite de votre activit\u00e9.  Avec une combinaison gagnante de qualit\u00e9 d\u2019image exceptionnelle et de rapidit\u00e9 d\u2019impression \u00e9tonnante, l\u2019appareil Xerox Phaser 6700 offre \u00e0 votre entreprise ou \u00e0 votre grand groupe de travail un niveau sup\u00e9rieur de productivit\u00e9 en gros volumes. Vous b\u00e9n\u00e9ficiez d\u2019une pr\u00e9cision des couleurs sans pareil pour chaque document strat\u00e9gique imprim\u00e9, avec l\u2019avantage suppl\u00e9mentaire d\u2019une facilit\u00e9 d\u2019utilisation sup\u00e9rieure et d\u2019une fiabilit\u00e9 de renom que seule Xerox peut vous offrir.  Pr\u00e9sentation g\u00e9n\u00e9rale <ul> <li>Couleur: jusqu'\u00e0 45 ppm Noir et Blanc : jusqu'\u00e0 45 ppm <\/li> <li>Format de papier maximal : 216 x 356 mm<\/li> <li>Impression recto-verso standard sur les configurations 6700\/DN, DT et DX<\/li> <li>L'option de finition ajoute une r\u00e9ception de 1.000 feuilles et l'agrafage de 50 feuilles<\/li> <li>V\u00e9ritable r\u00e9solution 2400 x 1200 dpi<\/li> <li>Fonctions d'utilisation ais\u00e9e et de s\u00e9curit\u00e9 avanc\u00e9es<\/li> <li>Kit de productivit\u00e9 optionnel avec disque dur de 160 Go (en standard sur Phaser 6700\/DX)<\/li> <li>Compatible Mac, Windows (notamment Vista), Unix, Linux et Citrix<\/li> <li>Cycle de service maximum de 120.000 pages par mois<\/li> <li>Dimensions minimum (L x P x H): 560 x 516 x 429 mm<\/li> <li>Alimentation \u00e9lectrique: 230 V, 50\/60 Hz<\/li> <li>Contenu de l'emballage<\/li> Cartouches de toner de couleur (capacit\u00e9 : 5 000 pages (de chaque)<sup>1<\/sup>)<\/li> Cartouche de toner noire (capacit\u00e9 : 7 100 pages<sup>1<\/sup>)<\/li> Cartouches de tambour<sup>2<\/sup> (capacit\u00e9 : 50 000 pages par couleur, 50 000 pages (noir))<\/li> Cordon d'alimentation<\/li> Logiciel et documentation<\/li> <\/ul>  Fonctions de productivit\u00e9 <ul> <li>Qualit\u00e9 d'impression sup\u00e9rieure gr\u00e2ce \u00e0 la v\u00e9ritable r\u00e9solution 2400 x 1200 et \u00e0 la compatibilit\u00e9 totale avec Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Extraordinaire performance, avec une vitesse d'impression couleur et noir et blanc pouvant atteindre jusqu'\u00e0 45 ppm<\/li> <li>Le cycle de service mensuel de 120.000 pages supporte les volumes d'impression bureautique les plus \u00e9lev\u00e9s<\/li> <li>Le processeur 1,25 GHz et la m\u00e9moire syst\u00e8me de 1 Go standard g\u00e8rent ais\u00e9ment un flux complexe de t\u00e2ches<\/li> <li>La fonction \u00ab Print Around \u00bb \u00e9limine les retards d'impression prolong\u00e9s en suspendant toute t\u00e2che exigeant des ressources diff\u00e9rentes (format de papier diff\u00e9rent, par exemple) afin de traiter la t\u00e2che suivante de la file d'attente.<\/li> <li>L'option de finition permet d'ajouter une r\u00e9ception de 1.000 feuilles et l'agrafage de 50 feuilles<\/li> <\/ul>  Fonctions simples <ul> <li>Le grand \u00e9cran tactile couleur de 4,3 de l'interface permet de trouver ais\u00e9ment les fonctions n\u00e9cessaires.<\/li> <li>Les fichiers d'aide vid\u00e9o int\u00e9gr\u00e9s offrent une assistance de d\u00e9pannage rapide, directement en fa\u00e7ade<\/li> <li>Le syst\u00e8me \u00ab Color By Words \u00bb permet de s\u00e9lectionner les modifications chromatiques voulues dans une simple liste contextuelle. <\/li> <li>La fonction de s\u00e9lection intelligente de magasin supprime la conjecture en affichant tous les types et les formats de support au moment de l'impression<\/li> <\/ul>  Des fonctions qui pr\u00e9servent les ressources <ul> <li>Le mode duplex standard sur les configurations Phaser 6700\/DN, DT et DX contribue \u00e0 diminuer la consommation de papier<\/li> <li>Le toner innovant EA requiert une temp\u00e9rature de fixation plus basse que le toner conventionnel mais permet l'impression de superbes graphiques brillants.<\/li> <li>Les configurations Phaser 6700\/DN, DT et DX sont conformes aux plus hautes normes ENERGY STAR\u00ae d'\u00e9conomie d'\u00e9nergie.<\/li> <\/ul>  Fonctions de s\u00e9curit\u00e9 <ul> <li>S\u00e9curit\u00e9 de premier ordre qui comprend un cryptage libre 256 bits utilisant la norme FIPS 140-2, plus la prise en charge int\u00e9gr\u00e9e des normes IPv6, IPsec, HTTPS s\u00e9curis\u00e9, entre autres fonctions de s\u00e9curit\u00e9 r\u00e9seau standard dans l'industrie<\/li> <li>Le kit de productivit\u00e9 optionnel avec disque dur inclut la fonction d'impression prot\u00e9g\u00e9e, qui conserve les t\u00e2ches d'impression priv\u00e9es dans la file d'attente jusqu'\u00e0 ce que leur propri\u00e9taire les d\u00e9clenche au niveau du syst\u00e8me (en standard sur Phaser 6700\/DX)<\/li> <li>La fonction de nettoyage des images supprime totalement les donn\u00e9es inutiles du stockage interne de l'imprimante couleur Phaser 6700<\/li> <\/ul>  <sup>1<\/sup> Pages standard moyennes. Rendement d\u00e9clar\u00e9 conform\u00e9ment \u00e0 la norme ISO\/IEC 19798. Le rendement varie en fonction de l'image, de la couverture et du mode d'impression. <sup>2<\/sup> Pages approximatives. Rendement d\u00e9clar\u00e9 des tambours bas\u00e9 sur un travail moyen de 4 pages au format A4. Rendement d\u00e9clar\u00e9 des unit\u00e9s de fusion bas\u00e9 sur des pages au format A4 et de grammage de 75 gm\u00b2. Les rendements des modules photor\u00e9cepteur et four d\u00e9pendent dela longueur des tirages, des supports utilis\u00e9s - type, format, grammage, orientation - et des modes d'utilisation du syst\u00e8me."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-20T00:00:00+00:00"}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"e5959088-1944-4047-939d-5e3e176e98fa","identifier":"11042552","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","print_scan_sales","xerox"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"a4_210_x_297_mm_"}],"picture":[{"locale":null,"scope":null,"data":"3\/f\/a\/f\/3faf03765dc228fadfd43692f8b9617c0003d431_11042552_8439.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/3\/f\/a\/f\/3faf03765dc228fadfd43692f8b9617c0003d431_11042552_8439.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Xerox 670DTM"}],"description":[{"locale":"de_DE","scope":"print","data":"Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 Farblaserdrucker Der Phaser\u00ae 6700 Farblaserdrucker steigert die Produktivit\u00e4t Ihrer Arbeitsgruppe, damit Sie mehr Zeit haben, sich ganz auf das zu konzentrieren, was am wichtigsten ist: der Erfolg Ihres Unternehmens.  Mit seiner \u00fcberzeugenden Kombination aus hervorragender Bildqualit\u00e4t und der beeindruckend schnellen Druckgeschwindigkeit verhilft der Xerox Phaser 6700 Ihrem Unternehmen oder\u2009Ihrer gro\u00dfen Arbeitsgruppe beim Drucken hoher Auflagen zu einer neuen Stufe der Produktivit\u00e4t. Bei jedem Ausdruck wichtiger Unternehmensdokumente k\u00f6nnen Sie sich auf unschlagbare Farbgenauigkeit verlassen. Weitere Pluspunkte: die enorme Benutzerfreundlichkeit und die bekannte Zuverl\u00e4ssigkeit, die nur Xerox bietet.   Die Fakten auf einen Blick <ul> <li>Farbe: bis zu 45 Seiten\/Min. in DIN A4 Schwarzwei\u00df: bis zu 45 Seiten\/Min. in DIN A4 <\/li> <li>Maximales Papierformat: 216 x 356 mm<\/li> <li>Beidseitig bedruckte Ausgabe standardm\u00e4\u00dfig mit 6700\/DN-, DT- und DX-Konfiguration<\/li> <li>Erweiterbar durch Endverarbeitungsoptionen f\u00fcr Stapeln (1.000 Blatt) und Heften (50 Blatt)<\/li> <li>Druckaufl\u00f6sung von 2.400 x 1.200 dpi<\/li> <li>Erweiterte Bedienerfreundlichkeit und Sicherheitsfunktionen<\/li> <li>Optionales Produktivit\u00e4ts-Kit mit 160 GB-Festplattenlaufwerk (Standard auf dem Modell DX)<\/li> <li>Kompatibel mit Mac, Windows (einschlie\u00dflich Vista), Unix, Linux und Citrix<\/li> <li>Maximales technisches Druckvolumen von bis zu 120.000 Seiten pro Monat<\/li> <li>Mindestabmessungen (B x T x H): 560 x 516 x 429 mm<\/li> <li>Elektrische Anschlusswerte: 230 V, 50\/60 Hz<\/li> <li>Lieferumfang<\/li> Farbe Tonerkartuschen (Kapazit\u00e4t: Je 5.000 Seiten<sup>1<\/sup>)<\/li> Schwarze Tonerkartusche (Kapazit\u00e4t: 7.100 Seiten<sup>1<\/sup>)<\/li> Trommeleinheiten<sup>2<\/sup> (Kapazit\u00e4t: 50.000 Seiten je Farbe, 50.000 Schwarzwei\u00dfseiten)<\/li> Netzkabel<\/li> Software und Dokumentation<\/li> <\/ul>  Produktivit\u00e4tsmerkmale <ul> <li>Herausragende Druckqualit\u00e4t Dank echter 2.400 x 1.200 dpi Druckaufl\u00f6sung und True Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Unglaubliche Leistung mit einer Druckgeschwindigkeit von bis zu 45 S.\/Min. in Farbe und Schwarzwei\u00df<\/li> <li>Maximales technisches Druckvolumen von 120.000 Seiten f\u00fcr B\u00fcros mit h\u00f6chstem Druckvolumen<\/li> <li>1,25 GHz-Prozessor und 1 GB Standard-Systemspeicher bew\u00e4ltigen einen konstanten Strom komplexester Auftr\u00e4ge mit Leichtigkeit<\/li> <li>Dank der Druckumgehungsfunktion entstehen keine langen Druckverz\u00f6gerungen, da der auf andere Ressourcen angewiesene Auftrag (z. B. anderes Papierformat) angehalten wird und der n\u00e4chste anstehende Druckauftrag vorgezogen wird<\/li> <li>Erweiterbar durch Endverarbeitungsoptionen f\u00fcr Stapeln (1.000 Blatt) und Heften (50 Blatt)<\/li> <\/ul>  Bedienerfreundliche Merkmale <ul> <li>\u00dcber die gro\u00dfe, farbige 10,9 cm-Touchscreen-Benutzeroberfl\u00e4che greifen Sie schnell und einfach auf jede ben\u00f6tigte Funktion zu<\/li> <li>Integrierte Videoanleitungen bieten direkt \u00fcber das Bedienfeld schnelle Hilfe bei der Fehlerbehebung<\/li> <li>Color By Words \u2013 W\u00e4hlen Sie die gew\u00fcnschten Farbmodifikationen einfach \u00fcber eine Dropdownliste im Drucker-Treiber aus<\/li> <li>Papierzuf\u00fchrung mit intelligenten Funktionen - Kein R\u00e4tselraten mehr durch die Anzeige aller verf\u00fcgbaren Druckmaterialien und -formate zum Zeitpunkt des Druckvorgangs<\/li> <\/ul>  Merkmale zur Schonung von Ressourcen <ul> <li>Serienm\u00e4\u00dfiger Duplexdruck bei Phaser 6700\/DN-, DT- und DX-Konfigurationen f\u00fcr weniger Papierverbrauch<\/li> <li>Innovativer EA-Toner erm\u00f6glicht im Vergleich zu herk\u00f6mmlichem Toner eine Fixierung bei geringerer Temperatur und erzeugt dabei hochwertigen B\u00fcro-Grafikdruck mit gl\u00e4nzender Oberfl\u00e4che<\/li> <li>Die Phaser 6700\/DN-, DT- und DX-Konfigurationen unterst\u00fctzt die ENERGY STAR\u00ae-Spitzenstandards f\u00fcr sparsamen Energieverbrauch.<\/li> <\/ul>  Sicherheitsmerkmale <ul> <li>Neueste Sicherheitsfunktionen mit kostenloser 256-Bit-Verschl\u00fcsselung nach dem Standard FIPS 140-2, au\u00dferdem integrierte Unterst\u00fctzung von IPv6, IPsec, sichere HTTPS-Verbindung und andere Netzwerksicherheitsfunktionen nach Branchennorm<\/li> <li>Optionales Produktivit\u00e4ts-Kit mit Festplattenlaufwerk enth\u00e4lt die gesch\u00fctzte Druckausgabe, die private Auftr\u00e4ge in der Warteschlange h\u00e4lt, bis sie vom Auftraggeber am Ger\u00e4t freigegeben werden (Standard auf dem Modell DX)<\/li> <li>Die verf\u00fcgbare Daten\u00fcberschreibung \u201eImage Overwrite\u201c entfernt nicht ben\u00f6tigte Daten komplett aus dem Festplattenspeicher des Farbdruckers Phaser 6700<\/li> <\/ul>  <sup>1<\/sup> Durchschnittliche Standardseiten. Angegebener Ertrag gem\u00e4\u00df ISO\/IEC 19798. Ertrag variiert aufgrund von Druckbild, Seitendeckung und Druckmodus. <sup>2<\/sup> Ungef\u00e4hre Anzahl Seiten. Angegebener Ertrag der Trommeln basiert auf einer durchschnittlichen Auftragsgr\u00f6\u00dfe von 4 Seiten im Format A4\/Letter. Angegebener Ertrag des Fixierers basiert auf Seiten von 75 g\/m\u00b2 im Format A4\/Letter. Ergiebigkeit von Trommel und Fixiereinheit variieren je nach Auftragsumfang, Nutzungsmustern sowie Art, Gr\u00f6\u00dfe, Grammatur und Ausrichtung des Materials."},{"locale":"en_US","scope":"print","data":"Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 Colour Laser Printer The Phaser\u00ae 6700 colour laser printer accelerates work group productivity, giving you more time to focus on what matters most: the success of your business.  With the winning combination of exceptional image quality and impressive fast print speed, the Xerox Phaser 6700 takes your business or large work group to a new level of high-volume productivity. You get unbeatable colour accuracy on every business-critical document you print, with the added benefits of superior ease-of-use and renowned reliability that only come from Xerox.  Quick Facts <ul> <li>Colour: up to 45 ppm Black: up to 45 ppm <\/li> <li>Maximum paper size: 216 x 356 mm<\/li> <li>Two-sided output standard on 6700\/DN, DT and DX configurations<\/li> <li>Finishing option adds 1000-sheet stacking and 50-sheet stapling<\/li> <li>True 2400 x 1200 dpi print resolution<\/li> <li>Advanced ease-of-use and security features<\/li> <li>Optional Productivity Kit with 160 GB hard drive (standard on DX model)<\/li> <li>Mac, Windows (including Vista), Unix, Linux, and Citrix compatible<\/li> <li>Maximum duty cycle of up to 120,000 pages per month<\/li> <li>Minimum dimensions (w x d x h): 560 x 516 x 429 mm<\/li> <li>Power requirements: 240 V, 50\/60 Hz<\/li> <li>What comes in the box<\/li> Colour toner cartridges (capacity: 5,000 pages each<sup>1<\/sup>)<\/li> Black toner cartridge (capacity: 7,100 pages<sup>1<\/sup>)<\/li> Drum cartridges<sup>2<\/sup> (capacity: 50,000 pages per colour, 50,000 pages black)<\/li> Power cord<\/li> Software and documentation<\/li> <\/ul>  Productivity Features <ul> <li>Superior print quality thanks to true 2400 x 1200 dpi print resolution and true Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Incredible performance, with a colour and black-and-white print speed of up to 45 ppm<\/li> <li>The 120,000-page monthly duty cycle supports the heaviest office print volumes<\/li> <li>1.25 GHz processor and standard 1 GB system memory handle a steady stream of complex jobs with ease<\/li> <li>The Print Around feature eliminates extended printing delays by holding a job in need of resources (such as a different paper size) and printing the next job in the queue<\/li> <li>Finisher option allows you to add 1000-sheet stacking and 50-sheet stapling<\/li> <\/ul>  Ease-of-use Features <ul> <li>The large, 109 mm colour touch screen interface makes it ultra easy to find the functions you need<\/li> <li>Embedded help videos provide quick troubleshooting assistance right on the front panel<\/li> <li>Color By Words lets you select desired colour modifications from a simple drop-down list <\/li> <li>Smart Trays alleviate guesswork by showing all available media types and sizes at print time<\/li> <\/ul>  Resource-conserving Features <ul> <li>Standard duplexing on Phaser 6700\/DN, DT and DX configurations help you reduce paper consumption<\/li> <li>Innovative EA Toner requires a lower fusing temperature than traditional toner while offering glossy, beautiful office graphics<\/li> <li>The Phaser 6700\/DN, DT and DX configurations support the highest ENERGY STAR\u00ae standards for power-saving.<\/li> <\/ul>  Security Features <ul> <li>State-of-the-art security includes free 256-bit encryption using the FIPS 140-2 standard, plus built-in support for IPv6, IPsec, secure HTTPS, and other industry-standard network security features<\/li> <li>Optional Productivity Kit with Hard Drive includes the Secure Print feature which holds private print jobs in the queue until they\u2019re released at the device by the job owner (standard on DX model)<\/li> <li>Available Image Overwrite feature completely removes unneeded data from the Phaser 6700 colour printer\u2019s internal storage<\/li> <\/ul>  <sup>1<\/sup> Average standard pages. Declared Yield in accordance with ISO\/IEC 19798. Yield will vary based on image, area coverage and print mode. <sup>2<\/sup> Approximate pages. Declared Yield on Drums based on an average job size of 4 pages A4\/letter size. Declared Yield on Fusers based on A4\/letter size 20 lb (75 gsm) pages. Drum and Fuser Yields will vary based on job run length, media type, size, weight, orientation, and usage patterns."},{"locale":"fr_FR","scope":"print","data":"Imprimante laser couleur Xerox<sup>\u00ae<\/sup> Phaser<sup>\u00ae<\/sup> 6700 L\u2019imprimante laser couleur Phaser<sup>\u00ae<\/sup> 6700 am\u00e9liore la productivit\u00e9 du groupe de travail en vous lib\u00e9rant du temps que vous pouvez ainsi consacrer \u00e0 ce qui rev\u00eat le plus d\u2019importance : la r\u00e9ussite de votre activit\u00e9.  Avec une combinaison gagnante de qualit\u00e9 d\u2019image exceptionnelle et de rapidit\u00e9 d\u2019impression \u00e9tonnante, l\u2019appareil Xerox Phaser 6700 offre \u00e0 votre entreprise ou \u00e0 votre grand groupe de travail un niveau sup\u00e9rieur de productivit\u00e9 en gros volumes. Vous b\u00e9n\u00e9ficiez d\u2019une pr\u00e9cision des couleurs sans pareil pour chaque document strat\u00e9gique imprim\u00e9, avec l\u2019avantage suppl\u00e9mentaire d\u2019une facilit\u00e9 d\u2019utilisation sup\u00e9rieure et d\u2019une fiabilit\u00e9 de renom que seule Xerox peut vous offrir.  Pr\u00e9sentation g\u00e9n\u00e9rale <ul> <li>Couleur: jusqu'\u00e0 45 ppm Noir et Blanc : jusqu'\u00e0 45 ppm <\/li> <li>Format de papier maximal : 216 x 356 mm<\/li> <li>Impression recto-verso standard sur les configurations 6700\/DN, DT et DX<\/li> <li>L'option de finition ajoute une r\u00e9ception de 1.000 feuilles et l'agrafage de 50 feuilles<\/li> <li>V\u00e9ritable r\u00e9solution 2400 x 1200 dpi<\/li> <li>Fonctions d'utilisation ais\u00e9e et de s\u00e9curit\u00e9 avanc\u00e9es<\/li> <li>Kit de productivit\u00e9 optionnel avec disque dur de 160 Go (en standard sur Phaser 6700\/DX)<\/li> <li>Compatible Mac, Windows (notamment Vista), Unix, Linux et Citrix<\/li> <li>Cycle de service maximum de 120.000 pages par mois<\/li> <li>Dimensions minimum (L x P x H): 560 x 516 x 429 mm<\/li> <li>Alimentation \u00e9lectrique: 230 V, 50\/60 Hz<\/li> <li>Contenu de l'emballage<\/li> Cartouches de toner de couleur (capacit\u00e9 : 5 000 pages (de chaque)<sup>1<\/sup>)<\/li> Cartouche de toner noire (capacit\u00e9 : 7 100 pages<sup>1<\/sup>)<\/li> Cartouches de tambour<sup>2<\/sup> (capacit\u00e9 : 50 000 pages par couleur, 50 000 pages (noir))<\/li> Cordon d'alimentation<\/li> Logiciel et documentation<\/li> <\/ul>  Fonctions de productivit\u00e9 <ul> <li>Qualit\u00e9 d'impression sup\u00e9rieure gr\u00e2ce \u00e0 la v\u00e9ritable r\u00e9solution 2400 x 1200 et \u00e0 la compatibilit\u00e9 totale avec Adobe\u00ae PostScript\u00ae 3\u2122<\/li> <li>Extraordinaire performance, avec une vitesse d'impression couleur et noir et blanc pouvant atteindre jusqu'\u00e0 45 ppm<\/li> <li>Le cycle de service mensuel de 120.000 pages supporte les volumes d'impression bureautique les plus \u00e9lev\u00e9s<\/li> <li>Le processeur 1,25 GHz et la m\u00e9moire syst\u00e8me de 1 Go standard g\u00e8rent ais\u00e9ment un flux complexe de t\u00e2ches<\/li> <li>La fonction \u00ab Print Around \u00bb \u00e9limine les retards d'impression prolong\u00e9s en suspendant toute t\u00e2che exigeant des ressources diff\u00e9rentes (format de papier diff\u00e9rent, par exemple) afin de traiter la t\u00e2che suivante de la file d'attente.<\/li> <li>L'option de finition permet d'ajouter une r\u00e9ception de 1.000 feuilles et l'agrafage de 50 feuilles<\/li> <\/ul>  Fonctions simples <ul> <li>Le grand \u00e9cran tactile couleur de 4,3 de l'interface permet de trouver ais\u00e9ment les fonctions n\u00e9cessaires.<\/li> <li>Les fichiers d'aide vid\u00e9o int\u00e9gr\u00e9s offrent une assistance de d\u00e9pannage rapide, directement en fa\u00e7ade<\/li> <li>Le syst\u00e8me \u00ab Color By Words \u00bb permet de s\u00e9lectionner les modifications chromatiques voulues dans une simple liste contextuelle. <\/li> <li>La fonction de s\u00e9lection intelligente de magasin supprime la conjecture en affichant tous les types et les formats de support au moment de l'impression<\/li> <\/ul>  Des fonctions qui pr\u00e9servent les ressources <ul> <li>Le mode duplex standard sur les configurations Phaser 6700\/DN, DT et DX contribue \u00e0 diminuer la consommation de papier<\/li> <li>Le toner innovant EA requiert une temp\u00e9rature de fixation plus basse que le toner conventionnel mais permet l'impression de superbes graphiques brillants.<\/li> <li>Les configurations Phaser 6700\/DN, DT et DX sont conformes aux plus hautes normes ENERGY STAR\u00ae d'\u00e9conomie d'\u00e9nergie.<\/li> <\/ul>  Fonctions de s\u00e9curit\u00e9 <ul> <li>S\u00e9curit\u00e9 de premier ordre qui comprend un cryptage libre 256 bits utilisant la norme FIPS 140-2, plus la prise en charge int\u00e9gr\u00e9e des normes IPv6, IPsec, HTTPS s\u00e9curis\u00e9, entre autres fonctions de s\u00e9curit\u00e9 r\u00e9seau standard dans l'industrie<\/li> <li>Le kit de productivit\u00e9 optionnel avec disque dur inclut la fonction d'impression prot\u00e9g\u00e9e, qui conserve les t\u00e2ches d'impression priv\u00e9es dans la file d'attente jusqu'\u00e0 ce que leur propri\u00e9taire les d\u00e9clenche au niveau du syst\u00e8me (en standard sur Phaser 6700\/DX)<\/li> <li>La fonction de nettoyage des images supprime totalement les donn\u00e9es inutiles du stockage interne de l'imprimante couleur Phaser 6700<\/li> <\/ul>  <sup>1<\/sup> Pages standard moyennes. Rendement d\u00e9clar\u00e9 conform\u00e9ment \u00e0 la norme ISO\/IEC 19798. Le rendement varie en fonction de l'image, de la couverture et du mode d'impression. <sup>2<\/sup> Pages approximatives. Rendement d\u00e9clar\u00e9 des tambours bas\u00e9 sur un travail moyen de 4 pages au format A4. Rendement d\u00e9clar\u00e9 des unit\u00e9s de fusion bas\u00e9 sur des pages au format A4 et de grammage de 75 gm\u00b2. Les rendements des modules photor\u00e9cepteur et four d\u00e9pendent dela longueur des tirages, des supports utilis\u00e9s - type, format, grammage, orientation - et des modes d'utilisation du syst\u00e8me."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-20T00:00:00+00:00"}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"183c8cf0-392d-4e7a-bd5b-a3f9de265ba4","identifier":"11047562","enabled":true,"family":"pc_monitors","categories":["pc_monitors","samsung","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Samsung S24A450MW"}],"description":[{"locale":"en_US","scope":"print","data":"With the Samsung S24A450MW Professional Monitor, uncomfortable viewing is in the past. You can improve posture and enhance your visual experience by maintaining optimal eye level with simple and flexible adjustment of height, tilt and pivot. The lightweight and compact S24A450MW also helps make the most of your working environment with space-saving innovations like the detachable adaptor and easy VESA wall-mounting, and conserve the natural environment with energy-saving features and efficient design.\\n\\n<b>Conveniently adjust monitor height, tilt and perspective<\/b>\\nThe Samsung LED Business Monitor SA450 has been designed to help boost work efficiency, delivering a tailored experience with its choice of viewer settings. The height-adjustable stand ensures that the screen can always be set at the optimal eye level, which enhances the visual experience while also helping maintain the viewer\u2019s body posture. Other features include the tilt and pivot capabilities, which not only increase comfort levels but also introduce new ways of working. The SA450 Monitor can rotate 90\u00b0 degrees, allowing for more appropriate view depending on the work. So, now you can take convenience and efficiency to amazing heights with the Samsung LED Business Monitor SA450.\\n\\n<b>Maximise workspace with an efficient detachable adaptor<\/b>\\nIf you need a work monitor that uses office space efficiently, then Samsung LED Business Monitor SA450 is the perfect choice. It features an innovative new detachable adaptor, which allows the monitor to be easily moved and installed. From physically moving the monitor with the carrying handle to quickly installing, the SA450 is ready to deliver an efficient and clean work space. The SA450 is also equipped and prepared for you as a VESA Wall mount, providing a multi-screen or wall mounted monitor. Optimising your office space is now easily achieved with the Samsung LED Business Monitor SA450.\\n\\n<b>Enjoy energy savings with the lightweight LED display<\/b>\\nSamsung\u2019s lightweight LED Business Monitor SA450 provides another energy saving option through its low consumption levels. This reduction in energy helps both financial and environmental aspects of the business, and is an important part of any work operation. The LED Business Monitor SA450 is also remarkably lightweight and reduces the hassles associated with transporting monitors, and is just one more way that Samsung is helping enhance the working environment.\\n\\n<b>Go green with Samsung\u2019s Adaptor On Off 0W<\/b>\\nThe ultimate energy saving measure has been created by Samsung with the new Adaptor On Of mode. By simply flicking the mechanical switch found on the Samsung LED Business monitor SA450, you can cut energy output while not using the monitor down to an amazing 0 Watts. Conventional standby modes reduce energy output to about 1 Watt, but the SA450 goes one stop further for greater results. This helps minimises both environmental impact and operating costs, and is just one more step by Samsung in creating a greener environment.\\n\\n<b>Clear your desk with Samsung\u2019s Cable Arrangement<\/b>\\nA tidy and clean workspace is paramount when it comes to showing professionalism at work. That\u2019s why the Samsung LED Business Monitor SA450 comes with a Cable Arrangement. It conveniently organises the cables coming from the monitor into a simple bundle along the stand and helps minimise clutter around the screen. With the Samsung LED Business Monitor SA450, you can finally enjoy a neat workspace, where annoying cables are kept out of sight.\\n\\n<b>Upgrade to the next level with Mega Dynamic Contrast<\/b>\\nExperience amazing new levels of colour, brilliance and picture quality through the very latest in Mega Dynamic Contrast Ratio. The Samsung LED Business monitor SA450 delivers images so real-to-life that it will transform your whole viewing experience. Packed with breathtaking 5000000:1 contrast ratio, the highest level currently available, the SA450 ensures that blacks are at their absolute darkest and (with pristine whites) colours are at their brightest. You will immediately notice the crystal clear picture and its unbelievable intensity. It is like an explosion of colours and leaves other screens seeming dull in comparison.\\n\\n<b>A monitor design to match business needs<\/b>\\nThe Samsung LED Business Monitor SA450 has been designed to enhance work conditions and efficiency. Featuring Front Tactile Buttons, the SA450 minimises costly errors found with high usage, which is a common problem with touch type button monitors. Furthermore, with its smarter design, users can still access these buttons when wall mounted, which can be an issue when monitors feature side panel buttons. Adding to the visual experience, the SA450 features a Narrow Matt Bezel. This reduces distraction around display area and delivers an experience that is immersive and engaging.\\n\\n<b>Magic Angle Vertical delivers perfection every time<\/b>\\nThe Samsung LED Business monitor SA450 feature the Magic Angle Vertical to deliver a picture-perfect screen even when not viewed from directly in front. This means that you can watch your monitor sitting down, standing up or lying on the couch and still enjoy a great view. And with 20 different angle steps (10 up and 10 down) you will always have a choice to match your position. So, when watching with Magic Angle Vertical, which is even also specialised for LED Business monitor, it feels like you\u2019re always standing right in front of the screen\u2026 even if you aren\u2019t."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-20T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}],"weight":[{"locale":null,"scope":null,"data":{"amount":"5.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"28c1bd51-9909-4eef-984f-157f23eb1911","identifier":"11049714","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["scan"]}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS MF4430"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Stylish and compact<\/b>\\nThis multifunctional offers high quality print, copy and scan functionality in one space saving, highly affordable package. With its small footprint and stylish all black design, it\u2019s a welcome addition to any desk and is ideal for use at home or in the office.\\n\\n<b>Superior image quality<\/b>\\nAn enhanced print resolution of up to 1200 x 600 dpi delivers professional laser output for all your work, with sharp text and fine graphics.\\n\\n<b>35-sheet Automatic Document Feeder<\/b>\\nCopy and scan multiple page documents quickly and easily with the 35-sheet Automatic Document Feeder.\\n\\n<b>Easy to use<\/b>\\nThe i-SENSYS MF4430 features a simple and intuitive LCD interface designed for easy operation. With 5 lines of text plus animations, features can be quickly and easily accessed and more information can be communicated saving time and effort.\\n\\n<b>Save time and energy<\/b>\\nWith an output speed of 23 ppm and a Fast First Copy Out Time of less than 9 seconds, prints and copies are delivered the moment you need them. With quick recovery from sleep mode, thanks to Quick First-Print technologies, long waits for your documents are a thing of the past. Additionally, this economical device uses only 3 watts in sleep mode, ensuring energy efficiency.\\n\\n<b>Versatile colour scanning<\/b>\\nScanning colour documents and photos is easy and highly versatile using a resolution as high as 9600 x 9600 dpi. Files can be scanned directly to email, or searchable PDF using the MF Toolbox, enabling them to be quickly retrieved in the future.\\n\\n<b>All-in-One cartridge<\/b>\\nThe All-In-One recyclable cartridge ensures maintenance-free operation and continuous high quality output. Replace the compact cartridge in seconds \u2013 containing toner, drum and cleaning units \u2013 with an Authentic Canon Laser Cartridge and your multifunctional is as good as new."}],"color_scanning":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-21T00:00:00+00:00"}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"56967630-405d-491b-ba43-2186895ba904","identifier":"11051162","enabled":true,"family":"led_tvs","categories":["led_tvs","toshiba","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"picture":[{"locale":null,"scope":null,"data":"f\/c\/1\/3\/fc138ac237a30412daab892ddfc82da5b97e447c_11051162_7823.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/f\/c\/1\/3\/fc138ac237a30412daab892ddfc82da5b97e447c_11051162_7823.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Toshiba 40TL838G LED TV"}],"description":[{"locale":"de_DE","scope":"print","data":"<b>FULL HD, 200HZ AMR, LED-TV<\/b>\\n\\nSmarter Einstieg in die 3D-Welt. Mit der Active-Shutter-Technik erleben Sie mit einer entsprechenden Brille 3D-Filme in h\u00f6chster Aufl\u00f6sung und mit atemberaubendem Tiefeneffekt auf dem 40TL838G (102 cm Bilddiagonale).\\n\\n<b>LED<\/b>\\n\\nLEDs wandeln Strom effizient in Licht um und reagieren schneller als Leuchtstoffr\u00f6hren auf Helligkeits\u00e4nderungen. Sie liefern so bessere Bildqualit\u00e4t und erm\u00f6glichen bei LCD-Fernsehern \u2013 in Kombination mit unserer Dimming-Funktion \u2013 eine nat\u00fcrliche Farbwiedergabe bei niedrigem Stromverbrauch.\\n\\n<b>HBBTV<\/b>\\n\\nEin europ\u00e4ischer Standard f\u00fcr die \u00dcbertragung und Anzeige von Internetinhalten auf Fernsehern. HbbTV erm\u00f6glicht den Zugriff auf umfangreiche Zusatzinformationen zum laufenden Programm und die Mediatheken der Fernsehsender.\\n\\n<b>Toshiba Places<\/b>\\n\\n<b>Dualtuner<\/b>\\n\\nDieser TV bietet neben einem analogen Tuner ebenfalls einen Tuner f\u00fcr DVB-T und DVB-C.\\nToshiba Places \u2013 die besten Internet-Inhalte auf Knopfdruck"},{"locale":"en_US","scope":"print","data":"DIVE INTO 3D<br>\\n<br>\\n - 40\" (102 cm) LED Smart TV<br>\\n - 3D Full HD panel (active shutter technology)<br>\\n - 200 AMR (Active Motion & Resolution)<br>\\n - WiFi\u00ae ready (optional WiFi\u00ae dongle required)<br>\\n - Toshiba Places online portal<br>\\n - Dual Tuner (DVB-T, DVB-C)<br>\\n - Connections: 4x HDMI\u2122, 2x USB<br>\\n - Colour: black brushed-metal frame"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-21T00:00:00+00:00"}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":40,"unit":"INCH"}}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"9a50102f-51bc-46af-802a-ad1cb3824825","identifier":"11057376","enabled":true,"family":"pc_monitors","categories":["lenovo","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Lenovo ThinkVision LT1952p"}],"description":[{"locale":"en_US","scope":"print","data":"For enterprises that need a green, fully functional display screen, with unparalleled visual quality, the ThinkVision LT1952p is the best choice. Compatible with virtually any hardware platform, the LT1952p offers VGA, DVI-D, and DisplayPort connections. The LT1952p is a breeze to use with exceptional LED performance, swivel, tilt, and lift options, 5 milliseconds response time, and a 1000:1 contrast ratio. The LT1952p delivers high energy cost savings, through compliance with go green certifications. The monitors are mercury-free, contain reduced toxic chemicals. The LT1952p delivers the best value on investment for large enterprises."}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-22T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":19,"unit":"INCH"}}],"weight":[{"locale":null,"scope":null,"data":{"amount":"4.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"114f6557-b734-459e-83d7-e28f3456a74e","identifier":"11057377","enabled":true,"family":"pc_monitors","categories":["lenovo","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Lenovo ThinkVision LT2252p"}],"description":[{"locale":"en_US","scope":"print","data":"For large enterprises that demand performance, quality, and green values, Lenovo introduces the ThinkVision LT2252p.The LT2252p offers multiple input options for hardware compatibility \u2013 VGA, DVI-D and DisplayPort .A color gamut of 72%, higher resolution and contrast ratio gives you the best screen space and clarity needed to be productive. The monitor complements the speed of your ThinkCentre with lightning fast 5 milliseconds response times. Collaboration is more effective with lift, tilt, pivot and swivel features. With no comprise on quality, the LT2252p offers remarkable savings with certifications for green energy.\\n\\n<b>Features & Benefits:<\/b>\\n\\n- Native resolution of 1680x1050\\n- White LED backlight\\n- Aspect ratio: 16:10\\n- Brightness: 250 cd\/m2 (typical)\\n- Contrast ratio: 1000:1 (typical)\\n- View angles(Horizontal\/Vertical, @CR=10:1): 170 degrees \/ 160 degrees\\n- Respond time: 5ms (on\/off, typical)\\n- Lift, Tilt swivel and pivot stand\\n- VGA, DVI-D, DisplayPort connections\\n- Compliance with ENERGY STAR 5.1 requirements\\n- TCO certified Edge 1.1\\n- Mercury \/ Arsenic free Glass\\n- Kensington Lock slot support for security\\n- Meets 100mm VESA standard(1) for mounting\\n- Cable Management for better user experience"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-22T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":5}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1da13ac7-686d-4d54-a12e-53180fd532ed","identifier":"11057379","enabled":true,"family":"pc_monitors","categories":["lenovo","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Lenovo ThinkVision LT2452p"}],"description":[{"locale":"en_US","scope":"print","data":"Designed for large enterprises, the LT2452p is the perfect companion for your ThinkCentre desktops. Using a display has never been more comfortable, with exceptional on screen performance, with In-plane Switching (IPS) for wide viewing angles. Engineered with collaboration in mind, the 24\" widescreen has lift, tilt, swivel, and pivot capacity, allowing for high viewing comfort. The LT2452p also offers high energy savings with green certifications. Additionally, the four USB ports allow you to connect portable devices directly to your screen, adding expansion options to your PC. The LT2452p widescreen monitor is the right choice for those who need an ultimate display to increase productivity and ease of use.\\n\\n<b>Features and Benefit:<\/b>\\n\\n- Native resolution of 1920x1200 eIPS panel\\n- White LED backlight\\n- Aspect ratio: 16:10\\n- Brightness: 300 cd\/m2 (typical)\\n- Contrast ratio: 1000:1 (typical)\\n- View angles(Horizontal\/Vertical, @CR=10:1): 178 degrees \/ 178 degrees\\n- Respond time: 7ms (GtG)\\n- lift, Tilt, swivel and pivot stand\\n- VGA, DVI-D, DisplayPort connections\\n- Compliance with ENERGY STAR 5.1 requirements\\n- TCO certified Edge 1.1\\n- EPEAT Gold\/ULE Gold\\n- Kensington Lock slot support for security\\n- Meets 100mm VESA standard(*) for mounting\\n- Cable Management for better user experience"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-22T00:00:00+00:00"}],"response_time":[{"locale":null,"scope":null,"data":7}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":24,"unit":"INCH"}}]},"created":"2023-04-18T13:32:49+00:00","updated":"2023-04-18T13:32:49+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"1770deaa-eb49-4b7a-9fb6-db1c0ff72edb","identifier":"11060805","enabled":true,"family":"multifunctionals","categories":["canon","multifunctionals","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"multifunctional_functions":[{"locale":null,"scope":null,"data":["scan"]}],"name":[{"locale":null,"scope":null,"data":"Canon i-SENSYS MF5940DN"}],"description":[{"locale":"de_DE","scope":"print","data":"Optimierte Produktivit\u00e4t dank leistungsstarker SEND-Funktion und automatischen Duplexfunktionen. Kompaktes, netzwerkf\u00e4higes, energieeffizientes und daher sparsames Multifunktionssystem.\\n\\n- Automatischer Duplexdruck, Kopie, Fax und Scan\\n- Bis zu 33 Seiten\/Minute, Ausgabe der ersten Seite nach nur ca. 8 Sekunden\\n- Separate Funktionstasten f\u00fcr einfaches Scannen, umweltbewusstes Kopieren und sicheres Drucken\\n- Scan-to-E-Mail, -Netzwerkordner oder -USB-Stick\\n- Netzwerkf\u00e4hig, PCL5e\/6\\n- Energieeffizient\\n\\n<b>SW-Laser-Multifunktionssystem f\u00fcr mittlere Arbeitsgruppen.<\/b>\\n\\n<b>Kompaktes Laser-Multifunktionssystem<\/b>\\nDie herausragende Leistung dieses kompakten, netzwerkf\u00e4higen Multifunktionsger\u00e4ts erf\u00fcllt die Anforderungen kleiner, vielbesch\u00e4ftigter Arbeitsgruppen. Der benutzerfreundliche i-SENSYS MF5940dn bietet Duplexdruck, Scan-, Kopier- und Faxfunktionen in einem schlanken Ger\u00e4t.\\n\\n<b>Zeitsparend<\/b>\\nDer i-SENSYS MF5940dn steigert mit seiner Ausgabegeschwindigkeit von 33 Seiten pro Minute und schneller Ausgabe der ersten Seite nach weniger als 8 Sekunden die Produktivit\u00e4t. Au\u00dferdem gew\u00e4hrleistet die Quick First Print-Technologie minimale Wartezeiten f\u00fcr Ausdrucke. Der automatische Dokumenteneinzug mit Duplexfunktion f\u00fcr bis zu 50 Blatt zum Scannen, Kopieren oder Faxen doppelseitiger Dokumente und die optionale Papierkassette, die die Papierkapazit\u00e4t auf insgesamt bis zu 800 Blatt erweitert, garantieren ebenfalls schnelleres und effizienteres Arbeiten.\\n\\n<b>Zielwahl-Tasten f\u00fcr einfache Bedienung<\/b>\\nDas intuitive 5-zeilige LCD-Display zeigt mehr Informationen an, damit Anwender die verf\u00fcgbaren Funktionen optimal nutzen k\u00f6nnen. F\u00fcr einen noch h\u00f6heren Bedienkomfort sorgen Zielwahltasten, die direktes Scannen auf den PC, umweltfreundliches Kopieren mehrerer Seiten auf einen Ausdruck zum Einsparen von Papier und Kosten und sicheren Druck von vertraulichen Dokumenten erm\u00f6glichen und Ressourcen schonen.\\n\\n<b>Beschleunigte Arbeitsabl\u00e4ufe<\/b>\\nMit den SEND-Funktionen von Canon k\u00f6nnen Sie Ihre Dokumente schneller und effizienter verteilen. Sie bieten die M\u00f6glichkeit direkt in eine E-Mail, einen Netzwerkordner oder auf einen USB-Stick zu scannen. Dar\u00fcber hinaus erstellt die Compact PDF-Komprimierungstechnologie kleinere Dateien \u2013 mit ca. einem Zehntel der Gr\u00f6\u00dfe, die standardm\u00e4\u00dfige Komprimierung bietet \u2013 ohne Qualit\u00e4tsverlust, sodass Dokumente einfacher gesendet und gemeinsam genutzt werden k\u00f6nnen.\\n\\n<b>Einfache Verwaltung<\/b>\\nMit diesem leistungsstarken, netzwerkf\u00e4higen Ger\u00e4t, auf das jedes Mitglied der Arbeitsgruppe zugreifen kann, sparen Sie Platz und Kosten. Der i-SENSYS MF5940dn kann \u00fcber das Netzwerk per Remote User Interface im Browser problemlos verwaltet werden.\\nDank der PCL5e\/6-Kompatibilit\u00e4t l\u00e4sst er sich nahtlos in Ihre Arbeitsumgebung integrieren.\\n\\n<b>Energie sparen und Kosten senken<\/b>\\nSch\u00fctzen Sie die Umwelt, und reduzieren Sie gleichzeitig Kosten. Der i-SENSYS MF5940dn erf\u00fcllt die Energy Star-Richtlinie und ist mit seinem geringen durchschnittlichen Energieverbrauch (TEC) von nur 1,4 kWh zzt. branchenf\u00fchrend. Im Ruhezustand ist er mit einem Verbrauch von lediglich 2,3 Watt noch energiesparender. Automatischer Duplexdruck f\u00fchrt durch geringeren Papierverbrauch zu weiteren Kosteneinsparungen."},{"locale":"en_US","scope":"print","data":"Improve productivity thanks to powerful SEND functionality and auto duplexing features. This compact, network-ready, multifunctional is highly energy efficient, keeping costs down.\\n\\n- Auto duplex print, copy, fax and scan\\n- 33 ppm\/cpm, 8 seconds First Copy Out Time\\n- Solution keys for easy scan, eco copy and secure print\\n- Scan to email, network folder and USB memory key\\n- Network-ready, PCL5e\/6\\n- Energy efficient\\n\\n<b>The easiest way to accelerate small workgroup productivity.<\/b>\\n\\n<b>Compact laser All-in-One<\/b>\\nMeet the demands of small, busy workgroups with the exceptional performance of this compact, network-ready multifunctional. The easy to use, i-SENSYS MF5940dn offers double-sided printing, scanning, copying and faxing in a single slim device.\\n\\n<b>Time-saver<\/b>\\nThe i-SENSYS MF5940dn boosts productivity with its 33 ppm output speed and class-leading First Copy Out Time of less than 8 seconds. There is also minimal waiting time for print outs, thanks to Quick First-Print technologies. The 50-sheet Duplex Automatic Document Feeder for scanning, copying or faxing double-sided documents, together with the optional cassette that expands paper supply capacity up to 800 sheets, also ensure faster and more efficient working.\\n\\n<b>One touch, ease of use<\/b>\\nThe intuitive 5-line LCD display presents more information on screen, so users make the most of the available functions. For even greater ease of use, there are one touch solution keys that allow quick scanning direct to your PC; eco-copying for combining several pages into a single print out, saving paper and money; and secure print, which is a secure way to print sensitive documents and reduce waste.\\n\\n<b>Accelerate workflows<\/b>\\nDistribute your documents faster and more efficiently using Canon\u2019s SEND functionality. With this you can scan direct to email, to a network folder or to a USB memory key. In addition, Compact PDF compression technology creates smaller files \u2013 a tenth of the size achievable with standard compression \u2013 without compromising quality, making it much easier to send and share documents.\\n\\n<b>Easy to manage<\/b>\\nSave space and cut costs with one high performance network-ready device that\u2019s available to everyone in the workgroup. The i-SENSYS MF5940dn is easy to mange over the network, via a web browser using the Remote User Interface.\\nThanks to its PCL5e\/6 compatibility it seamlessly integrates into your business environment.\\n\\n<b>Save energy and cut costs<\/b>\\nReduce your impact on the environment, while cutting costs. Energy Star compliant, the i-SENSYS MF5940dn leads the way with one of the lowest Typical Energy Consumption (TEC) figures \u2013 just 1.4 kWh. In sleep mode it only consumes 2.3 Watts of energy for greater energy efficiency. Automatic double-sided printing cuts costs further by reducing paper usage."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-22T00:00:00+00:00"}],"color_scanning":[{"locale":null,"scope":null,"data":true}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ace8d187-f08e-4578-9bca-3819f23f433f","identifier":"11070214","enabled":true,"family":"pc_monitors","categories":["iiyama","pc_monitors","tvs_projectors_sales"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"iiyama ProLite B2274HDS"}],"description":[{"locale":"de_DE","scope":"print","data":"Das neueste 22-Zoll- Display von iiyama ProLite B2274HDS-2 bietet Full-HD und ist mit einem stromsparendem und langlebigem LED-Backlight ausgestattet. Die H\u00f6henverstellbarkeit von bis zu 110 mm und die PivotFunktion pr\u00e4destinieren den Monitor f\u00fcr den anspruchsvollen Business-Einsatz. Ein Kontrastverh\u00e4ltnis von 5.000.000:1 ACR, schnelle Responsezeiten von 2 ms, exzellente Bildsch\u00e4rfe und brillante Farben runden die herausragende Qualit\u00e4t ab. Dank VESA-Mounting und integriertem Netzteil ist eine komfortable Wandmontage gew\u00e4hrleistet. Das Ger\u00e4t bietet Anschl\u00fcsse in VGA, DVI, HDMI sowie integrierte Stereolautsprecher mit 2 x 1 Watt.\\n\\n<b>LED-Backlghit<\/b>\\n\\nEin typisches CCFL LCD benutzt vier Hintergrundbeleuchtungslampen. Die Verwendung von LED Dioden lassen die Leistungsaufnahme betr\u00e4chtlich sinken, verringern die CO2-Emissionen und stellen somit ein umweltfreundliches Produkt dar.\\n\\n<b>ACR<\/b>\\n\\nDas Kontrastverh\u00e4ltnis ist ein Messwert um den maximalen relativen Helligkeitsunterscheid zwischen Schwarz und Wei\u00df darzustellen.\\nACR (Advanced Contrast Ratio) ist ein Feature welches den Kontrast und Helligkeit automatisch ver\u00e4ndert. F\u00fcr perfekte Bilder bei Filmen oder beim spielen.\\n\\n<b>HDMI<\/b>\\n\\nHDMI (High Definition Multimedia Interface) ist eine Schnittstelle f\u00fcr die volldigitale \u00dcberragung von Audio- und Video Daten.\\n\\n<b>VESA<\/b>\\n\\nVESA mount, Ein Standard wodurch Sie sehr leicht eine Wand- oder Tischhalterung anbringen k\u00f6nnen.\\n\\n<b>Pivot<\/b>\\n\\nMit der Pivotfunktion k\u00f6nnen sie den Bildschirm im Quer- oder Hochformat betreiben. Speziell gesch\u00e4tzt bei Anwendern die lange Tabellen oder Texte bearbeiten m\u00fcssen.\\n\\n<b>Full HD<\/b>\\n\\nMit einer Aufl\u00f6sung von 1920x1080p kann ihr LCD hochaufl\u00f6sende Bilder darstellen. Es bietet ihnen ein Vielfaches an darstellbarer Fl\u00e4che gegen\u00fcber einem Standard LCD. z.B. 60 % mehr Bildinhalt im Vergleich zu einem LCD mit einer Aufl\u00f6sung von 1280 x 1024.\\n\\n<b>Lautsprecher<\/b>\\n\\nAusgestattet mit zwei hochwertigen Stereolautsprecher.\\n\\n<b>OverDrive aN \/ aus<\/b>\\n\\nBei sehr schnellen bewegten Grafiken\/Bildern kann der Monitor verschwommen wirken. Durch die Aktivierung des Overdrives Features wird dieses minimiert.\\n\\n<b>HAS<\/b>\\n\\nDer h\u00f6henverstellbare Fu\u00df erm\u00f6glicht es Ihnen den Bildschirm perfekt zu positionieren, ein optimaler Sehkomfort ist dadurch gew\u00e4hrleistet. Ist gut f\u00fcr Ihre Gesundheit und steigert auch die Produktivit\u00e4t."},{"locale":"en_US","scope":"print","data":"iiyama's Business LED-backlit LCD, the ProLite B2274HDS follows full HD resolution of 1920 x 1080. It comes with Height Adjustable and Portrait Mode base providing the greatest comfort in use . High specifications include 2msec Response Time and 5M : 1 Advanced Contrast Ratio for vibrant images and blur free Video. Triple Input support of Analogue, DVI and HDMI ensures compatibility with the latest installed graphics cards and embedded Notebook outputs! And VESA mount compliance means you can easily mount your monitor to a wall.\\n\\n<b>LED-Backlit<\/b>\\n\\nA typical CCFL LCD uses four backlight lamps. Using LED diodes considerably lowers the power consumption and reduces the CO2 emission into the environment making this LCD a true ECO-Friendly product.\\n\\n<b>Full HD<\/b>\\n\\nWith true 1920 x 1080p resolution your monitor is ready to display high definition images. This means you can accommodate more information on your screen; e.g. 60% more in comparison to a 1280 x 1024 monitor.\\n\\n<b>ACR<\/b>\\n\\nContrast Ratio is a measurement of the difference between the darkest black and the brightest white your monitor can display. Advanced Contrast Ratio is a feature that automatically adjusts contrast and brightness of the screen to assure perfect picture quality while watching films and playing games.\\n\\n<b>Speakers<\/b>\\n\\nThis LED monitor is equipped with two high quality stereo speakers.\\n\\n<b>HDMI<\/b>\\n\\nHDMI stands for High-Definition Multimedia Interface. Much smaller and more convenient than DVI, HDMI also has the significant advantage over DVI that it supports audio as well as video signals.\\n\\n<b>OverDrive ON \/ OFF<\/b>\\n\\nWhen very fast graphics are displayed your monitor can sometimes get blurry. Turning on the OverDrive feature will eliminate that.\\n\\n<b>VESA<\/b>\\n\\nVESA mount compliance means you can easily mount your monitor to a wall.\\n\\n<b>Pivot<\/b>\\n\\nScreen rotation means you can change the position of the screen from landscape into portrait. This feature can be very handy while working with long spreadsheets or texts.\\n\\n<b>Height Adjustable Stand<\/b>\\n\\nA Height Adjustable Stand allows you to set the perfect position of the screen ensuring ergonomic posture and optimal viewing comfort which benefits not only your health but also productivity."},{"locale":"fr_FR","scope":"print","data":"Le mod\u00e8le ProLite B2274HDS est un \u00e9cran LCD avec r\u00e9tro-\u00e9clairage par LED qui fait partie de la gamme PRO iiyama et les mod\u00e8les caract\u00e9ris\u00e9s par la r\u00e9solution Full HD (1920 x 1080 points). Il est fourni avec un pied r\u00e9glable en hauteur qui permet aussi l\u2019ajustage au mode Portrait, offrant ainsi le plus grand confort d'utilisation. Les caract\u00e9ristiques techniques \u00e9lev\u00e9es incluent le temps de r\u00e9ponse ultra rapide de 2 ms et le niveau du contraste dynamique (ACR) 5M : 1 pour obtenir des images \u00e9clatantes et vid\u00e9o sans effet de r\u00e9manence. Les trois entr\u00e9es vid\u00e9o : analogique D-Sub et num\u00e9riques DVI et HDMI assurent la compatibilit\u00e9 avec les derni\u00e8res cartes graphiques ou entr\u00e9es int\u00e9gr\u00e9es d\u2019un ordinateur portable. La conformit\u00e9 au standard de montage VESA signifie que vous pouvez accrocher facilement votre moniteur sur le mur.\\n\\n<b>R\u00e9tro-\u00e9clairage \u00e0 LED<\/b>\\n\\nUn LCD CCFL typique utilise quatre lampes de r\u00e9tro\u00e9clairage. Les diodes LED permettent de r\u00e9duire consid\u00e9rablement la consommation d'\u00e9nergie et r\u00e9duire les \u00e9missions de CO2 dans l'environnement, en faisant de cet \u00e9cran LCD un vrai produit respectueux de l'environnement.\\n\\n<b>ACR<\/b>\\n\\nLe ratio de contraste est la mesure de la diff\u00e9rence entre le noir le plus profond et le blanc le plus clair que puisse afficher votre moniteur. Le ratio de contraste avanc\u00e9 est une fonction qui ajuste automatiquement le contraste et la luminosit\u00e9 pour assurer une qualit\u00e9 parfaite d\u2019affichage lorsque vous regardez les films ou jouez aux jeux vid\u00e9o.\\n\\n<b>HDMI<\/b>\\n\\nLe port HDMI est une interface utilis\u00e9e pour des affichages Haute D\u00e9finition. Plus petit et plus pratique que le DVI, le HDMI a aussi l\u2019avantage significatif sur le DVI, de pouvoir transmettre le son, aussi bien que le signal vid\u00e9o.\\n\\n<b>VESA<\/b>\\n\\nLa conformit\u00e9 au standard de montage VESA signifie que vous pouvez accrocher facilement votre moniteur sur le mur ou bureau qui sont conformes au standard VESA.\\n\\n<b>Pivot<\/b>\\n\\nRotation de l'\u00e9cran signifie que vous pouvez changer la position de l'\u00e9cran de l'horizontale en verticale. Cette fonction est particuli\u00e8rement appr\u00e9ci\u00e9e par les utilisateurs de CAO et PAO.\\n\\n<b>Full HD<\/b>\\n\\nAvec une r\u00e9solution de 1920 x 1080 points, votre moniteur LCD est pr\u00eat pour afficher tous types d\u2019images Haute D\u00e9finition. Ceci signifie que vous avez une plus grande surface visible (environ 60 % de plus) par rapport \u00e0 un moniteur \u00e0 la d\u00e9finition traditionnelle de 1280 x 1024 points.\\n\\n<b>Haut-parleurs<\/b>\\n\\nCe moniteur LED est \u00e9quip\u00e9 de deux haut-parleurs st\u00e9r\u00e9o de qualit\u00e9.\\n\\n<b>OverDrive ON \/ OFF<\/b>\\n\\nLorsque des dessins tr\u00e8s compliqu\u00e9s sont affich\u00e9s, votre moniteur peut quelques fois devenir flou. Mettre en fonction l\u2019 \u00ab overdrive \u00bb peut permettre d\u2019\u00e9liminer ce probl\u00e8me.\\n\\n<b>SOCLE AJUSTABLE EN HAUTEUR<\/b>\\n\\nSocle ajustable en hauteur vous permet de d\u00e9finir la position id\u00e9ale de l'\u00e9cran en assurant un confort de visualisation optimal."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-23T00:00:00+00:00"}],"display_srgb":[{"locale":null,"scope":null,"data":false}],"display_color":[{"locale":null,"scope":null,"data":false}],"response_time":[{"locale":null,"scope":null,"data":2}],"display_diagonal":[{"locale":null,"scope":null,"data":{"amount":22,"unit":"INCH"}}]},"created":"2023-04-18T13:32:53+00:00","updated":"2023-04-18T13:32:53+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"fc35b321-c741-4378-9b47-394d5a79e6bd","identifier":"11070593","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Canon PowerShot SX40 HS"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"Get closer with the PowerShot SX40 HS. An ultra-wide 35x optical zoom, great low light results of the HS System, Full HD and high-speed shooting make this the travel powerhouse for those who want it all.\\n\\n<b>Features<\/b>\\n\\n- 35x ultra wide-angle zoom with USM\\n- Image Stabilizer (4.5-stop). Intelligent IS\\n- HS System (12.1 MP) with DIGIC 5\\n- Full HD, HDMI\\n- 6.8 cm (2.7\") vari-angle LCD, EVF\\n- Smart Auto, Multi-area WB\\n- High-speed Burst HQ\\n- Manual modes\\n- Zoom Framing Assist\\n- Range of accessories\\n\\n<b>Go far, get closer with 35x zoom<\/b>\\n\\n\\n<b>35x ultra wide-angle zoom with USM<\/b>\\nA huge optical zoom including 24mm ultra wide-angle provides an incredible range (24-840mm) to suit everything from sweeping landscapes and indoor scenes to long-range close-ups of wildlife. The Ultrasonic Motor ensures highly accurate, near silent zooming even in movie mode.\\n\\n<b>Shake-free images with Intelligent IS<\/b>\\nA powerful optical Image Stabilizer delivers sharp images in low light or when using the full extent of the zoom. Intelligent IS automatically selects the optimal image stabilisation mode from 7 options, to ensure clear, detailed photos and videos.\\n\\n<b>HS System with DIGIC 5<\/b>\\nA powerful combination of the latest DIGIC 5 image processor and high-sensitivity CMOS sensor, the HS System lets you shoot with low noise and high image quality even in low light - reducing the need for flash or tripod, freezing motion without blur and increasing available flash range\\n\\n<b>Full HD Movies with HDMI-CEC<\/b>\\nRecord superb, Full HD (1080p) movies at 24fps with stereo sound. HDMI-CEC connection allows for loss-less viewing on a compatible HDTV and control of playback using the TV remote.\\n\\n<b>Vari-angle LCD and Viewfinder<\/b>\\nA 6.8 cm (2.7\u201d) vari-angle PureColor II VA LCD provides excellent visibility and enables easy framing from difficult angles. The Electronic Viewfinder can give steadier aiming.\\n\\n<b>Smart Auto with Multi-area WB<\/b>\\nSmart Auto is truly automatic, allowing the camera to detect from 32 different scenes (21 in movies), ensuring optimum results. Multi-area White Balance captures scenes in their natural colours even when illuminated by multiple types of light.\\n\\n<b>High-speed Burst HQ<\/b>\\nCapture split second action in full 12.1 MP resolution, at up to 10.3 shots\/sec. for up to 8 shots, using High-speed Burst HQ mode.\\n\\n<b>Manual modes<\/b>\\nManual modes let you take full control of the exposure to get the results you want. Easily choose your own settings such as aperture, shutter speed, white balance and ISO.\\n\\n<b>Zoom Framing Assist<\/b>\\nZoom Framing Assist helps you keep track of a distant subject when shooting with maximum zoom. At the press of a button it quickly zooms out of the scene - so you can relocate the subject - zooming back in the moment it\u2019s released.\\n\\n<b>Range of accessories<\/b>\\nAn optional Lens Filter Adapter lets you attach 67mm lens filters from Canon\u2019s EOS range. A hot-shoe allows use of Canon Speedlite EX flash units to increase flash range and expand your creativity."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-23T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"optical_zoom":[{"locale":null,"scope":null,"data":35}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:57+00:00","updated":"2023-04-18T13:32:57+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"15454c6e-b11c-4b3c-9fa0-6ff449e17b29","identifier":"11090767","enabled":true,"family":"webcams","categories":["cameras_sales","microsoft","webcams"],"groups":[],"parent":null,"values":{"maximum_video_resolution":[{"locale":null,"scope":null,"data":"1280_x_720"}],"picture":[{"locale":null,"scope":null,"data":"0\/c\/1\/c\/0c1c88d19b077561db13310c87f7eb5937d7de07_11090767_332.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/0\/c\/1\/c\/0c1c88d19b077561db13310c87f7eb5937d7de07_11090767_332.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Microsoft LifeCam Cinema 50 Pack"}],"total_megapixels":[{"locale":null,"scope":null,"data":"5"}],"description":[{"locale":"en_US","scope":"print","data":"<b>HD Video On The Go<\/b>\\nThis full-featured webcam delivers smooth, detailed video and crystal-clear audio.\\n\\n<b>True 720p HD video<\/b>\\nRecords true HD-quality video at up to 30 fps.\\n\\n<b>Auto Focus<\/b>\\nImages stay sharp and detailed even during close-ups.\\n\\n<b>High-precision glass element lens<\/b>\\nDelivers more accurate colors and sharper video.\\n\\n<b>ClearFrame Technology<\/b>\\nDelivers smooth, detailed video, even in low light conditions.\\n\\n<b>Digital Microphone<\/b>\\nWith noise cancelling technology, helps improve speech quality for crystal clear audio.\\n\\n<b>TrueColor Technology<\/b>\\nAutomatically controls exposure for bright and colorful video.\\n\\n<b>Aluminum Body<\/b>\\nLight weight with improved the durability of the webcam body.\\n\\n<b>Flexible Stand<\/b>\\nBends, folds and shapes for the best angle on laptop screens, flat panels, and traditional monitors.\\n\\n<b>Optimized for Windows Live<\/b>\\nThe perfect complement to Windows Live Messenger with easy setup and use. It just makes sense that you get a great HD experience with Microsoft LifeCams and Windows Live Messenger.\\n\\n<b>Windows Live Movie Maker<\/b>\\nStart a movie project with one click, and then upload widescreen video to social networking sites, with Windows Vista or later. (Broadband may be required.)\\n\\n<b>Windows Live Photo Gallery<\/b>\\nEasily upload a photo that you can edit, tag, and share with friends and family.\\n\\n<b>Windows Live Call Button<\/b>\\nThe easy way to start a video call with Windows Live Messenger,. (Requires Windows Vista or later, and call resolution depends on messaging client.)\\n\\n<b>Video Effects<\/b>\\nDiscover a fun way to express yourself with these entertaining video effects built into the LifeCam dashboard.\\n\\n<b>Broad IM Compatibility<\/b>\\nBasic video and audio functionality with Windows Live Messenger, AOL Instant Messenger, Yahoo! Messenger, Microsoft Office Communicator, Skype."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-25T00:00:00+00:00"}],"maximum_frame_rate":[{"locale":null,"scope":null,"data":30}]},"created":"2023-04-18T13:32:45+00:00","updated":"2023-04-18T13:32:45+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"ff9ce0c4-5ba3-4f4b-8f8d-77786b8ffccf","identifier":"11092375","enabled":true,"family":"digital_cameras","categories":["cameras_sales","canon","digital_cameras"],"groups":[],"parent":null,"values":{"camera_type":[{"locale":null,"scope":null,"data":"compact"}],"sensor_type":[{"locale":null,"scope":null,"data":"ccd"}],"name":[{"locale":null,"scope":null,"data":"Canon PowerShot SX40 HS"}],"total_megapixels":[{"locale":null,"scope":null,"data":"16000000"}],"description":[{"locale":"en_US","scope":"print","data":"Get closer with the PowerShot SX40 HS. An ultra-wide 35x optical zoom, great low light results of the HS System, Full HD and high-speed shooting make this the travel powerhouse for those who want it all.\\n\\n<b>Features<\/b>\\n\\n- 35x ultra wide-angle zoom with USM\\n- Image Stabilizer (4.5-stop). Intelligent IS\\n- HS System (12.1 MP) with DIGIC 5\\n- Full HD, HDMI\\n- 6.8 cm (2.7\") vari-angle LCD, EVF\\n- Smart Auto, Multi-area WB\\n- High-speed Burst HQ\\n- Manual modes\\n- Zoom Framing Assist\\n- Range of accessories\\n\\n<b>Go far, get closer with 35x zoom<\/b>\\n\\n\\n<b>35x ultra wide-angle zoom with USM<\/b>\\nA huge optical zoom including 24mm ultra wide-angle provides an incredible range (24-840mm) to suit everything from sweeping landscapes and indoor scenes to long-range close-ups of wildlife. The Ultrasonic Motor ensures highly accurate, near silent zooming even in movie mode.\\n\\n<b>Shake-free images with Intelligent IS<\/b>\\nA powerful optical Image Stabilizer delivers sharp images in low light or when using the full extent of the zoom. Intelligent IS automatically selects the optimal image stabilisation mode from 7 options, to ensure clear, detailed photos and videos.\\n\\n<b>HS System with DIGIC 5<\/b>\\nA powerful combination of the latest DIGIC 5 image processor and high-sensitivity CMOS sensor, the HS System lets you shoot with low noise and high image quality even in low light - reducing the need for flash or tripod, freezing motion without blur and increasing available flash range\\n\\n<b>Full HD Movies with HDMI-CEC<\/b>\\nRecord superb, Full HD (1080p) movies at 24fps with stereo sound. HDMI-CEC connection allows for loss-less viewing on a compatible HDTV and control of playback using the TV remote.\\n\\n<b>Vari-angle LCD and Viewfinder<\/b>\\nA 6.8 cm (2.7\u201d) vari-angle PureColor II VA LCD provides excellent visibility and enables easy framing from difficult angles. The Electronic Viewfinder can give steadier aiming.\\n\\n<b>Smart Auto with Multi-area WB<\/b>\\nSmart Auto is truly automatic, allowing the camera to detect from 32 different scenes (21 in movies), ensuring optimum results. Multi-area White Balance captures scenes in their natural colours even when illuminated by multiple types of light.\\n\\n<b>High-speed Burst HQ<\/b>\\nCapture split second action in full 12.1 MP resolution, at up to 10.3 shots\/sec. for up to 8 shots, using High-speed Burst HQ mode.\\n\\n<b>Manual modes<\/b>\\nManual modes let you take full control of the exposure to get the results you want. Easily choose your own settings such as aperture, shutter speed, white balance and ISO.\\n\\n<b>Zoom Framing Assist<\/b>\\nZoom Framing Assist helps you keep track of a distant subject when shooting with maximum zoom. At the press of a button it quickly zooms out of the scene - so you can relocate the subject - zooming back in the moment it\u2019s released.\\n\\n<b>Range of accessories<\/b>\\nAn optional Lens Filter Adapter lets you attach 67mm lens filters from Canon\u2019s EOS range. A hot-shoe allows use of Canon Speedlite EX flash units to increase flash range and expand your creativity."},{"locale":"fr_FR","scope":"print","data":"<b>Zoom ultra grand-angle 35x avec Moteur USM (Ultrasonic Motor)<\/b>\\nLe zoom optique tr\u00e8s puissant comprenant un ultra grand-angle 24 mm couvre une plage de focales incroyable (24-840 mm). Il est adapt\u00e9 \u00e0 toutes les situations, des paysages panoramiques et des sc\u00e8nes d'int\u00e9rieur aux gros plans \u00e0 distance de faune et de flore. Gr\u00e2ce au moteur ultrasonique, le zoom est extr\u00eamement pr\u00e9cis et son fonctionnement quasiment silencieux, m\u00eame en mode vid\u00e9o.\\n\\n<b>Des images stables gr\u00e2ce au stabilisateur d'image intelligent<\/b>\\nLe stabilisateur d'image optique puissant garantit des images nettes en basse lumi\u00e8re ou lorsque vous utilisez le zoom maximum. Le stabilisateur d'image intelligent s\u00e9lectionne automatiquement parmi les 7 options disponibles le mode de stabilisation d'image optique qui vous garantira des photos et vid\u00e9os nettes et un niveau de d\u00e9tail \u00e9lev\u00e9.\\n\\n<b>Syst\u00e8me Haute Sensibilit\u00e9 avec DIGIC 5<\/b>\\nGr\u00e2ce \u00e0 une alliance parfaite entre le tout r\u00e9cent processeur d'image DIGIC 5 et le capteur CMOS haute sensibilit\u00e9, le Syst\u00e8me Haute Sensibilit\u00e9 vous permet de r\u00e9aliser des prises de vues avec un faible niveau de bruit et une haute qualit\u00e9 d'image, m\u00eame en basse lumi\u00e8re. Vous avez ainsi moins souvent besoin d'utiliser un flash ou un tr\u00e9pied, les mouvements sont fig\u00e9s sans effet de flou et la port\u00e9e du flash disponible est plus importante.\\n\\n<b>Vid\u00e9os Full HD avec HDMI-CEC<\/b>\\nEnregistrez de magnifiques vid\u00e9os Full HD (1080p) \u00e0 24 im.\/s avec son st\u00e9r\u00e9o. La connexion HDMI-CEC permet de r\u00e9duire la perte lors de l'affichage sur un t\u00e9l\u00e9viseur HD et de contr\u00f4ler la lecture via la t\u00e9l\u00e9commande du t\u00e9l\u00e9viseur.\\n\\n<b>\u00c9cran LCD orientable et viseur<\/b>\\nL'\u00e9cran PureColor II VA LCD orientable de 6,8 cm (2,7 pouces) assure une excellente visibilit\u00e9 et permet un cadrage en toute simplicit\u00e9 sous des angles difficiles. Le viseur \u00e9lectronique permet de r\u00e9aliser des prises de vues plus stables.\\n\\n<b>Smart Auto avec correction de la balance des blancs multizones<\/b>\\nLe mode Smart Auto est enti\u00e8rement automatique, ce qui permet \u00e0 l'appareil de d\u00e9tecter 32 sc\u00e8nes diff\u00e9rentes (21 pour les vid\u00e9os). Vous avez ainsi la garantie d'un r\u00e9sultat optimal. La correction de la balance des blancs multizones permet un rendu des couleurs naturelles, m\u00eame lorsque les sources d'\u00e9clairage sont multiples.\\n\\n<b>Mode Rafale grande vitesse HQ<\/b>\\nSaisissez l'action en une fraction de seconde dans une r\u00e9solution de 12,1 millions de pixels, en r\u00e9alisant jusqu'\u00e0 10,3 prises de vues\/seconde, pour 8 images maximum, via le mode Rafale grande vitesse HQ.\\n\\n<b>Modes manuels<\/b>\\nAvec les modes manuels, vous contr\u00f4lez enti\u00e8rement l'exposition, ce qui vous permet d'obtenir exactement le r\u00e9sultat que vous voulez. Choisissez facilement vos propres r\u00e9glages, tels que l'ouverture, la vitesse d'obturation, la balance des blancs et la sensibilit\u00e9 ISO.\\n\\n<b>Assistant de cadrage au zoom<\/b>\\nL'assistant de cadrage au zoom permet de suivre un sujet \u00e0 distance lorsque vous utilisez le zoom maximum. D'une pression sur un bouton, l'assistant permet de zoomer rapidement en arri\u00e8re. Vous pouvez ainsi plus facilement retrouver le sujet. Un nouveau zoom est effectu\u00e9 lorsque la touche est rel\u00e2ch\u00e9e.\\n\\n<b>Gamme d'accessoires<\/b>\\nL'adaptateur de filtre pour objectif en option vous permet de fixer des filtres pour objectif 67 mm de la gamme EOS de Canon. La griffe permet d'utiliser les flashes Canon Speedlite EX pour augmenter la port\u00e9e du flash et stimuler votre cr\u00e9ativit\u00e9."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-26T00:00:00+00:00"}],"auto_exposure":[{"locale":null,"scope":null,"data":false}],"auto_focus_lock":[{"locale":null,"scope":null,"data":false}],"auto_focus_assist_beam":[{"locale":null,"scope":null,"data":false}],"optical_zoom":[{"locale":null,"scope":null,"data":35}],"weight":[{"locale":null,"scope":null,"data":{"amount":"533.0000","unit":"GRAM"}}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"223604cd-92a7-40b1-b486-b2e647124613","identifier":"11102651","enabled":true,"family":"laser_led_printers","categories":["laser_led_printers","lexmark","print_scan_sales"],"groups":[],"parent":null,"values":{"maximum_print_size":[{"locale":null,"scope":null,"data":"legal_216_x_356_mm_"}],"picture":[{"locale":null,"scope":null,"data":"a\/7\/2\/5\/a725e3f9e4d2486205aa5d13059402da4e190984_15743_11102651_3195.jpg","_links":{"download":{"href":"https:\/\/ak7-ee.cloud.induxx.be\/api\/rest\/v1\/media-files\/a\/7\/2\/5\/a725e3f9e4d2486205aa5d13059402da4e190984_15743_11102651_3195.jpg\/download"}}}],"name":[{"locale":null,"scope":null,"data":"Lexmark T650n"}],"description":[{"locale":"en_US","scope":"print","data":"Robust, ultra-fast and incredibly versatile, the Lexmark T650n Series fits every type of need. Whether you\u2019re looking for a serious performer for high-volume printing or an effective solution for printing on a wide range of media, these powerful monochrome laser printers deliver the ultimate combination of quality, low ownership costs and outstanding reliability.\\n\\nUp to 43 ppm print speeds.\\n\\n500MHz processor.\\n\\n128MB standard memory.\\n\\nRecommended monthly volume: 3,000 to 20,000 pages.\\n\\n350-sheet standard input, 4,000 maximum.\\n\\n350-sheet standard output, 2,750 maximum.\\n\\nShips with a 7,000-page Starter Return Program Print Cartridge.\\n\\nLexmark High Yield Print Cartridge (25,000 pages) available."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2011-09-28T00:00:00+00:00"}],"weight":[{"locale":null,"scope":null,"data":{"amount":"18.0000","unit":"KILOGRAM"}}]},"created":"2023-04-18T13:32:36+00:00","updated":"2023-04-18T13:32:37+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
