{"uuid":"877e76a7-be5d-449d-be5b-ac16e72a0202","identifier":"19535631","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA5MXX04RFC"}],"description":[{"locale":"en_US","scope":"print","data":"Philips SA5MXX04RFC. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 192. Supported radio bands: FM. Dimensions (WxDxH): 24.5 x 15.9 x 82.4"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-08-17T00:00:00+00:00"}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
