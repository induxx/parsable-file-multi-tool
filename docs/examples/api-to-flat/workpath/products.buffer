{"uuid":"f34204fc-6cee-40c9-a217-f41de062e8d3","identifier":"18184965","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA5DOT04PF"}],"description":[{"locale":"en_US","scope":"print","data":"Philips SA5DOT04PF. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 320. Weight: 0.019. Dimensions (WxDxH): 41.8 x 15 x 41.8"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-15T00:00:00+00:00"}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"e7914c9f-af3c-43d7-b60c-799ef0a4c00b","identifier":"18184975","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA5MXX04AFC"}],"description":[{"locale":"en_US","scope":"print","data":"Philips SA5MXX04AFC. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 192. Supported radio bands: FM. Dimensions (WxDxH): 24.5 x 15.9 x 82.4"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-15T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"b425bf5c-2202-42ce-9311-fdf7546a98de","identifier":"18246112","enabled":true,"family":"camcorders","categories":["camcorders","cameras_sales","canon"],"groups":[],"parent":null,"values":{"sensor_type":[{"locale":null,"scope":null,"data":"cmos"}],"name":[{"locale":null,"scope":null,"data":"Canon LEGRIA HF G30"}],"total_megapixels":[{"locale":null,"scope":null,"data":"3.09"}],"description":[{"locale":"en_US","scope":"print","data":"<b>Capture the action like a pro with the Canon LEGRIA HF G30<\/b>\\nThe flagship LEGRIA HF G30 camcorder packs high-specification optics, sensor and stabiliser plus Wi-Fi connectivity into a compact body, ideal for enthusiasts who want to match their creativity with professional quality videos.\\n\\n- 20x zoom, 26.8mm wide-angle lens; 8 blade circular aperture\\n- Control settings remotely and share with Wi-Fi\\n- Simultaneous recording of AVCHD and MP4\\n- Canon HD CMOS PRO sensor, DIGIC DV 4\\n- Optical Intelligent IS\\n- Full manual control\\n- Instant AF; Face Detection\\n- 8.8cm OLED touch screen\\n\\n<b>20x zoom, 26.8mm wide-angle lens, 8-blade aperture<\/b>\\nThe brand new 26.8mm wide angle lens provides better image quality than ever before in a compact camcorder, while the smooth 20x optical zoom lets you get closer to the action. A new, 8-blade circular aperture enables beautiful \u2018Bokeh\u2019 effect.\\n\\n<b>Wi-Fi Remote<\/b>\\nEnjoy the freedom of controlling your LEGRIA HF G30 when the camcorder is positioned out of reach. Control a number of settings, including shutter speed, focus and exposure wirelessly by using your smartphone or tablets web browser.\\n\\n<b>Dual-Format Recording<\/b>\\nSimultaneously record in different formats (AVCHD and MP4) or at different bitrates, to the dual SDXC card slots and enjoy the twin benefits of professional quality footage and easy upload to the web. Capture fast and slow motion when shooting in MP4 format.\\n\\n<b>HD CMOS PRO sensor, DIGIC DV 4<\/b>\\nWith an effective pixel count of approximately 2.91 megapixels, the new HD CMOS PRO sensor \u2013 designed and manufactured by Canon for its professional models \u2013 delivers stunning picture quality, even in low light, as well as wide dynamic range and realistic colour reproduction. The new powerful DIGIC DV 4 image processor works with the sensor to provide images with lower noise and more depth.\\n\\n<b>Optical Intelligent Image Stabilisation<\/b>\\nIntelligent IS combats camera shake by automatically selecting the right optical image stabilisation from 4 modes to counteract movement and prevent blur. The advanced dynamic mode corrects roll and tilt movements that can occur when walking, ensuring sharp steady videos in every situation.\\n\\n<b>Full Manual Control<\/b>\\nA manual lens ring allows intuitive control of focus or zoom. Exposure, aperture, shutter speed and gain can all be independently adjusted using the touch screen and customisable control dial, allowing you to unleash your creativity.\\n\\n<b>Instant AutoFocus, Face Detection<\/b>\\nInstant AF provides fast and accurate focusing for pin-sharp HD quality. Face Detection automatically optimises camcorder settings for perfectly-focused and exposed shots of people.\\n\\n<b>8.8cm (3.5\u201d) fold-out OLED touchscreen and tiltable EVF<\/b>\\nThe responsive organic electrostatic LED touch screen, with a 1.23 million dot resolution, offers superior definition, contrast and colour reproduction over LCD. The 0.61cm (0.24\u201d) 1.56 million pixel electronic colour viewfinder can tilt up to 45\u00b0 to allow you further control especially in bright conditions"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-22T00:00:00+00:00"}],"image_stabilizer":[{"locale":null,"scope":null,"data":true}],"optical_zoom":[{"locale":null,"scope":null,"data":20}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"91b79de4-9a65-41ff-8e2a-0101ce876030","identifier":"18252723","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA5MXX04KN Mix 4GB* MP3 player"}],"description":[{"locale":"en_US","scope":"print","data":"Philips SA5MXX04KN Mix 4GB* MP3 player. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 192. Dimensions (WxDxH): 24.5 x 15.9 x 82.4"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-24T00:00:00+00:00"}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"eda11da6-2ebb-4c3f-9687-84f8e83f1f37","identifier":"18252792","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","trust"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Trust Cylo Wireless Speaker"}],"description":[{"locale":"de_DE","scope":"print","data":"Kleines Aluminiumgeh\u00e4use: kann \u00fcberall mitgenommen werden. Bluetooth, 8 m Funkbereich. Kn\u00f6pfe f\u00fcr Lautst\u00e4rke, Wiedergabe und Pause. Anrufannahmetaste f\u00fcr die Annahme von Telefonanrufen. Akku aufladbar \u00fcber USB (Kabel inbegriffen). Extra Anschluss f\u00fcr MP3\/iPod."},{"locale":"en_US","scope":"print","data":"Small aluminium housing: take it anywhere. Bluetooth, 8m wireless range. Volume, play and pause buttons. Call pick up button to answer telephone calls. Battery rechargeable by USB (cable included). Extra connection for MP3\/iPod."},{"locale":"fr_FR","scope":"print","data":"Bo\u00eetier compact en aluminium\u00a0: emportez-le n'importe o\u00f9. Bluetooth, port\u00e9e sans fil de 8\u00a0m. Boutons de volume, de lecture et de pause. Bouton de prise de ligne pour r\u00e9pondre aux appels t\u00e9l\u00e9phoniques. Batterie rechargeable par port USB (c\u00e2ble inclus). Connexion suppl\u00e9mentaire pour lecteur MP3\/iPod."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-24T00:00:00+00:00"}]},"created":"2023-04-18T13:32:42+00:00","updated":"2023-04-18T13:32:43+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"0cc91cc0-ca08-4515-a83c-6f47033c683f","identifier":"18252793","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","loudspeakers","trust"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Trust Jukebar Wireless Speaker - black"}],"description":[{"locale":"de_DE","scope":"print","data":"Kleines Format, gro\u00dfer Klang. Bluetooth, 10 m Funkbereich. Musikwiedergabe und Freisprech-Telefonate. Kn\u00f6pfe f\u00fcr Lautst\u00e4rke, Medium und Anrufannahme. Aufladbare Batterie, 17 Stunden Laufzeit. Eingang f\u00fcr iPod\/Smartphone und Kopfh\u00f6reranschluss."},{"locale":"en_US","scope":"print","data":"Small size, powerful sound. Bluetooth, 10m wireless range. For music and hands-free calling. Volume, media and call-pickup buttons. Rechargeable battery, 17 hours playtime. iPod\/smartphone input and headphone connection."},{"locale":"fr_FR","scope":"print","data":"Enceinte compacte au son puissant. Bluetooth, port\u00e9e sans fil de dix m\u00e8tres. Con\u00e7ue pour la diffusion de musique et la t\u00e9l\u00e9phonie mains libres. Touches de volume, multim\u00e9dias et de prise d\u2019appel. Batterie rechargeable, dix-sept heures de diffusion. Entr\u00e9e iPod\/smartphone et connexion pour casque."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-24T00:00:00+00:00"}]},"created":"2023-04-18T13:32:40+00:00","updated":"2023-04-18T13:32:40+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"3c978210-3bf5-49ae-840b-7291d2cb7f5f","identifier":"18258543","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA4VD408KF"}],"description":[{"locale":"de_DE","scope":"print","data":"Der 11\u00a0cm (4,3\") GoGEAR Video MP3-Videoplayer bietet Ihnen lebhafte klare Videos. Genie\u00dfen Sie Videos in beliebten Formaten wie RMVB, MPEG4 und AVI in HD-Qualit\u00e4t. Steigern Sie Ihr Entertainmenterlebnis mit einem 11\u00a0cm (4,3\") gro\u00dfen LCD-Bildschirm plus eingebautem Lautsprecher"},{"locale":"en_US","scope":"print","data":"Philips SA4VD408KF. Display diagonal: 4.3. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 192. Supported radio bands: FM. Weight: 0.136. Dimensions (WxDxH): 123 x 11 x 78"},{"locale":"fr_FR","scope":"print","data":"Le baladeur vid\u00e9o MP3 GoGEAR Video 4,3\" affiche des vid\u00e9os d'une nettet\u00e9 saisissante. Regardez des vid\u00e9os aux formats classiques (RMVB, MPEG4 et AVI) en qualit\u00e9 HD. Avec son \u00e9cran LCD de 4,3\" et son haut-parleur int\u00e9gr\u00e9, le plaisir est encore plus grand."}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:55+00:00","updated":"2023-04-18T13:32:55+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"56cc1168-f00a-473a-b638-a81cc5144c97","identifier":"18258554","enabled":true,"family":"mp3_players","categories":["audio_video_sales","mp3_players","philips"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"Philips SA5DOT04BF MiniDot 4GB* MP3 player"}],"description":[{"locale":"en_US","scope":"print","data":"Philips SA5DOT04BF MiniDot 4GB* MP3 player. MP3 bit rates: 8 - 320, WMA bit rates: 5 - 320. Supported radio bands: FM. Weight: 0.019. Dimensions (WxDxH): 41.8 x 15 x 41.8"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-04-27T00:00:00+00:00"}]},"created":"2023-04-18T13:32:51+00:00","updated":"2023-04-18T13:32:51+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
{"uuid":"7089b831-8030-4774-8b24-2d264b2f5ac1","identifier":"18264046","enabled":true,"family":"loudspeakers","categories":["audio_video_sales","hp","loudspeakers"],"groups":[],"parent":null,"values":{"name":[{"locale":null,"scope":null,"data":"HP H5M98AA"}],"description":[{"locale":"de_DE","scope":"print","data":"Kristallklarer Sound \u00fcber einen kompakten, ultraportablen Lautsprecher mit modernem Design \u2013 kompatibel mit Laptops, Mobiltelefonen, tragbare Spielekonsolen, MP3-Playern, Tablets und Desktop-PCs.\\n\\n- Das moderne Design erg\u00e4nzt jedes Ger\u00e4t \u2013 in einem beeindruckend kleinen Lautsprecher.\\n- Bequemer Anschluss an Laptop, Mobiltelefon, portable Spielekonsolen oder MP3-Player \u00fcber eine 3,5 mm-Kopfh\u00f6rerbuchse \u2013 anschlie\u00dfen, abspielen, genie\u00dfen!\\n- Gemeinsame Nutzung von Musik, Pr\u00e4sentationen, Videos und mehr mit kristallklarem Sound, der im ganzen Raum h\u00f6rbar ist.\\n- Sehr ansprechendes Design mit dynamischer Auswahl an Metallic-Farben: Schwarz, wei\u00df, rot oder pink. Umfasst au\u00dferdem eine praktischeTransporttasche.\\n- Unterbrechungsfreier Musikgenuss dank einer eines internen, wiederaufladbaren Lithium-Ionen-Akkus mit einer Wiedergabedauer von bis zu 12 Stunden."},{"locale":"en_US","scope":"print","data":"Hear beautiful sound from a compact, modern designed, ultra-portable speaker - compatible with laptops, cell phones, portable game devices, MP3 players, tablets, desktop PCs.\\n\\n- The modern artistic design complements any device - all within an impressively compact palm-sized speaker.\\n- Conveniently connect using a 3.5 mm headphone jack with laptops, cell phones, portable game devices or MP3 players \u2013 Plug, Play, Enjoy!\\n- Share the music, presentation, videos and more with crisp clear acoustics that can easily be heard throughout the room.\\n- Beautiful design made even better with your choice of dynamic metallic colors: black, white, red or pink. Also includes a convenient carrying pouch.\\n- Experience uninterrupted enjoyment with a rechargeable internal lithium ion battery that lasts up to 12 hours."},{"locale":"fr_FR","scope":"print","data":"<span style=\"font-size: larger; font-weight: bold;\">Overview<\/span><br \/>\u00c9coutez un son superbe \u00e9mis par un haut-parleur compact ultra-portable au design moderne - compatible avec des ordinateurs portables, t\u00e9l\u00e9phones portables, p\u00e9riph\u00e9riques de jeu portables, MP3 lecteurs, tablettes, ordinateurs de bureau.<br \/><br \/><span style=\"font-size: larger; font-weight: bold;\">Features<\/span><br \/>&bull;&nbsp;Le design artistique moderne accompagne n'importe quel p\u00e9riph\u00e9rique - le tout dans un haut-parleur remarquablement de la taille d'une paume.<br \/><br \/>\\n&bull;&nbsp;Connectez-le facilement \u00e0 l'aide d'une prise casque jack de 3,5 mm \u00e0 des ordinateurs portables, t\u00e9l\u00e9phones portables, p\u00e9riph\u00e9riques de jeu portables ou MP3 lecteurs \u2013 Branchez, Jouez, Appr\u00e9ciez\u00a0!<br \/><br \/>\\n&bull;&nbsp;Partagez de la musique, des pr\u00e9sentations, des vid\u00e9os et bien plus encore avec un son clair et cristallin parfaitement audible dans toute la pi\u00e8ce.<br \/><br \/>\\n&bull;&nbsp;Design superbe, encore plus beau avec votre choix de couleurs m\u00e9talliques dynamiques\u00a0: noir, blanc, rouge ou rose. Comprend \u00e9galement une pochette de transport.<br \/><br \/>\\n&bull;&nbsp;\u00c9prouvez un plaisir ininterrompue gr\u00e2ce \u00e0 une batterie lithium-ion interne rechargeable fonctionnant jusqu'\u00e0 12 heures.[k1]\\n"}],"release_date":[{"locale":null,"scope":"ecommerce","data":"2013-05-02T00:00:00+00:00"}]},"created":"2023-04-18T13:32:47+00:00","updated":"2023-04-18T13:32:47+00:00","associations":{"PACK":{"products":[],"product_models":[],"groups":[]},"UPSELL":{"products":[],"product_models":[],"groups":[]},"X_SELL":{"products":[],"product_models":[],"groups":[]},"SUBSTITUTION":{"products":[],"product_models":[],"groups":[]}},"quantified_associations":[],"metadata":{"workflow_status":"working_copy"}}
